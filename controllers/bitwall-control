        `<path d="M7 2.5h2.5V5M9.5 2.5 5.5 6.5" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>`,
  log: `<rect x="2" y="1.5" width="8" height="9" rx="1" fill="none" stroke="currentColor" stroke-width="1.1"/>` +
       `<path d="M4 4.5h4M4 6.5h4M4 8.5h2.5" stroke="currentColor" stroke-width="1.1" stroke-linecap="round"/>`,
};

/* What a layer says about itself: the base's is the wall's meta, and a
 * layer above has its own, kept by its session. */
function metaOf(w, x) {
  return x.name === w.base ? (w.meta || {}) : ((w.metas || {})[x.name] || {});
}

/* The record a session was started from, with its id: the one under the
 * instance `sessions` lists it with, or null. */
function recordOf(w, x) {
  return x && x.instance && S.running[x.instance] ? {...S.running[x.instance], id: x.instance} : null;
}

/* One sender in a hat: its record's controls, what it says it is and
 * where it sits, and the facts that grow with the detail level. `x` is its
 * layer as `sessions` lists it, or null while the listing has not come. */
function hatEntry(w, meta, x, deep, place) {
  const val = key => (meta[key] || {}).value;
  const inst = val("instance") || (x && x.instance), rec = inst ? S.running[inst] : null;
  const name = val("name"), desc = val("description");
  const op = inst ? S.ops[inst] : null, busy = op && op.state === "busy";
  const icon = (action, label, glyph, off) =>
    `<button data-sender-action="${action}" data-id="${esc(inst)}" title="${label}" aria-label="${label}"` +
    `${off ? " disabled" : ""}><svg viewBox="0 0 12 12" aria-hidden="true">${glyph}</svg></button>`;
  const ctl = rec ? `<span class="ctl">` +
    (rec.up ? icon("stop", "stop", ICONS.stop, busy) : icon("stop", "clear", ICONS.clear, busy)) +
    icon("restart", "restart", ICONS.restart, busy) + icon("log", "log", ICONS.log, false) + `</span>` : "";
  const opNote = op && (busy || op.state === "failed")
    ? `<div class="op${op.state === "failed" ? " bad" : ""}" title="${esc(op.text || "")}">${busy ? DOING[op.action] + "…"
      : op.action + " failed" + (op.text ? ": " + esc(op.text.split("\n")[0]) : "")}</div>` : "";
  const pair = (n, v) => `<div class="pair"><span class="n" data-what="${n}">${n}</span>` +
                          `<span>${esc(v)}</span></div>`;
  const who = `<div class="who"${rec ? ` draggable="${S.controls === "off" ? "false" : "true"}" data-inst="${esc(inst)}"` +
              ` title="drag to another wall to move it"` : ""}><span class="name">${esc(name || (x && x.name) || "a sender with no name")}` +
              (place ? ` <span class="place">${esc(place)}</span>` : "") + `</span>${ctl}</div>`;
  const rest = opNote ? [opNote] : [];
  if (desc) rest.push(`<div class="desc">${esc(desc)}</div>`);
  if (deep > 0) {
    if (rec) {
      rest.push(pair("source", `${rec.sender} on ${rec.host}`));
      const opts = Object.entries(rec.options || {}).map(([o, v]) => v === true ? o : `${o} ${v}`);
      if (opts.length) rest.push(pair("options", opts.join(", ")));
      rest.push(pair("state", (rec.up ? "up" : "dead") + (rec.since ? `, started ${ago(rec.since)}` : "")));
    } else if (inst) {
      rest.push(pair("source", "no record of it on any sender host"));
    } else {
      rest.push(pair("source", "started by hand"));
    }
  }
  if (deep > 1) {
    const session = x ? x.name : w.base;
    if (inst) rest.push(pair("instance", inst));
    if (rec) { rest.push(pair("pid", rec.pid)); rest.push(pair("log", rec.log || "–")); }
    if (session) rest.push(pair("session", session));
    const bm = (w.smeasures || {})[session];
    if (bm) rest.push(pair("quiet", `${bm.quiet}s since its last byte`));
  }
  return {rec, who, rest};
}

/* The senders on a wall, top layer first down to the base: what each says
 * about itself, and, when a controller started it, its record on the host
 * it runs on, joined by the instance id the wall carries. One sender has
 * the hat to itself; more are stacked in it, each with its place. */
function hat(k, deep) {
  const w = S.walls[k], base = w.meta || {};
  const el = document.getElementById(id(k, "hat"));
  // A drag whose source is taken out from under it is ended by the
  // browser, and the hat is drawn several times a second.
  if (dragging && dragging.inst && el.querySelector(`[data-inst="${CSS.escape(dragging.inst)}"]`)) return;
  const wop = S.wallops[k];
  const dropNote = wop && wop.state === "busy" ? `<span class="op">starting ${esc(wop.sender)}…</span>`
    : wop && wop.state === "failed" ? `<span class="op bad">${esc(wop.text.split("\n")[0])}</span>` : "";
  const note = dropNote ? `<div class="note">${dropNote}</div>` : "";
  let layers = layersOf(w);
  if (!layers.length && HAT_KEYS.some(key => base[key])) layers = [null];
  if (!layers.length) {
    el.className = "hat none" + dropMark(el); el.innerHTML = dropNote || "no sender"; alignHats(); return;
  }
  /* Layers saying one instance are one sender's -- a base and the camera
   * it put over it, say -- and get one entry: the lowest of them as the
   * sender, its controls, record and words, and the rest listed in it.
   * A layer with no instance is nobody's but its own. */
  const instOf = x => x ? ((metaOf(w, x).instance || {}).value || x.instance)
    : (base.instance || {}).value;
  const groups = [], byInst = {};
  for (const x of layers) {
    const inst = instOf(x);
    if (inst && byInst[inst]) byInst[inst].push(x);
    else { const g = [x]; groups.push(g); if (inst) byInst[inst] = g; }
  }
  const entries = groups.map(g => {
    const x = g[g.length - 1];                         // top first: the lowest is last
    const e = hatEntry(w, x ? metaOf(w, x) : base, x, deep,
      x && (groups.length > 1 || x.z !== "0" || g.length > 1) ? described(w, x).place : "");
    if (g.length > 1) {
      const also = g.slice(0, -1).map(y => {
        const name = (metaOf(w, y).name || {}).value;
        return `${described(w, y).place} ${y.type}` + (name ? ` · ${name}` : "");
      });
      e.rest.splice(e.rest.findIndex(r => r.includes('class="desc"')) + 1, 0,
        `<div class="pair"><span class="n" data-what="also">also</span>` +
        `<span>${esc(also.join(", "))}</span></div>`);
    }
    return e;
  });
  if (entries.length === 1) {
    const [e] = entries, rows = [note + e.who, ...e.rest];
    el.className = "hat" + (e.rec && e.rec.up === false ? " dead" : "") + dropMark(el);
    el.classList.toggle("one", rows.length === 1);
    el.innerHTML = rows.join("");
  } else {
    el.className = "hat many" + dropMark(el);
    el.innerHTML = note + entries.map(e =>
      `<div class="sender${e.rec && e.rec.up === false ? " dead" : ""}">${e.who}${e.rest.join("")}</div>`).join("");
  }
  alignHats();
  adrift();
}

/* A link to a wall's glass for whoever is looking at this page, from the
 * ports, addresses and path its report says it is reached on: its HTTPS
 * name where it has one and the page is seen over the tailnet, since a
 * browser decodes a film only on a secure page; else the address the page
 * itself was reached on where the receiver is on this machine and takes
 * it, else one on the same network as the page's -- the tailnet's
 * 100.64/10 or not -- marked unsure where none is. */
function reachLink(w) {
  const here = location.hostname;
  const loop = a => ["127.0.0.1", "::1", "localhost", "[::1]"].includes(a);
  const tailnet = a => /^100\.(6[4-9]|[7-9]\d|1[01]\d|12[0-7])\./.test(a) || /\.ts\.net$/.test(a);
  const local = ["localhost", "127.0.0.1", "::1"].includes(w.host);
  const tls = (w.reach || {}).https;
  if (tls && tls.name && tls.port && (tailnet(here) || (!local && loop(here))))
    return {url: `https://${tls.name}:${tls.port}${tls.path || "/"}`, sure: true};
  const r = (w.reach || {}).http;
  if (!r || !r.port) return null;
  const bound = (r.bound || "").split(",").filter(Boolean);
  let host, sure = true;
  if (bound.includes("*")) { host = local ? here : w.host; sure = local || !tailnet(here); }
  else if (local && bound.includes(here)) host = here;
  else if (local && loop(here)) host = bound.find(loop) || bound[0];
  else {
    const fit = bound.find(a => !loop(a) && tailnet(a) === tailnet(here));
    host = fit || bound[0]; sure = !!fit;
  }
  if (!host) return null;
  if (host.includes(":") && !host.startsWith("[")) host = `[${host}]`;
  return {url: `http://${host}:${r.port}${r.path || "/"}`, sure};
}

/* A wall as a record names it, `host:wall`, as the page names it. */
function wallName(wall) {
  const [host, n] = [wall.slice(0, wall.lastIndexOf(":")), wall.slice(wall.lastIndexOf(":") + 1)];
  const d = S.devices.find(y => y.host === host);
  return d ? `${d.name}:${n}` : wall;
}

/* The records no wall shows, by their instance, each under the device
 * that is its host: a dead sender whose wall has since shown something
 * else or nothing has nowhere else to be seen. Each can be dragged onto a
 * wall, as a running one can. */
function adrift() {
  const shown = new Set(Object.values(S.walls).flatMap(w => [((w.meta || {}).instance || {}).value,
    ...Object.values(w.metas || {}).map(m => (m.instance || {}).value),
    ...(w.sessions || []).map(x => x.instance)]).filter(Boolean));
  const lost = Object.entries(S.running).filter(([iid]) => !shown.has(iid));
  for (const d of S.devices) {
    const el = document.getElementById("adrift-" + d.name); if (!el) continue;
    if (dragging && dragging.inst && el.querySelector(`[data-inst="${CSS.escape(dragging.inst)}"]`)) continue;
    const mine = lost.filter(([, rec]) => rec.host === d.host);
    const deep = LEVELS.indexOf(S.level);
    const html = !mine.length ? "" : `<span class="kind">no wall</span><div class="hats">` + mine.map(([iid, rec]) => {
      /* What it is, from its catalogue entry, since no wall is saying. */
      const x = ((S.catalogue[rec.host] || {}).senders || []).find(y => y.id === rec.sender);
      const meta = {name: {value: x ? x.label : rec.sender.split("/").pop()}, instance: {value: iid}};
      if (x && x.description) meta.description = {value: x.description};
      const e = hatEntry({smeasures: {}}, meta, null, deep, "last on " + wallName(rec.wall));
      const rows = [e.who, ...e.rest];
      return `<div class="hat${rec.up ? "" : " dead"}${rows.length === 1 ? " one" : ""}">${rows.join("")}</div>`;
    }).join("") + `</div>`;
    /* Made again only when it says something new: this runs on every
     * update, and a button replaced between press and release is a click
     * that never lands. */
    if (el.dataset.html !== html) { el.innerHTML = html; el.dataset.html = html; }
  }
}

/* Every hat as tall as the tallest, its words at the bottom against the
 * display, so the displays all start on one line however much each hat
 * says. Once a frame, however many walls changed in it. */
let aligning = false;
function alignHats() {
  if (aligning) return;
  aligning = true;
  requestAnimationFrame(() => {
    aligning = false;
    const hats = [...document.querySelectorAll(".wall > .hat")];
    for (const h of hats) h.style.minHeight = "";
    const tallest = Math.max(0, ...hats.map(h => h.offsetHeight));
    for (const h of hats) h.style.minHeight = tallest + "px";
  });
}
window.addEventListener("resize", alignHats);
window.addEventListener("resize", () => document.querySelectorAll("[data-cards]").forEach(railEnds));

function update(k) {
  const w = S.walls[k]; if (!w || !document.getElementById(id(k))) return;
  const meta = w.meta || {};
  const named = (meta.name || {}).value;
  document.getElementById(id(k, "name")).textContent = named || `${w.device}:${w.number}`;
  const st = w.status.split(":")[0];
  const m = w.measures || {};
  showNum(k, "font", w.font);
  const canPic = !!w.capture;
  document.getElementById(id(k, "picrow")).style.display = canPic ? "" : "none";
  const auto = S.auto[k] || 0;
  for (const [ms] of AUTO) document.getElementById(id(k, "auto-" + ms)).classList.toggle("on", auto === ms);
  document.getElementById(id(k, "expand")).disabled = !PICS[k];
  document.getElementById(id(k, "forget")).disabled = !PICS[k];
  const canMirror = (w.caps || []).includes("mirror");
  document.getElementById(id(k, "mirrorrow")).style.display = canMirror ? "" : "none";
  for (const [ms] of MIRRORS)
    document.getElementById(id(k, "mirror-" + ms)).classList.toggle("on", (w.mirror || 0) === ms);
  document.getElementById(id(k, "mexpand")).disabled = !PICS[k];

  if (modalKey === k) document.getElementById("modal-age").textContent = !PICS[k] ? ""
    : w.mirror && PICS[k].head.mirror ? `live, every ${w.mirror} ms` : "captured " + ago(PICS[k].head.t)
      + ((PICS[k].head.without || []).length ? ", cells only: video layers left out" : "");
  const display = w.display || (m.display && m.display !== "-" ? m.display : null);
  const power = w.power || (m.power && m.power !== "-" ? m.power : null);
  const lit = display === "lit";
  const name = n => `<span class="n" data-what="${n}"` +
    `>${n}</span>`;
  const pair = (n, v) => `<div class="pair">${name(n)}<span>${esc(v)}</span></div>`;
  /* How much of a wall to say: which wall it is, then how it is working,
   * then everything, which is what you want when something is wrong. Each
   * level adds to the end of the one before, so turning the detail up
   * leaves what was there where it was. */
  const deep = LEVELS.indexOf(S.level);
  hat(k, deep);
  sessionControls(k);
  const wall = [];
  /* The wall: its glass, its screen, who is there, and the connection. */
  wall.push(pair("wall", `${w.device}:${w.number}`));
  wall.push(pair("display", display || "–"));
  if (w.watching !== null && w.watching !== undefined) wall.push(pair("watching", String(w.watching)));
  if (power) wall.push(pair("power", power));
  if (st !== "open")
    wall.push(`<div class="pair">${name("session")}<span class="${st}"><i></i>${esc(w.status)}</span></div>`);
  if (deep > 0) {
    const pr = w.presence;
    if (pr && (pr.name || pr.from))
      wall.push(pair("presence", (pr.here ? "somebody" : "nobody") + (pr.name ? ` · ${pr.name}` : "")
                     + (deep > 1 && pr.from ? ` · from ${pr.from}` : "")));
    const screen = [m.connector && m.connector !== "-" ? m.connector : "", w.pixels || ""].filter(Boolean);
    if (screen.length) wall.push(pair("screen", screen.join(" · ")));
  }
  /* The program keeping the wall: at every level where it is not the
   * source this page has, which is what needs doing something about. */
  const rc = w.receiver;
  if (rc) {
    const want = (S.versions || {})[rc.program], off = !!want && rc.version !== want;
    if (deep > 0 || off)
      wall.push(`<div class="pair">${name("receiver")}<span class="${off ? "off" : ""}">` +
                `${esc(rc.program + " " + (rc.version || "-"))}${off ? " · not the source here" : ""}</span></div>`);
    if (deep > 1) {
      if (rc.started) wall.push(pair("started", ago(+rc.started)));
      if (rc.booted) wall.push(pair("booted", ago(+rc.booted)));
    }
  }
  if (deep > 1) {
    if (m.atlas) wall.push(pair("atlas", `${m.atlas}/${m.atlas_of}`
      + (+m.restarts ? `, ${m.restarts} restarts` : "")));
    wall.push(`<div class="wide">${name("caps")}<span>${esc((w.caps || []).join(" "))}</span></div>`);
  }
  /* The wall, its facts and then its numbers; then its sessions, each with
   * its own facts and numbers in the same shape. */
  /* A web wall is removed from its own heading, with the hat's stop. */
  const dev = S.devices.find(d => d.name === w.device);
  const remove = dev && (dev.webwalls || []).includes(k)
    ? `<button class="wctl min" data-remove="1" data-k="${esc(k)}" title="remove this web wall"` +
      ` aria-label="remove this web wall"><svg viewBox="0 0 12 12" aria-hidden="true">${ICONS.stop}</svg></button>` : "";
  /* And where it says its glass is reached, opened from here. */
  const link = reachLink(w);
  const open = link ? `<a class="wctl${link.sure ? "" : " doubt"}" href="${esc(link.url)}" target="_blank" rel="noopener"` +
    ` title="${esc(link.sure ? "open this wall's glass: " + link.url : link.url + " -- may not be reachable from here")}"` +
    ` aria-label="open this wall's glass"><svg viewBox="0 0 12 12" aria-hidden="true">${ICONS.open}</svg></a>` : "";
  let html = `<div class="sect"><div class="sh wallh"><span class="n" data-what="wall">wall</span>` +
             `<span class="wctls">${open}${remove}</span></div><div class="grp">${wall.join("")}</div>` +
             `<div class="strip" id="${id(k, "strip")}"></div></div>`;
  html += sessionsHtml(k, deep, meta);
  document.getElementById(id(k, "facts")).innerHTML = html;

  document.getElementById(id(k, "blank-1")).classList.toggle("on", lit);
  document.getElementById(id(k, "blank-0")).classList.toggle("on", display === "blank");
  document.getElementById(id(k, "powerword")).textContent =
    (display || "–") + (power === "standby" ? " · standby" : "");
  const s = w.stats || {};
  document.getElementById(id(k, "stats-1")).classList.toggle("on", !!s.on);
  document.getElementById(id(k, "stats-0")).classList.toggle("on", !s.on);
  for (const part of ["sopts", "srow"])
    document.getElementById(id(k, part)).classList.toggle("dimmed", !s.on);
  document.getElementById(id(k, "ssize")).parentElement.classList.toggle("dimmed", !s.on);
  showNum(k, "ssize", s.size);
  for (const p of POINTS) document.getElementById(id(k, "at-" + p)).classList.toggle("on", s.at === p);
  const shown = (s.show || "").split(",");
  const names = w.names || [];
  const chips = document.getElementById(id(k, "names"));
  if (chips.dataset.names !== names.join(",")) {
    chips.dataset.names = names.join(",");
    chips.innerHTML = (names.length ? `<button data-k="${esc(k)}" data-show="all">all</button>` : "") +
      names.map(n => `<button data-k="${esc(k)}" data-name="${esc(n)}">${esc(n)}</button>`).join("");
  }
  for (const b of chips.querySelectorAll("[data-name]")) b.classList.toggle("on", shown.includes(b.dataset.name));
  const fmt = (n, v) => v === "-" || v === undefined ? "–" : ["in", "out", "inbox"].includes(n) ? bytes(+v) + (n === "inbox" ? "" : "/s")
    : ["frame", "draw", "swap", "pong"].includes(n) ? v + "ms" : ["cpu", "gpu"].includes(n) ? v + "%"
    : n === "temp" ? v + "°" : n === "atlas" ? v + "/" + m.atlas_of : v;
  const live = w.live !== false;
  for (const [ms] of RATES)
    document.getElementById(id(k, "rate-" + ms)).classList.toggle("on",
      ms ? live && w.every === ms : !live);
  const strip = document.getElementById(id(k, "strip"));
  strip.classList.toggle("on", live && !!w.measured);
  if (live && w.measured)
    /* Only what the wall says it has: one that cannot know a number
     * leaves it out of its line, and is not shown a dash for it. */
    strip.innerHTML = STRIP.filter(n => n in m).map(n => {
      /* A window with no frames in it has nothing to say, which at a fast
       * rate is most of them on a slow wall. What it last said is worth
       * more than a dash, so it is kept, and dimmed to say it is old. */
      const fresh = m[n] !== undefined && m[n] !== "-";
      const held = fresh ? m[n] : (HELD[k] || {})[n];
      if (fresh) (HELD[k] = HELD[k] || {})[n] = m[n];
      return `<div><span class="n" data-what="${n}"` +
        `>${n}</span>` +
        `<span class="v${fresh ? "" : " stale"}">${esc(held === undefined ? "–" : fmt(n, held))}</span>` +
        `<span>${spark(k, n)}</span></div>`;
    }).join("");
}

/* A number being changed: shown as it is clicked or typed, and sent once,
 * when the clicking stops or Enter is pressed, so the wall is not redrawn
 * at every size on the way to the one wanted. */
const PENDING = {}, LIMITS = {font: [4, 400], ssize: [8, 40]};
function showNum(k, what, value) {
  const el = document.getElementById(id(k, what)); if (!el) return;
  const p = PENDING[k + what];
  el.classList.toggle("pending", !!p);
  if (p) { if (document.activeElement !== el) el.value = p.value; }
  else if (document.activeElement !== el) el.value = value ?? "";
}
function nudge(k, what, value, wait) {
  const [lo, hi] = LIMITS[what];
  value = Math.max(lo, Math.min(hi, Math.round(value)));
  const p = PENDING[k + what] || (PENDING[k + what] = {});
  p.value = value;
  clearTimeout(p.timer);
  p.timer = setTimeout(() => {
    delete PENDING[k + what];
    send(k, what === "font" ? "font " + value : "stats 1 size=" + value);
    update(k);
  }, wait);
  showNum(k, what);
}
function current(k, what) {
  const p = PENDING[k + what], w = S.walls[k];
  return p ? p.value : what === "font" ? (+w.font || 14) : (+(w.stats || {}).size || 14);
}

/* A picture: a two-byte length, a JSON header, and the glass as QOI, or a
 * wall with no glass as its cells. A mirror's frame is a whole picture
 * too, so each replaces the last. */
function gotPicture(buf) {
  const view = new DataView(buf), n = view.getUint16(0);
  const head = JSON.parse(new TextDecoder().decode(new Uint8Array(buf, 2, n)));
  const body = new Uint8Array(buf, 2 + n);
  if (head.format === "grid") {
    document.fonts.load(`${GRID_FONT}px ${GRID_FAMILY}`).then(() => showPicture(head, gridImage(head, body)));
    return;
  }
  showPicture(head, qoiDecode(body));
}
function showPicture(head, image) {
  if (!image) return;
  PICS[head.key] = {head, image};
  paintPic(head.key);
  if (modalKey === head.key) paintInto(document.getElementById("modal-pic"), head.key, true);
  update(head.key);
}

/* A wall's cells as a picture, drawn as the web receiver draws a cells
 * layer (PROTOCOL.md, *Layers and types*): each layer's repaint through
 * its parser into a grid, the base first and each layer over it, a cell
 * left in the default colours transparent, over the wall's black. The
 * base reads no alpha. The cells are sized so the base's grid is
 * GRID_WIDTH pixels across, and a layer with a grid of its own is fitted
 * to the same box, centred. */
const GRID_WIDTH = 1600, GRID_FONT = 100;
const GRID_FAMILY = '"bitwall wall", "MesloLGS Nerd Font Mono", Menlo, ui-monospace, monospace';
function gridImage(head, body) {
  const B = window.Bitwall, Screen = customElements.get("bitwall-screen");
  if (!B || !Screen || !head.layers || !head.layers.length) return null;
  const c = document.createElement("canvas"), ctx = c.getContext("2d");
  ctx.font = `${GRID_FONT}px ${GRID_FAMILY}`;
