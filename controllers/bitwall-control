/* The values a card's options are set to, kept per card and between
 * visits: what a drag starts the sender with. */
S.cardopts = {};
try { S.cardopts = JSON.parse(localStorage.getItem("bitwall-control-cardopts") || "{}"); } catch (e) {}
function cardValues(host, x) {
  const kept = S.cardopts[host + "|" + x.id] || {}, out = {};
  for (const [name, o] of Object.entries(x.options || {}))
    out[name] = name in kept ? kept[name] : o.default;
