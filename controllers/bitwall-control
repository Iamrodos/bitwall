  return `<div class="opts">` + opts.map(([name, o]) => {
    const at = `data-cardopt="${key}" data-name="${esc(name)}" draggable="false" title="${esc(o.description)}"`;
    const input = o.type === "bool" ? `<input type="checkbox" ${at} ${v[name] ? "checked" : ""}>`
      : o.type === "choice" ? `<select ${at}>` + o.choices.map(c =>
          `<option ${c === v[name] ? "selected" : ""}>${esc(c)}</option>`).join("") + `</select>`
      : o.type === "walls" ? `<input class="walls${wallsWhy(v[name], o) ? " bad" : ""}" type="text" spellcheck="false" autocapitalize="off" placeholder="host:wall, …" value="${esc(v[name])}" ${at}>`
      : `<input class="num" type="number" inputmode="numeric" min="${o.min}" max="${o.max}" value="${v[name]}" ${at}>`;
    return `<label title="${esc(o.description)}">${esc(o.label)}</label>${input}`;
