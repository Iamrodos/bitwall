  const cls = e.mark === "<" ? "in" : e.mark === "~" ? "st" : e.text.startsWith("error ") ? "err" : "";
  return `<div class="${cls}"><span class="t">${clock(e.t)}</span> ${esc(e.mark)} ${e.who ? esc(e.who) + " " : ""}${esc(e.text)}</div>`;
}
function shows(k, e) {
  if (!S.filters[k + "q"] && QUIET.test(e.text)) return false;
  const f = (S.filters[k] || "").toLowerCase();
  return !f || e.text.toLowerCase().includes(f);
}
function fillLog(k) {
  const el = document.getElementById(id(k, "log")); if (!el) return;
  el.innerHTML = (S.history[k] || []).filter(e => shows(k, e)).map(lineHtml).join("");
  el.scrollTop = el.scrollHeight;
}
