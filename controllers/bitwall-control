def tailscale_address():
    """This machine's Tailscale address, or None where there is none."""
    for exe in ("tailscale", "/Applications/Tailscale.app/Contents/MacOS/Tailscale"):
        try:
            out = subprocess.run([exe, "ip", "-4"], capture_output=True,
                                 text=True, timeout=5)
        except (OSError, subprocess.TimeoutExpired):
            continue
        ip = out.stdout.split()[0] if out.returncode == 0 and out.stdout.split() else ""
        if ip.startswith("100."):
            return ip
    return None


async def main_async(hosts, port):
    server = Server()
    app = web.Application()
    app.router.add_get("/", server.page)
    app.router.add_get("/ws", server.ws)
    app.router.add_get("/font.woff2", server.font)
    app.router.add_get("/bitwall-screen.js", server.screen_js)
    runner = web.AppRunner(app)
    await runner.setup()
    for host in hosts:
        await web.TCPSite(runner, host, port).start()
    print("bitwall-control  " + "  ".join(f"http://{h}:{port}/" for h in hosts)
          + f"  devices={','.join(d['name'] for d in DEVICES)}", flush=True)
    tasks = [asyncio.ensure_future(server.finding()), asyncio.ensure_future(server.pushing()),
             asyncio.ensure_future(server.watching_senders()),
             asyncio.ensure_future(server.watching_catalogues())]
    # SIGTERM and ^C both cancel this task, so the cleanup below runs on
    # a loop that is still running. Only the first does: a stop comes as
    # several signals at once -- uv passes on what the process group was
    # sent as well -- and a second cancel would cut the cleanup short.
    me = asyncio.current_task()

    def stop():
        for sig in (signal.SIGINT, signal.SIGTERM):
            asyncio.get_running_loop().add_signal_handler(sig, lambda: None)
        me.cancel()
    # Windows' loop takes no signal handlers; there ^C cancels this task
    # by way of asyncio.run, to the same cleanup.
    if not WINDOWS:
        for sig in (signal.SIGINT, signal.SIGTERM):
            asyncio.get_running_loop().add_signal_handler(sig, stop)
    try:
        await asyncio.Event().wait()
    except asyncio.CancelledError:
        pass
    finally:
        for t in tasks:
            t.cancel()
        # Every session closed before the server goes, and none waited on
        # for longer than a wall that is not answering deserves.
        with contextlib.suppress(asyncio.TimeoutError):
            walls = list(server.walls.values())
            await asyncio.wait_for(
                asyncio.gather(*(w.stop() for w in walls), return_exceptions=True), 8)
            # A wall still being opened closes what it opens once it sees
            # it is gone, so each wall's own loop is let finish too.
            await asyncio.wait_for(
                asyncio.gather(*(w.task for w in walls if w.task),
                               return_exceptions=True), 8)
        await runner.cleanup()


def same_origin(origin, host):
    """Whether a page at `origin` was served from `host`, the request's
    Host header: the same host and port, the port given or the scheme's
    own. No origin at all is a program, not a page, and is let in."""
    if origin is None:
        return True
    from urllib.parse import urlsplit

    def where(scheme, netloc):
        u = urlsplit(f"{scheme}://{netloc}")
        try:
            port = u.port
        except ValueError:
            return None
        return (u.hostname or "").lower(), port or (443 if scheme in ("https", "wss") else 80)
    u = urlsplit(origin)
    if u.scheme not in ("http", "https") or not u.netloc or not host:
        return False
    there = where(u.scheme, u.netloc)
    return there is not None and there == where(u.scheme, host)


def devices_file(ap, path):
    """The devices a file names, checked: each a name, a host and the
    order its walls stand in, if any. Other keys are other readers'."""
    try:
        with open(os.path.expanduser(path), encoding="utf-8") as fh:
            said = json.load(fh)
    except (OSError, ValueError) as e:
        ap.error(f"--devices {path}: {e}")
    devices = []
    for d in said if isinstance(said, list) else []:
        name, host = d.get("name", ""), d.get("host", "")
        order = d.get("order", [])
        if not (isinstance(name, str) and re.match(r"^[A-Za-z0-9_-]{1,32}$", name)
                and isinstance(host, str) and host and isinstance(order, list)
                and all(isinstance(o, str) for o in order)):
            ap.error(f"--devices {path}: {d!r} is not a name, a host and an order")
        devices.append({"host": host, "name": name, "order": order})
    if not devices:
        ap.error(f"--devices {path}: no devices in it")
    return devices


def default_devices(ap):
    """The devices of `$BITWALL_DEVICES` or ~/.bitwall/devices.json, else
    this machine alone, named by its short host name."""
    path = os.environ.get("BITWALL_DEVICES") or os.path.expanduser(DEVICES_FILE)
    if os.path.exists(path):
        return devices_file(ap, path)
    import socket
    name = re.sub(r"[^A-Za-z0-9_-]", "", socket.gethostname().split(".")[0])[:32]
    return [{"host": "localhost", "name": name or "this", "order": []}]


def git_ssh_first():
    """Git's `ssh` ahead of Windows' own on the path, for this and every
    program it starts: Windows' own never exits when its stdout is a pipe,
    and every ssh run here has one (AGENTS.md, Traps)."""
    found = shutil.which("ssh") or ""
    if not os.path.isfile(os.path.join(GIT_SSH, "ssh.exe")):
        print(f"bitwall-control: no Git ssh at {GIT_SSH}; using {found or 'no ssh'}, "
              f"which may hang", flush=True)
        return
    if os.path.dirname(found).lower() != GIT_SSH.lower():
        os.environ["PATH"] = GIT_SSH + os.pathsep + os.environ.get("PATH", "")
        print(f"bitwall-control: Git's ssh first on the path, ahead of {found or 'none'}",
              flush=True)


def main():
    ap = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
    ap.add_argument("--host", action="append", default=[],
                    help="an address to listen on, instead of 127.0.0.1 and the "
                         "Tailscale address; anyone who can reach the page can "
                         "change every wall")
    ap.add_argument("--port", type=int, default=8910)
    ap.add_argument("--device", action="append", default=[], metavar="NAME=HOST",
                    help="a device to show instead of the devices file, and "
                         "with it the sender hosts; may be given more than once")
    ap.add_argument("--devices", metavar="FILE",
                    help="the devices, a JSON list of {name, host, order} "
                         "(default $BITWALL_DEVICES, else " + DEVICES_FILE +
                         ", else this machine alone)")
    a = ap.parse_args()
    if WINDOWS:
        # A log in a file is in the machine's code page, which has not
        # every character a wall or a sender may say.
        for stream in (sys.stdout, sys.stderr):
            with contextlib.suppress(AttributeError, ValueError):
                stream.reconfigure(errors="backslashreplace")
        git_ssh_first()
    # Stopped by a signal is stopped as by ^C: every session is closed
    # either way.
    signal.signal(signal.SIGTERM, signal.default_int_handler)
    hosts = a.host or ["127.0.0.1"] + [ip for ip in [tailscale_address()] if ip]
    if a.devices and a.device:
        ap.error("--devices or --device, not both")
    if not a.device:
        DEVICES[:] = devices_file(ap, a.devices) if a.devices else default_devices(ap)
        SENDER_HOSTS[:] = list(dict.fromkeys(d["host"] for d in DEVICES))
    if a.device:
        devices = []
        for spec in a.device:
            name, eq, host = spec.partition("=")
            if not eq or not re.match(r"^[A-Za-z0-9_-]{1,32}$", name) or not host:
                ap.error(f"--device {spec}: not NAME=HOST")
            devices.append({"host": host, "name": name})
        DEVICES[:] = devices
        SENDER_HOSTS[:] = list(dict.fromkeys(d["host"] for d in devices))
    try:
        asyncio.run(main_async(hosts, a.port))
    except KeyboardInterrupt:
        pass


if __name__ == "__main__":
    main()
