  if (Date.now() - pongAt > 30000) { try { ws.close(); } catch (e) {} return; }
  ws.send(JSON.stringify({type: "ping"}));
}, 10000);

function connect() {
  pongAt = Date.now();
  ws = new WebSocket((location.protocol === "https:" ? "wss://" : "ws://") + location.host + "/ws");
  ws.binaryType = "arraybuffer";
  ws.onopen = () => { S.since = Date.now(); document.getElementById("conn").textContent = "live"; };
  ws.onclose = () => { document.getElementById("conn").textContent = "disconnected, retrying…"; setTimeout(connect, 1500); };
  ws.onmessage = ev => {
    S.bytes += ev.data instanceof ArrayBuffer ? ev.data.byteLength : ev.data.length;
    if (ev.data instanceof ArrayBuffer) { gotPicture(ev.data); return; }
    const m = JSON.parse(ev.data);
    pongAt = Date.now();
    if (m.type === "pong") return;
    if (m.type === "ack") {
      const w = waiting[m.ref]; if (!w) return;
      clearTimeout(w.timer); delete waiting[m.ref];
      if (!m.ok) w.failed(m.why);
      return; }
    if (m.type === "state" && S.version && m.version !== S.version) { location.reload(); return; }
    if (m.type === "state") S.version = m.version;
    if (m.type === "state") { S.devices = m.devices; S.walls = m.walls; S.history = m.history;
      S.running = m.running || {}; S.catalogue = m.catalogue || {}; S.reach = m.reach || {};
      S.versions = m.versions || {}; render(); }
    else if (m.type === "catalogue") { S.catalogue = m.catalogue; S.reach = m.reach || {}; if (S.catalog) render(); }
    else if (m.type === "running") { S.running = m.running; for (const k of Object.keys(S.walls)) update(k); adrift(); }
    else if (m.type === "wall-op") { S.wallops[m.key] = m; update(m.key); }
    else if (m.type === "web-op") { S.webops[m.device] = m; render(); }
    else if (m.type === "sender-op") {
      if (m.action === "log") { if (logId === m.id) showLog(m.text); }
      else { S.ops[m.id] = m; for (const k of Object.keys(S.walls)) update(k); adrift(); } }
    else if (m.type === "devices") { S.devices = m.devices; S.versions = m.versions || S.versions;
      // A wall no device has any more is gone, and so is all it said: its
      // senders are on no wall now.
      const kept = new Set(m.devices.flatMap(d => d.walls));
      for (const k of Object.keys(S.walls)) if (!kept.has(k)) delete S.walls[k];
      render(); }
    else if (m.type === "wall") { const was = (S.walls[m.wall.key] || {});
      if (was.every !== m.wall.every || was.live !== m.wall.live || was.mirror !== m.wall.mirror)
        setTimeout(render, 0);
      S.walls[m.wall.key] = m.wall; if (m.wall.measured) keep(m.wall.key, m.wall.measures || {}); if (!document.getElementById(id(m.wall.key))) render(); else update(m.wall.key); }
    else if (m.type === "line") { beat(m); (S.history[m.key] = S.history[m.key] || []).push(m);
      if (S.history[m.key].length > 400) S.history[m.key].shift(); appendLine(m.key, m); }
    else if (m.type === "answer") { S.answers[m.key] = m; showAnswer(m.key); }
  };
}

/* Whether every wall is already at this rate, so the choice can show
 * itself as made rather than offered. */
function everyWall(ms) {
  const walls = Object.values(S.walls);
  return walls.length > 0 && walls.every(w =>
    ms ? w.live !== false && w.every === ms : w.live === false);
}

function rate(key, live, ms) {
  if (ws && ws.readyState === 1) ws.send(JSON.stringify({type: "rate", key, live, ms}));
}

function send(key, words) {
  if (!ws || ws.readyState !== 1) return;
  S.answers[key] = {pending: true, words};
  showAnswer(key);
  ws.send(JSON.stringify({type: "command", key, words, ref: ++ref}));
}

function id(key, part) { return "w-" + key.replace(/[^a-z0-9]/gi, "-") + (part ? "-" + part : ""); }

function render() {
  document.getElementById("levels").innerHTML = LEVELS.map(x =>
    `<button data-level="${x}" class="${x === S.level ? "on" : ""}">${x}</button>`).join("");
  document.getElementById("allrates").innerHTML = RATES.map(([ms, x]) =>
    `<button data-allrate="${ms}" class="${everyWall(ms) ? "on" : ""}">${x}</button>`).join("");
  const mirrors = Object.values(S.walls).filter(w => (w.caps || []).includes("mirror"));
  document.getElementById("allmirror").innerHTML = MIRRORS.map(([ms, x]) =>
    `<button data-allmirror="${ms}" class="${mirrors.length && mirrors.every(w => (w.mirror || 0) === ms)
      ? "on" : ""}">${x}</button>`).join("");
  document.getElementById("showing").innerHTML =
    SHOWING.map(x => `<button data-controls="${x}" class="${x === S.controls ? "on" : ""}">${x}</button>`).join("");
  for (const x of SHOWING) document.body.classList.toggle("controls-" + x, x === S.controls);
