#: A command to a web receiver on its own pair of fifos in the run
#: directory, run on the web receiver's host: the command goes in with an
#: id, and the lines that come back carrying it are its answer, the last
#: of them anything but a `wall` line. Exit 0 when the answer is not an
#: error.
WEB_COMMAND = r"""
import os, secrets, select, sys, time
run, words = sys.argv[1], sys.argv[2]
cid = "ctl" + secrets.token_hex(6)
out = os.open(os.path.join(run, "bitwall-web.out"), os.O_RDONLY | os.O_NONBLOCK)
fd = os.open(os.path.join(run, "bitwall-web.in"), os.O_WRONLY | os.O_NONBLOCK)
os.write(fd, (words + " id=" + cid + "\n").encode())
os.close(fd)
end, buf, got, mark = time.time() + 5, b"", [], " id=" + cid
while time.time() < end:
    if not select.select([out], [], [], max(0, end - time.time()))[0]:
        break
    try:
        data = os.read(out, 65536)
    except BlockingIOError:
        continue
    if not data:
        time.sleep(0.02)
        continue
    *lines, buf = (buf + data).split(b"\n")
    for line in lines:
        text = line.decode(errors="replace")
        if text.endswith(mark):
            got.append(text[:-len(mark)])
            if not text.startswith("wall "):
                print("\n".join(got))
                sys.exit(1 if text.startswith("error ") else 0)
print("\n".join(got + ["error no answer from the web receiver"]))
sys.exit(1)
"""


#: The verbs of a meta statement: a report's line that starts with none of
#: them is a layer's, its session's name first.
META_VERBS = ("set", "hide", "show", "age", "clear")


def with_id(command, cid):
    """The command, carrying an id where it will be read as one: in front
    of the verb for `meta`, whose value is the rest of the line."""
    verb, space, rest = command.partition(" ")
    if verb == "meta":
        return f"meta id={cid}{space}{rest}"
    return f"{command} id={cid}"


def ssh(host, script):
    """How to run a script on a device: here for this machine, as a sender
    does, else over ssh on one shared connection."""
    if host in LOCAL:
        return ["sh", "-c", script]
    if not portable.SSH_SHARES:
        return ["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=5",
                f"{_pi.USER}@{host}", script]
    cm = os.path.join(os.environ.get("TMPDIR", "/tmp"), f"bitwall-cm-{host}")
    return ["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=5",
            "-o", f"ControlPath={cm}", "-o", "ControlMaster=auto",
            "-o", "ControlPersist=60", f"{_pi.USER}@{host}", script]


def python_here():
    """The Python a script carried to this machine runs on: `python3`, as
    on every other host, and on Windows this one, which has what it
    imports wherever it was started from."""
    return sys.executable if WINDOWS else "python3"


def token(text):
    return re.sub(r"[^A-Za-z0-9_-]", "-", text)[:32]


def options_argv(options):
    """A record's options as `bitwall-senders start` takes them again."""
    argv = []
    for name, value in (options or {}).items():
        argv += [f"--{name}"] if value is True else [] if value in (False, "") \
            else [f"--{name}", str(value)]
    return argv


def pairs(text):
    """`k=v` words as a dict, the rest ignored."""
    return dict(w.split("=", 1) for w in text.split() if "=" in w)


class Wall:
    """One wall's state as its session tells it, and the session itself."""

    def __init__(self, server, device, number, run):
        self.server = server
        self.device = device
        self.number = number
        self.key = f"{device['name']}:{number}"
        self.run = run
        #: What this page's session on the wall is called; the wall may
        #: hand it a `-r<k>` name when the last one has not yet gone.
        self.session = token(f"control-{device['name']}-{number}")
        self.history = collections.deque(maxlen=HISTORY)
        self.status = "starting"
        self.since = time.time()
        self.lines = 0
        self.dropped = 0
        self.opened = 0
        self.last_line = None
        self.grid = None
        self.font = None
        self.caps = []
        self.receiver = None         # the program keeping it, as its report says
        self.reach = None            # how its glass is reached from elsewhere, by scheme
        self.names = []              # the measures the wall can show
        self.stats = {}
        self.measures = {}           # the wall's own line: the glass and the painter
        self.smeasures = {}          # a line for each session, by its name
        self.measured = None
        self.display = None          # lit, blank, away or doze, as said
        self.power = None            # on or standby: the monitor, where it is known
        self.watching = None         # how many are looking, as the wall counts them
        self.presence = None         # whether anybody is there, and who says
        self.meta = {}               # what the base says about itself
        self.metas = {}              # what each layer above it says, by session
        self.reporting = set()       # sessions a followed report is being said to
        self.sessions = []           # who is on the wall, as it lists them
        self.base = None             # the session holding the base, if one does
        self.pic = None              # what the last picture was, and when
        self.pictures = None         # the formats its pictures come in, as its report says
        self.blobs = {}              # command id -> the future its picture comes to
        self.unheard = set()         # ids of pictures asked while live, kept out of the traffic
        self.pixels = None           # the glass, (w, h), as `screen` says
        self.pic_data = b""
        self.every = 1000            # ms between measure lines
        self.live = False            # whether the session asks for them at all
        self.mirror = 0              # ms between mirror frames, or 0 for none
        self.looking = None          # the task re-picturing a wall with no glass, while live
        self.gone = False
        self.ctl = None
        # One thread writes to the session, so commands reach the wall in
        # the order they were given.
        self.writer = concurrent.futures.ThreadPoolExecutor(1)
        self.task = None             # run_session, holding the session
        self.waiting = {}            # command id -> list of answer lines
        self.listing = None          # a `sessions` answer as it comes in
        self.seq = 0
        self._dirty = True

    # -------------------------------------------------------------- state

    def room_for(self, iid, place, replace):
        """Why a sender, instance `iid` going at `place`, cannot be moved
        here, or None where it can: the wall's own `caps` and `sessions`,
        asked as `bitwall-senders start` asks them."""
        where = f"{self.device['name']}:{self.number}"
        if any(x.get("instance") == iid for x in self.sessions) \
                or (self.meta.get("instance") or {}).get("value") == iid:
            return f"it is on {where} already"
        if place == "controller":
            return None
        if place == "base":
            if self.base and not replace:
                return f"{where}'s base is held"
            return None
        said = next((c[7:] for c in self.caps if c.startswith("layers=")), "")
        places = int(said) if said.isdigit() else 1
        if places < 2:
            return f"{where} takes no layers, only a base"
        held = {x.get("z") for x in self.sessions if x.get("role") == "layer"}
        if all(str(z) in held for z in range(1, places)):
            return f"{where} has every layer held"
        return None

    def view(self):
        return {
            "key": self.key, "device": self.device["name"], "number": self.number,
            "host": self.device["host"], "run": self.run, "session": self.session,
            "status": self.status, "since": self.since, "lines": self.lines,
            "dropped": self.dropped, "opened": self.opened, "last_line": self.last_line,
            "grid": self.grid, "font": self.font, "caps": self.caps, "names": self.names,
            "stats": self.stats, "measures": self.measures, "measured": self.measured,
            "smeasures": self.smeasures,
            "pixels": "%dx%d" % self.pixels if self.pixels else None,
            "every": self.every, "live": self.live, "pic": self.pic, "mirror": self.mirror,
            "display": self.display, "power": self.power, "presence": self.presence,
            "watching": self.watching, "receiver": self.receiver, "reach": self.reach,
            "meta": self.meta, "metas": self.metas, "sessions": self.sessions,
            "base": self.base, "capture": self.capture_kind(),
        }

    def set_status(self, status):
        if status != self.status:
            self.status = status
            self.since = time.time()
            self.note("~", "", status)
            self._dirty = True

    def note(self, mark, who, text):
        """A line into the history, and to the page as it happens. `who`
        is the session a followed line was said to or came from, and
        empty for this page's own."""
        entry = {"t": time.time(), "mark": mark, "who": who, "text": text}
        self.history.append(entry)
        self.server.send_all({"type": "line", "key": self.key, **entry})

    def heard(self, said):
        """One thing the wall said on the session: a line, or a picture or
        a mirror frame as a whole."""
        self.lines += 1
        self.last_line = time.time()
        if isinstance(said, Blob):
            head = said.said
            cid = head.get("id")
            if cid in self.waiting:
                self.waiting[cid].append(head.raw[:-len(f" id={cid}")])
            if cid in self.blobs:
                if cid not in self.unheard:     # a live one would flood the traffic
                    self.note(">", "", head.raw)
                self.unheard.discard(cid)
                self.blobs.pop(cid).set_result((head, said.data))
                return
            # `picture glass qoi 640x360 <bytes>`: only the glass is asked for.
            size = head.args[2] if len(head.args) > 2 and "x" in head.args[2] else "0x0"
            w, _, h = size.partition("x")
            if tuple(head.args[:2]) != ("glass", "qoi"):
                return
            if head.name == "picture":
                self.note(">", "", head.raw)
                self.picture(w, h, said.data)
            elif head.name == "mirror":
                self.mirrored(w, h, said.data)
            return
        mark, who, line = ">", "", said
        if said.name in (">", "<"):
            # Followed: the direction, the session concerned, and the line
            # as it was.
            mark = said.name
            who = said.args[0] if said.args else ""
            rest = (said.raw or "").split(" ", 2)
            line = protocol.parse(rest[2]) if len(rest) > 2 else None
            if line is None:
                return
            line.raw = rest[2]
        if mark == ">" and not who and line.name == "measure":
            said = pairs(line.raw[8:])
            if "session" in said:
                self.smeasures[said["session"]] = said
            else:
                self.measures = said
                self.measured = time.time()
                # Each period's session lines follow the wall's, so one
                # for a session no longer on the wall is let go here.
                live = {x["name"] for x in self.sessions}
                self.smeasures = {k: v for k, v in self.smeasures.items() if k in live}
            self._dirty = True
            return               # a second's numbers are state, not traffic
        self.note(mark, who, line.raw)
        if mark == "<" and line.name == "meta" and line.args[:2] == ("set", "instance") \
                and len(line.args) >= 3:
            # A layer saying the instance it was started under, which the
            # listing had not yet: the card joins it to its record by it.
            for x in self.sessions:
                if x["name"] == who:
                    x["instance"] = line.args[2]
                    self._dirty = True
        if mark != ">":
            return
        cid = line.get("id")
        text = line.raw
        if cid is not None and text.endswith(f" id={cid}"):
            text = text[:-len(f" id={cid}")]
        if not who and cid in self.waiting:
            self.waiting[cid].append(text)
        if not who and cid in self.blobs and text.startswith("error "):
            self.blobs.pop(cid).set_result(None)
        word, _, rest = text.partition(" ")
        if who:
            # Which sessions are being told a report, from its `hello` to
            # its `area`: the `hello` at the door is followed by `opened`.
            if word == "hello":
                self.reporting.add(who)
            elif word in ("area", "opened"):
                self.reporting.discard(who)
        if word == "area":
            grid, _, font = rest.partition(" ")
            self.grid, self.font = grid, int(font) if font.isdigit() else font
        elif word == "stats":
            on, _, opts = rest.partition(" ")
            self.stats = {"on": on == "1", **pairs(opts)}
        elif word == "caps":
            self.caps = rest.split()
        elif word == "receiver":
            # Said before `reach` in every report, so a receiver that no
            # longer says `reach` is not left with the last one's.
            program, _, opts = rest.partition(" ")
            self.receiver, self.reach = {"program": program, **pairs(opts)}, None
        elif word == "reach":
            scheme, _, opts = rest.partition(" ")
            self.reach = dict(self.reach or {}, **{scheme: pairs(opts)})
        elif word == "screen":
            pw, _, ph = pairs(rest).get("pixels", "").partition("x")
            if pw.isdigit() and ph.isdigit() and int(pw) and int(ph):
                self.pixels = (int(pw), int(ph))
        elif word == "measures":
            self.names = rest.split()
        elif word == "pictures":
            self.pictures = rest.split()
        elif word == "display":
            self.display = rest
        elif word == "power":
            self.power = rest
        elif word == "watching":
            self.watching = int(rest) if rest.isdigit() else None
        elif word == "presence":
            here, _, opts = rest.partition(" ")
            self.presence = {"here": here == "1", **pairs(opts)}
        elif word == "meta" and (not who or who in self.reporting or who == self.base
                                 or any(x["name"] == who and x["role"] == "layer"
                                        for x in self.sessions)):
            # Meta is per session. A report, this page's own or one said to
            # another session, carries the base's untagged and each layer's
            # above it tagged with its session; outside a report, a layer's
            # answers are its own, and the base's are the wall's.
            verb, _, more = rest.partition(" ")
            if not who or who in self.reporting:
                if verb in META_VERBS:
                    self.meta_line(self.meta, verb, more)
                else:
                    tag, (verb, _, more) = verb, more.partition(" ")
                    self.meta_line(self.metas.setdefault(tag, {}), verb, more)
            elif who == self.base:
                self.meta_line(self.meta, verb, more)
            else:
                self.meta_line(self.metas.setdefault(who, {}), verb, more)
        elif word == "session" and not who:
            self.session_line(line, cid)
        elif word == "sessions" and not who:
            if cid is not None and cid == self.listing_id and self.listing is not None:
                self.set_sessions(self.listing)
                self.listing = None
        elif word == "dropped":
            self.dropped += int(rest) if rest.isdigit() else 0
            # Among what was dropped may be a session coming or going.
            self.ask_sessions()
        self._dirty = True

    @staticmethod
    def meta_line(meta, verb, more):
        """One meta statement, `set name Galaga` and the like, into the
        keys it is about."""
        key, _, value = more.partition(" ")
        if verb == "set":
            meta.setdefault(key, {}).update(value=value, age=0)
        elif verb in ("hide", "show"):
            meta.setdefault(key, {})["hidden"] = verb == "hide"
        elif verb == "age" and key in meta:
            meta[key]["age"] = int(value) if value.isdigit() else 0
        elif verb == "clear":
            meta.pop(key, None) if key else meta.clear()

    def session_line(self, line, cid):
        """`session opened|closed|moved ...` as they happen, and `session <name>
        ...` as a listing answers."""
        args = list(line.args)
        if args[:1] == ["opened"] and len(args) >= 5:
            name, role, z, kind = args[1:5]
            self.sessions = [x for x in self.sessions if x["name"] != name]
            one = {"name": name, "role": role, "z": z, "type": kind}
            if line.opts.get("instance"):
                one["instance"] = line.opts["instance"]
            self.sessions.append(one)
            self.metas.pop(name, None)
            if role == "layer" and z == "0":
                self.base, self.meta = name, {}
        elif args[:1] == ["closed"] and len(args) >= 2:
            name = args[1]
            self.sessions = [x for x in self.sessions if x["name"] != name]
            self.metas.pop(name, None)
            self.reporting.discard(name)
            if name == self.base:
                self.base, self.meta = None, {}
        elif args[:1] == ["moved"] and len(args) >= 3:
            name, z = args[1:3]
            for x in self.sessions:
                if x["name"] == name:
                    x["z"] = z
        elif cid is not None and cid == self.listing_id and len(args) >= 4:
            if self.listing is None:
                self.listing = []
            one = {"name": args[0], "role": args[1], "z": args[2], "type": args[3]}
            if line.opts.get("instance"):
                one["instance"] = line.opts["instance"]
            self.listing.append(one)

    def set_sessions(self, listing):
        self.sessions = listing
        live = {x["name"] for x in listing}
        self.metas = {k: v for k, v in self.metas.items() if k in live}
        base = next((x["name"] for x in listing if x["role"] == "layer" and x["z"] == "0"), None)
        if base != self.base:
            self.base = base
            if base is None:
                self.meta = {}

    listing_id = None

    def ask_sessions(self):
        """Ask who is on the wall; the answer is gathered as it comes."""
        self.seq += 1
        self.listing_id = token(f"p{os.getpid()}-{self.seq}")
        self.listing = []
        self.send(with_id("sessions", self.listing_id))

    # ------------------------------------------------------------ session

    async def run_session(self):
        """Hold a controller session on the wall, and open it again
        whenever it ends."""
        loop = asyncio.get_running_loop()
        while not self.gone:
            self.set_status("connecting")
            c = Controller(f"{self.device['host']}:{self.number}", name=self.session,
                           user=_pi.USER, run=self.run)
            try:
                await asyncio.to_thread(c.open)
            except (NoWall, Refused) as e:
                self.set_status(f"down: {e}")
                await asyncio.sleep(RETRY)
                continue
            except Exception as e:                                 # noqa: BLE001
                self.set_status(f"down: {e!r}")
                await asyncio.sleep(RETRY)
                continue
            if self.gone:
                await asyncio.to_thread(c.close)
                break
            self.ctl = c
            self.session = c.name
            self.opened += 1
            self.set_status("open")
            self.pictures = None        # a report that has no line has no formats
            for said in c.report:
                self.heard(said)
            self.send("follow in")
            self.ask_sessions()
            if self.live:
                self.send(f"measures {self.every}")
            if self.mirror:
                self.start_mirror()     # a session made again has none
            ended = asyncio.Event()

            def pump():
                # A wall slower to close than the page is to stop is still
                # read after the loop has gone, with nobody left to tell.
                with contextlib.suppress(RuntimeError):
                    while (said := c.read()) is not None:
                        loop.call_soon_threadsafe(self.heard, said)
                    loop.call_soon_threadsafe(ended.set)
            threading.Thread(target=pump, daemon=True,
                             name=f"control-{self.key}").start()
            await ended.wait()
            self.ctl = None
            self.measures, self.smeasures, self.measured = {}, {}, None
            reason = (f"closed: {c.closed}" if c.state == "closed"
                      else "the wall has gone" if c.state == "lost" else c.state)
            await asyncio.to_thread(c.close)
            if self.gone:
                break
            self.set_status(f"down: {reason}")
            await asyncio.sleep(RETRY)

    def send(self, words):
        """One command down the session, off the loop's thread: a write
        waits only when the wall has stopped reading."""
        c = self.ctl
        if c is not None and not self.gone:
            asyncio.get_running_loop().run_in_executor(self.writer, c.send, words)

    def rate(self, live, ms):
        """Measure lines every `ms`, or none. With none, the wall does not
        make them at all."""
        ms = max(200, min(60000, int(ms)))
        if (live, ms) == (self.live, self.every):
            return
        self.live, self.every = live, ms
        self.note("~", "", f"measures every {ms} ms" if live else "no measures")
        if not live:
            self.measures, self.smeasures, self.measured = {}, {}, None
        self._dirty = True
        self.send(f"measures {ms}" if live else "measures 0")

    def glass_size(self):
        """The size the glass is asked for at: wide enough for the modal
        view, the glass's own shape, and never more than the glass."""
        pw, ph = self.pixels or (1920, 1080)
        w = min(pw, GLASS_WIDTH)
        return w, max(1, round(w * ph / pw))

    def capture_kind(self):
        """How this wall is pictured: `glass` where its `pictures` says it
        makes a QOI, or where it says no `pictures` at all; `grid` where it
        makes only its cells; None where it takes no pictures."""
        if "picture" not in self.caps:
            return None
        if self.pictures is None or "qoi" in self.pictures:
            return "glass"
        return "grid" if "grid" in self.pictures else None

    async def grid_picture(self, live=False):
        """The wall as its cells: the base's grid, then each cells layer's
        above it in z order, each asked as `picture <session>`, and sent to
        the page as one picture for it to draw as cells."""
        layered = [x for x in self.sessions if x.get("role") == "layer"]
        held = [x for x in layered if x.get("type") == "cells"]
        left = [x["name"] for x in layered if x.get("type") != "cells"]
        if left and not live:
            self.note("~", "", f"picture in cells only, without {' '.join(left)}")
        held.sort(key=lambda x: int(x["z"]) if str(x.get("z")).isdigit() else 0)
        layers, data = [], b""
        for x in held:
            self.seq += 1
            cid = token(f"p{os.getpid()}-{self.seq}")
            got = asyncio.get_running_loop().create_future()
            self.blobs[cid] = got
            if live:
                self.unheard.add(cid)
            self.send(with_id(f"picture {x['name']}", cid))
            try:
                answer = await asyncio.wait_for(got, ANSWER * 2)
            except asyncio.TimeoutError:
                self.blobs.pop(cid, None)
                self.unheard.discard(cid)
                continue
            if answer is None:
                continue
            head, part = answer
            size = head.args[2] if len(head.args) > 2 else ""
            cols, _, rows = size.partition("x")
            if tuple(head.args[1:2]) != ("grid",) or not (cols.isdigit() and rows.isdigit()):
                continue
            layers.append({"session": x["name"], "z": x["z"], "cols": int(cols),
                           "rows": int(rows), "bytes": len(part)})
            data += part
        if not layers:
            return
        self.pic = {"key": self.key, "format": "grid", "t": time.time(), "bytes": len(data),
                    "w": layers[0]["cols"], "h": layers[0]["rows"], "layers": layers,
                    "without": left}
        if live:
            self.pic["mirror"] = "grid"
        self.pic_data = data
        self.server.send_picture(self)

    async def look_again(self):
        """The cells pictured every `mirror` ms, no oftener than a quarter
        of a second, for as long as the mirror is wanted."""
        while self.mirror and not self.gone and self.capture_kind() == "grid":
            began = time.monotonic()
            await self.grid_picture(live=True)
            await asyncio.sleep(max(0.05, max(self.mirror, 250) / 1000 - (time.monotonic() - began)))

    def picture(self, w, h, data):
        """A picture of the glass came: kept, so a page that opens later has
        it, and sent to every page open now."""
        self.pic = {"key": self.key, "format": "qoi", "t": time.time(), "bytes": len(data),
                    "w": int(w) if w.isdigit() else 0, "h": int(h) if h.isdigit() else 0}
        self.pic_data = data
        self.server.send_picture(self)

    def set_mirror(self, ms):
        """Frames every `ms`, or none with 0. The wall keeps the mirror on
        the session, so it goes when the session does and is asked for
        again each time the session is opened."""
        ms = 0 if not ms else max(50, min(60000, int(ms)))
        if ms == self.mirror:
            return
        self.mirror = ms
        self.note("~", "", f"mirror every {ms} ms" if ms else "no mirror")
        self._dirty = True
        if ms:
            self.start_mirror()
        elif self.capture_kind() != "grid":
            self.send("mirror glass off")

    def start_mirror(self):
        """Ask for the mirror, which a wall starts again with a whole frame,
        so this is also how a page that has lost track gets one. A wall
        with no glass is pictured in cells again at the mirror's rate
        instead: PROTOCOL.md offers no mirror of a cells layer above the
        base yet, and a picture has them all."""
        if self.mirror and self.capture_kind() == "grid":
            if self.looking is None or self.looking.done():
                self.looking = asyncio.ensure_future(self.look_again())
            return
        if self.mirror and "mirror" in self.caps:
            w, h = self.glass_size()
            self.send(f"mirror glass every={self.mirror} size={w}x{h}")

    def mirrored(self, w, h, data):
        """A look at the glass as it changes: whole, so a page that missed
        one loses nothing, and kept as the picture a page opening later is
        sent."""
        self.pic = {"key": self.key, "format": "qoi", "mirror": "qoi", "t": time.time(),
                    "bytes": len(data), "w": int(w) if w.isdigit() else 0,
                    "h": int(h) if h.isdigit() else 0}
        self.pic_data = data
        self.server.send_frame(dict(self.pic), data)

    async def stop(self):
        """Let the wall go: the session closed in good order, so the wall
        hears `close` rather than finding its writer gone."""
        self.gone = True
        c = self.ctl
        if c is not None:
            await asyncio.get_running_loop().run_in_executor(self.writer, c.close)
        self.writer.shutdown(wait=False)

    async def command(self, words):
        """Send one command and wait for what it causes to be said."""
        c = self.ctl
        if c is None:
            return {"ok": False, "answer": [f"no session on the wall: {self.status}"]}
        self.seq += 1
        cid = token(f"p{os.getpid()}-{self.seq}")
        self.waiting[cid] = []
        if not await asyncio.get_running_loop().run_in_executor(
                self.writer, c.send, with_id(words, cid)):
            self.waiting.pop(cid, None)
            return {"ok": False, "answer": ["could not reach the wall"]}
        end = time.monotonic() + ANSWER
        while time.monotonic() < end:
            await asyncio.sleep(0.05)
            got = self.waiting[cid]
            if got and time.monotonic() > end - ANSWER + 0.3:
                break
        answer = self.waiting.pop(cid, [])
        return {"ok": not any(a.startswith("error ") for a in answer), "answer": answer}


class Server:
    def __init__(self):
        self.walls = {}              # key -> Wall
        self.sockets = set()
        self.found = {d["name"]: "not yet asked" for d in DEVICES}
        self.running = {}            # instance id -> its record, and its host
        self.poke = asyncio.Event()  # ask the sender hosts again, now
        self.catalogue = {}          # sender host -> what it can run, as its catalogue says
        self.reach = {}              # sender host -> the device hosts it can ssh to
        self.web = {}                # device name -> its web receiver's run and walls
        self.web_lock = asyncio.Lock()   # this Windows machine's web receiver, one caller at a time
        self.pipes = {}              # device name -> its run directory, where it is Windows'

    def send_all(self, msg):
        text = json.dumps(msg)
        for ws in list(self.sockets):
            if not ws.closed:
                asyncio.ensure_future(ws.send_str(text))

    @staticmethod
    def framed(w):
        """A picture as one binary message: the length of a JSON header in
        two bytes, the header, and the picture itself. One message, so
        nothing sent to the same page can land between the two."""
        head = json.dumps(w.pic).encode()
        return len(head).to_bytes(2, "big") + head + w.pic_data

    def send_frame(self, head, frame):
        """A mirror frame, framed as a picture is."""
        head = json.dumps(head).encode()
        data = len(head).to_bytes(2, "big") + head + frame
        for ws in list(self.sockets):
            if not ws.closed:
                asyncio.ensure_future(ws.send_bytes(data))

    def send_picture(self, w):
        data = self.framed(w)
        for ws in list(self.sockets):
            if not ws.closed:
                asyncio.ensure_future(ws.send_bytes(data))

    def devices(self):
        out = []
        for d in DEVICES:
            walls = [w for w in self.walls.values() if w.device is d]
            order = d.get("order", [])
            # The walls in the order given, then the rest: screens by
            # number, then names.
            walls.sort(key=lambda w: (0, order.index(w.number), 0, "") if w.number in order
                       else (1, not w.number.isdigit(),
                             int(w.number) if w.number.isdigit() else 0, w.number))
            web = self.web.get(d["name"])
            out.append({"name": d["name"], "host": d["host"], "found": self.found[d["name"]],
                        "walls": [w.key for w in walls], "web": web is not None,
                        "webwalls": [f"{d['name']}:{n}" for n in web["walls"]] if web else []})
        return out

    async def records(self, host):
        """What a sender host has running, as its records say, by asking
        `instance.py` there as `bitwall-senders status` does."""
        with open(INSTANCE) as fh:
            code = fh.read()
        argv = ([python_here(), "-", "status", "{}"] if host in LOCAL else
                ["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=5",
                 f"{_pi.USER}@{host}", f"{self.far_python(host)} - status '{{}}'"])
        try:
            proc = await asyncio.create_subprocess_exec(
                *argv, stdin=asyncio.subprocess.PIPE,
                stdout=asyncio.subprocess.PIPE, stderr=asyncio.subprocess.DEVNULL)
            out, _ = await asyncio.wait_for(proc.communicate(code.encode()), 15)
            return json.loads(out)["running"]
        except (OSError, asyncio.TimeoutError, ValueError, KeyError):
            return None

    async def watching_senders(self):
        """Every sender host's records, to the page whenever they change.
        A host that cannot be asked keeps what it last said."""
        import datetime
        while True:
            running = dict(self.running)
            for host in SENDER_HOSTS:
                recs = await self.records(host)
                if recs is None:
                    continue
                for iid in [i for i, r in running.items() if r["host"] == host]:
                    del running[iid]
                for r in recs:
                    try:
                        since = datetime.datetime.strptime(
                            r.get("started", ""), "%Y-%m-%dT%H:%M:%S%z").timestamp()
                    except ValueError:
                        since = None
                    running[r["id"]] = {"host": host, "sender": r.get("sender"),
                                        "wall": r.get("wall"), "place": r.get("place", "base"),
                                        "options": r.get("options", {}),
                                        "pid": r.get("pid"), "up": r.get("up"),
                                        "since": since, "log": r.get("log")}
            if running != self.running:
                self.running = running
                self.send_all({"type": "running", "running": running})
            self.poke.clear()
            try:
                await asyncio.wait_for(self.poke.wait(), RUNNING)
            except asyncio.TimeoutError:
                pass

    def far_python(self, host):
        """The Python to run a script with on a device over ssh: uv's on a
        Windows host, whose `python3` an ssh login may not run (relay.py,
        WINDOWS_PYTHON), else `python3`."""
        windows = any(d["host"] == host and d["name"] in self.pipes for d in DEVICES)
        return relay.WINDOWS_PYTHON if windows else "python3"

    async def catalogue_of(self, host):
        """What a sender host can run, by walking its catalogue there as
        `bitwall-senders list` does."""
        with open(WALKER) as fh:
            code = fh.read()
        argv = ([python_here(), "-", os.path.expanduser(CATALOGUE)] if host in LOCAL else
                ["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=5",
                 f"{_pi.USER}@{host}", f'{self.far_python(host)} - "$HOME/{CATALOGUE[2:]}"'])
        try:
            proc = await asyncio.create_subprocess_exec(
                *argv, stdin=asyncio.subprocess.PIPE,
                stdout=asyncio.subprocess.PIPE, stderr=asyncio.subprocess.DEVNULL)
            out, _ = await asyncio.wait_for(proc.communicate(code.encode()), 20)
            said = json.loads(out)
            return {"senders": said["senders"], "problems": said["problems"],
                    "unavailable": said.get("unavailable", [])}
        except (OSError, asyncio.TimeoutError, ValueError, KeyError):
            return None

    async def reachable(self, host):
        """Which other devices a sender host can reach without a password,
        so a sender on it may be started on their walls: asked of the host
        itself, since the keys are its own."""
        others = [d["host"] for d in DEVICES if d["host"] not in LOCAL and d["host"] != host]
        if host in LOCAL or not others:
            return None
        if any(d["host"] == host and d["name"] in self.pipes for d in DEVICES):
            # A Windows host's shell is PowerShell, and its ssh to ask
            # with is Git's (AGENTS.md, Traps).
            script = ("foreach ($h in " + ",".join("'" + o.replace("'", "''") + "'"
                                                   for o in others)
                      + ") { & '" + GIT_SSH + "\\ssh.exe' -o BatchMode=yes "
                      "-o ConnectTimeout=3 $h true *> $null; "
                      "if ($LASTEXITCODE -eq 0) { $h } }")
        else:
            script = " ".join(f"ssh -o BatchMode=yes -o ConnectTimeout=3 {shlex.quote(o)} true "
                              f"</dev/null >/dev/null 2>&1 && echo {shlex.quote(o)};"
                              for o in others)
        try:
            proc = await asyncio.create_subprocess_exec(
                *ssh(host, script), stdin=asyncio.subprocess.DEVNULL,
                stdout=asyncio.subprocess.PIPE, stderr=asyncio.subprocess.DEVNULL)
            out, _ = await asyncio.wait_for(proc.communicate(), 20)
            return out.decode().split()
        except (OSError, asyncio.TimeoutError):
            return None

    async def watching_catalogues(self):
        """Every sender host's catalogue, to the page when it changes. A
        host that cannot be asked keeps what it last said."""
        while True:
            cats = dict(self.catalogue)
            for host in SENDER_HOSTS:
                got = await self.catalogue_of(host)
                if got is not None:
                    cats[host] = got
            reach = dict(self.reach)
            for host in SENDER_HOSTS:
                got = await self.reachable(host)
                if got is not None:
                    reach[host] = got
            if cats != self.catalogue or reach != self.reach:
                self.catalogue, self.reach = cats, reach
                self.send_all({"type": "catalogue", "catalogue": cats, "reach": reach})
            await asyncio.sleep(FIND)

    async def senders(self, *args):
        """`bitwall-senders` with these arguments: its exit status, and
        what it said, both logged with how long it took."""
        began = time.monotonic()
        # Windows runs no script by its first line, so there this Python
        # runs it.
        proc = await asyncio.create_subprocess_exec(
            *([sys.executable, SENDERS] if WINDOWS else [SENDERS]), *args,
            stdin=asyncio.subprocess.DEVNULL,
            stdout=asyncio.subprocess.PIPE, stderr=asyncio.subprocess.STDOUT)
        out, _ = await proc.communicate()
        text = out.decode(errors="replace").strip()
        print(f"{time.strftime('%H:%M:%S')} bitwall-senders {shlex.join(args)} -> "
              f"{proc.returncode} in {time.monotonic() - began:.1f}s: {text}", flush=True)
        return proc.returncode, text

    async def sender_op(self, action, iid):
        """Stop, restart or read the log of a running sender, by its
        instance id, telling every page how it goes."""
        rec = self.running.get(iid)
        if rec is None:
            return
        say = lambda state, text="": self.send_all(
            {"type": "sender-op", "id": iid, "action": action, "state": state, "text": text})
        if action == "log":
            say("done", await self.read_log(rec))
            return
        say("busy")
        code, text = await self.senders("stop", iid, "--on", rec["host"])
        if code != 0 or action == "stop":
            self.poke.set()
            return say("done" if code == 0 else "failed", text)
        code, text = await self.start_when_free(rec["host"], rec["sender"], rec["wall"],
                                                options_argv(rec.get("options")))
        say("done" if code == 0 else "failed", text)

    async def move(self, iid, key, replace):
        """A running sender moved to another wall: stopped where it is and
        started on the new one with the options it has, at the place its
        entry gives, and with `--replace` when told to take a held base.
        The new wall is asked first whether it has the place, so a move
        that cannot land leaves the sender where it was. Every page is told
        how it goes, by the sender's instance and by the wall's key."""
        rec, w = self.running.get(iid), self.walls.get(key)
        if rec is None or w is None:
            return
        print(f"{time.strftime('%H:%M:%S')} move {iid} ({rec['sender']}) to {key}"
              f"{' replacing its base' if replace else ''}", flush=True)

        def say(state, text=""):
            if state != "busy":
                print(f"{time.strftime('%H:%M:%S')} move {iid} to {key}: {state}"
                      f"{': ' + text if state == 'failed' else ''}", flush=True)
            self.send_all({"type": "sender-op", "id": iid, "action": "move", "state": state,
                           "text": text})
            self.send_all({"type": "wall-op", "key": key, "sender": rec["sender"],
                           "state": state, "text": text})
        host = rec["host"]
        if host not in LOCAL and host != w.device["host"] \
                and w.device["host"] not in self.reach.get(host, []):
            return say("failed", f"{host} cannot reach {w.device['host']}")
        why = w.room_for(iid, rec.get("place", "base"), replace)
        if why:
            return say("failed", why)
        say("busy")
        code, text = await self.senders("stop", iid, "--on", host)
        if code != 0:
            self.poke.set()
            return say("failed", text)
        argv = (["--replace"] if replace else []) + options_argv(rec.get("options"))
        code, text = await self.start_when_free(host, rec["sender"],
                                                f"{w.device['host']}:{w.number}", argv)
        say("done" if code == 0 else "failed", text)

    async def start_when_free(self, host, sender, wall, argv=()):
        """Start a sender on a wall, waiting while the wall still calls a
        sender just stopped there its own: it takes a few seconds to call
        one gone, and refuses a start until it has."""
        until = time.monotonic() + FREED
        while True:
            code, text = await self.senders("start", sender, wall, *argv, "--on", host)
            if code == 0 or "base has" not in text or time.monotonic() > until:
                break
            await asyncio.sleep(3)
        self.poke.set()
        return code, text

    async def drop(self, key, host, sender, replace, options=None):
        """A catalogue sender started on a wall, dropped there or asked
        for on its card: started at the place its entry gives, with the
        options chosen, and with `--replace` when told to take a held base.
        Every page is told how it goes, by the wall's key."""
        w = self.walls.get(key)
        print(f"{time.strftime('%H:%M:%S')} drop {sender} from {host} on {key}"
              f"{' replacing its base' if replace else ''} options={options}", flush=True)

        def say(state, text=""):
            if state != "busy":
                print(f"{time.strftime('%H:%M:%S')} drop on {key}: {state}"
                      f"{': ' + text if state == 'failed' else ''}", flush=True)
            self.send_all({"type": "wall-op", "key": key, "sender": sender, "state": state, "text": text})
        if w is None or host not in SENDER_HOSTS:
            return say("failed", "no such wall or sender host")
        if host not in LOCAL and host != w.device["host"] \
                and w.device["host"] not in self.reach.get(host, []):
            return say("failed", f"{host} cannot reach {w.device['host']}")
        say("busy")
        # Checked again by `bitwall-senders` against the catalogue; here only
        # that each is a word it can be given.
        argv = ["--replace"] if replace else []
        for name, value in (options or {}).items():
            if not (isinstance(name, str) and re.match(r"^[a-z][a-z0-9-]{0,31}$", name)):
                continue
            if value is True:
                argv.append(f"--{name}")
            elif isinstance(value, (int, str)) and not isinstance(value, bool) \
                    and re.match(r"^[A-Za-z0-9_.,:-]{1,1024}$", str(value)):
                argv += [f"--{name}", str(value)]
        code, text = await self.start_when_free(host, sender, f"{w.device['host']}:{w.number}", argv)
        say("done" if code == 0 else "failed", text)

    async def web_command(self, device, run, words):
        """A command to a device's web receiver, and its answer. Where the
        device keeps its walls as Windows' pipes it goes through the relay,
        or in this process for this machine's, one at a time, since the
        receiver's `out` takes one reader at a time."""
        if run.startswith(PIPES):
            if device["host"] in LOCAL and WINDOWS:
                async with self.web_lock:
                    code, answer = await asyncio.to_thread(relay.web, _local, run, words)
                return code, "\n".join(answer)
            try:
                proc = await asyncio.create_subprocess_exec(
                    *Link(device["host"]).relay_argv("web", run, words),
                    stdin=asyncio.subprocess.DEVNULL,
                    stdout=asyncio.subprocess.PIPE, stderr=asyncio.subprocess.STDOUT)
                out, _ = await asyncio.wait_for(proc.communicate(), 20)
            except (OSError, asyncio.TimeoutError) as e:
                return 1, f"error could not ask the web receiver: {e or 'timed out'}"
            return proc.returncode, out.decode(errors="replace").strip()
        argv = (["python3", "-", run, words] if device["host"] in LOCAL
                else ssh(device["host"], f"python3 - {shlex.quote(run)} {shlex.quote(words)}"))
        try:
            proc = await asyncio.create_subprocess_exec(
                *argv, stdin=asyncio.subprocess.PIPE,
                stdout=asyncio.subprocess.PIPE, stderr=asyncio.subprocess.STDOUT)
            out, _ = await asyncio.wait_for(proc.communicate(WEB_COMMAND.encode()), 15)
        except (OSError, asyncio.TimeoutError) as e:
            return 1, f"error could not ask the web receiver: {e or 'timed out'}"
        return proc.returncode, out.decode(errors="replace").strip()

    async def web_op(self, action, name, wall, presence=None):
        """A web wall made or removed on a device's web receiver. A wall
        removed has whatever a controller started on it stopped first, so
        nothing is left waiting for a wall that will not come back. Every
        page is told how it goes, by the device and the wall's name."""
        device = next((d for d in DEVICES if d["name"] == name), None)
        web = self.web.get(name)
        print(f"{time.strftime('%H:%M:%S')} web {action} {wall} on {name}"
              f"{' presence=' + presence if presence else ''}", flush=True)

        def say(state, text=""):
            if state != "busy":
                print(f"{time.strftime('%H:%M:%S')} web {action} {wall} on {name}: {state}"
                      f"{': ' + text if state == 'failed' else ''}", flush=True)
            self.send_all({"type": "web-op", "device": name, "action": action, "wall": wall,
                           "state": state, "text": text})
        if device is None or web is None:
            return say("failed", f"{name} has no web receiver")
        if not WALL_TOKEN.match(wall) or wall.isdigit():
            return say("failed", f"{wall!r} is not a wall's name: a-z, 0-9, _ and -, "
                                 f"not all digits, at most 32")
        if presence is not None and not re.match(r"^[A-Za-z0-9_-]{1,32}$", presence):
            return say("failed", f"{presence!r} is not a presence's name")
        say("busy")
        if action == "remove":
            w = self.walls.get(f"{name}:{wall}")
            held = set() if w is None else {x.get("instance") for x in w.sessions} \
                | {(w.meta.get("instance") or {}).get("value")}
            held.discard(None)
            if held - set(self.running):
                # Started since the records were last asked for.
                for host in SENDER_HOSTS:
                    for r in await self.records(host) or []:
                        if r["id"] in held:
                            self.running.setdefault(r["id"], {"host": host})
            for iid in [i for i in held if i in self.running]:
                code, text = await self.senders("stop", iid, "--on", self.running[iid]["host"])
                if code != 0:
                    self.poke.set()
                    return say("failed", text)
            self.poke.set()
        words = f"make {wall}" + (f" presence={presence}" if presence else "") \
            if action == "make" else f"remove {wall}"
        code, text = await self.web_command(device, web["run"], words)
        await self.find(device)
        self.send_all({"type": "devices", "devices": self.devices()})
        say("done" if code == 0 else "failed", text.removeprefix("error ").strip())

    async def read_log(self, rec):
        path = rec.get("log")
        if not path:
            return "(no log)"
        if rec["host"] in LOCAL:
            try:
                with open(path, errors="replace") as fh:
                    return "".join(collections.deque(fh, LOG_LINES)) or "(empty)"
            except OSError as e:
                return f"(cannot read {path}: {e.strerror})"
        proc = await asyncio.create_subprocess_exec(
            *ssh(rec["host"], f"tail -n {LOG_LINES} {shlex.quote(path)}"),
            stdin=asyncio.subprocess.DEVNULL, stdout=asyncio.subprocess.PIPE,
            stderr=asyncio.subprocess.STDOUT)
        out, _ = await proc.communicate()
        return out.decode(errors="replace") or "(empty)"

    @staticmethod
    def versions():
        """Each receiver program's version as this machine's copy of it
        works out, which a wall running anything else is behind or ahead
        of. Worked out when asked, so a change to a receiver's source is
        seen without restarting the page server."""
        out = {}
        for program in _receivers.SOURCES:
            with contextlib.suppress(OSError):
                out[program] = _receivers.version(program)
        return out

    def snapshot(self):
        return {"type": "state", "version": VERSION, "devices": self.devices(),
                "versions": self.versions(), "running": self.running,
                "catalogue": self.catalogue, "reach": self.reach,
                "walls": {k: w.view() for k, w in self.walls.items()},
                "history": {k: list(w.history) for k, w in self.walls.items()}}

    async def listing(self, device):
        """What a device has, as FIND_WALLS says it, a line each, or why it
        could not be asked: by the host's own shell, or where its walls are
        Windows' pipes by the relay's `find`, in this process for this
        machine's. A host whose shell answers the listing with nothing but
        complaint is asked where it keeps its walls through the relay, once:
        PowerShell cannot run the listing, and a Windows host says so."""
        name, host = device["name"], device["host"]
        if host in LOCAL and WINDOWS:
            run = (os.environ.get("BITWALL_RUN") or os.environ.get("BITWALL_LOCAL_RUN")
                   or _local.run_dir())
            return await asyncio.to_thread(relay.find, _local, run)
        if name in self.pipes:
            return await self.relay_find(device)
        run = (shlex.quote(os.environ["BITWALL_RUN"]) if os.environ.get("BITWALL_RUN")
               else f'"{RUN_HERE}"')
        try:
            proc = await asyncio.create_subprocess_exec(
                *Link(host).argv(FIND_WALLS.format(run=run)),
                stdin=asyncio.subprocess.DEVNULL,
                stdout=asyncio.subprocess.PIPE, stderr=asyncio.subprocess.PIPE)
            out, err = await asyncio.wait_for(proc.communicate(), 15)
        except (OSError, asyncio.TimeoutError) as e:
            return f"unreachable: {e or 'timed out'}"
        lines = out.decode(errors="replace").splitlines()
        if not lines and err.strip() and host not in LOCAL and proc.returncode not in (0, 255) \
                and await self.pipes_run(device):
            return await self.relay_find(device)
        if proc.returncode not in (0, 1):
            return "unreachable: " + (err.decode().strip() or "ssh failed")
        return lines

    async def run_relay(self, host, verb, *args):
        """The relay run on a host through ssh: its exit code and what it
        printed, or None where it could not be run."""
        try:
            proc = await asyncio.create_subprocess_exec(
                *Link(host).relay_argv(verb, *args), stdin=asyncio.subprocess.DEVNULL,
                stdout=asyncio.subprocess.PIPE, stderr=asyncio.subprocess.PIPE)
            out, err = await asyncio.wait_for(proc.communicate(), 20)
        except (OSError, asyncio.TimeoutError):
            return None
        return proc.returncode, out.decode(errors="replace"), err.decode(errors="replace")

    async def pipes_run(self, device):
        """A device's run directory where it keeps its walls as Windows'
        pipes, kept for the device, else None: BITWALL_RUN where that names
        one, or the host's own answer to `relay run`."""
        run = os.environ.get("BITWALL_RUN") or ""
        if not run.startswith(PIPES):
            got = await self.run_relay(device["host"], "run")
            run = got[1].strip() if got and got[0] == 0 else ""
        if run.startswith(PIPES):
            self.pipes[device["name"]] = run
            print(f"{time.strftime('%H:%M:%S')} {device['name']} keeps its walls "
                  f"as Windows' pipes, {run}: asked through the relay", flush=True)
            return run
        return None

    async def relay_find(self, device):
        got = await self.run_relay(device["host"], "find", self.pipes[device["name"]])
        if got is None:
            return "unreachable: the relay did not answer"
        code, out, err = got
        if code != 0:
            return "unreachable: " + (err.strip()[-200:] or f"the relay exited {code}")
        return out.splitlines()

    async def find(self, device):
        """Which walls a device has: a session on each one new, and none
        on one that has gone."""
        said = await self.listing(device)
        if isinstance(said, str):
            self.found[device["name"]] = said
            return
        found, web = {}, None
        for line in said:
            kind, _, path = line.partition(" ")
            if kind == "web" and path:
                web = path
            if kind != "wall" or not path.endswith("/door.in"):
                continue
            wall_dir = path[:-len("/door.in")]
            wall = wall_dir.rsplit("/", 1)[-1]
            if WALL_TOKEN.match(wall):
                found[wall] = wall_dir
        self.found[device["name"]] = (f"{len(found)} wall{'s' if len(found) != 1 else ''}"
                                      if found else "nothing running")
        # Which of them a web receiver keeps, as it lists them: the run
        # directory is shared with any other receiver on the device.
        if web is None:
            self.web.pop(device["name"], None)
        else:
            code, text = await self.web_command(device, web, "list")
            self.web[device["name"]] = {"run": web, "walls": sorted(
                line.split(" ", 1)[1] for line in text.splitlines()
                if line.startswith("wall ")) if code == 0 else []}
        for n, run_dir in found.items():
            key = f"{device['name']}:{n}"
            if key not in self.walls:
                w = self.walls[key] = Wall(self, device, n, run_dir)
                w.task = asyncio.ensure_future(w.run_session())
        # A wall the device no longer has is let go: its session closed
        # and its card gone, rather than left saying what it last said.
        # Only when the device answered: one that cannot be reached still
        # has its walls, as far as anyone knows.
        for key, w in list(self.walls.items()):
            if w.device is device and w.number not in found:
                asyncio.ensure_future(w.stop())
                del self.walls[key]

    async def finding(self):
        while True:
            await asyncio.gather(*(self.find(d) for d in DEVICES))
            self.send_all({"type": "devices", "devices": self.devices(),
                           "versions": self.versions()})
            await asyncio.sleep(FIND)

    async def pushing(self):
        """Wall state to the page, no more often than PUSH."""
        while True:
            await asyncio.sleep(PUSH)
            for w in self.walls.values():
                if w._dirty:
                    w._dirty = False
                    self.send_all({"type": "wall", "wall": w.view()})

    # -------------------------------------------------------------- http

    async def page(self, request):
        return web.Response(text=PAGE, content_type="text/html")

    async def screen_js(self, request):
        return web.FileResponse(os.path.join(WEB, "bitwall-screen.js"),
                                headers={"Content-Type": "text/javascript"})

    async def font(self, request):
        return web.FileResponse(os.path.join(WEB, "wall.woff2"),
                                headers={"Content-Type": "font/woff2"})

    async def answer(self, ws, w, words, ref):
        try:
            result = await w.command(words)
        except Exception as e:
            print(f"bitwall-control: {w.key} {words}: {e!r}", file=sys.stderr, flush=True)
            result = {"ok": False, "answer": [f"failed: {e}"]}
        if not ws.closed:
            await ws.send_str(json.dumps({"type": "answer", "key": w.key, "words": words,
                                          "ref": ref, **result}))

    async def ws(self, request):
        # A page on another site may open a socket here too, and a
        # browser lets it: the socket is refused unless the page that
        # asks was served from this same host and port. A browser always
        # says its page's Origin; a program that says none is let in, as
        # it could reach every wall's door anyway.
        if not same_origin(request.headers.get("Origin"), request.host):
            print(f"bitwall-control: refused a socket from {request.headers.get('Origin')!r} "
                  f"for {request.host!r}", file=sys.stderr, flush=True)
            raise web.HTTPForbidden(text="not this page's origin\n")
        ws = web.WebSocketResponse(heartbeat=20)
        await ws.prepare(request)
        self.sockets.add(ws)
        await ws.send_str(json.dumps(self.snapshot()))
        for w in list(self.walls.values()):
            if w.pic:
                await ws.send_bytes(self.framed(w))
            # A page that has just come has nothing to paint diffs onto.
            w.start_mirror()
        try:
            async for msg in ws:
                if msg.type != WSMsgType.TEXT:
                    continue
                try:
                    m = json.loads(msg.data)
                except ValueError:
                    continue
                w = self.walls.get(m.get("key"))
                kind, ref = m.get("type"), m.get("ref")

                def ack(ok, why=""):
                    """Every request a page waits on is answered, taken or not,
                    so none can vanish with the page still waiting."""
                    if kind in ("drop", "sender", "move", "web"):
                        print(f"{time.strftime('%H:%M:%S')} request {kind} "
                              f"{m.get('action') or m.get('sender')} "
                              f"{m.get('key') or m.get('id')}: {'taken' if ok else why}", flush=True)
                    asyncio.ensure_future(ws.send_str(json.dumps(
                        {"type": "ack", "ref": ref, "ok": ok, "why": why})))

                if kind == "ping":
                    asyncio.ensure_future(ws.send_str(json.dumps({"type": "pong"})))
                elif kind == "drop" and not w:
                    ack(False, f"no wall {m.get('key')} yet: the page server is still finding "
                               f"walls, try again in a few seconds")
                elif kind == "sender" and m.get("id") not in self.running:
                    ack(False, f"no record of {m.get('id')} yet: the page server is still "
                               f"asking the sender hosts, try again in a few seconds")
                elif m.get("type") == "picture" and w and w.capture_kind() == "glass":
                    gw, gh = w.glass_size()
                    asyncio.ensure_future(self.answer(ws, w, f"picture glass size={gw}x{gh}",
                                                      m.get("ref")))
                elif m.get("type") == "picture" and w and w.capture_kind() == "grid":
                    asyncio.ensure_future(w.grid_picture())
                elif m.get("type") == "mirror" and w and isinstance(m.get("ms"), int):
                    w.set_mirror(m["ms"])
                elif m.get("type") == "whole" and w:
                    w.start_mirror()
                elif m.get("type") == "rate" and w and isinstance(m.get("ms"), int):
                    w.rate(bool(m.get("live", True)), m["ms"])
                elif (m.get("type") == "drop" and w and isinstance(m.get("sender"), str)
                      and isinstance(m.get("host"), str)):
                    replace = m.get("replace") is True
                    opts = m.get("options") if isinstance(m.get("options"), dict) else None
                    ack(True)
                    asyncio.ensure_future(self.drop(w.key, m["host"], m["sender"], replace, opts))
                elif (kind == "web" and m.get("action") in ("make", "remove")
                      and isinstance(m.get("device"), str) and isinstance(m.get("wall"), str)):
                    presence = m.get("presence") if isinstance(m.get("presence"), str) \
                        and m.get("presence") else None
                    ack(True)
                    asyncio.ensure_future(self.web_op(m["action"], m["device"], m["wall"], presence))
                elif kind == "move" and not w:
                    ack(False, f"no wall {m.get('key')} yet: the page server is still finding "
                               f"walls, try again in a few seconds")
                elif kind == "move" and m.get("id") not in self.running:
                    ack(False, f"no record of {m.get('id')}: it may have stopped")
                elif kind == "move" and w:
                    ack(True)
                    asyncio.ensure_future(self.move(m["id"], w.key, m.get("replace") is True))
                elif (m.get("type") == "sender" and m.get("action") in ("stop", "restart", "log")
                      and isinstance(m.get("id"), str)):
                    ack(True)
                    asyncio.ensure_future(self.sender_op(m["action"], m["id"]))
                elif m.get("type") == "command" and w and isinstance(m.get("words"), str):
                    words = " ".join(m["words"].split())[:500]
                    if words:
                        # Each on its own, so a slow answer never holds up the next.
                        asyncio.ensure_future(self.answer(ws, w, words, m.get("ref")))
        finally:
            self.sockets.discard(ws)
        return ws


