  const el = document.getElementById(id(k, "log")); if (!el || !shows(k, e)) return;
  const stuck = el.scrollTop + el.clientHeight >= el.scrollHeight - 8;
  el.insertAdjacentHTML("beforeend", lineHtml(e));
  while (el.childElementCount > 400) el.firstElementChild.remove();
  if (stuck) el.scrollTop = el.scrollHeight;
}
