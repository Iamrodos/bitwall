      data-sender="${esc(x.id)}" data-host="${esc(host)}" data-label="${esc(x.label)}">
      <b>${esc(x.label)}</b>` +
      (deep > 0 ? `<span class="d">${esc(x.description)}</span>` : "") +
      (deep > 1 ? `<span class="id">${esc(x.id)}</span>` + optionsHtml(host, x) : "") +
    `</div>`).join("") || `<div class="none">nothing matches</div>`;
