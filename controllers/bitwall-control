/* How much each wall says about itself, for the whole page. */
const LEVELS = ["min", "more", "all"];

/* What each name means, for a tooltip on a mouse and a line of its own on
 * a tap. The measures are as PROTOCOL.md defines them. */
const WHAT = {
  wall: "which screen this is: the device, and its number on that device",
  display: "what the wall shows: lit, or dark because blank (somebody asked), away (nobody there) or doze (no sender)",
  also: "the other layers this sender holds on the wall: the same program, started and stopped with it, so its controls are these",
  source: "the catalogue entry this sender was started from, and the host it runs on; started by hand means no controller started it, so there is no record",
  options: "what it was started with, each checked against its catalogue entry",
  state: "whether its process is still running, from the record on its host, and when it was started",
  instance: "the id its controller gave it, which the wall carries hidden and the record is named by",
  pid: "its process on the host it runs on; stop ends that process's whole group",
  log: "where its output goes, on the host it runs on",
  watching: "how many can see the wall: tabs in view on the web, 1 or 0 on a Pi; a sender draws nothing at 0",
  power: "the monitor itself: on, drawing full power whatever it shows, or asleep in standby",
  presence: "whether anybody is there to see, what this wall follows, and who says so",
  screen: "the connector the wall is on",
  receiver: "the program keeping this wall and the version of its source, red where it is not the source this page has: a wall still to be updated, or one ahead of here",
  started: "when the receiver program started",
  booted: "when the machine the wall is on last started",
  grid: "cells across and down, and the font size that produced them",
  sender: "whether a sender is attached, and how long since its last byte",
  shot: "how old the picture on this card is",
  session: "this page's own session on the wall, and how it is doing",
  "s-head": "a session on the wall, and what it is: the base, a layer's video or cells above it, or a controller watching it",
  "s-layer": "where the layer is in the stack: the base at the bottom, or its place above",
  "s-role": "a controller: it watches and commands the wall and draws nothing",
  "s-session": "the session's name, as the wall lists it",
  "s-instance": "the record of the controller that started it, or by hand when none did",
  "s-pid": "the sender's process, on the host that started it",
  "s-fps": "frames a second the wall took from this session",
  "s-in": "bytes a second the wall read from this session",
  "s-out": "bytes a second the wall wrote to this session",
  "s-dropped": "lines the wall could not fit down this session's out",
  "s-queue": "bytes waiting on this session's out",
  "s-quiet": "seconds since this session's last byte",
  "s-pong": "this session's last ping round trip",
  "s-decode": "time to decode one of this layer's frames",
  sessions: "who is on the wall, as it lists them: each session's name, role, place and type",
  ping: "the wall asking a quiet sender whether it is there, and the answer",
  since: "how long the session has been in the state it is in",
  run: "the wall's directory on the device",
  named: "what this page's session on the wall is called",
  lines: "lines heard on the session, and when the last one came",
  reports: "times this page has opened its session, which counts the wall's restarts",
  dropped: "lines the wall could not fit down the session",
  atlas: "glyph slots used of all there are, and times the atlas filled",
  caps: "what this receiver says it can do",
  fps: "times a second the glass was redrawn, by any layer, the overlay's own refreshes aside",
  quiet: "seconds since the base's last byte",
  in: "bytes a second the wall read from every session, commands included",
  out: "bytes a second the wall wrote to every session, pictures and mirror frames included",
  inbox: "bytes read and not yet painted",
  frame: "time taken to read each sender frame's escape codes and set the cells they change",
  draw: "time taken to hand the GPU the whole grid to draw, each time the glass is updated",
  swap: "time taken to put the finished picture on the screen, each time the glass is updated; often mostly waiting for the GPU to finish drawing it",
  pong: "the last ping's round trip",
  cpu: "the painter's share of a core",
  gpu: "the painter's share of the GPU, where the driver counts it",
  temp: "the board's temperature",
  meta: "what the sender says about itself; a * means it is kept off the glass",
