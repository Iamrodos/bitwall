  <div class="box">
    <div class="bar"><span class="title" id="log-title"></span><span class="age" id="log-age"></span>
      <button id="log-again">refresh</button><button id="log-close" aria-label="close">✕</button></div>
    <pre class="logtext" id="log-text"></pre>
  </div>
</div>
<script src="/bitwall-screen.js"></script>
<script>
"use strict";
const S = {devices: [], walls: {}, history: {}, answers: {}, filters: {}, open: {}, running: {}, ops: {}};
let logId = null;
S.wallops = {};         // wall key -> how a start dropped on it is going
let pending = null;     // a drop waiting on the replace question
try { S.open = JSON.parse(localStorage.getItem("bitwall-control-open") || "{}"); } catch (e) {}
/* What this page is being sent, so the header says what it costs. */
