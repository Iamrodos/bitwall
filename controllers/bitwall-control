const AUTO = [[0, "once"], [2000, "2s"], [5000, "5s"], [10000, "10s"]];
/* How often a live picture is brought up to date, or never. */
const MIRRORS = [[0, "off"], [100, "100ms"], [250, "250ms"], [500, "500ms"], [1000, "1s"]];
const PICS = {};           /* key -> {head, bytes} */
let modalKey = null;
/* Off, or how often: one choice, since a rate is what being on means. */
const RATES = [[0, "off"], [250, "250ms"], [1000, "1s"], [2000, "2s"], [5000, "5s"]];
const POINTS = ["nw", "n", "ne", "w", "c", "e", "sw", "s", "se"];
const QUIET = /^(ping|pong)\b/;
let ws, ref = 0;

function esc(s) { return String(s).replace(/[&<>"]/g, c => ({"&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;"}[c])); }
function ago(t) { if (!t) return "never"; const s = Math.max(0, Date.now() / 1000 - t);
  return s < 60 ? s.toFixed(0) + "s ago" : s < 3600 ? (s / 60).toFixed(0) + "m ago"
    : s < 172800 ? (s / 3600).toFixed(1) + "h ago" : (s / 86400).toFixed(1) + "d ago"; }
