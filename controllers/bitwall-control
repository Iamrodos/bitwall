/* A request the page waits on: answered by the server's ack, or failed
 * here when no answer comes, so nothing waits on a connection that died. */
const waiting = {};
function request(msg, failed) {
  if (!ws || ws.readyState !== 1) {
    failed("not connected to the page server; reconnecting, try again");
    try { ws && ws.close(); } catch (e) {}
    return;
