  for (const said of String(text).split(",")) {
    const target = said.replace(/@(?:[0-9]+x[0-9]+(?:\/[0-9]+)?|\/[0-9]+)$/, "");
    let host = target, wall = "0";
    if (target.split(":").length === 2) {
      [host, wall] = target.split(":");
      if (!WALL_TOKEN.test(wall)) return `${target}: the wall after ':' must be a number, or a name of a-z, 0-9, _ and -`;
    }
    if (!HOST.test(host) && !IPV6.test(host)) return `${target}: not a host, or host:wall`;
    if (seen.has(host + ":" + wall)) return `${target}: named twice`;
    seen.add(host + ":" + wall);
