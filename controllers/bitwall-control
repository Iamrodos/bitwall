<span class="hgroup"><span class="hlabel">controls</span><span class="seg" id="showing"></span></span>
<span class="hgroup"><span class="hlabel">capture</span>
<button id="shootall" title="capture every wall" aria-label="capture every wall">⦿</button></span>
<span class="hgroup"><span class="hlabel">live</span><span class="seg" id="allmirror"></span></span>
<span class="hgroup"><span class="hlabel">measures</span><span class="seg" id="allrates"></span></span>
<span class="hgroup"><span class="hlabel">catalogue</span><span class="seg" id="catalogshow"></span></span></div>
<span class="hstatus"><span class="conn" id="conn">connecting…</span><span id="wsspark"></span></span></header>
<main id="devices"></main>
<div id="what" role="tooltip"></div>
<div class="modal" id="modal" role="dialog" aria-modal="true">
  <div class="box">
    <div class="bar"><span class="title" id="modal-title"></span><span class="age" id="modal-age"></span>
      <button id="modal-again">capture</button><button id="modal-close" aria-label="close">✕</button></div>
    <div class="pic" id="modal-pic"></div>
  </div>
</div>
<div class="modal confirm" id="confirmmodal" role="dialog" aria-modal="true">
  <div class="box">
    <p id="confirm-text"></p>
    <div class="buttons"><button id="confirm-no">cancel</button><button id="confirm-yes" class="on">replace</button></div>
  </div>
</div>
