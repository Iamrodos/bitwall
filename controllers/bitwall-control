  const root = document.getElementById("devices");
  // Where each carousel was scrolled to, put back after the page is built
  // again, which it is every time the devices are asked what they have.
  const scrolled = {};
  root.querySelectorAll("[data-cards]").forEach(b => { scrolled[b.dataset.cards] = b.scrollLeft; });
  // And a new wall's name being typed keeps its place.
  const typing = document.activeElement && document.activeElement.dataset
    && document.activeElement.dataset.webform !== undefined ? document.activeElement : null;
  const typed = typing && {form: typing.dataset.webform, field: typing.dataset.field,
                           at: typing.selectionStart};
  root.innerHTML = S.devices.map(d => `
    <section class="device${S.folded[d.name] ? " folded" : ""}">
      <div class="head"><button class="fold" data-fold="${esc(d.name)}" aria-expanded="${!S.folded[d.name]}"
        title="${S.folded[d.name] ? "show" : "fold"} ${esc(d.name)}">${S.folded[d.name] ? "▸" : "▾"}</button><h2>${esc(d.name)}</h2><span class="meta">${esc(d.host)} · ${esc(d.found)}</span>${makeHtml(d)}</div>
      ${S.catalog ? catalogHtml(d.host) : ""}
      <div class="adrift" id="adrift-${esc(d.name)}"></div>
      <div class="walls">${d.walls.map(k => wallHtml(k)).join("")}</div>
    </section>`).join("");
  for (const d of S.devices) for (const k of d.walls) { update(k); fillLog(k); showAnswer(k); paintPic(k); }
  adrift();
  if (typed) {
    const el = root.querySelector(`[data-webform="${CSS.escape(typed.form)}"][data-field="${typed.field}"]`);
    if (el) { el.focus(); el.setSelectionRange(typed.at, typed.at); }
  }
  document.querySelectorAll("[data-cards]").forEach(b => {
    if (scrolled[b.dataset.cards]) b.scrollLeft = scrolled[b.dataset.cards];
    railEnds(b);
  });
