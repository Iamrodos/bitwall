 * refused here rather than by the sender host. Empty is the option not
 * given. */
const WALL_TOKEN = /^[a-z0-9][a-z0-9_-]{0,31}$/;
const HOST = /^[A-Za-z0-9][A-Za-z0-9._-]{0,252}$/, IPV6 = /^[0-9A-Fa-f]*:[0-9A-Fa-f:]*:[0-9A-Fa-f:]*$/;
