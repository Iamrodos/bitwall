#!/usr/bin/env python3
"""Matrix rain in a terminal, or in a tmux pane.

    senders/games/matrix/pane-matrix
    senders/games/matrix/pane-matrix --glyphs ascii

One of the two front ends on `rain.py`. It takes the area from the terminal
itself, asks the rain for a grid, and writes the cells that changed since
the last frame as truecolour ANSI. Diffing matters here for the same reason
it matters on a wall: between two rows a stream changes nothing at all, so
a full repaint would spend a screen on a picture that is still.

Autowrap is turned off because the grid is exactly as wide as the screen,
and with wrap on the last cell of a line pushes the cursor onto the next.
"""
import argparse
import os
import sys
import time

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

from rain import ASCII_GLYPHS, GLYPHS, Config, Rain             # noqa: E402

FPS = 12
GAP = 4          # re-homing the cursor costs more than a few unchanged cells


def sgr(g):
    p = ["0"]
    if g.bold:
        p.append("1")
    p += ["39"] if g.fg is None else [
        "38", "2", str(int(g.fg[0:2], 16)), str(int(g.fg[2:4], 16)),
        str(int(g.fg[4:6], 16))]
    return "\033[" + ";".join(p) + "m"


def paint(grid, prev, cols, rows):
    """ANSI for the cells that differ from the previous frame."""
    out = []
    cur = None
    for y in range(rows):
        row = grid[y]
        old = prev[y] if prev is not None and y < len(prev) else None
        x = 0
        while x < cols:
            if old is not None and row[x] == old[x]:
                x += 1
                continue
            start, end, gap, probe = x, x + 1, 0, x + 1
            while probe < cols:
                if old is not None and row[probe] == old[probe]:
                    gap += 1
                    if gap > GAP:
                        break
                else:
                    end = probe + 1
                    gap = 0
                probe += 1
            out.append(f"\033[{y + 1};{start + 1}H")
            for i in range(start, end):
                g = row[i]
                a = (g.fg, g.bold)
                if a != cur:
                    out.append(sgr(g))
                    cur = a
                out.append(g.ch)
            x = end
    if out:
        out.append("\033[0m")
    return "".join(out)


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--density", type=float, default=0.5)
    ap.add_argument("--flicker", type=float, default=5.0)
    ap.add_argument("--glyphs", choices=("katakana", "ascii"),
                    default="katakana")
    args = ap.parse_args()

    rain = Rain(Config(
        density=max(0.02, min(1.0, args.density)),
        flicker=max(0.0, args.flicker),
        glyphs=GLYPHS if args.glyphs == "katakana" else ASCII_GLYPHS))
    prev = None
    area = None
    sys.stdout.write("\033[?25l\033[?7l\033[0m\033[2J")
    try:
        while True:
            cols, rows = os.get_terminal_size()
            if (cols, rows) != area:
                area, prev = (cols, rows), None
                sys.stdout.write("\033[0m\033[2J")
            grid = rain.frame(cols, rows)
            data = paint(grid, prev, cols, rows)
            prev = grid
            if data:
                sys.stdout.write(data)
                sys.stdout.flush()
            time.sleep(1.0 / FPS)
    except KeyboardInterrupt:
        pass
    finally:
        sys.stdout.write("\033[0m\033[?7h\033[?25h\033[2J\033[H")
        sys.stdout.flush()
    return 0


if __name__ == "__main__":
    sys.exit(main())
