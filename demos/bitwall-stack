#!/usr/bin/env -S uv run --quiet --script
# /// script
# requires-python = ">=3.14"
# dependencies = ["aiohttp"]
# ///
"""Several walls on one page, stacked down it.

    demos/bitwall-stack [--port 8902] snake sysinfo

Then open `http://localhost:8902/stack`, or from elsewhere with `--host`,
and point a sender at each name:

    BITWALL_RUN=$TMPDIR/bitwall-web senders/games/snake/main.py localhost:snake

The order on the page is the order on the command line, so the first name
is the top wall. Every wall is live at once -- unlike the carousel, which
builds only what is in view, because here everything is in view.

A page rather than a receiver. It embeds the web receiver, which does the
walls, and adds the one route that arranges them -- so the receiver never
learns that a stack exists, and a wall here is the same wall as one in a
tab on its own.

Heights are shares of the viewport rather than aspect ratios: two walls
of different shapes still have to add up to one screen, and a wall that
kept its own proportions would leave the other one a slot it cannot use.
Each wall then takes the cells that fit the box it is given.
"""
import argparse
import asyncio
import json
import os
import sys

from aiohttp import web

HERE = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, os.path.dirname(HERE))
from bitwall.receivers import web as receiver                  # noqa: E402

PAGE = """<!doctype html>
<meta charset=utf-8>
<meta name=viewport content="width=device-width,initial-scale=1">
<title>%(title)s</title>
<style>
  html, body { margin: 0; height: 100%%; background: #000; }
  body { display: flex; flex-direction: column; }
  #bar { flex: 0 0 auto; display: flex; gap: 18px; align-items: center;
         padding: 6px 10px; background: #111116; color: #8a8a94;
         font: 12px ui-monospace, Menlo, monospace; flex-wrap: wrap; }
  #bar .set { display: flex; gap: 6px; align-items: center; }
  #bar b { color: #c8c8d0; font-weight: normal; }
  #bar button { background: #22222a; color: #c8c8d0; border: 1px solid #33333d;
                border-radius: 4px; font: inherit; padding: 3px 9px;
                cursor: pointer; }
  #bar button:active { background: #33333d; }
  #bar .at { min-width: 8ch; color: #55555c; }
  #bar .stats { color: #55555c; display: none; }
  #bar.showing .stats { display: inline; }
  .wall { flex: 1 1 0; min-height: 0; position: relative; }
  bitwall-screen { position: absolute; inset: 0; }
</style>
<div id=bar>%(controls)s</div>
%(walls)s
<script type=module src="/bitwall-screen.js"></script>
<script type=module>
  /* The element already knows how to magnify what the sender asked for.
     A wall on a page with others is the case that needs it most: two
     dashboards built for different distances have to share one screen,
     and only whoever is looking knows how that should fall. */
  /* What a wall costs is per wall, so it belongs beside that wall's
     controls rather than as one figure for the page. `s` toggles them,
     the key the single-wall page uses for the same thing. */
  const bar = document.getElementById('bar');
  const rate = (b) => {
    const kb = b / 1024;
    return kb > 1100 ? (kb / 1024).toFixed(1) + 'MB/s'
                     : kb.toFixed(0) + 'KB/s';
  };
  document.addEventListener('keydown', (e) => {
    if (e.key === 's' && !e.metaKey && !e.ctrlKey && !e.altKey) {
      e.preventDefault();
      bar.classList.toggle('showing');
    }
  });

  for (const set of document.querySelectorAll('#bar .set')) {
    const wall = document.querySelector(
      `bitwall-screen[name="${set.dataset.wall}"]`);
    const at = set.querySelector('.at');
    const stats = set.querySelector('.stats');
    let want = 1;
    const show = (e) => {
      at.textContent = `${want.toFixed(2)}x` +
        (wall.fontPx ? ` ${wall.cols}x${wall.rows}` : '');
      const d = e && e.detail;
      if (d) {
        stats.textContent = ` @${d.font}px  ${d.fps.toFixed(1)}fps  ` +
          `${d.paintMs.toFixed(2)}ms/paint  ${rate(d.rate)} uncompressed`;
      }
    };
    const step = (by) => {
      want = wall.zoom(by === 0 ? 1 : want * by);
      show();
    };
    set.querySelector('.less').onclick = () => step(1 / 1.15);
