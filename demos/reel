def chrome():
    for name in CHROME:
        found = name if os.path.isfile(name) else shutil.which(name)
        if found:
            return found
    return None


async def _cdp_shot(url, out, settle):
    import aiohttp
    async with aiohttp.ClientSession() as http:
        pages = []
        for _ in range(100):
            try:
                async with http.get(f"http://127.0.0.1:{DEBUG_PORT}/json") as r:
                    pages = [p for p in await r.json() if p.get("type") == "page"]
                if pages:
                    break
            except aiohttp.ClientError:
                pass
            await asyncio.sleep(0.1)
        if not pages:
            raise RuntimeError("Chrome did not open a page")
        async with http.ws_connect(pages[0]["webSocketDebuggerUrl"], max_msg_size=0) as ws:
            n = 0

            async def call(method, **params):
                nonlocal n
                n += 1
                await ws.send_json({"id": n, "method": method, "params": params})
                async for msg in ws:
                    got = json.loads(msg.data)
                    if got.get("id") == n:
                        return got.get("result", {})
            await call("Page.navigate", url=url)
            await asyncio.sleep(settle)
            # Every wall's picture, live: the page's own button for it.
            await call("Runtime.evaluate", expression="""
                [...document.querySelectorAll('button')]
                  .filter(b => b.textContent.trim() === '250ms')[0]?.click()""")
            await asyncio.sleep(settle)
            got = await call("Page.captureScreenshot", format="png")
            with open(out, "wb") as fh:
                fh.write(base64.b64decode(got["data"]))


def control_picture(out, env, logs, size=(1920, 1080), settle=2.0):
    """The control page, its own, pictured by Chrome; whether it was."""
    exe = chrome()
    if exe is None:
        log("no Chrome: no picture of the control page")
        return False
    home = os.path.join(logs, "control-home")
    os.makedirs(home, exist_ok=True)
    cenv = dict(env, HOME=home)
    cenv.setdefault("UV_CACHE_DIR", os.path.expanduser("~/.cache/uv"))
    with open(os.path.join(logs, "control.log"), "a") as lf:
        page = subprocess.Popen(
            [os.path.join(ROOT, "controllers/bitwall-control"), "--device",
             "reel=localhost", "--host", "127.0.0.1", "--port", str(CONTROL_PORT)],
            env=cenv, stdout=lf, stderr=subprocess.STDOUT, start_new_session=True)
    browser = subprocess.Popen(
        [exe, "--headless=new", "--disable-gpu", "--hide-scrollbars",
         f"--remote-debugging-port={DEBUG_PORT}", f"--window-size={size[0]},{size[1]}",
         f"--user-data-dir={os.path.join(logs, 'chrome')}", "about:blank"],
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    try:
        for _ in range(100):
            try:
                urllib.request.urlopen(f"http://127.0.0.1:{CONTROL_PORT}/", timeout=1)
                break
            except OSError:
                time.sleep(0.1)
        asyncio.run(_cdp_shot(f"http://127.0.0.1:{CONTROL_PORT}/", out, settle))
        log(f"pictured the control page: {out}")
        return True
    except Exception as e:                                      # noqa: BLE001
        log(f"no picture of the control page: {e}")
        return False
    finally:
        for p in (browser, page):
            try:
                os.killpg(p.pid, signal.SIGTERM)
                p.wait(5)
            except (ProcessLookupError, subprocess.TimeoutExpired):
                pass


