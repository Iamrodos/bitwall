def read_srt(path):
    """A SubRip file's lines as (start, end, text) in seconds, its lines of
    text joined into one; none where there is no file."""
    try:
        with open(path, encoding="utf-8-sig") as fh:
            text = fh.read().replace("\r", "")
    except OSError:
        return []
    out = []
    stamp = re.compile(r"(\d+):(\d+):(\d+)[,.](\d+)\s*-->\s*(\d+):(\d+):(\d+)[,.](\d+)")
    for block in re.split(r"\n\s*\n", text.strip()):
        rows = block.split("\n")
        for i, row in enumerate(rows):
            m = stamp.search(row)
            if m:
                v = [int(x) for x in m.groups()]
                out.append((v[0] * 3600 + v[1] * 60 + v[2] + v[3] / 1000,
                            v[4] * 3600 + v[5] * 60 + v[6] + v[7] / 1000,
                            " ".join(r.strip() for r in rows[i + 1:] if r.strip())))
                break
    return out


class Procs:
    """The senders the reel runs, by name, each in a process group of its
    own with its output in a log of its own."""

    def __init__(self, logs, env):
        self.logs, self.env = logs, env
        self.running = {}
        self.reapers = []
        self.n = 0

    def start(self, name, argv):
        if name in self.running:
            self.stop(name)
        self.n += 1
        out = open(os.path.join(self.logs, f"{self.n:03d}-{name}.log"), "w")
        p = subprocess.Popen(argv, stdout=out, stderr=subprocess.STDOUT,
                             stdin=subprocess.DEVNULL, env=self.env,
                             start_new_session=True, cwd=ROOT)
        out.close()
        self.running[name] = p
        log(f"started {name} ({p.pid}): {' '.join(argv[1:])}")
        return p

    def stop(self, *names):
        """SIGTERM now, SIGKILL in five seconds, waited for elsewhere."""
        for name in names:
            p = self.running.pop(name, None)
            if p is None:
                continue
            # The whole group, even where its first process has gone: what
            # it started may still be running in it.
            try:
                os.killpg(p.pid, signal.SIGTERM)
            except ProcessLookupError:
                continue
            reaper = threading.Thread(target=self._reap, args=(p,), daemon=True)
            reaper.start()
            self.reapers.append(reaper)
            log(f"stopped {name}")

    @staticmethod
    def _reap(p):
        try:
            p.wait(5)
        except subprocess.TimeoutExpired:
            try:
                os.killpg(p.pid, signal.SIGKILL)
            except ProcessLookupError:
                pass
            p.wait()

    def rename(self, old, new):
        if old in self.running:
            self.running[new] = self.running.pop(old)

    def stop_all(self):
        """Stop every sender, and wait until each has gone, SIGKILL and
        all, so none outlives the reel."""
        self.stop(*list(self.running))
        for reaper in self.reapers:
            reaper.join()

    def check(self):
        """Say once of any sender that has ended on its own."""
        for name, p in list(self.running.items()):
            if p.poll() is not None:
                log(f"{name} ended by itself, exit {p.returncode}; see {self.logs}")
                del self.running[name]


# ------------------------------------------------------------ the reel

class Reel:
    """The reel's scenes, its chapters in order, each a run of shots, and
    what each shot needs on the wall."""

    SCENES = (("intro", ("logo", "problem", "text", "styled", "secure")),
              ("idea", ("diagram", "beat")),
              ("more", ("fluid", "fonts", "panes", "swap", "ticker", "terminal")),
              ("pixels", ("receivers_more", "film", "framed", "rick", "subtitles", "native")),
              ("running", ("stats", "pip")),
              ("build", ("again", "python", "rust", "closer", "end")))

    @classmethod
    def shots(cls, names):
        """The shots `names` asks for, in its order: a scene's name is all
        its shots, `scene.shot` or a shot's own name is that shot."""
        scenes = dict(cls.SCENES)
        every = {shot: scene for scene, shots in cls.SCENES for shot in shots}
        out = []
        for name in names:
            scene, dot, shot = name.partition(".")
            if not dot and name in scenes:
                out += [f"{name}.{s}" for s in scenes[name]]
            elif dot and shot in scenes.get(scene, ()):
                out.append(name)
            elif not dot and name in every:
                out.append(f"{every[name]}.{name}")
            else:
                raise ValueError(name)
        return out
    #: The four panes' second senders, which act three brings back.
    SWAPPED = (("tl", "senders/games/snake/main.py"),
               ("tr", "senders/maze/main.py"),
               ("bl", "senders/games/torus/main.py"),
               ("br", "senders/games/matrix/main.py"))

    def __init__(self, a, procs, run, stop):
        self.a, self.p, self.run, self.stop = a, procs, run, stop
        self.target = a.target
        self.host, _, wall = a.target.partition(":")
        self.wall = wall or "0"
        self.caption_file = os.path.join(a.logs, "caption")
        self.slide_file = os.path.join(a.logs, "slide")
        self.code_file = os.path.join(a.logs, "slide-code")
        self.keep = os.path.join(a.logs, "panes")
        self.shot = os.path.join(a.logs, "control.png")
        self.base = set()           # the processes that are the base now
        self.ctl = None
        self.shooting = None
        self.film_began = None      # when the film was at FILM_SEEK

    # -- plumbing

    def wait(self, secs):
        until = time.monotonic() + secs
        while (left := until - time.monotonic()) > 0:
            if self.stop.wait(min(left, 0.25)):
                raise Stopped
            self.p.check()

    @staticmethod
    def write(path, text):
        tmp = path + ".tmp"
        with open(tmp, "w", encoding="utf-8") as fh:
            fh.write(text + "\n")
        os.replace(tmp, path)

    def say(self, text, rise=None):
        """The caption, and where the strip goes: `rise` is (share, seconds)
        off its edge, or home where it is not said."""
        self.write(self.caption_file, text + (f"\nrise {rise[0]} {rise[1]}" if rise else ""))
        log(f"caption: {text!r}" + (f" rising {rise[0]} over {rise[1]} s" if rise else ""))

    def start(self, name, rel, *args, target=None):
        exe = rel if os.path.isabs(rel) else os.path.join(ROOT, rel)
        return self.p.start(name, [exe, *args, target or self.target])

    def take_base(self, names, start, settle=0.8):
        """Start what is to be the base, then stop what was."""
        old = self.base - set(names)
        start()
        self.base = set(names)
        self.wait(settle)
        self.p.stop(*old)

    def slide(self, *lines):
        """The full wall's slide, starting the slides where they are not
        the base already."""
        self.write(self.slide_file, "\n".join(lines))
        if "slides" not in self.base:
            self.take_base({"slides"}, lambda: self.start(
                "slides", "demos/reel", "--slides", self.slide_file))

    def controller(self):
        if self.ctl is None or self.ctl.state != "open":
            self.ctl = bitwall.Controller(self.target).open()
        return self.ctl

    # -- panes

    def pane(self, name):
        local = self.host in ("localhost", "127.0.0.1")
        return f"{self.host if local else 'localhost'}:{self.wall}-{name}"

    def pane_ready(self, name, secs=10):
        door = os.path.join(self.run, "bitwall", f"{self.wall}-{name}", "door.in")
        until = time.monotonic() + secs
        while not os.path.exists(door):
            if time.monotonic() > until:
                log(f"pane {name}: no door at {door}")
                return False
            self.wait(0.05)
        return True

    def ctl_pane(self, name, command):
        c = bitwall.Controller(self.pane(name)).open()
        got = [x.raw for x in c.ask(command, timeout=3)]
        c.close()
        log(f"{name}: {command} -> {'; '.join(got) or 'nothing'}")

    def in_pane(self, pane, rel, *args):
        """A sender on a pane, asking for the font the pane has: a pane
        answers any other with its own area, which a sender waits on."""
        self.base.add(f"pane-{pane}")
        return self.start(f"pane-{pane}", rel, "--font", str(self.a.pane_font), *args,
                          target=self.pane(pane))

    def split(self, name, way, new, rel, *args):
        self.ctl_pane(name, f"split {way} {new}")
        if self.pane_ready(new):
            self.in_pane(new, rel, *args)

    def panes(self, first, fresh=True):
        """The wall cut into panes, from `first` or the layout kept."""
        if fresh:
            shutil.rmtree(self.keep, ignore_errors=True)
        self.take_base({"panes"}, lambda: self.start(
            "panes", "senders/panes/main.py", "--name", first,
            "--font", str(self.a.pane_font)), settle=0.1)
        if not self.pane_ready(first):
            raise RuntimeError("panes did not make its first pane")

    def swap(self, pane, rel, *args):
        """A pane's sender replaced: the new one first, then the old."""
        self.p.rename(f"pane-{pane}", f"old-{pane}")
        self.in_pane(pane, rel, *args)
        self.wait(1.0)
        self.p.stop(f"old-{pane}")

    def ticker(self):
        self.start("ticker", "senders/ticker/main.py", "--at", "top", "--font", "44",
                   "--where", WHERE[0], "--lat", WHERE[1], "--lon", WHERE[2])

    # -- the opening: the problem, and a board that grows

    def shot_logo(self):
        self.say("")
        self.slide("title", "bitwall", self.a.repo)
        self.wait(4)

    def shot_problem(self):
        self.say("")
        self.typed((("Need to show *something*,", "*somewhere* else?"),
                    ("try bitwall", "sending bits to walls.")))

    def shot_text(self):
        self.slide("text")
        self.say("A wall just shows what it's sent | such as plain text")
        self.wait(5)

    def shot_styled(self):
        self.slide("styled")
        self.say("...more text, styled")
        self.wait(5)

    def shot_secure(self):
        self.slide("secure")
        self.say("...even private data | the wall is not trusted with the keys")
        self.wait(12)

    # -- act one: the idea

    def shot_wall(self):
        self.slide("clock")
        self.ticker()
        self.say("This screen is a wall | it knows nothing")
        self.wait(5)

    def shot_nothing(self):
        self.say("No passwords, no data, no code on it")
        self.wait(4)

    def shot_diagram(self):
        self.p.stop("ticker")
        self.slide("diagram", "1")
        self.say("A sender runs where your *something* is | your data, your keys, your code")
        self.wait(4)
        self.slide("diagram", "2")
        self.say("ssh carries your bits there | you just send the updates")
        self.wait(4)
        self.slide("diagram", "3")
        self.say("...to a wall *somewhere* | a Pi, a browser, a terminal, e-paper")
        self.wait(5)

    def shot_fluid(self):
        self.take_base({"fluid"}, lambda: self.start(
            "fluid", "senders/fluid/main.py", "--font", "10", "--mode", "dye"))
        self.say("It's just a grid of cells | so play with what you send")
        self.wait(5)

    def shot_beat(self):
        self.say("")
        self.slide("beat")
        self.wait(2.5)

    def shot_terminal(self):
        self.p.stop("ticker")
        self.slide("terminal")
        self.say("This is all just text | bitwall can paint it in a terminal")
        self.wait(4)
        self.slide("terminal", "styled")
        self.say("...plain or styled | any terminal draws cells")
        self.wait(5)

    def shot_receivers_more(self):
        self.say("")
        self.slide("blank")
        self.wait(0.5)
        self.say("A receiver that does more than text? | what if it can reach the pixels too?")
        self.wait(4.5)
        self.say("...then you get more | pictures, video, layers of pixels")
        self.wait(4)

    # -- act two: more

    def shot_panes(self):
        self.panes("tl")
        self.in_pane("tl", "senders/fluid/main.py", "--mode", "dye")
        self.say("Cut a wall into panes | each its own sender")
        self.wait(1.0)
        self.split("tl", "right", "tr", "senders/games/raycast/main.py")
        self.wait(3.5)
        self.split("tl", "down", "bl", "senders/sysinfo/main.py")
        self.split("tr", "down", "br", "senders/letters/main.py", "--scene", "clock", "--hold")
        self.wait(3.5)

    def shot_swap(self):
        self.say("Swap any pane | the rest keep running")
        for pane, rel in self.SWAPPED:
            self.swap(pane, rel)
            self.wait(1.0)

    def shot_ticker(self):
        """Back to one sender on the whole wall, a band laid over it, and
        what is beneath changed while the band runs on."""
        self.one("raycast", "senders/games/raycast/main.py")
        self.say("One wall again | one sender")
        self.wait(2.5)
        self.ticker()
        self.wait(0.8)
        self.say("Add a layer over the top | of whatever is there")
        self.wait(4)
        self.say("Its empty cells are transparent | what's beneath shows through")
        self.wait(4)
        self.say("Change what's underneath | the band keeps flowing")
        self.wait(1)
        self.one("snake", "senders/games/snake/main.py")
        self.wait(3)
        self.one("torus", "senders/games/torus/main.py")
        self.wait(3.5)

    def one(self, name, rel, *args):
        """The whole wall one sender's again: it takes the base, and any
        panes and their senders go."""
        self.take_base({name}, lambda: self.start(name, rel, *args))
        self.p.stop(*[n for n in list(self.p.running) if n.startswith(("pane-", "old-"))])

    def shot_film(self):
        if not os.path.exists(FILM):
            log(f"no film at {FILM}: no film, and nothing framed")
            return
        self.p.stop("ticker")
        self.film_began = time.time() + 1.0
        self.take_base({"film"}, lambda: self.start(
            "film", "senders/film/main.py", "--file", FILM, "--seek", str(FILM_SEEK),
            "--ahead", "1.0"), settle=0.3)
        self.start("credit", "demos/caption", "--style", "label", "--at", "top",
                   "--align", "left", "--font", "18", "--place", "above",
                   "--text", FILM_CREDIT)
        self.say("Show a video | decoded by the wall itself")
        self.wait(7.5)

    def shot_framed(self):
        if not os.path.exists(FILM):
            return
        # The film carries on from where the full-wall film had got to.
        began, seek = self.film_began, FILM_SEEK
        if began is None:
            began, seek = time.time(), FILM_SEEK + 8
        self.start("framed", "demos/reel", "--framed", f"{began:.3f}", str(seek))
        self.wait(1.2)
        # A cells base is not taken over a film's video base: the film
        # goes, and the slides take the base it left.
        self.p.stop("credit", *self.base)
        self.base = set()
        self.wait(0.4)
        self.slide("nowplaying", f"{began:.3f}", str(seek))
        self.say("Resize and place it as you need | mix it with text")
        self.wait(7)

    def shot_rick(self):
        self.start("rick", "senders/ascii/main.py", "--name", "reel-rick", "--place", "above",
                   "--font", "14", "--grid", "210x58", "--only",
                   os.path.join(ROOT, "senders/ascii/whole") + " --centre=0.75 curl -sN ascii.live/rick")
        self.wait(0.8)
        self.say("And text over pixels | any layer, any order")
        self.wait(7)
        self.p.stop("rick")

    def shot_native(self):
        self.p.stop("subtitle", "framed")
        self.slide("platforms")
        self.say("Native receivers paint cells and pixels | on a Mac, Windows, Linux and a Pi")
        self.wait(6)

    def shot_subtitles(self):
        """The Rick Roll gone, and a better use of text over a film: a
        subtitle, on a label layer of its own, over the framed film."""
        subs = os.path.join(self.a.logs, "subtitle")
        self.write(subs, "")
        lines = read_srt(SUBTITLES)
        began = self.film_began or time.time()
        self.start("subtitle", "demos/caption", "--style", "subtitle",
                   "--box", ",".join(str(v) for v in FRAME), "--font", "24",
                   "--place", "above", "--file", subs)
        self.say("Ok, captions might be better | a better text overlay than a Rick Roll")
        # The line the film is saying now, as it plays in its frame.
        shown, until = None, time.monotonic() + 10
        while time.monotonic() < until:
            at = FILM_SEEK + time.time() - began
            now = next((t for start, end, t in lines if start <= at < end), "")
            if now != shown:
                self.write(subs, now)
                shown = now
            self.wait(0.2)
        self.p.stop("subtitle", "framed")
        self.film_began = None

    def shot_fonts(self):
        # A cells base is not taken over a film's video base: the film
        # goes first, and the slides take the base it left.
        self.slide("glyphs")
        self.say("A cell holds more than letters | blocks, lines, braille, octants, shapes")
        self.wait(5)
        self.slide("fonts")
        self.say("Helpers build big text from them | eight fonts in bitwall.letters")
        self.wait(6)

    # -- act three: running walls

    def playing(self):
        """The 'now playing' board with the film in its frame, as the
        running scene's wall: started where it is not up already."""
        if "framed" in self.p.running or not os.path.exists(FILM):
            return
        began, seek = time.time(), FILM_SEEK + 40
        self.start("framed", "demos/reel", "--framed", f"{began:.3f}", str(seek))
        self.wait(1.2)
        self.slide("nowplaying", f"{began:.3f}", str(seek))

    def shot_stats(self):
        self.playing()
        self.wait(1.0)
        self.controller().ask("stats 1 at=n size=34 show=wall,grid,fps,in,out,cpu,sender")
        self.say("Every wall measures itself, live")
        self.wait(6)
        self.controller().ask("stats 0")

    def shot_control(self):
        if self.shooting is not None:
            self.shooting.join(timeout=10)
        self.controller().ask("stats 0")
        if not os.path.exists(self.shot):
            return
        self.start("show", "demos/reel", "--show", self.shot)
        self.wait(0.6)
        self.say("One page sees and drives every wall")
        self.wait(5.4)

    def shot_pip(self):
        self.start("pip", "demos/reel", "--pip")
        self.wait(0.6)
        self.p.stop("show")
        self.say("Take a snapshot of any wall | or stream what it shows, live")
        self.wait(6.5)

    # -- act four: build your own

    def shot_again(self):
        """The diagram from the start again, asking what it takes to be
        the box on the left."""
        self.p.stop("pip", "show", "framed")
        self.controller().ask("stats 0")
        self.slide("diagram", "3", "CELLS AND PIXELS")
        self.say("So how hard is it | to write a sender?")
        self.wait(5)

    def shot_python(self):
        self.p.stop("pip", "show", "framed")
        self.write(self.code_file, f"code\n{PYTHON_SENDER}")
        self.panes("code")
        self.base.add("pane-code")
        self.start("pane-code", "demos/reel", "--slides", self.code_file,
                   "--slide-font", str(self.a.pane_font), target=self.pane("code"))
        self.ctl_pane("code", "split right run")
        self.ctl_pane("code", "share 55")
        if self.pane_ready("run"):
            self.base.add("pane-run")
            self.start("pane-run", PYTHON_SENDER, target=self.pane("run"))
        with open(os.path.join(ROOT, PYTHON_SENDER), encoding="utf-8") as fh:
            lines = sum(1 for line in fh if line.strip() and not line.startswith("#"))
        self.say(f"This is a complete sender | {lines} lines of Python")
        self.wait(8)

    def shot_rust(self):
        if not os.path.exists(RUST_BINARY):
            log(f"no {RUST_BINARY}: no Rust scene")
            return
        if "pane-run" not in self.base:
            self.shot_python()
        self.write(self.code_file, f"code\n{RUST_SENDER}")
        self.p.rename("pane-run", "old-run")
        self.start("pane-run", RUST_BINARY, target=self.pane("run"))
        self.wait(0.6)
        self.p.stop("old-run")
        self.say("...or Rust | where frame rate counts")
        self.wait(6.4)

    def shot_receivers(self):
        self.slide("receivers")
        self.say("A receiver is three promises | write your own")
        self.wait(8)

    #: The closer: seconds the prompt blinks alone, and each pass is held
    #: once it is typed.
    PROMPT, READ = 1.6, 4.0

    def typed(self, passes):
        """Passes of lines typed on a black screen, each from a blinking
        prompt, each held the same while it is read."""
        for lines in passes:
            self.slide("typing", f"{time.time() + self.PROMPT:.3f}", *lines)
            plain = sum(len(line.replace("*", "")) + 6 for line in lines)
            self.wait(self.PROMPT + plain * Slides.TYPE_EVERY + self.READ)

    def shot_closer(self):
        """The whole of it typed out on a black screen, before the card:
        no caption, the screen says it."""
        self.p.stop(*[n for n in list(self.p.running) if n.startswith(("pane-", "old-"))])
        self.say("")
        self.typed((("bitwall", "send text and pixels", "wherever you want."),
                      ("a small protocol", "with endless possibilities."),
                      ("use it for", "status displays,", "dashboards,",
                       "remote development,", "terminal walls,", "conferences,",
                       "installations..."),
                    ("what will you make, Neo?",)))
        self.slide("blank")
        self.wait(1.5)

    def shot_end(self):
        self.slide("title", "bitwall", self.a.repo)
        self.say("Everything you just saw is bitwall | captured straight off a wall")
        self.wait(8)

    def play(self):
        self.say("")
        self.start("caption", "demos/caption", "--file", self.caption_file,
                   "--font", str(self.a.caption_font), "--place", "top")
        loops = 0
        while True:
            started = time.monotonic()
            for name in self.a.shots:
                at = time.monotonic()
                getattr(self, "shot_" + name.partition(".")[2])()
                log(f"shot {name}: {time.monotonic() - at:.1f} s")
            loops += 1
            log(f"reel {loops} played in {time.monotonic() - started:.1f} s")
            if self.a.once:
                return


def build_rust():
    """The Rust sender, built where cargo is and it is not yet."""
    if os.path.exists(RUST_BINARY) or not shutil.which("cargo"):
        return
    log("building the Rust sender")
    subprocess.run(["cargo", "build", "--release", "--quiet", "--example", "wave"],
                   cwd=os.path.join(ROOT, "bitwall", "rust"))


def parse(argv):
    ap = argparse.ArgumentParser(description=(__doc__ or "").split("\n\n")[0])
    ap.add_argument("--once", action="store_true", help="play the reel once and stop")
    ap.add_argument("--repo", default="github.com/iamrodos/bitwall",
                    help="where the repo is, as the end card says it")
    ap.add_argument("--scenes", default=",".join(name for name, _ in Reel.SCENES),
                    help="the scenes, or scene.shot, to play in order (default "
                         "all: " + "; ".join(f"{n}: {','.join(s)}" for n, s in Reel.SCENES)
                         + ")")
    ap.add_argument("--pane-font", type=int, default=12,
                    help="the wall's font while it is cut into panes (default 12)")
    ap.add_argument("--caption-font", type=int, default=52,
                    help="the caption strip's font size (default 52)")
    ap.add_argument("--logs", default=None,
                    help="where the senders' logs go (default a new directory)")
    ap.add_argument("--slides", metavar="FILE", help=argparse.SUPPRESS)
    ap.add_argument("--slide-font", type=int, default=10, help=argparse.SUPPRESS)
    ap.add_argument("--show", metavar="IMAGE", help=argparse.SUPPRESS)
    ap.add_argument("--pip", action="store_true", help=argparse.SUPPRESS)
    ap.add_argument("--framed", nargs=2, type=float, metavar=("BEGAN", "SEEK"),
                    help=argparse.SUPPRESS)
    ap.add_argument("target", help="the wall, host:wall")
    a = ap.parse_args(argv)
    try:
        a.shots = Reel.shots([s for s in a.scenes.split(",") if s])
    except ValueError as e:
        ap.error(f"no scene or shot {e}: "
                 + "; ".join(f"{n}: {','.join(s)}" for n, s in Reel.SCENES))
    return a


def main():
    a = parse(sys.argv[1:])
    if a.slides:
        return slides_main(a.slides, a.target, a.slide_font)
    if a.show:
        return show_main(a.show, a.target)
    if a.pip:
        return pip_main(a.target)
    if a.framed:
        return framed_main(a.target, *a.framed)
    stop = stop_on_signals()
    a.logs = os.path.abspath(a.logs or tempfile.mkdtemp(prefix="bitwall-reel-"))
    os.makedirs(a.logs, exist_ok=True)
    env = dict(os.environ)
    host = a.target.partition(":")[0]
    if os.environ.get("BITWALL_RUN"):
        run = os.environ["BITWALL_RUN"]
    elif host in ("localhost", "127.0.0.1"):
        run = os.environ.get("XDG_RUNTIME_DIR") or os.path.expanduser("~/.bitwall/run")
    else:
        # The panes' walls in a run directory of the reel's own, so their
        # names meet nobody's on this machine.
        run = os.path.join(a.logs, "run")
        os.makedirs(run, exist_ok=True)
    env["XDG_RUNTIME_DIR"] = run
    env["BITWALL_PANES_KEEP"] = os.path.join(a.logs, "panes")
    # The reel asks its panes for their splits itself, where they are.
    os.environ["XDG_RUNTIME_DIR"] = run
    build_rust()
    procs = Procs(a.logs, env)
    log(f"reel on {a.target}; logs in {a.logs}; panes made in {run}")
    reel = Reel(a, procs, run, stop)
    try:
        reel.play()
    except Stopped:
        log("stopping")
    finally:
        procs.stop_all()
        if reel.ctl is not None:
            reel.ctl.ask("stats 0")
            reel.ctl.close()
        time.sleep(0.5)
    return 0


if __name__ == "__main__":
    sys.exit(main())
