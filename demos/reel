class Slides:
    """The reel's own base sender: a slide drawn in cells, chosen by the
    first line of a file and changed as the file is."""

    def __init__(self, path, w):
        self.path, self.w = path, w
        self.lines = []
        self.fits = {}

    def read(self):
        try:
            with open(self.path, encoding="utf-8") as fh:
                self.lines = fh.read().splitlines()
        except OSError:
            pass

    def render(self, cols, rows):
        grid = [[bitwall.cell(" ", TEXT, BG)] * cols for _ in range(rows)]
        kind, args = (self.lines[0], self.lines[1:]) if self.lines else ("", [])
        draw = getattr(self, "slide_" + kind, None)
        if draw and cols >= 20 and rows >= 8:
            draw(grid, cols, rows, args)
        return grid

    # -- drawing

    def fit(self, text, cols, rows, fonts, **opts):
        key = (text, cols, rows, tuple(fonts), tuple(sorted(opts.items())))
        if key not in self.fits:
            self.fits[key] = letters.fit(text, cols, rows, fonts=fonts,
                                         wall=self.w, **opts)
        return self.fits[key]

    def big(self, grid, text, x, y, cols, rows, fg, fonts, align="centre", bg=BG, **opts):
        """`text` as big as fits in the box, placed in it; (cols, rows)."""
        if cols < 1 or rows < 1:
            return (0, 0)
        got = self.fit(text, cols, rows, fonts, **opts)
        if not got:
            return (0, 0)
        c, r = letters.size(**{k: v for k, v in got.items()
                               if k not in ("smooth", "depth", "ghost")})
        dx = (cols - c) // 2 if align == "centre" else 0
        letters.draw(grid, x=x + dx, y=y + (rows - r) // 2, fg=fg, bg=bg,
                     wall=self.w, **got)
        return (c, r)

    @staticmethod
    def text(grid, text, x, y, fg, bg=BG, bold=False):
        if not 0 <= y < len(grid):
            return
        row = grid[y]
        for i, ch in enumerate(text):
            if 0 <= x + i < len(row):
                row[x + i] = bitwall.cell(ch, fg, bg, bold=bold)

    @classmethod
    def box(cls, grid, x, y, w, h, fg, bg=BG, title="", source=""):
        """A box with rounded corners, a title in its top edge and where
        its contents came from in its bottom one."""
        for j in range(y + 1, y + h - 1):
            for i in range(x + 1, x + w - 1):
                grid[j][i] = bitwall.cell(" ", TEXT, bg)
        for i in range(x + 1, x + w - 1):
            grid[y][i] = bitwall.cell("─", fg, BG)
            grid[y + h - 1][i] = bitwall.cell("─", fg, BG)
        for j in range(y + 1, y + h - 1):
            grid[j][x] = bitwall.cell("│", fg, BG)
            grid[j][x + w - 1] = bitwall.cell("│", fg, BG)
        for (i, j), ch in (((x, y), "╭"), ((x + w - 1, y), "╮"),
                           ((x, y + h - 1), "╰"), ((x + w - 1, y + h - 1), "╯")):
            grid[j][i] = bitwall.cell(ch, fg, BG)
        if title:
            cls.text(grid, f" {title} ", x + 2, y, "c9d1d9", BG, bold=True)
        if source:
            cls.text(grid, f" {source} ", x + w - len(source) - 4, y + h - 1, DIM, BG)

    # The caption takes the bottom of the wall: a slide keeps above its
    # last sixth.

    def slide_problem(self, grid, cols, rows, args):
        """Lines of big text, the words in *stars* in the accent: the
        reel's themes, as its captions mark them too."""
        lines = args or ["NEED TO SHOW *SOMETHING*,", "*SOMEWHERE* ELSE?"]
        plain = [line.replace("*", "") for line in lines]
        high = int(rows * 0.7) // max(1, len(lines))
        fonts = [letters.TILE, letters.HALF, letters.BLOCK]
        fits = [self.fit(line, cols - 8, high - 2, fonts) for line in plain]
        if not all(fits):
            return
        least = min(fits, key=lambda f: f.get("height") or 0)
        how = {k: v for k, v in least.items() if k != "text"}
        measure = {k: v for k, v in how.items() if k not in ("smooth", "depth", "ghost")}
        gap = letters.size("I I", **measure)[0] - 2 * letters.size("I", **measure)[0]
        top = rows // 10
        for n, line in enumerate(lines):
            words = line.split()
            wide = letters.size(plain[n], **measure)
            x = (cols - wide[0]) // 2
            y = top + n * high + (high - wide[1]) // 2
            for word in words:
                lit = word.startswith("*")
                word = word.replace("*", "")
                letters.draw(grid, word.upper(), x=x, y=y, fg=INK if lit else TEXT,
                             bg=BG, wall=self.w, **how)
                x += letters.size(word.upper(), **measure)[0] + gap

    # -- the board: the same room's board, plain, then styled, then
    # holding what only its sender could know.

    BOARD_FONT = 28
    #: The board drawn in a window has a frame round it: a little smaller.
    WINDOW_FONT = 22
    #: Seconds a typed character takes, and how long it flickers through
    #: other characters before it settles.
    TYPE_EVERY, TYPE_SETTLE = 0.07, 0.25
    #: The most lines, and the longest line, any typed pass has.
    TYPE_LINES, TYPE_WIDE = 7, 28

    def board(self, grid, cols, rows, stage):
        plain = stage == 1
        ink = "default" if plain else TEXT
        if plain:
            for row in grid:
                row[:] = [bitwall.cell(" ")] * cols
        # The caption's strip takes the bottom quarter: the board ends above.
        usable = rows - -(-rows // 4) - 1
        half = cols // 2
        top_h = max(6, (usable - 4) // 2 - 1) if stage == 3 else usable - 4
        top_h = min(top_h, 10) if stage == 3 else min(top_h, 12)
        now = time.time()
        clock = time.strftime("%H:%M:%S")
        if plain:
            self.text(grid, "Kitchen", 3, 1, "default", "default")
        else:
            band = "1b2230"
            for y in range(3):
                for x in range(cols):
                    grid[y][x] = bitwall.cell(" ", TEXT, band)
            grid[0] = [bitwall.cell("▄", band)] * cols
            grid[2] = [bitwall.cell("▀", band)] * cols
            for y, ch in ((0, "◢"), (2, "◥")):
                grid[y][0] = bitwall.cell(ch, INK)
            grid[1][0] = bitwall.cell("█", INK)
            self.text(grid, "KITCHEN", 3, 1, INK, band, bold=True)
            right = f"{clock}   {time.strftime('%a %-d %b')}"
            if stage == 3:
                right = "● live   " + right
            self.text(grid, right, cols - len(right) - 3, 1, TEXT, band)
            if stage == 3:
                self.text(grid, "●", cols - len(right) - 3, 1, "8cf08c", band)
        # Tonight, where the plain board's lines were.
        lines = (("Bins out tonight", INK), ("Back at 6", COOL), ("Milk, eggs, coffee", TEXT))
        if not plain:
            self.box(grid, 2, 4, half - 3, top_h, FAINT, "10151d", "Tonight",
                     "from the family calendar API" if stage == 3 else "")
        for i, (line, colour) in enumerate(lines):
            if plain:
                self.text(grid, line, 6, 6 + i, "default", "default")
            else:
                self.text(grid, "●", 6, 6 + i, colour, "10151d")
                self.text(grid, line, 8, 6 + i, TEXT, "10151d")
        if plain:
            return
        # The second panel, styled: a list; holding data: the shop.
        x2, w2 = half + 1, cols - half - 3
        if stage == 2:
            self.box(grid, x2, 4, w2, top_h, FAINT, "10151d", "Shopping")
            for i, (mark, item, done) in enumerate((("■", "Coffee", True),
                                                    ("□", "Milk", False),
                                                    ("□", "Eggs", False),
                                                    ("□", "Bread", False))):
                self.text(grid, mark, x2 + 4, 6 + i, "8cf08c" if done else DIM, "10151d")
                self.text(grid, item, x2 + 6, 6 + i, DIM if done else TEXT, "10151d")
            return
        orders = 128 + int(now / 4) % 9
        self.box(grid, x2, 4, w2, top_h, FAINT, "10151d", "Orders today",
                 "from the shop's database")
        self.big(grid, str(orders), x2 + 3, 5, w2 // 3, top_h - 2, INK,
                 [letters.HALF, letters.BLOCK], align="left", bg="10151d")
        self.text(grid, f"£{orders * 33.7:,.2f} taken", x2 + w2 // 3 + 6, 6, TEXT, "10151d")
        self.text(grid, f"{3 + int(now / 7) % 3} to ship by 5pm", x2 + w2 // 3 + 6, 7,
                  DIM, "10151d")
        self.text(grid, "Acme Example Shop", x2 + w2 // 3 + 6, 8, DIM, "10151d")
        # The bottom row: a server and a bank, each from where it came.
        y3 = 4 + top_h + 1
        h3 = usable - y3
        if h3 < 5:
            return
        third = (cols - 4) // 2
        self.box(grid, 2, y3, third - 1, h3, FAINT, "10151d", "web-01.example.com",
                 "from the monitoring API")
        cpu = 23 + 9 * abs(((now / 3) % 2) - 1)
        self.text(grid, "●", 6, y3 + 2, "8cf08c", "10151d")
        self.text(grid, f"healthy   cpu {cpu:4.1f}%   up 41 days", 8, y3 + 2, TEXT, "10151d")
        bars = "▁▂▃▄▅▆▇█"
        spark = "".join(bars[int(4 + 3 * __import__("math").sin(now * 1.3 + i / 2.3))]
                        for i in range(min(48, third - 10)))
        self.text(grid, spark, 6, y3 + 4, COOL, "10151d")
        xb = 2 + third + 1
        self.box(grid, xb, y3, cols - xb - 2, h3, FAINT, "10151d", "Example Bank",
                 "from the bank's API (fake)")
        self.text(grid, "balance", xb + 4, y3 + 2, DIM, "10151d")
        self.text(grid, "£ ●●,●●●.●●", xb + 14, y3 + 2, TEXT, "10151d", bold=True)
        self.text(grid, "rent due Friday", xb + 4, y3 + 4, INK, "10151d")

    def slide_text(self, grid, cols, rows, args):
        self.windowed(grid, cols, rows, 1)

    def slide_styled(self, grid, cols, rows, args):
        self.windowed(grid, cols, rows, 2)

    def slide_secure(self, grid, cols, rows, args):
        self.windowed(grid, cols, rows, 3)

    def window(self, grid, cols, rows, title):
        """A window with rounded corners and the three dots in its corner,
        above the caption's strip; where its inside is, (x, y, w, h)."""
        win = "16181d"
        top, h = 1, rows - rows // 4 - 2
        self.box(grid, 3, top, cols - 6, h, DIM, win)
        bar = top + 1
        for i, colour in enumerate(("ff5f57", "febc2e", "28c840")):
            self.text(grid, "●", 6 + 2 * i, bar, colour, win)
        self.text(grid, title, (cols - len(title)) // 2, bar, DIM, win)
        return 5, bar + 2, cols - 10, h - 4

    def windowed(self, grid, cols, rows, stage):
        """The kitchen board at a stage, drawn in a window: what a wall
        shows is plainly a screen of its own."""
        x, y, iw, ih = self.window(grid, cols, rows, "kitchen")
        # The board leaves the bottom quarter of what it is given to the
        # caption: give it a third more, and take the top.
        inner = [[bitwall.cell(" ", TEXT, BG)] * iw for _ in range(ih + ih // 3)]
        self.board(inner, iw, len(inner), stage)
        for j in range(ih):
            grid[y + j][x:x + iw] = inner[j]

    def font_for(self, default):
        """The font the slide is drawn at: the board's own, else `default`."""
        kind = self.lines[0] if self.lines else ""
        if kind in ("text", "styled", "secure", "terminal"):
            return self.WINDOW_FONT
        return self.BOARD_FONT if kind in ("glyphs", "platforms") else default

    def slide_nowplaying(self, grid, cols, rows, args):
        """A 'now playing' board around the framed film: a frame where
        the film's layer shows, and beside it what it is and how far in.
        The args are the Unix time the film was at `seek` seconds."""
        try:
            began, seek = float(args[0]), float(args[1])
        except (IndexError, ValueError):
            began, seek = time.time(), FILM_SEEK
        into = max(0.0, seek + time.time() - began)
        fx, fy, fw, fh = FRAME
        x0, y0 = int(fx * cols) - 1, int(fy * rows) - 1
        x1, y1 = -(-int((fx + fw) * cols * 1000) // 1000), -(-int((fy + fh) * rows * 1000) // 1000)
        x1, y1 = min(cols - 1, x1 + 1), min(rows - 1, y1)
        self.box(grid, x0, y0, x1 - x0 + 1, y1 - y0 + 1, INK, "000000")
        self.text(grid, " NOW PLAYING ", x0 + 2, y0, INK, BG, bold=True)
        # Under the film, its progress.
        bar_y = y1 + 2
        if bar_y < rows:
            span = x1 - x0 - 1
            done = round(span * into / FILM_LENGTH)
            for i in range(span):
                grid[bar_y][x0 + 1 + i] = bitwall.cell("━", INK if i < done else FAINT, BG)
            stamp = f"{int(into) // 60}:{int(into) % 60:02d} / {FILM_LENGTH // 60}:{FILM_LENGTH % 60:02d}"
            got = self.fit(stamp, x1 - x0 - 30, 3, [letters.HALF])
            wide = letters.size(**{k: v for k, v in got.items()
                                   if k not in ("smooth", "depth", "ghost")})[0] if got else 0
            self.big(grid, stamp, x1 - wide, bar_y + 1, wide, 3, DIM, [letters.HALF],
                     align="left")
            self.big(grid, "PLAYING", x0 + 1, bar_y + 1, 30, 3, INK, [letters.HALF],
                     align="left")
        # Beside it, what it is.
        px = x1 + 4
        pw = cols - px - 3
        if pw < 12:
            return
        y, high = y0 + 1, max(3, (y1 - y0) // 6)
        for line, colour, h in (("TEARS OF", TEXT, high), ("STEEL", TEXT, high),
                                ("BLENDER FOUNDATION", DIM, max(3, high // 2)),
                                ("CC BY 3.0  2012", DIM, max(3, high // 2))):
            self.big(grid, line, px, y, pw, h, colour, [letters.HALF, letters.DOTS],
                     align="left")
            y += h + 1

    def slide_title(self, grid, cols, rows, args):
        title = args[0] if args else "bitwall"
        sub = args[1] if len(args) > 1 else ""
        top = rows // 8
        self.big(grid, title, 4, top, cols - 8, int(rows * 0.42), INK,
                 [letters.TILE, letters.HALF, letters.BLOCK])
        if sub:
            self.big(grid, sub, 4, top + int(rows * 0.47), cols - 8, max(3, rows // 9),
                     DIM, [letters.HALF, letters.DOTS])

    def slide_glyphs(self, grid, cols, rows, args):
        """What a cell can hold beyond letters: the characters walls draw
        as shapes, a row of each kind."""
        octs = "".join(chr(0x1CD00 + i) for i in range(0, 230, 11))
        kinds = (("letters", "Aa Bb Cc 0123 ?!&@ {}[]", TEXT),
                 ("blocks", "▀ ▄ █ ▌ ▐  ▖ ▗ ▘ ▝ ▚ ▞ ▙ ▛ ▜ ▟  ░ ▒ ▓", INK),
                 ("eighths", "▁▂▃▄▅▆▇█  ▏▎▍▌▋▊▉", INK),
                 ("box lines", "┌─┬─┐ ┏━┓ ╔═╗ ╭─╮ ┼ ╋ ╬ ╰─╯", COOL),
                 ("braille", "⠁⠃⠇⡇⣇⣧⣷⣿  ⣀⣤⣶⣿  ⢸⡇⠿", COOL),
                 ("octants", " ".join(octs), "a6e3a1"),
                 ("shapes", "◢ ◣ ◤ ◥  ● ◆ ■ □ ▪  ▲ ▶ ▼ ◀", "ff7a90"))
        usable = rows - rows // 4 - 1
        gap = max(1, usable // (len(kinds) + 1))
        for i, (name, sample, colour) in enumerate(kinds):
            y = 1 + gap // 2 + i * gap
            self.text(grid, name, 4, y, DIM)
            self.text(grid, sample, 18, y, colour)

    def slide_platforms(self, grid, cols, rows, args):
        """The native receivers that paint cells and pixels both: a panel
        for each place one runs."""
        places = (("MAC", "a window, or no screen", COOL),
                  ("WINDOWS", "a window, or no screen", COOL),
                  ("LINUX", "a window, or no screen", COOL),
                  ("PI", "a Raspberry Pi's screens, through KMS", INK))
        usable = rows - rows // 4 - 1
        w, h = (cols - 9) // 2, (usable - 3) // 2
        for i, (name, what, colour) in enumerate(places):
            x, y = 3 + (i % 2) * (w + 3), 1 + (i // 2) * (h + 1)
            self.box(grid, x, y, w, h, FAINT)
            self.big(grid, name, x + 2, y + max(1, h // 4), w - 4, max(3, h // 2), colour,
                     [letters.HALF, letters.BLOCK])

    def slide_terminal(self, grid, cols, rows, args):
        """A terminal window painting the kitchen board as plain text: the
        whole of what a wall has been sent so far is cells, and any
        terminal draws cells."""
        win = "16181d"
        _, y, _, h = self.window(grid, cols, rows, "bitwall-term kitchen")
        h += 4
        self.text(grid, "$ bitwall-term kitchen", 6, y, "8fd18f", win)
        if args and args[0] == "styled":
            # The styled board, painted in the terminal as it is on a wall.
            iw, ih = cols - 10, h - 5
            inner = [[bitwall.cell(" ", TEXT, BG)] * iw for _ in range(ih + ih // 3)]
            self.board(inner, iw, len(inner), 2)
            for j in range(ih):
                grid[y + 1 + j][5:5 + iw] = inner[j]
            return
        for line in ("", "Kitchen", "", "  Bins out tonight", "  Back at 6",
                     "  Milk, eggs, coffee"):
            y += 1
            if line:
                self.text(grid, line, 6, y, "c8c8c8", win)

    def slide_beat(self, grid, cols, rows, args):
        lines = args or ["BUT WAIT,", "THERE'S MORE..."]
        high = int(rows * 0.3)
        for i, line in enumerate(lines[:2]):
            self.big(grid, line, 4, rows // 10 + i * (high + rows // 20), cols - 8, high,
                     INK if i == 0 else TEXT, [letters.TILE, letters.HALF, letters.BLOCK])

    def slide_clock(self, grid, cols, rows, args):
        now = time.localtime()
        self.big(grid, time.strftime("%H:%M", now), 4, int(rows * 0.16), cols - 8,
                 int(rows * 0.45), TEXT, [letters.SEGMENT7, letters.HALF], ghost=GHOST)
        self.big(grid, time.strftime("%A %-d %B", now).upper(), 4, int(rows * 0.66),
                 cols - 8, max(3, rows // 10), DIM, [letters.HALF, letters.DOTS])

    def slide_diagram(self, grid, cols, rows, args):
        """The sender, then the ssh between, then the wall: `args[0]` is
        how many of the three are up, `args[1]` what the wire says."""
        step = int(args[0]) if args and args[0].isdigit() else 3
        bw, bh = int(cols * 0.32), int(rows * 0.52)
        top = int(rows * 0.12)
        lx, rx = int(cols * 0.04), cols - int(cols * 0.04) - bw
        self.box(grid, lx, top, bw, bh, COOL)
        inner = bh - 4
        self.big(grid, "YOUR MACHINE", lx + 2, top + 2, bw - 4, inner // 3, COOL,
                 [letters.HALF, letters.BLOCK])
        for i, word in enumerate(("DATA", "KEYS", "CODE")):
            self.big(grid, word, lx + 2, top + 2 + inner // 3 + i * inner // 5,
                     bw - 4, inner // 5, TEXT, [letters.HALF], scale=1)
        if step < 2:
            return
        if step >= 3:
            self.box(grid, rx, top, bw, bh, INK)
            self.big(grid, "THE WALL", rx + 2, top + 2, bw - 4, inner // 3, INK,
                 [letters.HALF, letters.BLOCK])
            self.big(grid, "PAINTS", rx + 2, top + 2 + inner // 3 + inner // 5,
                     bw - 4, inner // 5, TEXT, [letters.HALF], scale=1)
        # The arrow between, cells running along it.
        y = top + bh // 2
        a0, a1 = lx + bw + 2, rx - 3
        for x in range(a0, a1):
            grid[y][x] = bitwall.cell("━", DIM, BG)
        grid[y][a1] = bitwall.cell("▶", INK, BG)
        step = int(time.monotonic() * 12)
        for k in range(0, a1 - a0, 9):
            x = a0 + (step + k) % (a1 - a0)
            grid[y][x] = bitwall.cell("■", INK, BG)
        label = max(3, rows // 9)
        wire = args[1] if len(args) > 1 else "CELLS OVER SSH"
        self.big(grid, wire, a0, y - label - 1, a1 - a0, label, DIM,
                 [letters.HALF, letters.DOTS])

    def slide_typing(self, grid, cols, rows, args):
        """Lines typed onto a black screen as a terminal in a film types
        them, in VT323, the VT320's own face: the newest character
        flickers through others before it settles, and a cursor blinks
        after the last. Every line is drawn at the scale the longest fits
        at, so the type does not change size as it grows."""
        if not args:
            return
        began, marked = float(args[0]), args[1:]
        # Words between *stars* are the theme's, in amber: each line as
        # its plain text and which of its characters are amber.
        lines, amber = [], []
        for line in marked:
            plain, mask = "", []
            for k, piece in enumerate(line.split("*")):
                plain += piece
                mask += [k % 2 == 1] * len(piece)
            lines.append(plain)
            amber.append(mask)
        for row in grid:
            row[:] = [bitwall.cell(" ", "default", "000000")] * cols
        typed = (time.time() - began) / self.TYPE_EVERY
        rng = random.Random(int(time.time() * 20))
        # Every pass at one size and from one place, whatever its lines:
        # the type fitted to the longest line and the most lines any pass
        # has, and the prompt always where the last one was.
        usable = rows - rows // 4 - 1
        high = max(3, usable // (self.TYPE_LINES + 1))
        left = max(2, cols // 10)
        prompt = "> "
        longest = prompt + "x" * self.TYPE_WIDE + "_"
        got = self.fit(longest, cols - 2 * left, high, [letters.VT323, letters.HALF])
        if not got:
            return
        # Lines as close as a terminal's: the type's own height and a
        # little lead, whatever room the fit was given.
        _, r = letters.size(**{k: v for k, v in got.items()
                               if k not in ("smooth", "depth", "ghost")})
        pitch = r + max(1, r // 4)
        top = max(0, (usable - pitch * self.TYPE_LINES) // 2)
        n, last = 0, None
        shown = []
        for line in lines:
            k = max(0, min(len(line), int(typed - n)))
            shown.append(line[:k])
            if k:
                last = (len(shown) - 1, (typed - n - k + 1) * self.TYPE_EVERY)
            n += len(line) + 6               # a breath at the end of a line
            if k < len(line):
                break
        if typed < 0:
            shown = [""]
        blink = int(time.time() * 2) % 2 == 0
        green, gold = "35e07a", INK
        for i, text in enumerate(shown):
            colours = [gold if a else green for a in amber[i][:len(text)]]
            if last and i == last[0] and last[1] < self.TYPE_SETTLE and text:
                text = text[:-1] + rng.choice("0123456789#$%&+=<>?/|")
            if i == 0:
                text, colours = prompt + text, [green] * len(prompt) + colours
            if i == len(shown) - 1 and blink:
                text, colours = text + "_", colours + [green]
            # Runs of one colour, each drawn after the last at one scale.
            x, run, start = left, "", 0
            for j in range(len(text) + 1):
                if j == len(text) or (j > start and colours[j] != colours[start]):
                    run = text[start:j]
                    if run:
                        letters.draw(grid, x=x, y=top + i * pitch, fg=colours[start],
                                     bg="000000", wall=self.w, **dict(got, text=run))
                        c, _ = letters.size(**{k: v for k, v in dict(got, text=run).items()
                                               if k not in ("smooth", "depth", "ghost")})
                        x += c
                    start = j

    def slide_fonts(self, grid, cols, rows, args):
        usable = rows - rows // 6
        cw, rh = cols // 2, usable // 4
        for i, (font, word, fg, opts) in enumerate(EIGHT):
            x, y = (i % 2) * cw, 1 + (i // 2) * rh
            self.text(grid, font.upper(), x + 3, y, DIM)
            self.big(grid, word, x + 3, y + 1, cw - 6, rh - 2, fg, [font], **opts)

    def slide_receivers(self, grid, cols, rows, args):
        usable = rows - rows // 6
        half = cols // 2
        head = max(3, usable // 9)
        self.big(grid, "RECEIVERS", 6, 1, half - 10, head, DIM, [letters.HALF],
                 align="left")
        names = ("PI SCREENS", "MAC AND WINDOWS", "A BROWSER TAB",
                 "A TERMINAL", "A PLAIN SHELL", "E-PAPER")
        each = (usable - head - 2) // len(names)
        for i, name in enumerate(names):
            y = 2 + head + i * each
            self.text(grid, "▪", 4, y + each // 2 - 1, INK)
            self.big(grid, name, 6, y, half - 10, each - 1, TEXT, [letters.HALF],
                     align="left")
        for y in range(1, usable):
            grid[y][half] = bitwall.cell("│", FAINT, BG)
        promises = (("1", "TAKE A FONT"), ("2", "SAY YOUR AREA"), ("3", "PAINT THE STREAM"))
        each = (usable - 2) // 3
        for i, (n, words) in enumerate(promises):
            y = 1 + i * each
            c, _ = self.big(grid, n, half + 4, y, 10, each - 2, INK,
                            [letters.TILE, letters.HALF], align="left")
            x = half + 6 + max(c, 4)
            self.big(grid, words, x, y, cols - x - 3, each - 2, TEXT,
                     [letters.HALF, letters.BLOCK], align="left")

    def slide_code(self, grid, cols, rows, args):
        path = args[0] if args else ""
        try:
            with open(os.path.join(ROOT, path), encoding="utf-8") as fh:
                lines = fh.read().splitlines()
        except OSError:
            lines = [f"cannot read {path}"]
        band = "161b24"
        for x in range(cols):
            grid[0][x] = bitwall.cell(" ", TEXT, band)
        self.text(grid, " " + path, 1, 0, INK, band, bold=True)
        for i, line in enumerate(lines[: rows - 2]):
            y = i + 2
            self.text(grid, f"{i + 1:3d}", 0, y, FAINT)
            x0, last = 5, 0
            for m in TOKENS.finditer(line):
                self.text(grid, line[last:m.start()], x0 + last, y, TEXT)
                self.text(grid, m.group(), x0 + m.start(), y, CODE_COLOURS[m.lastgroup])
                last = m.end()
            self.text(grid, line[last:], x0 + last, y, TEXT)


def slides_main(path, target, font):
    """A base sender showing the slide `path` names, as it changes."""
    stop = stop_on_signals()
    w = bitwall.attach(target, min_frame=1 / 10)
    slides = Slides(path, w)
    slides.read()
    w.meta(name="Reel slides", description="The reel's title cards and drawings")
    at = slides.font_for(font)
    with w.transition():
        w.set_font_size(at)
        w.set_source(slides.render)
    log(f"slides -> {target}, {w.area()[0]}x{w.area()[1]}: {slides.lines[:2]}")
    seen = None
    while not stop.wait(0.1):
        try:
            mt = os.stat(path).st_mtime_ns
        except OSError:
            continue
        if mt != seen:
            seen = mt
            slides.read()
            log(f"slide {slides.lines[:2]}")
            if slides.font_for(font) != at:
                at = slides.font_for(font)
                with w.transition():
                    w.set_font_size(at)
                    w.set_source(slides.render)
    w.detach()
    return 0


# ------------------------------------------------------ picture layers

def open_layer(target, stop):
    lay = bitwall.layer(target, place="above")
    until = time.monotonic() + 8
    while lay.pixels() is None and time.monotonic() < until and not stop.is_set():
        time.sleep(0.05)
    return lay


def show_main(path, target):
    """An image over the whole wall, on a layer, until stopped."""
    stop = stop_on_signals()
    lay = open_layer(target, stop)
    glass = lay.pixels() or (1920, 1080)
    with open(path, "rb") as fh:
        data = fh.read()
    lay.frame(data, at=(0, 0), size=glass, hold="still")
    log(f"show {path} -> {target} at {glass[0]}x{glass[1]}")
    stop.wait()
    lay.close()
    return 0


def framed_main(target, began, seek):
    """The film in the slides' frame: a video layer above the base, its
    frames JPEGs placed at the frame's box, decoded here by ffmpeg at the
    film's own clock from where it had got to."""
    stop = stop_on_signals()
    lay = open_layer(target, stop)
    gw, gh = lay.pixels() or (1920, 1080)
    fx, fy, fw, fh = FRAME
    at, size = (round(fx * gw), round(fy * gh)), (round(fw * gw), round(fh * gh))
    sw, sh = (round(size[0] * FRAME_SCALE) // 2 * 2, round(size[1] * FRAME_SCALE) // 2 * 2)
    if not lay.takes("jpeg"):
        log(f"{target} takes no JPEG: no framed film")
        lay.close()
        return 1
    into = seek + max(0.0, time.time() - began)
    enc = subprocess.Popen(
        ["ffmpeg", "-hide_banner", "-loglevel", "error", "-nostdin", "-ss", f"{into:.2f}",
         "-re", "-i", FILM, "-an", "-vf", f"fps={FRAME_FPS},scale={sw}:{sh}",
         "-f", "image2pipe", "-c:v", "mjpeg", "-q:v", "4", "-"],
        stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, start_new_session=True)
    log(f"framed -> {target}: {sw}x{sh} at {FRAME_FPS}fps into {size[0]}x{size[1]} "
        f"at {at[0]},{at[1]}, from {into:.1f}s")
    sent = [0]

    def carry():
        """Each JPEG ffmpeg writes, whole, to the layer at the box."""
        buf = b""
        while not stop.is_set():
            chunk = enc.stdout.read1(1 << 16)
            if not chunk:
                break
            buf += chunk
            while (end := buf.find(b"\xff\xd9")) >= 0:
                start = buf.find(b"\xff\xd8")
                frame, buf = buf[max(0, start):end + 2], buf[end + 2:]
                if start >= 0 and not stop.is_set():
                    lay.frame(frame, at=at, size=size, hold=round(2000 / FRAME_FPS))
                    sent[0] += 1
        stop.set()

    # The carrying on a thread of its own, so a stop is heard however
    # long a read waits: ffmpeg is ended, which ends the read.
    carrier = threading.Thread(target=carry, daemon=True)
    carrier.start()
    while not stop.wait(0.2):
        pass
    # Killed outright: ffmpeg told to stop finishes what it is writing,
    # into a pipe nobody reads any more.
    try:
        os.killpg(enc.pid, signal.SIGKILL)
    except ProcessLookupError:
        pass
    enc.wait()
    carrier.join(timeout=2)
    log(f"framed: {sent[0]} frames sent")
    lay.close()
    return 0


def pip_main(target):
    """The wall's own glass, live, shrunk into its top right corner with
    a border, from a mirror of it: the corner holds itself, smaller."""
    from PIL import Image
    stop = stop_on_signals()
    lay = open_layer(target, stop)
    gw, gh = lay.pixels() or (1920, 1080)
    w, h = (gw // 3) & ~1, (gh // 3) & ~1
    edge = max(4, gw // 320)
    at = (gw - w - 2 * edge - gw // 30, gh // 18)
    c = bitwall.Controller(target).open()
    errors = [x.raw for x in c.ask(f"mirror glass every=150 size={w}x{h} "
                                   f"format=jpeg quality=85", timeout=3)
              if getattr(x, "name", None) == "error"]
    if errors:
        log(f"{target}: {errors[0]}")
    log(f"pip -> {target}: {w}x{h} at {at[0]},{at[1]}")
    while not stop.is_set() and c.state == "open":
        said = c.read(timeout=0.5)
        if not isinstance(said, Blob):
            continue
        try:
            shot = Image.open(io.BytesIO(said.data)).convert("RGB")
        except Exception:                                       # noqa: BLE001
            continue
        framed = Image.new("RGB", (w + 2 * edge, h + 2 * edge), "#" + INK)
        framed.paste(shot.resize((w, h)), (edge, edge))
        buf = io.BytesIO()
        framed.save(buf, "JPEG", quality=88)
        lay.frame(buf.getvalue(), at=at, size=framed.size, hold=1500)
    c.send("mirror glass off")
    c.close()
    lay.close()
    return 0


