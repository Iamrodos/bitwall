    after = KittyWall(r, "again")
    ok, seen = after.covers(after.box(2, 1, 4, 2), BLUE)
    assert ok, f"the ended session's picture stayed: {seen}"
    after.send(after.at(0, 0), kitty("a=p,i=7,q=2"))
    assert "error kitty i=7: no such image" in after.errors(), after.errors()
    after.close()


@kitty_clause
def a_font_change_keeps_a_picture_on_its_cells(r):
