    `cat > in` is a sender, and silence never ends it."""
    c = connected(r, "cat", pongs=False)
    c.wait(lambda h: h.count("ping") >= 2, 3 * r.t.quiet + 2)
    assert c.heard.count("ping") >= 2, c.heard
    assert not any(x.startswith("closed ") for x in c.heard), c.heard
    c.command("report id=still")
    assert c.wait(lambda h: any(x.endswith(" id=still") for x in h)), "it was ended after all"
    c.close()


