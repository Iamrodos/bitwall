@kitty_clause
def a_picture_in_chunks_is_put_together(r):
    """`m=1` on every chunk but the last: the chunks are one picture."""
    import base64
    k = KittyWall(r)
    data = base64.b64encode(png_bytes(40, 30, (255, 255, 0, 255)))
    cut = [data[:40], data[40:120], data[120:]]
    k.send(k.at(1, 1),
           b"\x1b_Ga=T,f=100,i=3,c=2,r=2,q=2,m=1;" + cut[0] + b"\x1b\\",
           b"\x1b_Gm=1;" + cut[1] + b"\x1b\\",
