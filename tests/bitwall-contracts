def _frame_rate(fake, w, seconds):
    """Frames a second on the wire, over a window past the first."""
    w.set_source(Counter())
    assert wait_for(lambda: fake.frames(), 2), "never painted"
    time.sleep(0.3)
    start = time.monotonic()
    time.sleep(seconds)
    body = fake.text(start, start + seconds)
    return body.count(RESET) / seconds


