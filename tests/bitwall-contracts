#: A sender in a process of its own, on the fake wall at argv[1]: paints
#: a film, says `attached` once the session is open, detaches on SIGTERM
#: and says how long that took.
SENDER = """
import os, signal, sys, threading, time
sys.path.insert(0, sys.argv[2])
import bitwall
w = bitwall.attach("localhost", run=sys.argv[1], min_frame=0.02)
n = [0]
def film(cols, rows):
    n[0] += 1
    return [[bitwall.cell(str(n[0] % 10), "ffffff")] * cols for _ in range(rows)]
w.set_source(film)
stop = threading.Event()
signal.signal(signal.SIGTERM, lambda *_: stop.set())
while not w.talking:
    time.sleep(0.02)
print("attached", w.session.name, flush=True)
stop.wait()
began = time.monotonic()
w.detach()
print("detached %.2f" % (time.monotonic() - began), flush=True)
"""


def a_sender_process(fake):
    """A sender started on `fake`, in a process group of its own, once it
    has said it is attached; (proc, its session's name)."""
    proc = spawn([sys.executable, "-c", SENDER, fake.dir, ROOT],
                 stdout=subprocess.PIPE, start_new_session=True)
    line = proc.stdout.readline().decode()
    assert line.startswith("attached "), f"the sender said {line!r}"
    name = line.split()[1]
    assert wait_for(lambda: fake.text(), 3), "the sender never painted"
    return proc, name


def owned_by(pid):
    """A process's children, as (pid, command line): for a sender, its
    session's writer, a bare `cat` once the shell has handed over to it,
    and its listener, whose command names the wall and the session."""
    out = subprocess.run(["ps", "-axo", "pid=,ppid=,command="],
                         capture_output=True, text=True).stdout
    kids = []
    for line in out.splitlines():
        parts = line.split(None, 2)
        if len(parts) == 3 and parts[1] == str(pid):
            kids.append((int(parts[0]), parts[2].strip()))
    return kids


def session_processes(pid):
    """Of a process's children, the ones that are a session's ends."""
    return [(p, cmd) for p, cmd in owned_by(pid)
            if cmd == "cat" or "door.in" in cmd]


def gone(pids):
    """Whether none of these processes is running any more."""
    for pid in pids:
        try:
            os.kill(pid, 0)
        except ProcessLookupError:
            continue
        return False
    return True


