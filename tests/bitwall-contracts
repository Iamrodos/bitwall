    assert "\x1b[2;3H" in raw and "38;6;0;255;0;128" in raw and "48;6;0;0;0;64" in raw, repr(raw)
    assert "\x1b[49m" in raw, f"a ground left unset came back as one: {raw!r}"
    t.write(b"\x1b[2;4H \x1b[0m")
    _, text = layer_cells(r, ctl, "t", "H X")
    assert text == "H X", "a space in the default colours is a cell drawn, transparent"
    t.command("clear")
