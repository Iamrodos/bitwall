class DataStalled(fakewall.FakeWall):
    """The fake wall holding each `data` fifo open and never reading it,
    as a wall too busy to keep up does."""

    def _read_data(self, s, now):
        return


@check
def a_layer_closes_while_a_write_on_its_data_waits_on_a_wall_that_is_not_reading():
    """Closing is how a sender stops, and a sender is stopped when the
    wall is at its busiest: a `data_write` waiting for room gives way to
    `close()` rather than holding it until the wall reads again."""
    fake = DataStalled(run_dir(), "0", 20, 4, 14, timings=T)
    layer = bitwall.layer("localhost", run=fake.dir, place=0, take=True, data=True,
                          codec="qoi", fps=20)
    try:
        assert layer.has_data, layer.stopped
        went = []
        writer = threading.Thread(target=lambda: went.append(layer.data_write(b"x" * (4 << 20))),
                                  daemon=True)
        writer.start()
        time.sleep(0.5)
        assert writer.is_alive() and not went, "the write never had to wait"
        closer = threading.Thread(target=layer.close, daemon=True)
        began = time.monotonic()
        closer.start()
        closer.join(5)
        assert not closer.is_alive(), "close() waited on the write"
        writer.join(2)
        assert went == [None], went
        assert time.monotonic() - began < 4
    finally:
        fake.remove()


