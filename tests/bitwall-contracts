@conformance(known_for=SHELL_NO_CONTROLLERS)
def a_reader_that_falls_behind_gets_the_latest_state_and_a_count(r):
    """A full `out` never holds up the wall: state lines are merged into
    the latest value, the rest dropped and counted, and `dropped <n>` is
    said before the next line that fits."""
    c = Caller(r, "slow", "controller")
    assert c.opened
    for i in range(300):
        c.command(f"report id=r{i}")
    time.sleep(0.2)
    r.resize(71, 21)
    r.resize(72, 22)
    time.sleep(0.2)
    assert c.wait(lambda h: any(x.startswith("dropped ") for x in h)
                  and any(x.startswith("area 72x22 ") for x in h), 10), \
        f"heard {len(c.heard)} lines, last {c.heard[-3:]}"
    at = next(i for i, x in enumerate(c.heard) if x.startswith("dropped "))
    assert int(c.heard[at].split()[1]) > 0, c.heard[at]
    after = [x for x in c.heard[at + 1:] if x.startswith("area ")]
    assert after and all(x.startswith("area 72x22 ") for x in after), after
    assert not any(x.startswith("area 71x21") for x in c.heard[at:]), "a stale area survived"
    assert c.heard[:2] == ["hello v1 line", "opened slow"], c.heard[:2]
    c.close()


@conformance(known_for=SHELL_NO_CONTROLLERS)
def limits_controllers_as_caps_says(r):
    """An `open` past the number of controllers `caps` gives is `full`."""
    c = Caller(r, "c0", "controller")
    c.command("report id=n")
    assert c.wait(lambda h: any(x.startswith("caps ") for x in h))
    limit = int(protocol.parse(next(x for x in c.heard if x.startswith("caps "))).opts["controllers"])
    held = [c] + [Caller(r, f"c{i}", "controller") for i in range(1, limit)]
    assert all(x.opened for x in held), [x.heard for x in held if not x.opened]
    extra = Caller(r, "c-extra", "controller")
    assert extra.refused == "full", extra.heard
    for x in held + [extra]:
        x.close()


