@conformance(known_for=NO_DATA)
def a_stream_sits_where_align_says_on_a_glass_of_another_shape(r):
    """`align top`, `centre` or `bottom` on a video layer's `in` puts its
    stream's frames against the top of a glass taller than their shape,
    in the middle, or against the bottom, from the next frame; `caps` says
    `align`, and any other word is an error."""
    caps, _ = codecs_of(r)
    assert "align" in caps, caps
    ctl = connected(r, "ctl", "controller")
    gw, gh = glass_pixels(ctl)
    v = connected(r, "v", z="above", type="video", data="1", codec="qoi")
    fd = data_in(v)
    # Far wider than any glass, so there is glass to spare above and below.
    fw, fh = 64, 4
    k = min(gw / fw, gh / fh)
    dh = max(1, round(fh * k))
    want = {"top": 0, "centre": (gh - dh) // 2, "bottom": gh - dh}
    try:
        for where in ("top", "bottom", "centre"):
            v.command(f"align {where}")
            ctl.frames, ctl.heard = [], []
            os.write(fd, qoi_frame(fw, fh, (200, 40, 40, 255)))

            seen = []

            def at_y():
                ctl.frames = []
                ctl.command(f"picture v id=p{where}")
                ctl.wait_frames(lambda f: f, 1.0)
                for words, _ in ctl.frames[-1:]:
                    at = next((w[3:] for w in words if w.startswith("at=")), None)
                    if at:
                        seen[:] = [int(at.split(",")[1])]
                return seen[0] if seen else None
            assert wait_for(lambda: at_y() == want[where], 3), \
                f"align {where}: the frame is at y={seen}, not {want[where]}, on {gw}x{gh}"
        v.heard = []
        v.command("align middle")
        assert v.wait(lambda h: any(x.startswith("error align middle") for x in h)), v.heard
    finally:
        os.close(fd)
        v.close()
        ctl.close()


@conformance(known_for=NO_DATA)
def a_stream_fills_the_box_it_is_given_and_the_glass_again_without_one(r):
    """`box at=<x>,<y> size=<w>x<h>` on a video layer's `in` fits its
    stream's frames to that box on the glass, with their shape kept and
    `align` placing them within it, from the next frame; `box` alone gives
    back the whole glass; `caps` says `box`, and a box with no size, a bad
    value or another option is an error."""
    caps, _ = codecs_of(r)
    assert "box" in caps, caps
    ctl = connected(r, "ctl", "controller")
    gw, gh = glass_pixels(ctl)
    v = connected(r, "v", z="above", type="video", data="1", codec="qoi")
    fd = data_in(v)
    fw, fh = 64, 4
    bx, by, bw, bh = gw // 4, gh // 4, gw // 2, gh // 2
    seen = []

    def placed():
        """Where a picture of the layer says its frame went, and the size
        it was drawn at."""
        ctl.frames = []
        ctl.command("picture v")
        ctl.wait_frames(lambda f: f, 1.0)
        for words, _ in ctl.frames[-1:]:
            at = next((w[3:] for w in words if w.startswith("at=")), None)
            size = next((w[5:] for w in words if w.startswith("size=")), None)
            if at:
                seen[:] = [(tuple(int(n) for n in at.split(",")),
                            tuple(int(n) for n in size.split("x")) if size else None)]
        return seen[0] if seen else None

    def fit(x, y, w, h, top=False):
        k = min(w / fw, h / fh)
        dw, dh = max(1, int(fw * k + 0.5)), max(1, int(fh * k + 0.5))
        return (x + (w - dw) // 2, y if top else y + (h - dh) // 2), (dw, dh)

    try:
        for box, want in ((f"box at={bx},{by} size={bw}x{bh}", fit(bx, by, bw, bh)),
                          ("box", fit(0, 0, gw, gh))):
            v.command(box)
            os.write(fd, qoi_frame(fw, fh, (200, 40, 40, 255)))
            assert wait_for(lambda: placed() == want, 3), \
                f"{box}: the frame is {seen}, not {want}, on {gw}x{gh}"
        v.command("align top")
        v.command(f"box at={bx},{by} size={bw}x{bh}")
        os.write(fd, qoi_frame(fw, fh, (200, 40, 40, 255)))
        want = fit(bx, by, bw, bh, top=True)
        assert wait_for(lambda: placed() == want, 3), \
            f"align top in a box: the frame is {seen}, not {want}"
        v.heard = []
        for bad in ("box at=1,2", "box size=0x5", "box over=1", "box size",
                    "box at=,5 size=10x10", "box at=1_0,5 size=10x10", "box at=+1,2 size=10x10",
                    "box at=65536,0 size=10x10"):
            v.command(bad)
        for said in ("error box no size", "error box size=0x5: bad value",
                     "error box over=1: unknown option", "error box size: unknown option",
                     "error box at=,5: bad value", "error box at=1_0,5: bad value",
                     "error box at=+1,2: bad value", "error box at=65536,0: bad value"):
            assert v.wait(lambda h: any(x.startswith(said) for x in h)), (said, v.heard)
    finally:
        os.close(fd)
        v.close()
        ctl.close()


