@kitty_clause
def one_of_c_or_r_keeps_the_pictures_shape(r):
    """`c` alone: the picture is that many columns wide and as tall as its
    shape makes it; neither: its own size in pixels."""
    k = KittyWall(r)
    # 2:1, four columns wide: half as tall as it is wide
    k.send(k.at(1, 1), kitty("a=T,f=100,i=4,c=4,q=2", png_bytes(20, 10, (255, 0, 255, 255))))
    w = 4 * k.cw
    h = round(w * 10 / 20)
    x0, y0 = k.box(1, 1, 1, 1)[:2]
    ok, seen = k.covers((x0, y0, x0 + w, y0 + h), (255, 0, 255))
    assert ok, seen
    # its own size: 10x6 pixels from the cell's corner
    k.send(k.at(8, 2), kitty("a=T,f=100,i=5,q=2", png_bytes(10, 6, (0, 255, 255, 255))))
    x0, y0 = k.box(8, 2, 1, 1)[:2]
    ok, seen = k.covers((x0, y0, x0 + 10, y0 + 6), (0, 255, 255))
    assert ok, seen
    k.close()


@kitty_clause
def a_picture_defined_is_placed_by_id_and_deleted(r):
    """`a=t` defines, `a=p` places it at the cursor, `a=d,d=I` takes it and
    its placements away and the cells show again."""
    k = KittyWall(r)
    box = k.box(3, 2, 2, 2)
    k.send(kitty("a=t,f=100,i=6,q=2", png_bytes(8, 8, (255, 0, 0, 255))))
    ok, seen = k.covers(box, BLUE)
    assert ok, f"a=t drew something: {seen}"
    k.send(k.at(3, 2), kitty("a=p,i=6,c=2,r=2,q=2"))
    ok, seen = k.covers(box, (255, 0, 0))
    assert ok, seen
    k.send(kitty("a=d,d=I,i=6,q=2"))
    ok, seen = k.covers(box, BLUE)
    assert ok, f"still drawn after d=I: {seen}"
    k.send(k.at(3, 2), kitty("a=p,i=6,c=2,r=2,q=2"))
    assert "error kitty i=6: no such image" in k.errors(), k.errors()
    k.close()


@kitty_clause
def a_sessions_pictures_go_when_it_ends(r):
    """When the session ends its images and placements go with it."""
    k = KittyWall(r)
    k.send(k.at(2, 1), kitty("a=T,f=100,i=7,c=4,r=2,q=2", png_bytes(4, 4, (255, 0, 0, 255))))
    ok, seen = k.covers(k.box(2, 1, 4, 2), (255, 0, 0))
    assert ok, seen
    k.base.command("close")
    assert k.base.wait(lambda h: any(x.startswith("closed base") for x in h)), k.base.heard
    k.base.close()
