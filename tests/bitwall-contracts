@conformance(known_for=NO_DATA)
def a_stream_is_refused_what_the_wall_cannot_take(r):
    """A codec the wall does not take, or none, is `no-such-codec`; `data`
    on a cells layer, `codec`, `fps` or `start` without `data=1`, `start`
    without `fps`, and an `fps` or a `start` that is not one, are
    `no-such-key`."""
    video = {"z": "above", "type": "video"}
    for name, opts, reason in (
            ("a", dict(video, data="1"), "no-such-codec"),
            ("b", dict(video, data="1", codec="rgba"), "no-such-codec"),
            ("c", dict(video, data="1", codec="vp9"), "no-such-codec"),
            ("d", {"z": "0", "type": "cells", "data": "1", "codec": "qoi"}, "no-such-key"),
            ("e", dict(video, codec="qoi"), "no-such-key"),
            ("f", dict(video, fps="24"), "no-such-key"),
            ("g", dict(video, start="1790000000000"), "no-such-key"),
            ("h", dict(video, data="1", codec="qoi", start="1790000000000"), "no-such-key"),
            ("i", dict(video, data="1", codec="qoi", fps="0"), "no-such-key"),
            ("j", dict(video, data="1", codec="qoi", fps="fast"), "no-such-key"),
            ("k", dict(video, data="1", codec="qoi", fps="500"), "no-such-key"),
            ("l", dict(video, data="2", codec="qoi"), "no-such-key"),
            ("m", dict(video, data="1", codec="qoi", fps="24", start="soon"), "no-such-key")):
        c = Caller(r, name, "layer", **opts)
        assert c.refused == reason, f"{opts}: heard {c.heard}"
        assert not os.path.exists(os.path.join(c.dir, "data")), f"{opts}: a data fifo was made"
        c.close()
    ok = Caller(r, "ok", "layer", **dict(video, data="1", codec="qoi", fps="23.976"))
    assert ok.opened, f"fps=23.976: heard {ok.heard}"
    ok.close()


