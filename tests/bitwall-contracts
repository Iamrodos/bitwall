class EinkReceiver(Receiver):
    """`bitwall-eink`, built with `cargo build --release`, on a file panel
    in its run directory: every push a PNG, the glass the check's cells at
    its font, the cell asked of the program itself (`--cell`). The panel's
    policy holds pushes back, but its glass is composed at once, so a
    picture of it is what the paper is about to show; a resize is a new
    glass, said on its stdin as `glass WxH`."""

    name = "eink"
    title = "the eink receiver"
    _cells = {}

    def _cell(self):
        if self.font not in self._cells:
            out = subprocess.run([EINK, "--cell", str(self.font)], capture_output=True, text=True)
            self._cells[self.font] = tuple(map(int, out.stdout.strip().split("x")))
        return self._cells[self.font]

    def _glass(self):
        cw, ch = self._cell()
        return f"{self.cols * cw}x{self.rows * ch}"

    def start(self):
        self.proc = spawn([EINK, "--panel", "file:" + os.path.join(self.run, "panel"),
                           "--glass", self._glass(), "--font", str(self.font), self.wall],
                          stdin=subprocess.PIPE, env=dict(os.environ, BITWALL_RUN=self.run),
                          start_new_session=True)
        assert wait_for(lambda: fakewall.door_has_reader(self.door), 5), \
            "the eink receiver never made its door"

    def resize(self, cols, rows):
        self.cols, self.rows = cols, rows
        self.proc.stdin.write(f"glass {self._glass()}\n".encode())
        self.proc.stdin.flush()

    def screen(self):
        """The base as it stands, read back as the painter's is."""
        self._n = getattr(self, "_n", 0)
        return PainterReceiver.screen(self)


