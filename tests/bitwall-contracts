def _comes_back(source):
    """A sender attached to a fake wall whose receiver is killed outright
    and started again: whether the wall was painted in full afterwards,
    and told again who is sending and what it asked for."""
    fake = a_fake(20, 4)
    with captured_stderr():
        with attached(fake) as w:
            w.meta(name="survivor")
            w.set_font_size(17, wait=False)
            w.want(touch=True)
            w.set_source(source)
            assert wait_for(lambda: fake.frames(), 2), "never painted"
            time.sleep(0.5)          # past the first frames: quiet, if it can be
            fake.stop()              # kill -9: nothing said, the wall left stale
            time.sleep(0.5)
            mark = time.monotonic()
            fake.start()             # the receiver back, taking its wall over
            back = wait_for(lambda: fake.full_frames(mark), 5)
            since = lambda: [m for t, m in fake.asked if t >= mark]
            named = wait_for(lambda: any(m.args[:2] == ("set", "name") for m in since())
                             and any(m.name == "font" and m.args[:1] == ("17",)
                                     for m in since())
                             and any(m.name == "want" and m.get("touch") == "1"
                                     for m in since()), 2)
            first = since()[0].name if since() else None
            live = [s.name for s in fake.live()]
            return back, named, first, live, w.session.name


