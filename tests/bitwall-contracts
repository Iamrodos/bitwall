    misses."""
    c = connected(r, "ssh", pongs=True)
    assert c.wait(lambda h: c.answered >= 1, r.t.quiet + 1), c.heard
    c.pongs = False
    assert c.wait(lambda h: "closed ssh timeout" in h, r.t.quiet + 2 * r.t.pong + 1), c.heard
    assert c.ended(2)
    c.close()


