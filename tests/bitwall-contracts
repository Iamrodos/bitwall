@conformance(known_for=SHELL_NO_PING)
def asks_a_quiet_session_and_holds_it_to_its_answer(r):
    """After five quiet seconds the wall says `ping`; a session that has
    answered once is ended on the next it leaves unanswered, and told."""
    c = connected(r, "c", pongs=False)
    assert c.wait(lambda h: "ping" in h, r.t.quiet + 1), c.heard
    c.command("pong")
    c.heard = []
    assert c.wait(lambda h: "ping" in h, r.t.quiet + r.t.pong + 1), c.heard
    assert c.wait(lambda h: "closed c timeout" in h, r.t.pong + 1), c.heard
    assert c.ended(2)
    c.close()


@conformance(known_for=SHELL_NO_ANSWERS)
def a_writer_that_never_answers_ping_stays_alive(r):
