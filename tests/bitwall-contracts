@conformance(known_for=SHELL_NO_CONTROLLERS)
def a_mirror_of_a_cells_layer_starts_whole_and_then_sends_what_changed(r):
    """`mirror <session>` of a cells layer sends its whole grid, then only
    the cells that changed; painted in order they are the layer; `mirror
    <session> off` stops it."""
    base = connected(r, "base")
    ctl = connected(r, "ctl", "controller")
    base.write("\x1b[1;1Hbefore\x1b[0m")
    time.sleep(0.3)
    ctl.command("mirror base every=100")
    assert ctl.wait_frames(lambda f: f), f"no frame came; heard {ctl.heard}"
    assert ctl.frames[0][0][:3] == ["mirror", "base", "grid"], ctl.frames[0][0]
    whole = len(ctl.frames[0][1])
    cols, rows = map(int, ctl.frames[0][0][3].split("x"))
    base.write("\x1b[2;1Hchanged\x1b[0m")
    assert ctl.wait_frames(lambda f: any(w[:3] == ["mirror", "base", "diff"] for w, _ in f)), \
        [w for w, _ in ctl.frames]
    diff = next(d for w, d in ctl.frames if w[:3] == ["mirror", "base", "diff"])
    assert len(diff) < whole, "a diff of one word is as big as the wall"
    text, _ = shown(ctl.frames, cols, rows)
    assert text[0][0].startswith("before") and text[1][0].startswith("changed"), \
        (text[0][0][:10], text[1][0][:10])
    ctl.command("mirror base off")
    ctl.idle(0.3)
    ctl.frames = []
    base.write("\x1b[3;1Hafter\x1b[0m")
    ctl.idle(0.5)
    assert not ctl.frames, "a stopped mirror went on sending"
    base.close()
    ctl.close()


