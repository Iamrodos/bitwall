@conformance(known_for=SHELL_NO_ANSWERS)
def meta_is_per_session_and_goes_with_it(r):
    """Each session's `meta` is its own; a report carries the base's; a
    value with spaces comes back whole; when the base goes, so does it."""
    base = connected(r, "base")
    ctl = connected(r, "ctl", "controller")
    base.command("meta set name The Incredibles (2004)")
    assert base.wait(lambda h: "meta set name The Incredibles (2004)" in h), base.heard
    ctl.command("meta id=c set name Control")
    assert ctl.wait(lambda h: "meta set name Control id=c" in h), ctl.heard
    ctl.command("report id=m")
    assert ctl.wait(lambda h: any(x.startswith("area ") and x.endswith(" id=m") for x in h))
    report = [x for x in ctl.heard if x.endswith(" id=m")]
    assert "meta set name The Incredibles (2004) id=m" in report, report
    assert any(x.startswith("meta age name ") for x in report), report
    assert not any("Control" in x for x in report), report
    ctl.command("meta id=n report")
    assert ctl.wait(lambda h: "meta set name Control id=n" in h), ctl.heard
    base.command("meta set Name x id=e")
    assert base.wait(lambda h: "error meta set Name: not a key id=e" in h), base.heard
    base.command("close")
    assert ctl.wait(lambda h: "session closed base asked" in h)
    ctl.command("report id=o")
    assert ctl.wait(lambda h: any(x.startswith("area ") and x.endswith(" id=o") for x in h))
    assert not any(x.startswith("meta ") and x.endswith(" id=o") for x in ctl.heard), \
        "the base's meta outlived it"
    base.close()
    ctl.close()


#: The program each receiver says keeps its wall.
PROGRAMS = {"fake": "fakewall", "shell": "bitwall-shell", "pi": "bitwall-paint",
            "web": "bitwall-web", "term": "bitwall-term", "headless": "bitwall-headless",
            "eink": "bitwall-eink"}


@conformance(known_for={"headless": HEADLESS_NO_VERSION})
def a_report_says_which_program_keeps_the_wall_and_how_its_glass_is_reached(r):
    """A report says `receiver <program> version=<v> started=<t>`, with
    `booted=<t>` where the machine says: the version is the hash of the
    program's source as `bitwall.receivers.version` works it out, and the
    times are Unix seconds, none of them to come. A wall whose glass is
    reached from elsewhere says how, `reach http port=<p> bound=<a>
    path=<p>`, and only the web receiver's is."""
    c = Caller(r, "ctl", "controller")
    c.command("report id=r1")
    assert c.wait(lambda h: any(x.startswith("area ") and x.endswith(" id=r1") for x in h))
    report = [x[:-len(" id=r1")] for x in c.heard if x.endswith(" id=r1")]
    said = [protocol.parse(x) for x in report if x.startswith("receiver ")]
    assert len(said) == 1, report
    program = PROGRAMS[r.name]
    assert said[0].args == (program,), report
    want = fakewall.VERSION if program == "fakewall" else \
        receivers.version(program) if program in receivers.SOURCES else None
    assert said[0].opts.get("version") == want, (said[0].opts, want)
    now = time.time()
    for key in ("started", "booted"):
        if key == "started" or key in said[0].opts:
            t = protocol.number(said[0].opts.get(key))
            assert t is not None and 0 < t <= now + 1, (key, said[0].opts)
    reach = [x for x in report if x.startswith("reach ")]
    if r.name == "web":
        assert reach == [f"reach http port={r.port} bound=127.0.0.1 path=/r/{r.wall}"], reach
    else:
        assert reach == [], reach
    c.close()


@conformance(known_for=SHELL_NO_VIDEO)
