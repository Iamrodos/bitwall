@kitty_clause
@alone
def what_a_wall_will_not_draw_is_refused_on_out_and_not_drawn(r):
    """Each refusal said as `error kitty i=<id>: <reason>`, and nothing of
    the picture drawn: too big, too many, does not decode, not offered, no
    such image; deleting an id never defined is nothing, and said nothing."""
    k = KittyWall(r)
    red = png_bytes(4, 4, (255, 0, 0, 255))
    box = k.box(2, 1, 2, 2)
    # past 4096 pixels
    k.send(k.at(2, 1), kitty("a=T,f=100,i=10,c=2,r=2,q=2", png_bytes(4097, 1, (255, 0, 0, 255))))
    # received past 16 MB, in chunks
    import base64
    chunk = base64.b64encode(b"\0" * (300 << 10))
    strings = [b"\x1b_Ga=T,f=24,s=4096,v=4096,i=11,q=2,m=1;" + chunk + b"\x1b\\"]
    strings += [b"\x1b_Gm=1;" + chunk + b"\x1b\\"] * 56
    strings += [b"\x1b_Gm=0;" + chunk + b"\x1b\\"]
    k.send(k.at(2, 1), *strings)
    # does not decode
    k.send(k.at(2, 1), kitty("a=T,f=100,i=12,c=2,r=2,q=2", b"not a png at all"))
    k.send(k.at(2, 1), kitty("a=T,f=24,s=4,v=4,i=13,c=2,r=2,q=2", b"\xff" * 47))
    # not offered
    k.send(k.at(2, 1), b"\x1b_Ga=T,t=f,f=100,i=14,c=2,r=2,q=2;"
           + base64.b64encode(b"/etc/passwd") + b"\x1b\\")
    # no such image, and a delete of one that never was
    k.send(kitty("a=d,d=I,i=77,q=2"), k.at(2, 1), kitty("a=p,i=15,c=2,r=2,q=2"))
    said = k.errors()
    for want in ("error kitty i=10: too big", "error kitty i=11: too big",
                 "error kitty i=12: does not decode", "error kitty i=13: does not decode",
                 "error kitty i=14: not offered", "error kitty i=15: no such image"):
        assert want in said, (want, said)
    assert not any("i=77" in x for x in said), said
    ok, seen = k.covers(box, BLUE)
    assert ok, f"a refused picture was drawn: {seen}"
    # too many: a 33rd image, and a 65th placement
    k.send(*[kitty(f"a=t,f=24,s=1,v=1,i={100 + n},q=2", b"\xff\0\0") for n in range(33)])
    assert "error kitty i=132: too many" in k.errors(), k.errors()
    assert not any(f"i={100 + n}:" in x for x in k.errors() for n in range(32)), k.errors()
    k.send(*[kitty("a=p,i=100,c=1,r=1,C=1,q=2") for _ in range(65)])
    assert k.errors().count("error kitty i=100: too many") == 1, k.errors()
    k.close()


@check
def a_tab_opened_after_a_picture_was_placed_shows_it():
    """A web wall hands a tab joining late its kitty pictures and their
    placements, as it hands it the cells: the second tab draws the picture
    over the same cells as the first."""
    r = next((x for x in RECEIVERS if x.name == "web"), None)
    if r is None:
        return "no Chrome here"
    with r.running():
        k = KittyWall(r)
        k.send(k.at(2, 1), kitty("a=T,f=100,i=1,c=4,r=2,q=2", png_bytes(10, 10, (255, 0, 0, 255))))
        ok, seen = k.covers(k.box(2, 1, 4, 2), (255, 0, 0))
        assert ok, seen
        late = Chrome.get().tab(f"http://127.0.0.1:{r.port}/r/{r.wall}", *r.page.eval(
            "[innerWidth, innerHeight]"))
        try:
            look = (
                "(function(e){ if (!e || !e.cols || e.held) return null;"
                " var d = e.dpr, x0 = Math.round((e.ox + 2 * e.cw) * d),"
                " y0 = Math.round((e.oy + e.chh) * d), x1 = Math.round((e.ox + 6 * e.cw) * d),"
                " y1 = Math.round((e.oy + 3 * e.chh) * d), g = e.ctx;"
                " function at(x, y) { var p = g.getImageData(x, y, 1, 1).data;"
                " return [p[0], p[1], p[2]]; }"
                " return [[at(x0, y0), at(x1 - 1, y0), at(x0, y1 - 1), at(x1 - 1, y1 - 1)],"
                " [at(x0 - 1, y0), at(x1, y0), at(x0, y0 - 1), at(x0, y1)]]; })"
                f"({WebReceiver.SEL})")

            def shows():
                got = late.eval(look)
                return got if got and all(near(c, (255, 0, 0)) for c in got[0]) \
                    and all(near(c, BLUE) for c in got[1]) else None
            assert wait_for(shows, 5), f"the late tab does not show it: {late.eval(look)}"
        finally:
            Chrome.get().close_tab(late)
        k.close()


@check
def a_web_wall_follows_a_dragged_corner_with_one_repaint():
    """A web wall's pixels: the tab says its box once a
    resize has settled, so a corner dragged through several sizes is one
    new glass: the base hears one new area and one `repaint`, and a video
    layer is taken down and told `repaint` once."""
    r = next((x for x in RECEIVERS if x.name == "web"), None)
    if r is None:
        return "no Chrome here"
    with r.running():
        base = connected(r, "base")
        v = connected(r, "v", z="above", type="video")
        v.write(frame_bytes(qoi_frame(), "hold=60000"))
        assert answers(v, "a") and video_up(r), v.heard
        base.heard, v.heard = [], []
        for step in range(1, 6):
            cw, ch = r.area()[3]
            r.page.resize((r.cols + step) * cw, (r.rows + step) * ch)
            time.sleep(0.05)
        base.idle(1.0)
        v.idle(0.2)
        areas = [x for x in base.heard if x.startswith("area ")]
        assert len(areas) == 1 and area_of(areas[0])[:2] == (r.cols + 5, r.rows + 5), base.heard
        assert base.heard.count("repaint") == 1, base.heard
        assert v.heard.count("repaint") == 1, v.heard
        assert not video_up(r), "the layer outlived the glass it was drawn for"
        base.close()
        v.close()


@check
def a_layer_draws_over_the_base_without_taking_it():
    """`Wall.layer()` opens a video layer beside the sender's own base,
    which keeps the wall; its frames reach the wall, a frame the pipe
    cannot take now is dropped rather than queued, and `close()` takes the
    layer down."""
    fake = a_fake(20, 4)
