CACHE = os.path.join(os.path.expanduser("~"), ".cache", "bitwall-tests")


def _build_painter():
    """The Pi painter, built against the fakes in tests/paint/stub so it
    runs here as a real doors-speaking process with no glass behind it, or
    None where there is no C compiler.

    Kept in CACHE under a hash of everything that goes into it -- the
    sources, the fakes, the compiler and its flags -- so a run whose
    painter has not changed, and every worker of a run, starts at once."""
    cc = os.environ.get("CC") or shutil.which("cc") or shutil.which("clang") \
        or shutil.which("gcc")
    if not cc or not shutil.which(cc.split()[0]):
        return None
    stub = os.path.join(HERE, "paint", "stub")
    png = subprocess.run(["pkg-config", "--cflags", "--libs", "libpng"],
                         capture_output=True, text=True) \
        if shutil.which("pkg-config") else None
    png = png.stdout.split() if png and png.returncode == 0 else ["-lpng"]
    jpeg = subprocess.run(["pkg-config", "--cflags", "--libs", "libjpeg"],
                          capture_output=True, text=True) \
        if shutil.which("pkg-config") else None
    if jpeg and jpeg.returncode == 0:
        png += ["-DBITWALL_JPEG", *jpeg.stdout.split()]
    argv = [cc, "-std=c99", "-O1", "-w", "-I" + stub,
            f'-DBITWALL_VERSION="{receivers.version("bitwall-paint")}"', PAINT_C,
            os.path.join(stub, "fake.c"), *png, "-pthread"]
    h = hashlib.sha256("\0".join(argv).encode())
    for path in [PAINT_C, os.path.join(os.path.dirname(PAINT_C), "qoi.h")] + sorted(
            os.path.join(stub, n) for n in os.listdir(stub)):
        with open(path, "rb") as fh:
            h.update(fh.read())
    exe = os.path.join(CACHE, f"paint-{h.hexdigest()[:16]}", "bitwall-paint")
    if os.access(exe, os.X_OK):
        return exe
    os.makedirs(os.path.dirname(exe), exist_ok=True)
    building = f"{exe}.{os.getpid()}"
    built = subprocess.run(argv + ["-o", building], capture_output=True, text=True)
    if built.returncode != 0:
        print("  note  the painter did not build for the contracts:\n"
              + "\n".join(built.stderr.splitlines()[:6]))
        return None
    os.replace(building, exe)
    return exe


def _build_gpu_painter():
    """The painter as `make PLATFORM=<this machine>` builds it, on the real
    GPU (tests/gpupainter.py), or None where it does not build here."""
    try:
        return gpupainter.build()
    except RuntimeError as e:
        print(f"  note  {e}")
        return None


