# ------------------------------------------------ receivers: kitty graphics
#
# PROTOCOL.md, "A grid may carry kitty graphics": what a receiver that draws
# them itself draws, the painter and the web receiver alike. The fake wall
# and the shell receiver draw none of their own and are not held to it.
# The painter paints in software for these, since its fake GPU reads back
# black.

BLUE = (0, 0, 255)


def kitty_clause(fn=None, known_for=None):
    """One check per receiver that draws kitty graphics itself; `known_for`
    as `conformance` has it."""
    if fn is None:
        return lambda f: kitty_clause(f, known_for)
    for r in RECEIVERS:
        if r.name not in ("pi", "web", "eink"):
            continue

        def one(r=r):
            with r.running():
                if r.name == "pi":
                    r.software = True
                    r.restart()
                return fn(r)
        one.__name__ = f"{r.title} {fn.__name__}".replace(" ", "_")
        one.__doc__ = fn.__doc__
        one.alone = getattr(fn, "alone", False)
        if r.name in (known_for or {}):
            one.known = known_for[r.name]
        _checks.append(one)
    return fn


@kitty_clause(known_for={"eink": EINK_GREYS})
def a_frame_with_a_size_is_drawn_to_its_box(r):
    """`size=<w>x<h>` scales a frame to that box on the glass, its top
    left at `at`: a picture of the glass shows it filling the box and
    nothing past it."""
    from PIL import Image
    v = connected(r, "v", z=1, type="video")
    ctl = connected(r, "ctl", "controller")
    pw, ph = glass_pixels(ctl)
    for codec in [c for c in ("qoi", "png", "jpeg") if c in images_said(v)]:
        frame = (qoi_frame(2, 2, (255, 0, 0, 255)) if codec == "qoi"
                 else image_frame(codec, 2, 2))
        v.write(any_frame_bytes(codec, frame, "at=20,10 size=40x30 hold=5000"))
        assert answers(v, f"s{codec}"), v.heard
        assert not [x for x in v.heard if x.startswith("error")], v.heard
        time.sleep(0.3)
        ctl.frames.clear()
        ctl.command(f"picture glass id=g{codec}")
        assert ctl.wait_frames(lambda f: f, 4), f"no picture; heard {ctl.heard}"
        img = Image.open(io.BytesIO(ctl.frames[0][1])).convert("RGB")
        assert img.size == (pw, ph), img.size
        for x, y in ((22, 12), (40, 25), (57, 37)):
            red, g, b = img.getpixel((x, y))
            assert red > 200 and g < 60 and b < 60, f"{codec}: {(x, y)} is {(red, g, b)}"
        for x, y in ((64, 25), (40, 44)):
            red, g, b = img.getpixel((x, y))
            assert not (red > 200 and g < 60 and b < 60), \
                f"{codec}: drawn past its box at {(x, y)}"
    v.close()
    ctl.close()


def png_bytes(w, h, rgba):
    import io
    from PIL import Image
    out = io.BytesIO()
    Image.new("RGBA", (w, h), rgba).save(out, "PNG")
    return out.getvalue()


def kitty(keys, data=b""):
    """One kitty string, `ESC _G <keys> ; <base64> ESC \\`."""
    import base64
    return (f"\x1b_G{keys};".encode() + base64.b64encode(data) + b"\x1b\\")


class KittyWall:
    """A base painting the whole grid blue, and a controller looking at
    the glass: where a cell is on it, and the colour of a pixel there.

    On a glass of greys (`colour=grey`) a colour cannot be told from
    another, and a picture is dithered onto the greys, so a box is covered
    where every pixel in it differs from the blue ground's grey, as it
    shows, and every pixel round it is that grey."""

    def __init__(self, r, name="base"):
        self.r = r
        self.base = connected(r, name, z=0, type="cells")
        self.ctl = connected(r, "ctl-" + name, "controller")
        self.n = 0
        self.measure()
        self.paint()

    def measure(self):
        self.ctl.heard = []
        self.ctl.command("report id=m")
        assert self.ctl.wait(lambda h: (self.base.pump(), 1)[1]
                             and any(x.startswith("screen ") for x in h)
                             and any(x.startswith("area ") and x.endswith("id=m") for x in h)), \
            self.ctl.heard
        screen = protocol.parse(next(x for x in self.ctl.heard if x.startswith("screen ")))
        area = next(x for x in self.ctl.heard if x.startswith("area ") and x.endswith("id=m"))
        self.cols, self.rows, self.font = area_of(area)
        self.pw, self.ph = map(int, screen.opts["pixels"].split("x"))
        self.cw, self.ch = map(int, screen.opts["cell"].split("x"))
        self.grey = screen.opts.get("colour") == "grey"
        self.ground = None
        self.ox = max(0, (self.pw - self.cols * self.cw) // 2)
        self.oy = max(0, (self.ph - self.rows * self.ch) // 2)

    def paint(self):
        rows = "".join(f"\x1b[{y + 1};1H\x1b[48;2;0;0;255m" + " " * self.cols
                       for y in range(self.rows))
        self.base.write(rows + RESET)

    def send(self, *strings):
        """Kitty strings, then a command whose answer says they were read."""
        self.n += 1
        self.base.write(b"".join(strings))
        self.base.command(f"report id=k{self.n}")
        assert self.base.wait(lambda h: (self.ctl.pump(), 1)[1]
                              and any(x.endswith(f"id=k{self.n}") for x in h), 5), \
            self.base.heard

    def errors(self):
        return [x for x in self.base.heard if x.startswith(("error kitty", "kitty "))]

    def glass(self):
        import io
        from PIL import Image
        self.n += 1
        self.ctl.frames = []
        self.ctl.command(f"picture glass id=g{self.n}")
        # the base answers its pings meanwhile, or it is ended as silent
        assert self.ctl.wait_frames(lambda f: (self.base.pump(), f)[1], 4), \
            f"no picture; heard {self.ctl.heard}"
        return Image.open(io.BytesIO(self.ctl.frames[0][1])).convert("RGB")

    def box(self, col, row, cols, rows):
        """A rectangle of cells in glass pixels: x0, y0, x1, y1, exclusive."""
        x0, y0 = self.ox + col * self.cw, self.oy + row * self.ch
        return x0, y0, x0 + cols * self.cw, y0 + rows * self.ch

    def covers(self, box, colour, img=None):
        """Whether `colour` fills the pixel box and stops at its edges."""
        img = img or self.glass()
        x0, y0, x1, y1 = box
        if self.grey and self.ground is None:
            self.ground = img.getpixel((self.ox + self.cw // 2, self.oy + self.ch // 2))
        inside = [(x0, y0), (x1 - 1, y0), (x0, y1 - 1), (x1 - 1, y1 - 1),
                  ((x0 + x1) // 2, (y0 + y1) // 2)]
        outside = [(x0 - 1, y0), (x1, y0), (x0, y0 - 1), (x0, y1),
                   (x1 - 1, y1), (x1, y1 - 1)]
        got_in = [img.getpixel(p) for p in inside]
        got_out = [img.getpixel(p) for p in outside
                   if 0 <= p[0] < img.width and 0 <= p[1] < img.height]
        if self.grey:
            blue = self.ground
            if colour == BLUE:
                return (all(near(c, blue) for c in got_in + got_out)), (got_in, got_out)
            return (all(not near(c, blue) for c in got_in)
                    and all(near(c, blue) for c in got_out)), (got_in, got_out)
        return (all(near(c, colour) for c in got_in)
                and all(near(c, BLUE) for c in got_out)), (got_in, got_out)

    def at(self, col, row):
        return f"\x1b[{row + 1};{col + 1}H".encode()

    def close(self):
        self.base.close()
        self.ctl.close()


def near(a, b, slack=8):
    return all(abs(x - y) <= slack for x, y in zip(a, b))


@kitty_clause
def caps_says_kitty_where_the_grid_draws_it(r):
