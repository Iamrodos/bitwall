    knock(r.door, "open a layer")
    time.sleep(0.3)
    made = sorted(os.listdir(os.path.join(r.wall_dir, "s")))
    assert made == ["a"], f"a dropped request made something: {made}"
    a.command("report id=k")
    assert a.wait(lambda h: any(x.endswith(" id=k") for x in h)), "the holder stopped answering"
    assert not any(x == "hello v1 line" or x.startswith(("opened", "error open", "closed"))
                   for x in a.heard), f"the holder heard of the request: {a.heard}"
    a.close()


@conformance()
def refuses_a_key_role_or_type_it_does_not_take(r):
    """`hello` and then `error open <name> <reason>`, with the fixed
    words; the directory goes once the refusal is read, and the name
    is free again."""
    cases = [("layer", {"colour": "1"}, "no-such-key"),
             ("layer", {"type": "mono"}, "no-such-type"),
             ("layer", {"z": "99"}, "full"),
             ("layer", {"z": "any"}, "no-such-key"),
             ("controller", {"z": "0"}, "no-such-key"),
             ("painter", {}, "no-such-role"),
             ("", {}, "no-such-role")]
    for role, opts, reason in cases:
        c = Caller(r, "x", role, **opts)
        assert not c.dropped, f"{role} {opts}: dropped"
        assert c.heard[:1] == ["hello v1 line"], f"{role} {opts}: heard {c.heard}"
        assert c.refused == reason, f"{role} {opts}: heard {c.heard}"
        assert c.ended(r.t.keep + 1), f"{role} {opts}: out did not end"
        c.close()
        assert wait_for(lambda: not os.path.exists(c.dir), r.t.keep + 1), \
            f"{role} {opts}: the refused session's directory stayed"
    c = Caller(r, "x", "layer")
    assert c.opened, f"the name was not freed: {c.heard}"
    c.close()


@conformance()
def a_refused_name_is_in_use_until_its_directory_goes(r):
    """Asking again under a refused name before its directory has gone
    is dropped, and what a caller finds under that name is the refusal
    nobody read; once that is read the directory goes and the name is
    free."""
    knock(r.door, "open y painter")
    out = os.path.join(r.wall_dir, "s", "y", "out")
    assert wait_for(lambda: os.path.exists(out), 2), "the refusal was not made"
    knock(r.door, "open y layer")
    time.sleep(0.2)                     # both requests taken, nothing read
    heard = heard_on(out, 0.2)
    assert heard[:2] == ["hello v1 line", "error open y no-such-role"], heard
    assert not any(x.startswith("opened") for x in heard), f"a name in use was opened: {heard}"
    assert wait_for(lambda: not os.path.exists(out), r.t.keep + 1), \
        "the refused directory stayed after it was read"
    e = Caller(r, "y", "layer")
    assert e.opened, f"the name was not freed: {e.heard}"
    e.close()


@conformance(known_for=SHELL_NO_CONTROLLERS)
def takes_requests_from_several_writers_at_once(r):
    """Requests from writers at the door together are each taken whole,
    and each answered on its own session."""
    got = {}

    def one(i):
        got[i] = Caller(r, f"w{i}", "controller")
    threads = [threading.Thread(target=one, args=(i,)) for i in range(6)]
    for t in threads:
        t.start()
    for t in threads:
        t.join()
    for i, c in got.items():
        assert c.opened, f"w{i} heard {c.heard}"
        assert c.heard[:2] == ["hello v1 line", f"opened w{i}"], c.heard
        c.close()


@conformance()
def two_opens_racing_for_one_name_open_one_session(r):
    """Whichever request lands first has the name; the rest are dropped,
    and the one session hears one `opened` and no refusal."""
    threads = [threading.Thread(target=knock, args=(r.door, "open racer layer"))
               for _ in range(6)]
    for t in threads:
        t.start()
    for t in threads:
        t.join()
    out = os.path.join(r.wall_dir, "s", "racer", "out")
    assert wait_for(lambda: os.path.exists(out), 2), "no session was opened"
    lines = heard_on(out, 0.5)
    assert lines.count("opened racer z=0") == 1, lines
    assert not any(x.startswith("error open") for x in lines), lines
    assert os.listdir(os.path.join(r.wall_dir, "s")) == ["racer"]


