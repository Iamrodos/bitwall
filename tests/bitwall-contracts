@check
@known("screen.py ends a frame only on `ESC[m`; the bare `ESC[0m` serialise "
       "writes is read as a pen reset, so nothing is ever presented")
def the_pi_python_painter_presents_only_whole_frames():
    """`screen.py` presents on the delimiter, never on a piece of a frame."""
    s, why = _screen_py()
    if s is None:
        return why
    try:
        cols, rows = 20, 6
        whole = frame(cols, rows, "H4LF").encode()
        s.write(frame(cols, rows, "warm").encode())
        assert s.frames == 1, f"a whole frame presented {s.frames} times"
        cut = whole.index(b"H4LF") + 20
        s.write(whole[:cut])
        assert s.frames == 1, "half a frame was presented"
        s.write(whole[cut:])
        assert s.frames == 2, "the rest of the frame never presented"
    finally:
        s.close()


@check
@known("screen.py decodes each write on its own, so a glyph the pipe cut "
       "becomes U+FFFD")
def the_pi_python_painter_holds_a_glyph_cut_by_the_pipe():
    """What reaches a cell is the character that was sent, however cut."""
    s, why = _screen_py()
    if s is None:
        return why
    drawn = []
    real = s.run
    s.run = lambda text: (drawn.append(text), real(text))[1]
    try:
        raw = "\x1b[1;1H▀█⣿\x1b[0m".encode()
        cut = raw.index("█".encode()) + 1
        s.write(raw[:cut])
        s.write(raw[cut:])
        text = "".join(drawn)
        assert "�" not in text, f"drew {text!r}"
        assert "▀█⣿" in text, f"drew {text!r}"
    finally:
        s.close()


