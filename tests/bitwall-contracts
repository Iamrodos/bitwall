@conformance(known_for=dict(SHELL_NO_CONTROLLERS, term=TERM_NO_VIDEO))
def measures_sends_a_line_of_every_measure_on_its_own_clock(r):
    """`measures <ms>` is a `measure` line that often, to that controller
    alone, for the glass and the painter, and after it a line for each
    session, layers and controllers alike; `measures 0` stops it."""
    base = connected(r, "base", z=0)
    v = connected(r, "v", z="above", type="video")
    v.write(frame_bytes(qoi_frame(), "at=1,1 hold=5000"))
    ctl = connected(r, "ctl", "controller")
    other = connected(r, "other", "controller")
    ctl.command("measures 200")
    assert ctl.wait(lambda h: sum(x.startswith("measure ") and " session=" not in x
                                  for x in h) >= 2, 3), ctl.heard
    walls = [x for x in ctl.heard if x.startswith("measure ") and " session=" not in x]
    keys = [w.split("=", 1)[0] for w in walls[-1].split()[1:]]
    for k in ("wall", "grid", "font", "fps", "in", "out", "display"):
        assert k in keys, f"{k} missing from {walls[-1]}"
    for k in ("sender", "quiet", "pong", "inbox"):
        assert k not in keys, f"{k} is still on the wall's line: {walls[-1]}"
    lines = {}
    for x in ctl.heard:
        if x.startswith("measure ") and " session=" in x:
            kv = dict(w.split("=", 1) for w in x.split()[1:])
            lines[kv["session"]] = kv
    assert {"base", "ctl", "other"} <= set(lines), lines.keys()
    for name, kv in lines.items():
        for k in ("wall", "role", "fps", "in", "out", "dropped", "queue", "quiet", "pong"):
            assert k in kv, f"{k} missing from {name}'s line: {kv}"
    assert (lines["base"]["role"], lines["base"]["z"], lines["base"]["type"]) == \
        ("layer", "0", "cells"), lines["base"]
    assert lines["ctl"]["role"] == "controller" and lines["ctl"]["fps"] == "-" \
        and "z" not in lines["ctl"], lines["ctl"]
    assert (lines["v"]["z"], lines["v"]["type"]) == ("1", "video") \
        and "decode" in lines["v"], lines["v"]
    base.close()
    v.close()
    ctl.command("measures 0")
    ctl.idle(0.3)
    ctl.heard = []
    ctl.idle(0.5)
    assert not any(x.startswith("measure ") for x in ctl.heard), "it went on measuring"
    other.pump()
    assert not any(x.startswith("measure ") for x in other.heard), "another controller heard it"
    ctl.close()
    other.close()


def qoi_size(data):
    """(w, h) of a QOI image, or None if it is not one."""
    if len(data) < 22 or data[:4] != b"qoif" or data[-8:] != b"\0" * 7 + b"\1":
        return None
    return int.from_bytes(data[4:8], "big"), int.from_bytes(data[8:12], "big")


def fitted(glass, size):
    """The size a glass picture asked for at `size` comes back at: fitted
    inside it with the glass's shape, and never larger than the glass."""
    (gw, gh), (w, h) = glass, size
    if w >= gw and h >= gh:
        return gw, gh
    if gw * h <= gh * w:
        return max(1, (gw * h + gh // 2) // gh), h
    return w, max(1, (gh * w + gw // 2) // gw)


def no_glass(r, c):
    """Why a check of the glass cannot run on this wall, or None: a wall
    whose `pictures` names no `qoi` makes no picture of its glass, as a
    terminal that never sees its pixels does (PROTOCOL.md, "picture is the
    wall as it stands"). A wall that says no `pictures` at all is asked."""
    c.command("report id=gl")
    assert c.wait(lambda h: any(x.startswith("area ") and x.endswith(" id=gl") for x in h)), c.heard
    said = next((x for x in c.heard if x.startswith("pictures ") and x.endswith(" id=gl")), None)
    if said is not None and "qoi" not in said.split()[1:-1]:
        return f"skipped: {r.name} makes no picture of its glass"
    return None


def glass_pixels(c):
    """The glass's pixels, as its `screen` line says them."""
    c.command("report id=px")
    assert c.wait(lambda h: any(x.startswith("screen ") for x in h)), c.heard
    line = next(x for x in c.heard if x.startswith("screen "))
    w, h = protocol.parse(line).opts["pixels"].split("x")
    return int(w), int(h)


@conformance(known_for=dict(SHELL_NO_CONTROLLERS, term=
    "picture glass size=0x5 on a wall with no glass is `glass: not offered`, the check wants "
    "`bad size`: PROTOCOL.md does not say which a wall checks first"))
def a_picture_of_a_cells_layer_is_its_grid_to_whoever_asks(r):
    """`picture <session>` of a cells layer is its grid as a sender would
    write it: a line with the session, the format, the grid's size and a
    byte count, then those bytes, to the asker alone. Any session may ask."""
    base = connected(r, "base")
    ctl = connected(r, "ctl", "controller")
    base.write("\x1b[1;1H\x1b[38;2;200;10;10mhello\x1b[0m\x1b[3;5Hworld\x1b[0m")
    time.sleep(0.3)
    ctl.command("picture base id=a")
    assert ctl.wait_frames(lambda f: f), f"no picture came; heard {ctl.heard}"
    words, data = ctl.frames[0]
    assert words[:3] == ["picture", "base", "grid"] and words[-1] == "id=a", words
    cols, rows = map(int, words[3].split("x"))
    assert int(words[4]) == len(data) and data.endswith(b"\x1b[0m"), words
    text, grid = shown(ctl.frames, cols, rows)
    assert text[0][0].startswith("hello"), text[0][0][:20]
    assert text[2][0][4:9] == "world", text[2][0][:20]
    assert grid[0][0][1] == "c80a0a", grid[0][0]
    base.pump()
    assert not base.frames, "the base was sent the picture"
    base.command("picture base id=b")
    assert base.wait_frames(lambda f: f), f"the base could not ask; heard {base.heard}"
    assert base.frames[0][0][:3] == ["picture", "base", "grid"], base.frames[0][0]
    for ask, said in (("picture", "error picture no target"),
                      ("picture nobody", "error picture nobody: no such session"),
                      ("picture ctl", "error picture ctl: not a layer"),
                      ("picture grid", "error picture grid: no such session"),
                      ("picture base size=8x8", "error picture base size=8x8: only for the glass"),
                      ("picture glass size=0x5", "error picture size=0x5: bad size"),
                      ("picture glass soon", "error picture soon: unknown option")):
        ctl.command(ask)
        assert ctl.wait(lambda h: said in h), f"{ask}: heard {ctl.heard}"
    base.close()
    ctl.close()


@conformance(known_for=SHELL_NO_CONTROLLERS)
def a_picture_of_the_glass_is_qoi_at_its_own_size_or_the_size_asked(r):
