@check
def the_shell_receiver_paints_the_base_and_displaces_it_on_take():
    """What it keeps without reading a command: the base's bytes reach
    the terminal; a second base is `busy`, and with `take=1` the holder
    is told `closed <name> displaced` and its `out` ends; a base whose
    writer is killed once it has written is `closed <name> eof`, and the
    wall is free for the next `open`."""
    r = next(x for x in RECEIVERS if x.name == "shell")
    with r.running():
        a = Caller(r, "a", "layer", z=0, type="cells")
        assert a.opened and f"area {r.cols}x{r.rows} {r.font}" in a.heard[:4], a.heard
        a.write(frame(r.cols, r.rows, "WARM"))
        assert r.shows("WARM"), "the base's frame did not reach the terminal"
        b = Caller(r, "b", "layer", z=0)
        assert b.refused == "busy", b.heard
        c = Caller(r, "c", "layer", z=0, type="cells", take="1")
        assert c.opened, c.heard
        assert a.wait(lambda h: "closed a displaced" in h), a.heard
        assert a.ended(2), "the displaced session's out did not end"
        proc = spawn(["sh", "-c", f"exec cat > {shlex.quote(os.path.join(c.dir, 'in'))}"],
                     stdin=subprocess.PIPE)
        cool = frame(r.cols, r.rows, "COOL")
        proc.stdin.write(cool.encode() if isinstance(cool, str) else cool)
        proc.stdin.flush()
        assert r.shows("COOL"), "the new base's frame did not reach the terminal"
        proc.send_signal(signal.SIGKILL)
        proc.wait(3)
        assert c.wait(lambda h: "closed c eof" in h), c.heard
        assert c.ended(2), "out did not end after closed"
        assert wait_for(lambda: not os.path.exists(c.dir), 2), "the session's directory stayed"
        d = Caller(r, "d", "layer")
        assert d.opened, f"the wall was not freed: {d.heard}"
        for x in (a, b, c, d):
            x.close()


def conformance(known_for=None):
    """One check per receiver, named for it, from one clause.

    `known_for` maps a receiver's name to the reason that receiver is
    known not to keep this clause.
    """
    known_for = known_for or {}

    def make(fn):
        for r in RECEIVERS:
            def one(r=r):
                with r.running():
                    return fn(r)
            one.__name__ = f"{r.title} {fn.__name__}".replace(" ", "_")
            one.__doc__ = fn.__doc__
            one.alone = getattr(fn, "alone", False)
            if r.name in known_for:
                one.known = known_for[r.name]
            _checks.append(one)
        return fn
    return make


# ----------------------------------------------- receivers: at the door
#
# PROTOCOL.md's receiver side, driven at the fifos: a caller knocks at
# `door.in`, reads its own `out` and writes its own `in`, as the library
# and a controller will. Clocks are the receiver's, `r.t`, so a check
# waits for what the receiver takes and no longer.

def knock(door, line):
    """One request at a door, in one write, as a caller makes it. Fails
    at once when nothing reads the door, which is how a dead wall is
    told from a live one."""
    try:
        fd = os.open(door, os.O_WRONLY | os.O_NONBLOCK)
    except OSError as e:
        raise AssertionError(f"nothing reads {door}: {e.strerror}")
    try:
        os.write(fd, (line + "\n").encode())
    finally:
        os.close(fd)


_BLOB = re.compile(rb"^(picture|mirror) ")


class Caller:
    """A session as its caller has it: `open` written at the door, `out`
    read once it appears, `in` written to.

    `heard` is every line `out` said, in order; a picture or a mirror
    frame is taken off the stream into `frames`, header and bytes. `eof`
    is whether `out` has ended. A request nothing answered within `wait`
    is `dropped`; one the wall refused has `refused` set to the reason.
    A caller answers the wall's `ping` while it is pumped, unless told
    not to with `pongs=False`.
    """

    def __init__(self, r, name, role="layer", wait=2.0, pongs=True, **opts):
        self.r, self.name, self.pongs = r, name, pongs
        self.dir = os.path.join(r.wall_dir, "s", name)
        self.fd = self.writer = None
        self.heard, self.frames, self.buf, self.eof = [], [], b"", False
        #: Whether `out` has ever said anything, which `heard` cannot
        #: say once it has been emptied.
        self.spoke = False
        self.answered = 0
        words = ["open", name, role] + [f"{k}={v}" for k, v in opts.items()]
        knock(r.door, " ".join(words).rstrip())
        out = os.path.join(self.dir, "out")
        self.dropped = not wait_for(lambda: os.path.exists(out), wait)
        self.refused = self.opened = None
        if self.dropped:
            return
        self.fd = os.open(out, os.O_RDONLY | os.O_NONBLOCK)
        # The answer, `hello` and then `opened` or the refusal, is given
        # longer than the request: a receiver under load has made the
        # session but not yet said so, and the wait ends when it has.
        self.wait(lambda h: len(h) >= 2, max(wait, 5.0))
        self.refused = next((x.split()[3] for x in self.heard
                             if x.startswith(f"error open {name} ")), None)
        self.opened = any(x == f"opened {name}" or x.startswith(f"opened {name} ")
                          for x in self.heard)
        #: The layer the wall gave, from `opened <name> z=<n>`.
        self.z = next((x.split()[2][2:] for x in self.heard
                       if x.startswith(f"opened {name} z=")), None)

    def write(self, data):
        if self.writer is None:
            self.writer = open_writer(os.path.join(self.dir, "in"), 1.0)
        os.write(self.writer, data.encode() if isinstance(data, str) else data)

    def command(self, text):
        """One command, written whole, as `bitwall <text>` in an APC."""
        self.write(protocol.APC + protocol.MARK + " " + text + protocol.ST)

    def pump(self):
        if self.fd is None or self.eof:
            return
        while True:
            try:
                data = os.read(self.fd, 1 << 20)
            except BlockingIOError:
                break
            if not data:
                # Nothing read yet is nobody writing yet, not an ending:
                # the receiver makes `out` and opens its end a moment
                # later, and a read in between finds no writer.
                if self.spoke:
                    self.eof = True
                break
            self.spoke = True
            self.buf += data
        while b"\n" in self.buf:
            line, rest = self.buf.split(b"\n", 1)
            words = line.decode("utf-8", "replace").split()
            size = next((int(w) for w in reversed(words) if w.isdigit()), None)
            if _BLOB.match(line) and size is not None:
                if len(rest) < size:
                    break
                self.frames.append((words, rest[:size]))
                self.buf = rest[size:]
                continue
            self.buf = rest
            text = line.decode("utf-8", "replace")
            self.heard.append(text)
            if text == "ping" and self.pongs:
                self.answered += 1
                # A session the wall has ended has nobody reading `in`.
                with contextlib.suppress(OSError, AssertionError):
                    self.command("pong")

    def idle(self, seconds):
        """Wait, listening: pings are answered meanwhile."""
        self.wait(lambda h: False, seconds)

    def wait(self, test, timeout=2.0):
        """Listen until `test(heard)` is true or the time is up."""
        until = time.monotonic() + timeout
        while True:
            self.pump()
            if test(self.heard) or time.monotonic() >= until:
                return test(self.heard)
            time.sleep(0.02)

    def wait_frames(self, test, timeout=2.0):
        until = time.monotonic() + timeout
        while True:
            self.pump()
            if test(self.frames) or time.monotonic() >= until:
                return test(self.frames)
            time.sleep(0.02)

    def ended(self, timeout=2.0):
        """Whether `out` reached end of file within the time."""
        return wait_for(lambda: (self.pump(), self.eof)[1], timeout)

    def close_in(self):
        if self.writer is not None:
            os.close(self.writer)
            self.writer = None

    def close(self):
        self.close_in()
        if self.fd is not None:
            os.close(self.fd)
            self.fd = None


def heard_on(out, seconds):
    """The lines a session's `out` says over `seconds`, read by someone
    who did not ask for it."""
    fd = os.open(out, os.O_RDONLY | os.O_NONBLOCK)
    heard = b""
    until = time.monotonic() + seconds
    while time.monotonic() < until:
        with contextlib.suppress(BlockingIOError):
            heard += os.read(fd, 65536)
        time.sleep(0.02)
    os.close(fd)
    return heard.decode("utf-8", "replace").split("\n")


def connected(r, name, role="layer", **opts):
    """A session opened and connected: its report asked for and heard."""
    c = Caller(r, name, role, **opts)
    assert c.opened, f"{name}: heard {c.heard}"
    c.command("report id=_")
    assert c.wait(lambda h: any(x.startswith("area ") and x.endswith(" id=_") for x in h)), \
        f"{name}: no report; heard {c.heard}"
    c.heard = []
    return c


def area_of(line):
    """(cols, rows, font) from an `area` line."""
    words = line.split()
    cols, rows = map(int, words[1].split("x"))
    return cols, rows, int(words[2])


@conformance()
def opens_a_session_at_the_door(r):
