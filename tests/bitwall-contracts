class Throttled(fakewall.FakeWall):
    """The fake wall reading the base's `in` at a set rate, or not at all.

    `drain` is bytes a second, None for as fast as it is written; `stalled`,
    set, stops it reading while it still holds the fifo, as a receiver that
    has hung does.
    """

    def __init__(self, *args, drain=None, **kw):
        self.drain = drain
        self.stalled = threading.Event()
        super().__init__(*args, **kw)

    def _read_in(self, s, now):
        if s is not self.base:
            return super()._read_in(s, now)
        if self.stalled.is_set():
            s.idle_until = now + self.t.tick
            return
        before = s.in_bytes
        super()._read_in(s, now)
        if self.drain:
            s.idle_until = now + (s.in_bytes - before) / self.drain


def a_slow_fake(cols, rows, drain=None):
    return Throttled(run_dir(), "0", cols, rows, 14, drain=drain, timings=T)


covers = fakewall.covers


def decode(text, cols, rows):
    """What a stream paints, as cells, read by the terminal emulator.

    It is the emulator the terminal sources read through, so this is
    bitwall reading its own wire rather than a decoder written for it.
    """
    t = emulator(cols, rows)
    try:
        t.write(text.encode())
        return [[c[:4] for c in row] for row in t.cells()]
    finally:
        t.close()


def pictures(text, cols, rows):
    """What the screen held after each frame of a stream, in order."""
    t = emulator(cols, rows)
    out = []
    try:
        for body in text.split(RESET):
            t.write((body + RESET).encode())
            if body:
                out.append(tuple(tuple(c[:3] for c in row)
                                 for row in t.cells()))
    finally:
        t.close()
    return out


def picture(grid):
    """A grid as `pictures` reads one back."""
    return tuple(tuple(c[:3] for c in row) for row in grid)


@contextlib.contextmanager
def attached(fake, **kw):
    """A real Wall on the base of a fake wall, talking before it is
    handed back."""
    w = bitwall.attach("localhost", run=fake.dir, **kw)
    try:
        assert wait_for(lambda: w.talking, 3), "the wall never opened the session"
        assert wait_for(lambda: w.area() == (fake.cols, fake.rows), 2), \
            f"the area is {w.area()}, the wall's {(fake.cols, fake.rows)}"
        yield w
    finally:
        w.detach()


class Counter:
    """A source whose every frame differs from the last in one cell."""

    def __init__(self):
        self.n = 0

    def __call__(self, cols, rows):
        self.n += 1
        g = grid_of(cols, rows, ".", "333333")
        g[0][0] = cell("0123456789"[self.n % 10], "ffffff")
        return g


class Layered:
    """A source whose columns change at different rates, recording each
    grid it draws.

    Column x changes every 2**(x % 5) frames, so most of a frame is the
    same as the one before and a diff made against the wrong one leaves
    cells behind. Every cell has a colour of its own, so a frame is large
    enough to fill a pipe. `frozen` stops it changing.
    """

    def __init__(self, delay=0.0):
        self.n = 0
        self.delay = delay
        self.frozen = False
        self.drawn = []

    def __call__(self, cols, rows):
        if self.delay:
            time.sleep(self.delay)
        if not self.frozen or not self.drawn:
            self.n += 1
        g = [[cell("0123456789"[(self.n >> (x % 5)) % 10],
                   "%02x%02x%02x" % (x * 7 % 256, y * 29 % 256,
                                     (self.n >> (x % 5)) * 13 % 256))
              for x in range(cols)] for y in range(rows)]
        if not self.drawn or picture(g) != self.drawn[-1]:
            self.drawn.append(picture(g))
        return g


class Watched:
    """A source that records the areas it was started, resized and drawn at."""

    def __init__(self, ch="w"):
        self.ch = ch
        self.started = self.resized = self.drawn = None
        self.resizes = []

    def start(self, cols, rows):
        self.started = (cols, rows)

    def resize(self, cols, rows):
        self.resizes.append((cols, rows))

    def fileno(self):
        return None

    def pump(self):
        return True

    def cells(self, cols, rows):
        self.drawn = (cols, rows)
        return grid_of(cols, rows, self.ch, "00ff88")

    def close(self):
        pass


