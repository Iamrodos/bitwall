    assert not bad, f"{len(bad)} of {len(got)} frames were never drawn"


def as_arrays(grid):
    """A grid of cells as the arrays a pixel source would hand over."""
    import numpy as np

    def colour(c):
        return -1 if c == "default" else int(c, 16)
    return (np.array([[ord(c[0]) if c[0] else 0 for c in row]
                      for row in grid], np.int32),
            np.array([[colour(c[1]) for c in row] for row in grid],
                     np.int32),
            np.array([[colour(c[2]) for c in row] for row in grid],
                     np.int32),
            np.array([[c[3] | c[4] << 1 | c[5] << 2 | c[6] << 3 | c[7] << 4
                       for c in row] for row in grid], np.uint8))


class Both(Layered):
    """Layered, offering its frames as arrays as well as cells, and
    answering every third one with cells alone, as a film does with a
    sentence in place of its picture."""

    def arrays(self, cols, rows):
        grid = self(cols, rows)
        return grid if self.n % 3 == 0 else as_arrays(grid)


@check
def a_frame_handed_over_as_arrays_paints_what_its_cells_would():
    """The arrays path is held to the cells path by what reaches the
    screen: the same frames, diffed against each other in any order and
    at every depth, decode to the same pictures either way."""
    from bitwall.arrays import Frame
    rnd = random.Random(7)
    glyphs = "ab ▀▄█⠁é"
    for trial in range(40):
        cols, rows = rnd.randint(1, 30), rnd.randint(1, 8)
        palette = [f"{rnd.randrange(1 << 24):06x}" for _ in range(4)] \
            + ["default"]
        grids = []
        for _ in range(4):
            grids.append([[cell(rnd.choice(glyphs), rnd.choice(palette),
                                rnd.choice(palette), rnd.random() < .2,
                                rnd.random() < .1, rnd.random() < .1,
                                rnd.random() < .1, rnd.random() < .1)
                           for _ in range(cols)] for _ in range(rows)])
            # Most of each frame unchanged, so the diffs have runs and gaps.
            if len(grids) > 1:
                for y in range(rows):
                    for x in range(cols):
                        if rnd.random() < .6:
                            grids[-1][y][x] = grids[-2][y][x]
        frames = [Frame.fit(as_arrays(g), cols, rows) for g in grids]
        for depth in bitwall.DEPTHS:
            order = list(range(len(grids)))
            rnd.shuffle(order)
            by_cells = by_arrays = ""
            prev_g = prev_f = None
            for i in order:
                full = prev_g is None or rnd.random() < .2
                by_cells += serialise(grids[i], prev_g, full, cols, rows,
                                      depth)
                by_arrays += serialise(frames[i], prev_f, full, cols, rows,
                                       depth)
                prev_g, prev_f = grids[i], frames[i]
            assert pictures(by_arrays, cols, rows) \
                == pictures(by_cells, cols, rows), \
                f"{cols}x{rows} at {depth}: the two paths paint differently"
            assert decode(by_arrays, cols, rows) \
                == decode(by_cells, cols, rows), \
                f"{cols}x{rows} at {depth}: the attributes differ"


