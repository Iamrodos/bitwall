def the_control_page_holds_a_session_on_every_wall_it_finds():
    """`bitwall-control` finds a device's walls with one listing of
    `<run>/bitwall/*/door.in`, opens `control-<device>-<wall>` on each
    and follows its traffic. Through its page: a command is answered on
    that session, `measures` bring the wall's numbers, a picture and a
    mirror frame come on it, who is on the wall is listed and kept as
    sessions come and go, the base's meta is the wall's and goes with
    the base, and every session is closed when the server stops."""
    import aiohttp
    fake, env = a_controlled_fake()
    other = a_fake(30, 8, "eink", fake.run, timings=TC)
    port = free_port()
    proc = spawn([sys.executable, CONTROL, "--host", "127.0.0.1", "--port", str(port),
                  "--device", "mac=localhost"], env=env)
    assert wait_for(lambda: any(s.name == "control-mac-0" for s in fake.live())
                    and any(s.name == "control-mac-eink" for s in other.live()), 15), \
        (fake.live(), other.live())
    assert wait_for(lambda: next((s.follow for s in fake.live()
                                  if s.name == "control-mac-0"), None) == "in", 5), \
        "the page's session does not follow the wall's traffic"

    async def drive():
        got = {"walls": {}, "lines": [], "answers": [], "pics": [], "frames": []}

        async def until(ws, test, seconds):
            end = time.monotonic() + seconds
            while time.monotonic() < end:
                try:
                    msg = await asyncio.wait_for(ws.receive(), max(0.05, end - time.monotonic()))
                except asyncio.TimeoutError:
                    break
                if msg.type == aiohttp.WSMsgType.BINARY:
                    n = int.from_bytes(msg.data[:2], "big")
                    head = json.loads(msg.data[2:2 + n])
                    kind = "frames" if "mirror" in head else "pics"
                    got[kind].append((head, msg.data[2 + n:]))
                elif msg.type == aiohttp.WSMsgType.TEXT:
                    m = json.loads(msg.data)
                    if m["type"] == "state":
                        got["state"] = m
                        got["walls"].update(m["walls"])
                    elif m["type"] == "wall":
                        got["walls"][m["wall"]["key"]] = m["wall"]
                    elif m["type"] == "line":
                        got["lines"].append(m)
                    elif m["type"] == "answer":
                        got["answers"].append(m)
                else:
                    break
                if test():
                    return True
            return test()

        def wall(key="mac:0"):
            return got["walls"].get(key) or {}

        async with aiohttp.ClientSession() as http:
            async with http.ws_connect(f"http://127.0.0.1:{port}/ws") as ws:
                assert await until(ws, lambda: wall().get("status") == "open"
                                   and wall("mac:eink").get("status") == "open", 15), got["walls"]
                devices = got["state"]["devices"]
                assert [d["name"] for d in devices] == ["mac"], devices
                assert sorted(devices[0]["walls"]) == ["mac:0", "mac:eink"], devices
                assert wall()["session"] == "control-mac-0", wall()
                assert await until(ws, lambda: [x["name"] for x in wall()["sessions"]]
                                   == ["control-mac-0"], 5), wall()["sessions"]
                await ws.send_str(json.dumps({"type": "command", "key": "mac:0",
                                              "words": "font 23", "ref": 1}))
                assert await until(ws, lambda: got["answers"], 5), "no answer"
                a = got["answers"][0]
                assert a["ok"] and a["answer"][0].startswith("area ") \
                    and a["answer"][0].split()[2] == "23", a
                assert await until(ws, lambda: wall().get("font") == 23, 3), wall()
                await ws.send_str(json.dumps({"type": "rate", "key": "mac:0",
                                              "live": True, "ms": 250}))
                assert await until(ws, lambda: wall().get("measures"), 5), wall()
                assert wall()["measures"]["grid"] == wall()["grid"], wall()["measures"]
                await ws.send_str(json.dumps({"type": "picture", "key": "mac:0", "ref": 2}))
                assert await until(ws, lambda: got["pics"], 5), "no picture"
                head, data = got["pics"][0]
                assert head["format"] == "qoi" and (head["w"], head["h"]) == (fake.glass_w, fake.glass_h) \
                    and len(data) == head["bytes"] and data[:4] == b"qoif", head
                await ws.send_str(json.dumps({"type": "mirror", "key": "mac:0", "ms": 100}))
                assert await until(ws, lambda: got["frames"], 5), "no mirror frame"
                assert got["frames"][0][0]["mirror"] == "qoi", got["frames"][0][0]
                # A sender arriving is a session opened, the base, and its
                # meta is the wall's; leaving takes both away.
                w = bitwall.attach("localhost", run=fake.dir)
                try:
                    w.meta(name="Eye")
                    assert await until(ws, lambda: wall().get("base") and
                                       (wall()["meta"].get("name") or {}).get("value") == "Eye", 10), \
                        (wall().get("base"), wall().get("meta"), wall().get("sessions"))
                    base = wall()["base"]
                    assert {"name": base, "role": "layer", "z": "0", "type": "cells"} \
                        in wall()["sessions"], wall()["sessions"]
                    assert any(m["mark"] == "<" and m["who"] == base and m["text"].startswith("meta ")
                               for m in got["lines"]), "the base's commands were not followed"
                finally:
                    w.detach()
                assert await until(ws, lambda: wall().get("base") is None and not wall()["meta"]
                                   and [x["name"] for x in wall()["sessions"]] == ["control-mac-0"], 10), \
                    (wall().get("base"), wall().get("meta"), wall().get("sessions"))
                await ws.send_str(json.dumps({"type": "command", "key": "mac:0",
                                              "words": "frob", "ref": 3}))
                assert await until(ws, lambda: any(x["words"] == "frob" for x in got["answers"]),
                                   5), "no answer"
                frob = next(x for x in got["answers"] if x["words"] == "frob")
                assert frob["ok"] is False and frob["answer"] == ["error frob unknown command"], frob
        return got

    asyncio.run(drive())
    proc.terminate()
    proc.wait(timeout=10)
    assert wait_for(lambda: not fake.live() and not other.live(), 5), \
        f"the server left sessions behind: {fake.live()} {other.live()}"
    assert not fake.errors and not other.errors, (fake.errors, other.errors)


