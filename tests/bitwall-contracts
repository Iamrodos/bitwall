@kitty_clause
def a_png_placed_with_c_and_r_fills_exactly_those_cells(r):
    """`a=T,f=100` with `c` and `r`: the picture stretched over those cells
    at the cursor, and nothing beyond them."""
    k = KittyWall(r)
    k.send(k.at(2, 1), kitty("a=T,f=100,i=1,c=4,r=2,q=2", png_bytes(10, 10, (255, 0, 0, 255))))
    ok, seen = k.covers(k.box(2, 1, 4, 2), (255, 0, 0))
    assert ok, seen
    assert not k.errors(), k.errors()
