#: The receivers that paint with the Meslo Nerd Font beside the painter,
#: and so draw its icons; a terminal's font and a fake's are not known.
ICON_WALLS = ("pi", "web", "eink")


@conformance()
def a_wall_drawing_nerd_font_icons_claims_them_and_draws_one(r):
    """A wall whose font has the Nerd Font icons says so in `glyphs`, so
    `w.can` is true of one from each set (Font Awesome, Material Design
    in the supplementary plane, Codicons, Octicons, Weather, Powerline),
    and an icon on its glass has ink where a blank cell has none. On the
    web it is the page's icon face, fetched once the icon is drawn."""
    if r.name not in ICON_WALLS:
        return f"skipped: {r.name} draws with a font this check does not know"
    icons = "\uf05a\uf075\uf129\U000f0369\uea60\uf400\ue30d\ue0b0"
    if r.name == "pi":
        r.glyphs = None
        r.restart()
    ctl = connected(r, "ctl", "controller")
    w = bitwall.attach(f"localhost:{r.wall}", run=r.wall_dir)
    try:
        assert wait_for(lambda: w.glyphs, 5), "the wall said no glyphs"
        missing = [f"U+{ord(c):04X}" for c in icons if not w.can(c)]
        assert not missing, f"not claimed: {missing}; glyphs={w.screen().get('glyphs')}"
        loaded = ("Array.from(document.fonts).some(function (f) {"
                  " return f.unicodeRange.indexOf('F000') >= 0"
                  " && f.status === 'loaded'; })")
        if r.name == "web":
            assert not r.page.eval(loaded), "the page fetched its icon face with no icon drawn"
        w.set_source(lambda cols, rows: [
            [bitwall.cell("\uf05a" if (x, y) == (1, 1) else " ", "ffffff", "000000")
             for x in range(cols)] for y in range(rows)])
        if r.name == "web":
            assert wait_for(lambda: r.page.eval(loaded), 10), \
                "the page never fetched its icon face"
        if r.name == "pi" and not GPU:
            return "claimed; skipped the glass: its fake GPU reads every picture back black"
        for _ in range(50):                 # listening, so ctl is not let go
            ctl.idle(0.02)
        cols, rows = w.area()
        cw, ch = w.screen()["cell"]
        ctl.command("picture glass id=g")
        assert ctl.wait_frames(lambda f: f, 4), ctl.heard
        gw, gh, px = qoi_rgba(ctl.frames[-1][1])
        if cols * cw > gw or rows * ch > gh:
            cw, ch = gw / cols, gh / rows
        ox, oy = (gw - cols * cw) // 2, (gh - rows * ch) // 2

        def rgb(x, y):
            return px[(y * gw + x) * 4:(y * gw + x) * 4 + 3]
        ground = rgb(int(ox + 3.5 * cw), int(oy + 1.5 * ch))

        def inked(cx, cy):
            """The share of a cell's pixels unlike the ground: a glass of
            greys may be turned over, so ink is told by difference."""
            lit = 0
            for y in range(int(oy + cy * ch), int(oy + (cy + 1) * ch)):
                for x in range(int(ox + cx * cw), int(ox + (cx + 1) * cw)):
                    lit += max(abs(p - q) for p, q in zip(rgb(x, y), ground)) > 96
            return lit / (int(cw) * int(ch))
        icon, blank = inked(1, 1), inked(3, 1)
        assert icon > 0.1 and blank < 0.01, f"the icon's cell {icon:.2f} inked, a blank's {blank:.2f}"
    finally:
        w.detach()
        ctl.close()


def area_said(c, tag=None, after=0):
    """The last `area WxH F` said to a caller, from its `after`-th line on,
    with ` id=<tag>` if a tag is given, as (cols, rows, font); None if none."""
    for line in reversed(c.heard[after:]):
        w = line.split()
        if w[:1] == ["area"] and len(w) >= 3 and (tag is None or f"id={tag}" in w):
            cols, _, rows = w[1].partition("x")
            return int(cols), int(rows), int(w[2])
    return None


def area_asked(c, tag):
    """A caller's area as the wall says it now, asked with `report`."""
    c.command(f"report id={tag}")
    assert c.wait(lambda h: area_said(c, tag) is not None, 3), c.heard
    return area_said(c, tag)


