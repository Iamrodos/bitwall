def above_types(r):
    """The layer types the wall takes above the base, as its `caps` says
    them in `above=`; video alone where it does not say."""
    c = Caller(r, f"caps-{random.randrange(1 << 20):05x}", "controller")
    try:
        c.command("report id=c")
        c.wait(lambda h: any(x.startswith("caps") for x in h), 2)
        caps = next((x for x in c.heard if x.startswith("caps")), "")
    finally:
        c.close()
    said = next((w[6:] for w in caps.split() if w.startswith("above=")), None)
    return said.split(",") if said else ["video"]


def layer_cells(r, ctl, name, want=None):
    """A picture of a cells layer, as (the stream it was sent as, its text):
    asked again for a second or two until its text is `want`, since what the
    layer wrote on its own `in` may not have been read when this asks."""
    until = time.monotonic() + 2
    while True:
        ctl.frames.clear()
        ctl.command(f"picture {name} id=p{random.randrange(1 << 20)}")
        assert ctl.wait_frames(lambda f: f, 2), ctl.heard
        raw = ctl.frames[-1][1].decode("utf-8", "replace")
        text = re.sub(r"\x1b\[[0-9;?]*[A-Za-z]", "", raw)
        if want is None or text == want or time.monotonic() >= until:
            return raw, text
        time.sleep(0.05)


def qoi_rgba(data):
    """A QOI image's pixels, as (w, h, bytes of RGBA)."""
    w, h = int.from_bytes(data[4:8], "big"), int.from_bytes(data[8:12], "big")
    out, seen = bytearray(w * h * 4), [(0, 0, 0, 0)] * 64
    px, i, n = (0, 0, 0, 255), 14, 0
    run = 0
    while n < w * h:
        if run:
            run -= 1
        else:
            b = data[i]
            i += 1
            if b == 0xfe:
                px = (data[i], data[i + 1], data[i + 2], px[3])
                i += 3
            elif b == 0xff:
                px = tuple(data[i:i + 4])
                i += 4
            elif b >> 6 == 0:
                px = seen[b]
            elif b >> 6 == 1:
                px = ((px[0] + (b >> 4 & 3) - 2) & 255, (px[1] + (b >> 2 & 3) - 2) & 255,
                      (px[2] + (b & 3) - 2) & 255, px[3])
            elif b >> 6 == 2:
                dg = (b & 63) - 32
                b2 = data[i]
                i += 1
                px = ((px[0] + dg + (b2 >> 4) - 8) & 255, (px[1] + dg) & 255,
                      (px[2] + dg + (b2 & 15) - 8) & 255, px[3])
            else:
                run = b & 63
            seen[(px[0] * 3 + px[1] * 5 + px[2] * 7 + px[3] * 11) % 64] = px
        out[n * 4:n * 4 + 4] = bytes(px)
        n += 1
    return w, h, bytes(out)


@conformance(known_for=dict(NO_CELLS_ABOVE, eink=EINK_GREYS, **({} if GPU else {
    "pi": "its fake GPU reads every picture back black"})))
def a_cells_layer_is_drawn_over_the_base_on_the_glass(r):
    """On the glass, a cells layer's cells are drawn over the base's: a
    ground it sets covers the base, a ground with an alpha is mixed with
    it, and every cell it left alone shows the base."""
    base = connected(r, "base", z=0)
    ctl = connected(r, "ctl", "controller")
    if (skip := no_glass(r, ctl)):
        return skip
    t = connected(r, "t", z="above", type="cells")
    cols, rows, _ = area_asked(base, "a")
    base.write("\x1b[48;2;200;0;0m"
               + "".join(f"\x1b[{y + 1};1H" + " " * cols for y in range(rows)) + "\x1b[0m")
    t.write(b"\x1b[2;2H\x1b[48;2;0;0;255m \x1b[48;6;0;0;255;128m \x1b[0m")
    for _ in range(12):                 # listening, so no session is let go
        for x in (base, ctl, t):
            x.idle(0.02)
    t.command("report id=s")
    assert t.wait(lambda h: any(x.startswith("screen ") and "id=s" in x for x in h)), t.heard
    screen = next(x for x in t.heard if x.startswith("screen ") and "id=s" in x)
    cw, ch = (int(v) for v in re.search(r"cell=(\d+)x(\d+)", screen).groups())
    ctl.command("picture glass id=g")
    assert ctl.wait_frames(lambda f: f, 4), ctl.heard
    w, h, px = qoi_rgba(ctl.frames[-1][1])
    if cols * cw > w or rows * ch > h:
        cw, ch = w / cols, h / rows         # a glass that is not whole cells
    ox, oy = (w - cols * cw) // 2, (h - rows * ch) // 2

    def at(cx, cy):
        x, y = int(ox + cx * cw + cw / 2), int(oy + cy * ch + ch / 2)
        return tuple(px[(y * w + x) * 4:(y * w + x) * 4 + 3])
    near = lambda a, b: all(abs(p - q) <= 12 for p, q in zip(a, b))
    assert near(at(1, 1), (0, 0, 255)), f"the layer's ground: {at(1, 1)}"
    assert near(at(2, 1), (100, 0, 128)), f"half a blue over red: {at(2, 1)}"
    assert near(at(4, 1), (200, 0, 0)) and near(at(1, 3), (200, 0, 0)), \
        f"a cell the layer left alone: {at(4, 1)} {at(1, 3)}"
    for x in (base, ctl, t):
        x.close()


