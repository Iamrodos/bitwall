class HeadlessReceiver(Receiver):
    """core-rs's `examples/headless`, built with `cargo build --release
    --features decode --example headless`: the receiver core on a glass of
    pixels with no screen, the check's cells at its font, composed only
    when it is pictured. It is where the core's video layers and pictures
    of the glass are held to the clauses; a resize is a new glass, said on
    its stdin as `glass WxH`."""

    name = "headless"
    title = "the core-rs headless receiver"

    def _glass(self):
        cw, ch = (self.font * 4 + 3) // 7, (self.font * 8 + 3) // 7
        return f"{self.cols * cw}x{self.rows * ch}"

    def start(self):
        self.proc = spawn([HEADLESS, "--glass", self._glass(), self.wall], stdin=subprocess.PIPE,
                          env=dict(os.environ, BITWALL_RUN=self.run, BITWALL_FONT=str(self.font)),
                          start_new_session=True)
        assert wait_for(lambda: fakewall.door_has_reader(self.door), 5), \
            "the headless receiver never made its door"

    def resize(self, cols, rows):
        self.cols, self.rows = cols, rows
        self.proc.stdin.write(f"glass {self._glass()}\n".encode())
        self.proc.stdin.flush()


