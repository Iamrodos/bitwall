class PainterReceiver(Receiver):
    """`bitwall-paint --run`, one wall, built against the fake SDL/GL/KMS so
    it paints nowhere but speaks the door and sessions for real.

    Its glass is faked, so what it shows is read back by asking it for a
    picture of its base on a controller of its own. A cell is 8x16 fake pixels
    at font 14, so a WxH grid is a W*8 x H*16 glass, and a resize is that
    glass changed through a size file the fake reads.

    Pointed at a real painter (BITWALL_PAINTER), it is that painter with no
    screen, its glass `--glass` and its font the MesloLGS beside it, whose
    cell at 14 is 8x18, and a resize is `glass WxH` asked by a controller
    of its own, as a controller changes a glass with no screen.
    """

    name = "pi"
    title = "the pi painter"
    t = fakewall.Timings(0.1)
    #: Paint in software: the fake GPU reads back black, so a check that
    #: looks at the glass's pixels has the painter paint them itself.
    software = False
    #: More of its command line, as a check wants it.
    extra = ()

    #: A cell at font 14, in the glass's pixels.
    cell = (8, 18) if GPU else (8, 16)

    def _pixels(self, cols, rows):
        return cols * self.cell[0], rows * self.cell[1]

    def reset(self):
        super().reset()
        self.software = False
        self.glyphs = ""            # None: what the font says

    def start(self):
        self._n = 0
        self._sizefile = os.path.join(self.run, "size")
        w, h = self._pixels(self.cols, self.rows)
        with open(self._sizefile, "w") as fh:
            fh.write(f"{w}x{h}")
        env = dict(os.environ, BITWALL_CLOCK_SCALE="0.1",
                   BITWALL_STATUS_FONT="14", BITWALL_GLYPHS=self.glyphs,
                   BITWALL_FAKE_SIZE=self._sizefile)
        if self.glyphs is None:
            del env["BITWALL_GLYPHS"]
        if self.software:
            env["BITWALL_PAINT_SOFTWARE"] = "1"
        if GPU:
            argv = [PAINT_BIN, "--font", "14", "--font-file", gpupainter.FONT_FILE,
                    "--glass", f"{w}x{h}", "--run", self.run, "--walls", "1", *self.extra]
        else:
            argv = [PAINT_BIN, "--font", "14", "--font-file", "fake",
                    "--driver", "kmsdrm", "--run", self.run, "--walls", "1",
                    "--mode", f"0={w}x{h}", *self.extra]
        self.proc = spawn(argv, env=env)
        assert wait_for(lambda: fakewall.door_has_reader(self.door), 8), \
            "the painter never made its door"

    def resize(self, cols, rows):
        self.cols, self.rows = cols, rows
        w, h = self._pixels(cols, rows)
        with open(self._sizefile, "w") as fh:
            fh.write(f"{w}x{h}")
        if GPU:
            self._n += 1
            c = Caller(self, f"glass-{self._n}", "controller")
            assert c.opened, c.heard
            c.command(f"glass {w}x{h}")
            c.close()

    def die(self):
        if self.proc is not None:
            self.proc.kill()
            self.proc.wait(3)
            self.proc = None

    def restart(self):
        _stop(self.proc)
        self.proc = None
        self.start()

    def screen(self):
        """The base as it stands, a picture of it asked for on a controller
        of its own and read back as the text of its cells."""
        self._n += 1
        c = Caller(self, f"scr-{self._n}", "controller", wait=2.0)
        text = ""
        try:
            if not c.opened:
                return ""
            c.command("sessions id=s")
            c.wait(lambda h: any(x.startswith("sessions ") for x in h), 1.5)
            base = next((x.split()[1] for x in c.heard
                         if x.startswith("session ") and x.split()[2:5] == ["layer", "0", "cells"]),
                        None)
            if base is None:
                return ""
            c.command(f"picture {base} id=p")
            c.wait_frames(lambda f: f, 1.5)
            if c.frames:
                _, data = c.frames[0]
                raw = data.decode("utf-8", "replace")
                text = re.sub(r"\x1b\[[0-9;?]*[A-Za-z]", "", raw)
        finally:
            c.close()
        return text


WEB = os.path.join(RECEIVERS_DIR, "web", "bitwall-web")
CHROME = os.environ.get("BITWALL_CHROME",
                        "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome")


class Chrome:
    """A headless Chrome of the checks' own, driven over the DevTools
    protocol: a tab is a page opened on a viewport of a given size, and a
    resize is that viewport changed, as a window dragged."""

    _one = None

    @classmethod
    def get(cls):
        if cls._one is None:
            cls._one = cls()
            atexit.register(cls._one.quit)
        return cls._one

    def __init__(self):
        self.dir = tempfile.mkdtemp(prefix="bwc-chrome-")
        _runs.append(self.dir)
        self.proc = spawn([CHROME, "--headless=new", "--remote-debugging-port=0",
                           f"--user-data-dir={self.dir}", "--no-first-run",
                           "--no-default-browser-check", "--disable-background-timer-throttling",
                           "--disable-renderer-backgrounding",
                           "--disable-backgrounding-occluded-windows", "about:blank"])
        port_file = os.path.join(self.dir, "DevToolsActivePort")
        assert wait_for(lambda: os.path.exists(port_file)
                        and open(port_file).read().count("\n") >= 1, 10), "Chrome did not start"
        port, path = open(port_file).read().split("\n")[:2]
        self.port = int(port)
        self.browser = _Devtools(f"ws://127.0.0.1:{port}{path}")

    def tab(self, url, width, height):
        target = self.browser.call("Target.createTarget", url="about:blank")["targetId"]
        page = _Devtools(f"ws://127.0.0.1:{self.port}/devtools/page/{target}")
        page.target = target
        page.resize(width, height)
        page.call("Page.navigate", url=url)
        return page

    def close_tab(self, page):
        with contextlib.suppress(Exception):
            self.browser.call("Target.closeTarget", targetId=page.target)
        page.close()

    def quit(self):
        with contextlib.suppress(Exception):
            self.browser.close()
        _stop(self.proc)


class _Devtools:
    """One DevTools connection: a call and its answer, in turn."""

    def __init__(self, url):
        import websocket
        self.ws = websocket.create_connection(url, timeout=10, suppress_origin=True)
        self.n = 0
        self.lock = threading.Lock()

    def call(self, method, **params):
        with self.lock:
            self.n += 1
            me = self.n
            self.ws.send(json.dumps({"id": me, "method": method, "params": params}))
            while True:
                m = json.loads(self.ws.recv())
                if m.get("id") == me:
                    if "error" in m:
                        raise AssertionError(f"{method}: {m['error']}")
                    return m.get("result", {})

    def eval(self, expr):
        got = self.call("Runtime.evaluate", expression=expr, returnByValue=True)
        return got.get("result", {}).get("value")

    def resize(self, width, height):
        self.call("Emulation.setDeviceMetricsOverride", width=width, height=height,
                  deviceScaleFactor=1, mobile=False)

    def close(self):
        with contextlib.suppress(Exception):
            self.ws.close()


class WebReceiver(Receiver):
    """`bitwall-web` with one wall, its glass a tab in a headless Chrome.

    The tab is sized so the wall's area at font 14 is the grid a check
    wants, from the cell the tab measured, and a resize is the tab's
    viewport changed, which the tab says to the wall once it has settled.
    What the base shows is read back as a picture of it, as the painter's
    is, and whether a video layer is up is asked of the tab.
    """

    name = "web"
    title = "the web receiver"
    wall = "w"
    t = fakewall.Timings(0.1)
    SEL = "document.querySelector('bitwall-screen')"

    def reset(self):
        super().reset()
        self.port = None
        self.page = None
        self._n = 0

    def start(self):
        if self.port is None:
            self.port = free_port()
        self.proc = spawn([WEB, "--run", self.run, "--port", str(self.port),
                           "--host", "127.0.0.1", "--font", str(self.font), self.wall],
                          env=dict(os.environ, BITWALL_CLOCK_SCALE="0.1"),
                          start_new_session=True)
        assert wait_for(lambda: fakewall.door_has_reader(self.door), 15), \
            "the web receiver never made its door"
        if self.page is None:
            self.page = Chrome.get().tab(f"http://127.0.0.1:{self.port}/r/{self.wall}",
                                         800, 600)
        self.resize(self.cols, self.rows)
        assert wait_for(lambda: self.area()[:2] == [self.cols, self.rows], 10), \
            f"the tab never showed {self.cols}x{self.rows}: {self.area()}"

    def area(self):
        """What the tab holds of the wall: cols, rows, font, and a cell at
        that font in device pixels."""
        got = self.page.eval(
            f"(function(e){{ if (!e || !e.state || !e.table) return null;"
            f" var s = e.state; return [s.cols, s.rows, s.font, e.table[s.font - 4],"
            f" e.cols, e.rows]; }})({self.SEL})")
        return got or [None, None, None, None]

    def resize(self, cols, rows):
        self.cols, self.rows = cols, rows
        cell = wait_for(lambda: self.area()[3], 10)
        assert cell, "the tab never measured its cells"
        cw, ch = cell
        self.page.resize(cols * cw + cw // 2, rows * ch + ch // 2)

    def video_up(self):
        time.sleep(0.1)
        return bool(self.page.eval(f"{self.SEL}.videoUp()"))

    def _signal(self, sig):
        """A signal to the server and whatever `uv` started it as: its
        process group, since `uv run` does not pass SIGKILL on."""
        if self.proc is not None:
            with contextlib.suppress(ProcessLookupError):
                os.killpg(self.proc.pid, sig)
            with contextlib.suppress(Exception):
                self.proc.wait(5)
            self.proc = None

    def die(self):
        self._signal(signal.SIGKILL)

    def restart(self):
        self._signal(signal.SIGTERM)
        self.start()

    def stop(self):
        self._signal(signal.SIGTERM)
        if self.page is not None:
            Chrome.get().close_tab(self.page)
            self.page = None

    screen = PainterReceiver.screen


