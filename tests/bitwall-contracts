# -------------------------------------------------------------------- run

def run_one(fn):
    """One check run here, and what came of it: `ok`, `fail`, `error`,
    `skip`, `known` or `fixed`, what it said, anything it printed, and
    how long it took."""
    began = time.monotonic()
    printed = io.StringIO()
    reason = getattr(fn, "known", None)
    try:
        with contextlib.redirect_stdout(printed):
            note = fn()
    except AssertionError as exc:
        status, text = ("known", str(exc)) if reason else ("fail", str(exc))
    except NoEmulator as exc:
        status, text = "skip", str(exc)
    except Exception as exc:                           # noqa: BLE001
        status, text = "error", f"{type(exc).__name__}: {exc}"
    else:
        status, text = ("skip", note) if note else ("fixed", "") if reason else ("ok", "")
    return {"name": fn.__name__, "status": status, "text": text, "reason": reason,
            "printed": printed.getvalue(), "secs": time.monotonic() - began}


def report(r, width):
    """A check's result, as a line or two of the run's output."""
    name = r["name"].replace("_", " ")
    if r["printed"]:
        print(r["printed"], end="" if r["printed"].endswith("\n") else "\n")
    if r["status"] == "known":
        print(f"  known {name:<{width}} {r['reason']}\n        {r['text']}".rstrip())
    elif r["status"] == "fail":
        print(f"  FAIL  {name}\n        {r['text']}")
    elif r["status"] == "error":
        print(f"  ERROR {name}\n        {r['text']}")
    elif r["status"] == "skip":
        print(f"  skip  {name:<{width}} {r['text']}")
    elif r["status"] == "fixed":
        print(f"  ok!   {name:<{width}} known, and now passes: {r['reason']}")
    elif r["status"] == "flaky":
        print(f"  ok~   {name:<{width}} failed beside other checks and passed alone; "
              f"it runs alone from now on\n        {r['text']}")
    else:
        print(f"  ok    {name}")
    sys.stdout.flush()


# ------------------------------------------------------------- workers
#
# The checks are mostly waiting -- on receivers starting, on the
# protocol's own timers -- and each has a run directory of its own, so
# they run side by side: a pool of workers, each this script again,
# handed one check at a time, longest first by how long each took last
# time, so a long one never starts last. A worker is a process of its
# own because a receiver is a thing a check starts and stops, and two
# checks on one receiver object at once would each stop the other's.

#: A run on a real painter keeps its own, since its checks share names
#: with the fake-built painter's and take their own time.
_KEPT = "-gpu" if GPU else ""
DURATIONS = os.path.join(CACHE, f"durations{_KEPT}.json")
#: Checks that have failed beside others and passed alone, which run
#: alone from then on.
LEARNED = os.path.join(CACHE, f"alone{_KEPT}.json")


def _load(path, empty):
    try:
        with open(path) as fh:
            return type(empty)(json.load(fh))
    except (OSError, ValueError, TypeError):
        return empty


def _save(path, value):
    with contextlib.suppress(OSError):
        os.makedirs(CACHE, exist_ok=True)
        with open(path + ".new", "w") as fh:
            json.dump(value, fh, indent=0, sort_keys=True)
        os.replace(path + ".new", path)


#: What a real painter with no screen cannot keep yet, by check, and why.
#: Each is a clause the fake-built painter keeps, so the painter is what
#: is behind, not the clause.
GPU_KNOWN = {
    "the_painter_turned_says_its_glass_the_shape_it_hangs":
        "with no screen there is no output to turn: --glass is the glass as it "
        "hangs and --rotate is set aside (display-sdl.c), so a quarter turn "
        "keeps the glass's shape",
}
if GPU:
    for _fn in _checks:
        if _fn.__name__ in GPU_KNOWN:
            _fn.known = GPU_KNOWN[_fn.__name__]


def jobs_wanted(given):
    """How many checks run at once: as given, or BITWALL_JOBS, or one
    fewer than the machine's cores, leaving one for the receivers."""
    for said in (given, os.environ.get("BITWALL_JOBS")):
        if said is not None and str(said).isdigit() and int(said) > 0:
            return int(said)
    return max(1, (os.cpu_count() or 2) - 1)


def worker():
    """A worker: check names on stdin, one a line; each result, as JSON,
    on the pipe named by BITWALL_RESULTS, so nothing a check or what it
    starts writes to stdout can be taken for one."""
    out = os.fdopen(int(os.environ["BITWALL_RESULTS"]), "w", buffering=1)
    by_name = {c.__name__: c for c in _checks}
    # Stopped, it goes as it would at the end: its receivers stopped and
    # its run directories gone.
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(1))
    for line in sys.stdin:
        fn = by_name.get(line.strip())
        if fn is not None:
            out.write(json.dumps(run_one(fn)) + "\n")
    return 0


def run_pool(chosen, jobs, width):
    """The chosen checks across `jobs` workers, each result reported as
    it comes; the results, by name."""
    import selectors
    took, learned = _load(DURATIONS, {}), set(_load(LEARNED, []))
    # Longest first; one never timed goes first of all, as it may be long.
    # A check marked `alone`, or learned to need it, waits until every
    # other has finished, and then they go one at a time.
    order = sorted(chosen, key=lambda c: -took.get(c.__name__, 1e9))
    solo = {c.__name__ for c in chosen if getattr(c, "alone", False) or c.__name__ in learned}
    queue = [c.__name__ for c in order if c.__name__ not in solo]
    lone = [c.__name__ for c in order if c.__name__ in solo]
    sel, results, workers, busy = selectors.DefaultSelector(), {}, [], set()

    def hand(proc):
        """The next check this worker may take, if there is one now."""
        if queue:
            name = queue.pop(0)
        elif lone and not busy:
            name = lone.pop(0)
        else:
            return False
        proc.stdin.write(name + "\n")
        proc.stdin.flush()
        busy.add(proc)
        return True
    for _ in range(min(jobs, len(queue) + len(lone))):
        r, w = os.pipe()
        proc = subprocess.Popen([sys.executable, os.path.abspath(__file__), "--worker"],
                                stdin=subprocess.PIPE, text=True, pass_fds=(w,),
                                env=dict(os.environ, BITWALL_RESULTS=str(w)))
        os.close(w)
        reader = os.fdopen(r, "r")
        sel.register(reader, selectors.EVENT_READ, proc)
        workers.append(proc)
        hand(proc)
    try:
        while len(results) < len(chosen) and sel.get_map():
            for key, _ in sel.select():
                proc, line = key.data, key.fileobj.readline()
                if not line:
                    # A worker gone before its check said anything.
                    sel.unregister(key.fileobj)
                    continue
                r = json.loads(line)
                results[r["name"]] = r
                if r["status"] not in ("fail", "error"):
                    report(r, width)       # a failure waits for its second run
                busy.discard(proc)
                # Every idle worker, since the last of the others finishing
                # is what lets the first of the lone ones start.
                for idle in [w for w in workers if w not in busy and not w.stdin.closed]:
                    if not hand(idle) and not queue and not lone:
                        idle.stdin.close()
    finally:
        for proc in workers:
            with contextlib.suppress(Exception):
                if not proc.stdin.closed:
                    proc.stdin.close()
            try:
                proc.wait(timeout=30)
            except subprocess.TimeoutExpired:
                _stop(proc)
    for c in chosen:
        if c.__name__ not in results:
            r = {"name": c.__name__, "status": "error", "reason": None, "printed": "",
                 "text": "its worker ended before it finished", "secs": 0}
            results[c.__name__] = r
    # A check that failed in a worker is run again here, alone, in a
    # process that has run nothing else: one that passes then was the load,
    # or a worker worn by the checks before it, and runs alone from now on;
    # one that fails again has failed.
    by_name = {c.__name__: c for c in chosen}
    for name, r in list(results.items()):
        if r["status"] in ("fail", "error"):
            again = run_one(by_name[name])
            if again["status"] in ("ok", "fixed", "skip"):
                first = (r["text"] or "").splitlines()[:1] or ["an assertion with nothing to say"]
                again["status"], again["text"] = "flaky", first[0][:200]
                learned.add(name)
            results[name] = again
            report(again, width)
    took.update({n: r["secs"] for n, r in results.items()})
    _save(DURATIONS, took)
    _save(LEARNED, sorted(learned))
    return results


def main(argv):
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument("words", nargs="*", help="run only the checks whose names contain one")
    ap.add_argument("-j", "--jobs", help="checks run at once; 1 runs them one after "
                                         "another (default: BITWALL_JOBS, else cores - 1)")
    ap.add_argument("--worker", action="store_true", help=argparse.SUPPRESS)
    a = ap.parse_args(argv)
    if a.worker:
        return worker()
    words = a.words
    chosen = [c for c in _checks
              if not words or any(w in c.__name__.replace("_", " ")
                                  or w in c.__name__ for w in words)]
    width = max(len(c.__name__) for c in chosen) + 2
    jobs = jobs_wanted(a.jobs)
    began = time.monotonic()
    if jobs > 1 and len(chosen) > 1:
        print(f"  {len(chosen)} checks, {min(jobs, len(chosen))} at once")
        results = list(run_pool(chosen, jobs, width).values())
    else:
        results = []
        for fn in chosen:
            results.append(run_one(fn))
            report(results[-1], width)
    count = collections.Counter(r["status"] for r in results)
    failed = count["fail"] + count["error"]
    passed = count["ok"] + count["fixed"] + count["flaky"]
    flaky = f" ({count['flaky']} only alone)" if count["flaky"] else ""
    print(f"\n{passed} passed{flaky}, {failed} failed, {count['known']} known, "
          f"{count['skip']} skipped in {time.monotonic() - began:.0f}s")
    return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
