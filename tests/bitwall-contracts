@conformance(known_for=SHELL_NO_CONTROLLERS)
def a_glass_stream_is_raw_frames_on_a_fifo_of_its_own(r):
    """`mirror glass stream=i420 size=<w>x<h> fps=<n>`, on a wall whose
    `caps` says `stream`, makes `s/<name>/glass`, and frames come on it:
    each a header of 32 bytes -- `BWG1`, its size, its number, its time and
    how many bytes follow -- then the I420 planes at exactly that size. A
    second stream is `busy`; `off` ends it and the fifo goes."""
    ctl = connected(r, "ctl", "controller")
    ctl.command("report id=c")
    assert ctl.wait(lambda h: any(x.startswith("caps ") for x in h)), ctl.heard
    if "stream" not in next(x for x in ctl.heard if x.startswith("caps ")).split():
        ctl.close()
        return f"skipped: {r.name} does not offer stream"
    ctl.command("mirror glass stream=i420 size=64x36 fps=20")
    path = os.path.join(ctl.dir, "glass")
    assert wait_for(lambda: os.path.exists(path) and stat.S_ISFIFO(os.stat(path).st_mode), 2), \
        f"no fifo at {path}; heard {ctl.heard}"
    fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK)
    buf, frames = b"", []
    until = time.monotonic() + 3
    while len(frames) < 3 and time.monotonic() < until:
        ctl.pump()
        with contextlib.suppress(BlockingIOError):
            buf += os.read(fd, 1 << 20)
        while len(buf) >= 32:
            magic, w, h, n, us, length = struct.unpack("<4sIIQQI", buf[:32])
            assert magic == b"BWG1", buf[:32]
            if len(buf) < 32 + length:
                break
            frames.append((w, h, n, us, length))
            buf = buf[32 + length:]
        time.sleep(0.01)
    os.close(fd)
    assert len(frames) >= 3, frames
    assert all((w, h, length) == (64, 36, 64 * 36 * 3 // 2) for w, h, _, _, length in frames), \
        frames
    assert all(b[2] > a[2] and b[3] > a[3] for a, b in zip(frames, frames[1:])), frames
    ctl.command("mirror glass stream=i420 size=32x18 fps=5 id=b")
    assert ctl.wait(lambda h: "error mirror busy id=b" in h), ctl.heard
    ctl.command("mirror glass off")
    assert wait_for(lambda: not os.path.exists(path), 2), "off left the fifo"
    ctl.close()


def glass_frames(ctl, paths, n, timeout=4.0):
    """The headers of the first `n` whole frames on each glass fifo in
    `paths`, read side by side: {path: [(w, h, number, us, length)]}."""
    fds = {p: os.open(p, os.O_RDONLY | os.O_NONBLOCK) for p in paths}
    bufs, got = {p: b"" for p in paths}, {p: [] for p in paths}
    until = time.monotonic() + timeout
    try:
        while any(len(f) < n for f in got.values()) and time.monotonic() < until:
            ctl.pump()
            for p, fd in fds.items():
                with contextlib.suppress(BlockingIOError):
                    bufs[p] += os.read(fd, 1 << 20)
                while len(bufs[p]) >= 32:
                    magic, w, h, num, us, length = struct.unpack("<4sIIQQI", bufs[p][:32])
                    assert magic == b"BWG1", bufs[p][:32]
                    if len(bufs[p]) < 32 + length:
                        break
                    got[p].append((w, h, num, us, length))
                    bufs[p] = bufs[p][32 + length:]
            time.sleep(0.01)
    finally:
        for fd in fds.values():
            os.close(fd)
    return got


def streams_offered(ctl):
    """How many glass streams a wall runs at once, as its `caps` says: the
    number after `streams=`, 1 where it says `stream` alone, 0 where it
    does not stream."""
    ctl.command("report id=c")
    assert ctl.wait(lambda h: any(x.startswith("caps ") for x in h)), ctl.heard
    words = next(x for x in ctl.heard if x.startswith("caps ")).split()
    said = next((w.split("=", 1)[1] for w in words if w.startswith("streams=")), None)
    return int(said) if said and said.isdigit() else int("stream" in words)


@conformance(known_for=SHELL_NO_CONTROLLERS)
def a_wall_that_says_streams_runs_several_each_at_its_own_size(r):
    """On a wall whose `caps` says `streams=<n>`, a controller may hold
    several streams at once by `name=`, each on `s/<name>/glass-<name>` at
    the size and rate it asked for, beside another controller's on
    `glass`; the same name asked again is `busy`, `off name=` ends that
    one alone and `off` the rest of the session's; and past `n` a stream
    is refused."""
    ctl = connected(r, "ctl", "controller")
    n = streams_offered(ctl)
    if n < 2:
        ctl.close()
        return f"skipped: {r.name} runs {n} stream{'s' if n != 1 else ''} at once"
    other = connected(r, "other", "controller")
    ctl.command("mirror glass stream=i420 size=64x36 fps=20 name=big")
    ctl.command("mirror glass stream=i420 size=32x18 fps=10 name=small")
    other.command("mirror glass stream=i420 size=48x28 fps=10")
    paths = [os.path.join(ctl.dir, "glass-big"), os.path.join(ctl.dir, "glass-small"),
             os.path.join(other.dir, "glass")]
    assert wait_for(lambda: all(os.path.exists(p) for p in paths), 2), \
        f"no fifos; heard {ctl.heard} {other.heard}"
    got = glass_frames(ctl, paths, 3)
    for p, (w, h) in zip(paths, ((64, 36), (32, 18), (48, 28))):
        frames = got[p]
        assert len(frames) >= 3, (p, frames)
        assert all((fw, fh, ln) == (w, h, w * h * 3 // 2) for fw, fh, _, _, ln in frames), \
            (p, frames)
    ctl.command("mirror glass stream=i420 size=32x18 fps=5 name=big id=b")
    assert ctl.wait(lambda h: "error mirror busy id=b" in h), ctl.heard
    ctl.command("mirror glass off name=big")
    assert wait_for(lambda: not os.path.exists(paths[0]), 2), "off name= left its fifo"
    assert os.path.exists(paths[1]) and os.path.exists(paths[2]), "off name= ended the others"
    ctl.command("mirror glass off")
    assert wait_for(lambda: not os.path.exists(paths[1]), 2), "off left the session's stream"
    assert os.path.exists(paths[2]), "off ended another session's stream"
    for i in range(n - 1):
        ctl.command(f"mirror glass stream=i420 size=16x16 fps=1 name=s{i}")
    ctl.command("mirror glass stream=i420 size=16x16 fps=1 name=over id=f")
    assert ctl.wait(lambda h: f"error mirror glass: {n} streams already id=f" in h), ctl.heard
    other.close()
    ctl.close()


