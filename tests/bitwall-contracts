@conformance(known_for=SHELL_NO_ANSWERS)
def a_dead_door_is_known_at_once_and_a_stale_wall_is_taken_over(r):
    """Opening a door nobody reads fails without a wait; a session's
    `out` ending with no `closed` before it means the wall has gone; the
    receiver started again takes the wall over, sessions and all."""
    a = connected(r, "a")
    r.die()
    assert a.ended(2), "out did not end when the receiver died"
    assert not any(x.startswith("closed ") for x in a.heard), a.heard
    began = time.monotonic()
    try:
        knock(r.door, "open b layer")
    except AssertionError:
        pass
    else:
        raise AssertionError("a request at a dead door was taken")
    assert time.monotonic() - began < 0.5, "a dead door was waited on"
    a.close()
    r.start()
    assert not os.path.exists(a.dir), "a stale session survived the takeover"
    b = Caller(r, "a", "layer")
    assert b.opened, f"the wall taken over does not open: {b.heard}"
    b.close()


