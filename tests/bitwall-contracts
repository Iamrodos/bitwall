# ------------------------------------------------------------ the mirror
#
# `senders/mirror` shows one wall's glass on others. The fake wall does
# not stream its glass, so its parts are held here each on its own -- the
# fifo's reader, the choice of codec, the cutting of the stream and the
# fan-out to a slow and a fast destination -- and the whole of it run
# against a fake that streams as the painter does, with two fake walls
# taking what it sends.

MIRROR = os.path.join(ROOT, "senders", "mirror", "main.py")


def _mirror():
    import importlib.util
    spec = importlib.util.spec_from_file_location("mirror_main", MIRROR)
    m = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(m)
    return m


def glass_frame(w, h, n, us, y=16):
    """One raw frame as the painter writes it: the header, then I420."""
    body = bytes([y]) * (w * h) + bytes([128]) * (w * h // 2)
    return struct.pack("<4sIIQQI", b"BWG1", w, h, n, us, len(body)) + body


class StreamingFake(fakewall.FakeWall):
    """A fake wall that streams its glass raw as the painter does: on
    `mirror glass stream=i420 size= fps=` from a controller, `s/<name>/glass`
    is made and a frame written to it every 1/fps, numbered and timed, its
    grey stepping each frame. A frame nobody is ready for is let go, its
    number spent, and so is every `skip`th, to look like a busy painter.
    With `streams` it says `streams=<n>` in caps and runs that many at
    once, each by `name=` on `glass-<name>`, as the painter does; without,
    one at a time, as a painter that says no `streams` does."""

    def __init__(self, *a, skip=0, streams=0, **kw):
        self.glass_streams = {}
        self.asked_streams = []
        self.skip = skip
        self.streams = streams
        super().__init__(*a, **kw)

    def caps_line(self):
        more = f" streams={self.streams}" if self.streams else ""
        return super().caps_line().replace("caps ", "caps stream ", 1) + more

    def _cmd_mirror(self, s, m, tag, now):
        if m.args[:1] == ("glass",) and ("stream" in m.opts or m.args[1:2] == ("off",)):
            self.asked_streams.append(m.raw)
            name = m.opts.get("name", "")
            if m.args[1:2] == ("off",):
                self._halt_stream(s, name or None)
                return
            if (s, name) in self.glass_streams or (not self.streams and self.glass_streams) \
                    or len(self.glass_streams) >= max(1, self.streams):
                self._say(s, f"error mirror busy{tag}")
                return
            w, _, h = m.opts.get("size", "").partition("x")
            fps = float(m.opts.get("fps", "0"))
            path = os.path.join(s.path, "glass" + (f"-{name}" if name else ""))
            os.mkfifo(path, 0o600)
            halt = threading.Event()
            th = threading.Thread(target=self._stream, args=(path, int(w), int(h), fps, halt),
                                  daemon=True)
            self.glass_streams[(s, name)] = (halt, path)
            th.start()
            return
        return super()._cmd_mirror(s, m, tag, now)

    def _halt_stream(self, s, name=None):
        for key in [k for k in self.glass_streams if k[0] is s and name in (None, k[1])]:
            got = self.glass_streams.pop(key)
            got[0].set()
            with contextlib.suppress(OSError):
                os.unlink(got[1])

    def _end(self, s, reason):
        self._halt_stream(s)
        return super()._end(s, reason)

    def _stream(self, path, w, h, fps, halt):
        fd, n, t = None, 0, time.monotonic()
        while not halt.is_set():
            t += 1 / fps
            halt.wait(max(0.0, t - time.monotonic()))
            n += 1
            if self.skip and n % self.skip == 0:
                continue
            if fd is None:
                try:
                    fd = os.open(path, os.O_WRONLY | os.O_NONBLOCK)
                    os.set_blocking(fd, True)
                except OSError:
                    continue
            try:
                os.write(fd, glass_frame(w, h, n, int(time.time() * 1e6), (n * 8) % 220 + 16))
            except OSError:
                os.close(fd)
                fd = None
        if fd is not None:
            os.close(fd)


class KeepingFake(fakewall.FakeWall):
    """A fake wall that keeps the bytes of every stream on `data` that it
    shows, by session, for a check to read."""

    def __init__(self, *a, **kw):
        self.kept = collections.defaultdict(bytearray)
        super().__init__(*a, **kw)

    def _data_show(self, s, now, frame):
        if s.codec in ("h264", "hevc"):
            self.kept[s.name] += frame[3]
        return super()._data_show(s, now, frame)


def nal_types(data):
    return [data[m.end()] & 0x1F for m in re.finditer(b"\x00\x00\x01", data)]


@check
def the_mirror_reads_whole_frames_off_the_glass_fifo_however_they_arrive():
    """The mirror's reader takes a frame's header and its planes off the
    fifo whole, however short the reads the pipe gives it; says nothing
    when no writer is there; and calls a frame cut short or a header that
    is not one `Broken`."""
    m = _mirror()
    path = os.path.join(run_dir(), "glass")
    os.mkfifo(path)
    stop = threading.Event()
    fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK)
    try:
        assert m.read_frame(fd, stop) is None, "no writer is nothing"
        frames = [glass_frame(32, 18, n, 1_000_000 * n, 40 + n) for n in (5, 6, 9)]
        cut = glass_frame(32, 18, 10, 0)[:500]

        def write():
            w = os.open(path, os.O_WRONLY)
            data = b"".join(frames) + cut
            k = 0
            while k < len(data):
                step = random.choice((1, 7, 31, 200, 900))
                os.write(w, data[k:k + step])
                k += step
                time.sleep(0.0005)
            os.close(w)
        th = threading.Thread(target=write)
        th.start()
        got = []
        while len(got) < 3:
            f = m.read_frame(fd, stop)
            if f is None:
                time.sleep(0.005)
                continue
            got.append(f)
        assert [(w, h, n, us) for w, h, n, us, _ in got] == \
            [(32, 18, 5, 5_000_000), (32, 18, 6, 6_000_000), (32, 18, 9, 9_000_000)], got
        assert all(len(p) == 32 * 18 * 3 // 2 and p[0] == 40 + n and p[-1] == 128
                   for _, _, n, _, p in got), "the planes are not the frame's"
        th.join()
        try:
            m.read_frame(fd, stop)
        except m.Broken as e:
            assert "cut short" in str(e), e
        else:
            raise AssertionError("a frame cut short was taken")
        w = os.open(path, os.O_WRONLY)
        os.write(w, b"BWG2" + bytes(28))
        try:
            m.read_frame(fd, stop)
        except m.Broken as e:
            assert "not a frame" in str(e), e
        else:
            raise AssertionError("a header that is not one was taken")
        os.close(w)
    finally:
        os.close(fd)


@check
def the_mirror_pairs_each_destination_with_what_both_ends_do_best():
    """Hardware at both ends first, then x264 here to a hardware decoder,
    then MJPEG to a hardware decoder; otherwise refused, saying why, and
    `--codec` sends what a destination takes at all. A destination is sent
    the source's shape, no bigger than its glass, the cap or the source."""
    m = _mirror()

    def encoders(*names):
        return m.Encoders(works=lambda name: name in names)
    mac = encoders("h264_videotoolbox", "hevc_videotoolbox", "libx264", "mjpeg")
    pi5 = encoders("libx264", "mjpeg")
    pi3 = ("qoi", "h264"), ("h264",)
    pi5w = ("qoi", "hevc", "h264"), ("hevc",)
    web = ("qoi", "mjpeg", "h264", "hevc"), ("h264", "hevc")
    jpeg = ("qoi", "mjpeg", "h264"), ("mjpeg",)
    cases = [
        (mac, pi3, None, ("h264", "h264_videotoolbox")),
        (mac, pi5w, None, ("hevc", "hevc_videotoolbox")),
        (mac, web, None, ("hevc", "hevc_videotoolbox")),
        (pi5, pi3, None, ("h264", "libx264")),
        (pi5, web, None, ("h264", "libx264")),
        (pi5, jpeg, None, ("mjpeg", "mjpeg")),
        (pi5, pi5w, None, (None, None)),
        (pi5, pi5w, "h264", ("h264", "libx264")),
        (pi5, pi3, "mjpeg", ("mjpeg", None)),
        (mac, pi3, "h264", ("h264", "h264_videotoolbox")),
        (pi5, ((), ()), None, (None, None)),
        (encoders(), pi3, None, (None, None)),
    ]
    for enc, (codecs, hw), force, want in cases:
        codec, name, why = m.pair(codecs, hw, enc, force)
        got = (codec, name)
        assert got == want or (want[0] is None and name is None), (codecs, hw, force, got, why)
        assert why, "a choice says why"
    _, _, why = m.pair(*pi5w, pi5)
    assert "--codec h264" in why and "hw=hevc" in why, why
