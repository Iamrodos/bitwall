@conformance(known_for=SHELL_NO_TIMEOUT)
def a_sender_killed_outright_is_closed_eof(r):
    """`kill -9` on a sender closes its end of `in`, and the wall sees
    end of file; nothing else tells it."""
    c = Caller(r, "doomed", "layer")
    assert c.opened
    proc = spawn(["sh", "-c", f"exec cat > {shlex.quote(os.path.join(c.dir, 'in'))}"],
                 stdin=subprocess.PIPE)
    proc.stdin.write(protocol.command("report").encode())
    proc.stdin.flush()
    assert c.wait(lambda h: any(x.startswith("area ") for x in h)), c.heard
    proc.send_signal(signal.SIGKILL)
    proc.wait(3)
    assert c.wait(lambda h: "closed doomed eof" in h), c.heard
    assert c.ended(2)
    c.close()


