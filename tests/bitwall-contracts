# ------------------------------------------------ a video base, and data
#
# PROTOCOL.md's "A video base" and "The data pipe". Whether a layer is up
# is asked of the fake directly, and of any other receiver as a picture
# of the session or its measure line.

def layer_up(r, name):
    """Whether session `name` shows a frame: the fake's record, or else a
    picture of it asked on a controller of the check's own."""
    fake = getattr(r, "fake", None)
    if fake is not None:
        s = fake.session(name)
        return s is not None and fake.above.get(s.z) is s and s.z in fake.pics
    c = Caller(r, f"up-{random.randrange(1 << 20):05x}", "controller")
    try:
        if not c.opened:
            return None
        c.command(f"picture {name} id=p")
        c.wait(lambda h: any(x.startswith(f"error picture {name}") for x in h)
               or c.frames, 1.5)
        c.wait_frames(lambda f: f, 0.2)
        return bool(c.frames)
    finally:
        c.close()


def measured(r, name, seconds, test=None, then=None):
    """The measure lines of session `name` over `seconds`, each as a dict,
    heard on a controller of the check's own; early once one passes
    `test`. `then` is run once the first line has come, so what it does
    is counted in the lines after."""
    c = Caller(r, f"ms-{random.randrange(1 << 20):05x}", "controller")
    got = []
    try:
        if not c.opened:
            return got
        c.command("measures 200")
        until = time.monotonic() + seconds
        seen = 0
        while time.monotonic() < until:
            c.idle(0.1)
            for line in c.heard[seen:]:
                if line.startswith("measure ") and f" session={name} " in line:
                    got.append(dict(w.split("=", 1) for w in line.split()[1:] if "=" in w))
            seen = len(c.heard)
            if then is not None and got:
                then()
                then = None
                continue
            if test and got and test(got):
                break
    finally:
        c.close()
    return got


def data_in(c):
    """A writer's end of a session's `data`, once the wall holds it."""
    return open_writer(os.path.join(c.dir, "data"), 2.0)


def codecs_of(r):
    """The codecs a receiver's `caps` says a stream may be."""
    c = connected(r, f"cp-{random.randrange(1 << 20):05x}", "controller")
    c.command("report id=r")
    c.wait(lambda h: any(x.startswith("caps ") for x in h))
    caps = next((x for x in c.heard if x.startswith("caps ")), "").split()
    c.close()
    words = next((w[7:] for w in caps if w.startswith("codecs=")), "")
    return caps, words.split(",")


_clips = {}


def clip(codec):
    """One second of a test pattern at 10 frames a second, Annex B, in
    `codec`; None where this machine's ffmpeg cannot make it."""
    if codec in _clips:
        return _clips[codec]
    ff = shutil.which("ffmpeg")
    out = None
    encoders = {"h264": ("libx264", "h264_videotoolbox"),
                "hevc": ("libx265", "hevc_videotoolbox")}[codec]
    for enc in encoders if ff else ():
        path = os.path.join(run_dir(), f"clip.{codec}")
        made = subprocess.run(
            [ff, "-hide_banner", "-loglevel", "error", "-y", "-f", "lavfi",
             "-i", "testsrc2=size=128x72:rate=10", "-t", "1", "-pix_fmt", "yuv420p",
             "-c:v", enc, "-f", codec, path], capture_output=True)
        if made.returncode == 0 and os.path.getsize(path) > 0:
            with open(path, "rb") as fh:
                out = fh.read()
            break
    _clips[codec] = out
    return out


