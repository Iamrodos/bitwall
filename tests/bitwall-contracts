_checks = []


def check(fn):
    _checks.append(fn)
    return fn


def known(reason):
    """Mark a check as a contract the code is known not to keep."""
    def mark(fn):
        fn.known = reason
        return fn
    return mark


def alone(fn):
    """Mark a check to run with nothing beside it: one that times the
    receiver against the protocol's clocks, which the tests run fast, and
    that a machine busy with other checks makes miss them. Under the other
    decorators, so each check they make is marked."""
    fn.alone = True
    return fn


# ------------------------------------------------------------ housekeeping
#
# Everything started here is started in a run directory made here, and
# everything is stopped at exit whether or not the check that started it
# finished. The run directories are the only thing anything is matched
# by, so nothing that belongs to somebody else can be touched.

_runs = []
_procs = []


def run_dir():
    path = tempfile.mkdtemp(prefix="bwc-")
    _runs.append(path)
    return path


def _leftovers(paths):
    """Processes whose command line names one of our run directories."""
    out = subprocess.run(["ps", "-axo", "pid=,command="],
                         capture_output=True, text=True).stdout
    found = []
    for line in out.splitlines():
        pid, _, cmd = line.strip().partition(" ")
        if any(p in cmd for p in paths) and int(pid) != os.getpid():
            found.append((int(pid), cmd.strip()))
    return found


def _stop(proc, sig=signal.SIGTERM):
    if proc.poll() is None:
        try:
            proc.send_signal(sig)
            proc.wait(timeout=3)
        except Exception:
            proc.kill()
            proc.wait(timeout=3)


@atexit.register
def _clean_up():
    for proc in _procs:
        with contextlib.suppress(Exception):
            _stop(proc)
    for pid, _ in _leftovers(_runs):
        with contextlib.suppress(ProcessLookupError):
            os.kill(pid, signal.SIGTERM)
    for path in _runs:
        shutil.rmtree(path, ignore_errors=True)


def spawn(argv, **kw):
    kw.setdefault("stdout", subprocess.DEVNULL)
    kw.setdefault("stderr", subprocess.DEVNULL)
    proc = subprocess.Popen(argv, **kw)
    _procs.append(proc)
    return proc


def free_port():
    import socket
    with socket.socket() as s:
        s.bind(("127.0.0.1", 0))
        return s.getsockname()[1]


def wait_for(test, timeout, step=0.02):
    """Poll `test` until it is true or the time is up; its last answer."""
    until = time.monotonic() + timeout
    while True:
        got = test()
        if got or time.monotonic() >= until:
            return got
        time.sleep(step)


@contextlib.contextmanager
def captured_stderr():
    """What this process and its children write to fd 2, as a list of one.

    Taken at the descriptor rather than `sys.stderr`, because the thing a
    sender would say is as likely to come from the `cat` it runs.
    """
    said = [""]
    saved = os.dup(2)
    with tempfile.TemporaryFile() as fh:
        os.dup2(fh.fileno(), 2)
        try:
            yield said
        finally:
            sys.stderr.flush()
            os.dup2(saved, 2)
            os.close(saved)
            fh.seek(0)
            said[0] = fh.read().decode("utf-8", "replace")


# --------------------------------------------------------------- the pipes

def open_writer(path, timeout=3.0):
    """A writer's end of a fifo, once a receiver is holding it."""
    def attempt():
        try:
            return os.open(path, os.O_WRONLY | os.O_NONBLOCK)
        except OSError as e:
            if e.errno in (errno.ENXIO, errno.ENOENT):
                return None
            raise
    fd = wait_for(attempt, timeout)
    assert fd is not None, f"nothing is reading {path}"
    os.set_blocking(fd, True)
    return fd


def grid_of(cols, rows, ch=" ", fg="default", bg="default"):
    return [[cell(ch, fg, bg) for _ in range(cols)] for _ in range(rows)]


def frame(cols, rows, marker, fg="ff8800"):
    """A full frame with `marker` written at the top left."""
    g = grid_of(cols, rows, ".", "444444")
    for i, ch in enumerate(marker[:cols]):
        g[0][i] = cell(ch, fg)
    return serialise(g, None, True, cols, rows)


# --------------------------------------------------------------- receivers
#
# One adapter per receiver that runs here. Each starts the real program in
# a run directory of its own and gives the checks the same handful of
# things: a way to write to it, a screen to read back, and a way to change
# the size of what it is painting on.

class Receiver:
    name = ""
    title = ""
    cols, rows = 60, 16
    #: The wall it makes, under `<run>/bitwall/`.
    wall = "0"
    #: Its clocks, as `fakewall.Timings` has them.
    t = fakewall.Timings(1.0)

    def __init__(self):
        self.run = None
        self.proc = None
        self.painted = bytearray()
        self._lock = threading.Lock()

    @property
    def wall_dir(self):
        return os.path.join(self.run, "bitwall", self.wall)

    @property
    def door(self):
        return os.path.join(self.wall_dir, "door.in")

    def die(self):
        """Go as a killed receiver goes: nothing said, nothing tidied."""
        if self.proc is not None:
            self.proc.kill()
            self.proc.wait(3)
            self.proc = None

    def reset(self):
        self.cols, self.rows = type(self).cols, type(self).rows
        self.font = 14
        self.painted = bytearray()

    @contextlib.contextmanager
    def running(self):
        self.reset()
        self.run = run_dir()
        self.start()
        try:
            yield self
        finally:
            self.stop()

    def screen(self):
        with self._lock:
            return bytes(self.painted).decode("utf-8", "replace")

    def _collect(self, data):
        with self._lock:
            self.painted += data

    def shows(self, text, timeout=1.5):
        return wait_for(lambda: text in self.screen(), timeout)

    def stop(self):
        if self.proc is not None:
            _stop(self.proc)
            self.proc = None

    def restart(self):
        """Stop the program and start it again on the same run directory."""
        if self.proc is not None:
            _stop(self.proc)
            self.proc = None
        self.start()


class FakeWallReceiver(Receiver):
    """`tests/fakewall.py`, in this process, on clocks a tenth of
    PROTOCOL.md's.

    A check drives its fifos as it would a receiver in another process.
    What the fake recorded is at `fake`, for a check that wants to know
    what reached the wall; `screen` is the paint the base sent.
    """

    name = "fake"
    title = "the fake wall"
    t = fakewall.Timings(0.1)

    def __init__(self):
        super().__init__()
        self.fake = None

    def start(self):
        self.fake = fakewall.FakeWall(self.run, self.wall, self.cols, self.rows,
                                      self.font, timings=self.t)

    def die(self):
        self.fake.stop()

    def stop(self):
        if self.fake is not None:
            errors = self.fake.errors
            self.fake.remove()
            self.fake = None
            assert not errors, f"the fake wall faulted while serving:\n{errors[0]}"

    def restart(self):
        self.die()
        self.start()

    def resize(self, cols, rows):
        self.cols, self.rows = cols, rows
        self.fake.resize(cols, rows)

    def screen(self):
        return self.fake.text()


SHELL = os.path.join(RECEIVERS_DIR, "shell", "bitwall-shell")


class ShellReceiver(Receiver):
    """`bitwall-shell`, on a pty of the size the check wants.

    What it cats to its terminal is what the pty's master reads, so that
    is the screen. It says its area once, from `stty size`, so `resize`
    changes the pty and nothing is announced.
    """

    name = "shell"
    title = "the shell receiver"

    def start(self):
        self.master, slave = os.openpty()
        self._winsize(self.rows, self.cols)
        # A session of its own: the receiver ends its whole process group
        # as it goes, and the checks are not part of it.
        self.proc = spawn([SHELL, self.wall], stdin=slave, stdout=slave,
                          env=dict(os.environ, BITWALL_RUN=self.run,
                                   BITWALL_FONT=str(self.font)),
                          start_new_session=True)
        os.close(slave)
        self._halt = threading.Event()
        self._reader = threading.Thread(target=self._read, daemon=True)
        self._reader.start()
        assert wait_for(lambda: fakewall.door_has_reader(self.door), 5), \
            "the shell receiver never made its door"

    def _winsize(self, rows, cols):
        fcntl.ioctl(self.master, termios.TIOCSWINSZ,
                    struct.pack("HHHH", rows, cols, 0, 0))

    def _read(self):
        while not self._halt.is_set():
            r, _, _ = select.select([self.master], [], [], 0.05)
            if not r:
                continue
            try:
                data = os.read(self.master, 65536)
            except OSError:
                break
            if data:
                self._collect(data)

    def resize(self, cols, rows):
        self.cols, self.rows = cols, rows
        self._winsize(rows, cols)

    def stop(self):
        super().stop()
        if getattr(self, "_reader", None) is not None:
            self._halt.set()
            self._reader.join(2)
            os.close(self.master)
            self._reader = None

    def restart(self):
        self.stop()
        self.start()


TERM = os.path.join(RECEIVERS_DIR, "term", "target", "release", "bitwall-term")


class TermReceiver(ShellReceiver):
    """`bitwall-term`, built for this machine with `cargo build --release`,
    on a pty of the size the check wants, as the shell receiver is. It
    reads the stream into a grid and draws what changed, so the screen is
    the pty's master as the terminal emulator reads it, and a resize is
    told to it as a terminal tells it, by SIGWINCH."""

    name = "term"
    title = "the term receiver"

    def start(self):
        self.master, slave = os.openpty()
        self._winsize(self.rows, self.cols)
        self.proc = spawn([TERM, self.wall], stdin=slave, stdout=slave,
                          env=dict(os.environ, BITWALL_RUN=self.run,
                                   BITWALL_FONT=str(self.font), TERM="xterm-256color"),
                          start_new_session=True)
        os.close(slave)
        self._halt = threading.Event()
        self._reader = threading.Thread(target=self._read, daemon=True)
        self._reader.start()
        assert wait_for(lambda: fakewall.door_has_reader(self.door), 5), \
            "the term receiver never made its door"

    def resize(self, cols, rows):
        super().resize(cols, rows)
        if self.proc is not None:
            self.proc.send_signal(signal.SIGWINCH)


