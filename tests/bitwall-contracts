def _node(script, data):
    node = shutil.which("node")
    work = tempfile.mkdtemp(prefix="bwc-js-")
    try:
        path = os.path.join(work, "run.js")
        with open(path, "w") as fh:
            fh.write(script)
        with open(os.path.join(work, "data.json"), "w") as fh:
            json.dump(data, fh)
        out = subprocess.run([node, path, WEB_JS,
                              os.path.join(work, "data.json")],
                             capture_output=True, text=True, timeout=20)
        if out.returncode != 0:
            raise AssertionError(f"node failed: {out.stderr[:400]}")
        return json.loads(out.stdout)
    finally:
        shutil.rmtree(work, ignore_errors=True)


_C_PEN = r"""
#include "%s"
int main(void)
{
    int v[] = {38, 2, 1, 2};
    Pen p;
    pen_reset(&p);
    pen_take(&p, v, 4);
    printf("%%d %%d %%d %%02x%%02x%%02x\n", p.bold, p.faint, p.fg_set,
           p.fg.r, p.fg.g, p.fg.b);
    return 0;
}
"""


def _c_pen():
    """What the C painter's pen makes of `38;2;1;2`, or None without cc."""
    cc = os.environ.get("CC") or shutil.which("cc") or shutil.which("clang")
    if not cc:
        return None
    work = tempfile.mkdtemp(prefix="bwc-c-")
    try:
        src = os.path.join(work, "pen.c")
        with open(src, "w") as fh:
            fh.write(_C_PEN % PAINT_C)
        stub = os.path.join(HERE, "paint", "stub")
        exe = os.path.join(work, "pen")
        # libpng as tests/paint/run finds it, where pkg-config knows it.
        png = subprocess.run(["pkg-config", "--cflags", "--libs", "libpng"],
                             capture_output=True, text=True) \
            if shutil.which("pkg-config") else None
        png = png.stdout.split() if png and png.returncode == 0 else ["-lpng"]
        built = subprocess.run(
            [cc, "-std=c99", "-w", "-DBITWALL_TEST", "-I" + stub, src,
             os.path.join(stub, "fake.c"), *png, "-pthread", "-o", exe],
            capture_output=True, text=True, timeout=60)
        if built.returncode != 0:
            raise AssertionError(f"cc failed: {built.stderr[:400]}")
        bold, faint, fg_set, rgb = subprocess.run(
            [exe], capture_output=True, text=True, timeout=10).stdout.split()
        return {"bold": bold == "1", "faint": faint == "1",
                "fg": rgb if fg_set == "1" else None}
    finally:
        shutil.rmtree(work, ignore_errors=True)


@check
def serialise_never_writes_a_truecolour_sgr_short_of_its_three_numbers():
    """Whatever a cell holds, `38;2` and `48;2` go out with r, g and b.

    So a truncated form reaching a receiver was cut by something other
    than bitwall, and what a receiver does with one is its own business.
    """
    odd = ("0102", "zzzzzz", "", "12345678", "ff00ff", 255, -1, 300, None)
    grid = [[cell("x", fg, bg) for fg in odd] for bg in odd]
    out = serialise(grid, None, True, len(odd), len(odd))
    for m in re.finditer(r"\x1b\[([\d;]*)m", out):
        ps = m.group(1).split(";")
        for i, p in enumerate(ps):
            if p in ("38", "48") and i + 1 < len(ps) and ps[i + 1] == "2":
                assert len(ps) >= i + 5, f"short form {m.group(0)!r}"


@check
def a_truncated_truecolour_sgr_means_the_same_to_every_reader():
    """`ESC[38;2;1;2m`, one number short, read by each thing that reads.

    The C painter on the Pi, the JavaScript in a tab, and the terminal
    emulator, which the terminal sources read through. Nothing sends this,
    so any answer will do, as long as it is one: each reads the 38 as
    nothing and the numbers after it as attributes, bold and faint here,
    with no colour.
    """
    from bitwall import terminal
    text = "\x1b[38;2;1;2mX"
    readers = {}
    if terminal.available():
        t = terminal.Terminal(4, 1)
        t.write(text.encode())
        c = t.cells()[0][0]
        t.close()
        readers["emulator"] = {"bold": bool(c[3]), "faint": len(c) > 8 and bool(c[8]),
                               "fg": None if c[1] == "default" else c[1]}
    if shutil.which("node"):
        js = _node(_JS_SGR, {"text": text})
        readers["page"] = {"bold": js["bold"], "faint": js["faint"],
                           "fg": None if js["fg"] == -1
                           else f"{js['fg']:06x}"}
    c_pen = _c_pen()
    if c_pen is not None:
        readers["painter"] = c_pen
    if len(readers) < 2:
        return "skipped: only one reader can run here"
    answers = {json.dumps(v, sort_keys=True) for v in readers.values()}
    assert len(answers) == 1, "; ".join(f"{k} {v}" for k, v in
                                        readers.items())
    missing = {"emulator", "page", "painter"} - set(readers)
    if missing:
        return f"skipped in part: {', '.join(sorted(readers))} agree; " \
            f"no {' or '.join(sorted(missing))} here"


# ------------------------------------------- the fake wall, as a Wall sees it
#
# The library's own clauses run a real `Wall` against `tests/fakewall.py`
# in this process, on PROTOCOL.md's clocks unless a check needs the wall's
# clocks to run faster. What the fake recorded is what reached the wall.

#: The fake wall's clocks for the library's clauses: PROTOCOL.md's own, so
#: nothing here is ended by a ping the library had two seconds to answer.
T = fakewall.Timings(1.0)


def a_fake(cols=40, rows=10, wall="0", run=None, **kw):
    """A fake wall in a run directory of its own, or in `run`."""
    kw.setdefault("timings", T)
    return fakewall.FakeWall(run or run_dir(), wall, cols, rows, 14, **kw)


# ------------------------------------------------------------------- panes
#
# `senders/panes` is a sender outward and receiver cores inward: these hold
# it to what PANES.md promises, with real senders on its panes and the fake
# wall as the real one.

def _panes():
    import importlib.util
    path = os.path.join(ROOT, "senders", "panes", "main.py")
    spec = importlib.util.spec_from_file_location("panes_main", path)
    m = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(m)
    return m


def _composed(fake):
    """The real wall's picture, as the stream drew it."""
    from bitwall.grid import Grid
    g = Grid(fake.cols, fake.rows)
    g.feed(fake.text())
    return ["".join(row) for row in g.ch]


def _pane_sender(here, name, ch):
    w = bitwall.attach("localhost", run=os.path.join(here, "bitwall", f"0-{name}"))
    w.set_source(lambda c, r: [[cell(ch, "ffffff", "000000")] * c for _ in range(r)])
    return w


@check
def panes_cut_a_wall_and_each_sender_draws_in_its_own():
    """A pane is a wall a sender attaches to as to any other, and what it
    draws lands at its rectangle on the real wall; `split`, `share`,
    `unsplit` and `layout`, asked of a pane on a controller session,
    reshape the panes, and each sender is told its new area."""
    panes = _panes()
    fake = a_fake(40, 10)
    here = run_dir()
    was = os.environ.get("BITWALL_PANES_KEEP")
    os.environ["BITWALL_PANES_KEEP"] = run_dir()
    p = panes.Panes("localhost", "left", 14, run=fake.dir, here=here)
    senders, ctls = [], []
    try:
        p.attach()
        assert wait_for(lambda: "left" in p.walls, 4), "no first pane"
        left = bitwall.Controller("localhost", run=os.path.join(here, "bitwall", "0-left")).open()
        ctls.append(left)
        caps = next(m for m in left.report if m.name == "caps")
        assert {"split", "unsplit", "share", "layout"} <= set(caps.args), caps.raw
        got = left.ask("split right right")
        assert [(m.name, m.args) for m in got] == [("split", ("right",))] \
            and got[0].opts.get("right-of") == "left", [m.raw for m in got]
        assert wait_for(lambda: "right" in p.walls, 4), "no second pane"
        a, b = _pane_sender(here, "left", "A"), _pane_sender(here, "right", "B")
        senders += [a, b]
        assert wait_for(lambda: a.area() == (20, 10) and b.area() == (20, 10), 4), \
            (a.area(), b.area())
        assert wait_for(lambda: _composed(fake)[0] == "A" * 20 + "B" * 20, 4), _composed(fake)
        left.ask("share 30")
        assert wait_for(lambda: a.area() == (12, 10) and b.area() == (28, 10), 4), \
            (a.area(), b.area())
        assert wait_for(lambda: _composed(fake)[9] == "A" * 12 + "B" * 28, 4), _composed(fake)
        lay = [m for m in left.ask("layout") if m.name == "pane"]
        assert [(m.args[0], m.args[1], m.opts.get("at")) for m in lay] == \
            [("left", "12x10", "0,0"), ("right", "28x10", "12,0")], [m.raw for m in lay]
        err = left.ask("split down right")
        assert err and err[0].raw.startswith("error split right: name in use"), [m.raw for m in err]
        right = bitwall.Controller("localhost", run=os.path.join(here, "bitwall", "0-right")).open()
        ctls.append(right)
        right.ask("unsplit")
        assert wait_for(lambda: a.area() == (40, 10), 4), a.area()
        assert wait_for(lambda: _composed(fake)[0] == "A" * 40, 4), _composed(fake)
        assert wait_for(lambda: "right" not in p.walls, 4), sorted(p.walls)
        assert not os.path.exists(os.path.join(here, "bitwall", "0-right")), "its wall stayed"
    finally:
        for c in ctls:
            c.close()
        for w in senders:
            w.detach()
        if p.w is not None:
            p.w.detach()
        p.stop()
        if was is None:
            os.environ.pop("BITWALL_PANES_KEEP", None)
        else:
