@check
def the_control_page_takes_a_socket_only_from_its_own_pages():
    """The page's socket is opened from a page served by the same host
    and port, or by a program that says no Origin; a page on any other
    origin is refused before the socket opens."""
    import aiohttp
    run = run_dir()
    devices = os.path.join(run, "devices.json")
    with open(devices, "w") as fh:
        json.dump([{"name": "here", "host": "localhost"}], fh)
    env = dict(os.environ, BITWALL_RUN=run, HOME=run, BITWALL_DEVICES=devices)
    port = free_port()
    spawn([sys.executable, CONTROL, "--host", "127.0.0.1", "--port", str(port)], env=env)
    url = f"http://127.0.0.1:{port}/ws"

    async def status(origin=None, host=None):
        headers = {k: v for k, v in (("Origin", origin), ("Host", host)) if v}
        async with aiohttp.ClientSession() as http:
            try:
                async with http.ws_connect(url, headers=headers) as ws:
                    first = json.loads((await ws.receive(timeout=5)).data)
                    return 101, first.get("type")
            except aiohttp.WSServerHandshakeError as e:
                return e.status, None

    async def up():
        async with aiohttp.ClientSession() as http:
            async with http.get(f"http://127.0.0.1:{port}/") as r:
                return r.status == 200
    assert wait_for(lambda: _quietly(lambda: asyncio.run(up())), 15), "the page never came up"
    assert asyncio.run(status())[0] == 101
    assert asyncio.run(status(f"http://127.0.0.1:{port}"))[0] == 101
    assert asyncio.run(status("https://host.example.ts.net", "host.example.ts.net"))[0] == 101
    for origin in ("http://evil.example", f"http://localhost:{port}",
                   f"http://127.0.0.1:{port + 1}", "null"):
        assert asyncio.run(status(origin))[0] == 403, origin
    assert asyncio.run(status("https://evil.example.com", "host.example.ts.net"))[0] == 403


def _quietly(fn):
    """`fn()`, or False where it raised."""
    try:
        return fn()
    except Exception:
        return False


