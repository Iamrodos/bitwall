@check
def a_layer_asks_for_a_place_and_reads_back_the_one_it_got():
    """`bitwall.layer(target, place)` asks for `above`, `top` or a number
    and reads back the z the wall gave; left unsaid, the place is
    `BITWALL_PLACE`, as a controller sets it, or `above`."""
    fake = a_fake(20, 4)
    with attached(fake) as w:
        up = w.layer(place="top")
        low = w.layer()
        at = w.layer(place=4)
        os.environ["BITWALL_PLACE"] = "top"
        try:
            env = w.layer()
        finally:
            del os.environ["BITWALL_PLACE"]
        assert (up.z, low.z, at.z, env.z) == (7, 1, 2, 6), (up.z, low.z, at.z, env.z)
        assert {fake.above[z].name for z in (1, 2, 6, 7)} == \
            {x._session.name for x in (up, low, at, env)}
        # The one beneath going moves the one above it down, and it knows.
        low.close()
        assert wait_for(lambda: at.z == 1, 3), f"a moved layer still thinks it is at {at.z}"
        for bad in ("any", -1, "middle"):
            try:
                w.layer(place=bad)
            except ValueError:
                pass
            else:
                raise AssertionError(f"place={bad!r} was taken")
        for x in (up, at, env):
            x.close()


