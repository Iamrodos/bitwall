@check
def the_mirror_cuts_its_encoders_stream_where_each_frame_begins():
    """The encoder's Annex B stream is passed on piece by piece, nothing
    lost or changed, each access unit's first piece saying so and whether
    it is a key; a key without parameter sets of its own carries the last
    ones seen, so a destination starting there can decode it."""
    m = _mirror()
    if shutil.which("ffmpeg") is None:
        return "skipped: no ffmpeg"
    raw = b"".join(glass_frame(64, 36, n, 0, (n * 9) % 220 + 16)[32:] for n in range(30))
    enc = subprocess.run(
        ["ffmpeg", "-hide_banner", "-loglevel", "error", "-f", "rawvideo", "-pix_fmt",
         "yuv420p", "-s", "64x36", "-r", "25", "-i", "pipe:0", "-c:v", "libx264",
         "-preset", "ultrafast", "-tune", "zerolatency", "-bf", "0", "-g", "10",
         "-x264-params", "repeat-headers=1", "-f", "h264", "pipe:1"],
        input=raw, capture_output=True)
    if enc.returncode:
        return f"skipped: no libx264 ({enc.stderr[-100:]!r})"
    # The same stream with its headers said once, at the start, as some
    # hardware encoders write it.
    data = enc.stdout
    at = [m.start() - (m.start() > 0 and data[m.start() - 1] == 0)
          for m in re.finditer(b"\x00\x00\x01", data)]
    nals = [data[a:b] for a, b in zip(at, at[1:] + [len(data)])]
    first = next(k for k, u in enumerate(nals) if u.lstrip(b"\x00")[1] & 0x1F == 5)
    once = b"".join(u for k, u in enumerate(nals)
                    if k < first or u.lstrip(b"\x00")[1] & 0x1F not in (7, 8))
    assert len(once) < len(enc.stdout), "the headers were not said again to take out"
    for extra, data in ((True, enc.stdout), (False, once)):
        cut = m.Cutter("h264")
        pieces, k = [], 0
        while k < len(data):
            step = random.choice((1, 3, 5, 64, 999, 4096))
            pieces += cut.feed(data[k:k + step])
            k += step
        pieces += cut.flush()
        assert b"".join(p for p, _ in pieces) == data, "the stream was changed"
        starts = [(i, s) for i, (_, s) in enumerate(pieces) if s is not None]
        assert len(starts) == 30, len(starts)
        assert [n for n, (_, s) in enumerate(starts) if s.key] == [0, 10, 20], \
            [s.key for _, s in starts]
        at = starts[10][0]
        prefix = starts[10][1].prefix
        if extra:
            assert prefix == b"", "a key with its own headers was given more"
        else:
            assert prefix and set(nal_types(prefix)) == {7, 8}, nal_types(prefix)
        tail = prefix + b"".join(p for p, _ in pieces[at:])
        probe = subprocess.run(["ffprobe", "-v", "error", "-count_frames", "-show_entries",
                                "stream=nb_read_frames", "-of", "csv=p=0", "-f", "h264", "-"],
                               input=tail, capture_output=True, text=False)
        assert probe.stdout.strip() == b"20", (extra, probe.stdout, probe.stderr[-200:])
    jp = m.JpegCutter()
    one = b"\xff\xd8" + b"\x01\xff\x00\x02" + b"\xff\xd9"
    got = jp.feed(b"junk" + one[:3]) + jp.feed(one[3:] + one) + jp.feed(one[:5])
    assert [p for p, _ in got] == [one, one] and all(s.key for _, s in got), got


class _Layer:
    """A layer as the mirror's destinations use one, held in memory: open
    at once, its writes kept, each taking `slow` seconds."""

    def __init__(self, slow=0.0):
        self.slow, self.got = slow, []
        self.open_now = self.has_data = False
        self.stopped, self.z, self.lost = None, 1, []

    def open(self, wait=None):
        self.open_now = self.has_data = True
        return self

    def when_lost(self, fn):
        self.lost.append(fn)

    def meta(self, **kw):
        pass

    def data_write(self, chunk, timeout=None):
        if self.slow:
            time.sleep(self.slow)
        self.got.append(bytes(chunk))
        return len(chunk)

    def data_end(self, wait=None):
        pass

    def close(self):
        self.open_now = False


@check
def a_slow_mirror_destination_skips_to_a_keyframe_and_holds_up_nobody():
    """Each destination has a writer and a queue of its own. One that
    cannot keep up has its queue let go and is skipped until the next
    keyframe, then picks up there; the other has every frame, in order,
    whatever the slow one does."""
    m = _mirror()
    stop = threading.Event()
    fast_layer, slow_layer = _Layer(), _Layer(slow=0.004)
    fast = m.Dest("fast", None, lambda start: fast_layer, stop, cap=64 << 10).start()
    slow = m.Dest("slow", None, lambda start: slow_layer, stop, cap=24 << 10).start()
    try:
        assert wait_for(lambda: fast.want and slow.want, 3), "the layers were not opened"
        n = 300
        for i in range(n):
            s = m.Start(i % 15 == 0, b"PS" if i % 15 == 0 else b"")
            s.index = i
            head = b"\x00\x00\x01" + i.to_bytes(4, "big")
            for d in (fast, slow):
                d.offer(head, s)
                d.offer(bytes(2000), None)
                d.offer(bytes(1000), None)
            time.sleep(0.001)
        assert wait_for(lambda: not fast.items and not slow.items, 10), "the queues did not drain"
        time.sleep(0.1)

        def frames(layer):
            out = []
            for chunk in layer.got:
                at = chunk.find(b"\x00\x00\x01")
                if at >= 0 and len(chunk) >= at + 7:
                    out.append((int.from_bytes(chunk[at + 3:at + 7], "big"), chunk[:at]))
            return out
        got = frames(fast_layer)
        assert [i for i, _ in got] == list(range(n)), "the fast destination lost frames"
        got = frames(slow_layer)
        idx = [i for i, _ in got]
        assert idx == sorted(idx) and len(idx) < n and slow.skips > 0, (len(idx), slow.skips)
        for (a, _), (b, pre) in zip(got, got[1:]):
            if b != a + 1:
                assert b % 15 == 0 and pre == b"PS", f"picked up at {b}, not at a key with headers"
        assert sum(len(c) for c in slow_layer.got) == sum(
            3 + 4 + 3000 + (2 if i % 15 == 0 and (k == 0 or i != idx[k - 1] + 1) else 0)
            for k, i in enumerate(idx)), "a frame went part written"
    finally:
        stop.set()


