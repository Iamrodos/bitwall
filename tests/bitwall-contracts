@conformance(known_for=SHELL_NO_ANSWERS)
def drops_a_malformed_request_and_a_name_in_use_with_the_holder_untouched(r):
    """Nothing is made and nothing is said for a request that is not
    `open`, has no name or a bad one, or has a word that is not
    `key=value`; nor for a name that is in use, whose holder hears
    nothing of it."""
    a = connected(r, "a")
    for bad in ("frob b layer", "open", "open B@d layer", "open c layer z",
                "open " + "x" * 33 + " layer"):
