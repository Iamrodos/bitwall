    assert "cells" in opts.get("types", "").split(","), caps
    assert protocol.number(opts.get("controllers")) is not None, caps
    for word in ("display", "watching", "presence", "accepts"):
        assert any(x.startswith(word + " ") or x == word + " id=k3" for x in report), \
