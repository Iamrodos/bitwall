@check
def the_painter_turned_says_its_glass_the_shape_it_hangs():
    """`--rotate 0=<deg>` turns the picture on the output: a quarter turn
    swaps the glass's sides, so the wall says its pixels, works out its
    area and takes its pictures the shape it hangs; half a turn keeps its
    shape. Only the GPU path turns it: in software it is drawn as it comes,
    and says the output's own shape."""
    if not PAINT_BIN:
        return "no C compiler here"
    for turn, software in ((90, False), (180, False), (270, False), (90, True)):
        r = PainterReceiver()
        r.extra = ("--rotate", f"0={turn}")
        with r.running():
            if software:
                r.software = True
                r.restart()
            w, h = r._pixels(r.cols, r.rows)
            want = (h, w) if turn in (90, 270) and not software else (w, h)
            ctl = connected(r, "ctl", "controller")
            pw, ph = glass_pixels(ctl)
            assert (pw, ph) == want, (turn, software, (pw, ph), want)
            area = next(x for x in ctl.heard if x.startswith("area "))
            assert area_of(area)[:2] == (pw // r.cell[0], ph // r.cell[1]), \
                (turn, software, area, (pw, ph))
            ctl.command("picture glass id=p")
            assert ctl.wait_frames(lambda f: f, 4), f"no picture; heard {ctl.heard}"
            assert qoi_size(ctl.frames[0][1]) == (pw, ph), (turn, software, ctl.frames[0][0])
            ctl.close()


