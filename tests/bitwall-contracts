class NoEmulator(Exception):
    """The terminal emulator a check reads a stream through is not built."""


def emulator(cols, rows):
    """bitwall.terminal at cols x rows, the emulator the terminal sources
    read through; a check that needs one and finds none is skipped."""
    from bitwall import terminal
    if not terminal.available():
        raise NoEmulator(f"skipped: no emulator at {terminal.library()}")
    return terminal.Terminal(cols, rows)


def shown(frames, cols, rows):
    """The screen after painting frames in order, as the terminal emulator
    reads them: each row's text, and the cells."""
    t = emulator(cols, rows)
    try:
        for _, data in frames:
            t.write(data)
        grid = t.cells()
    finally:
        t.close()
    return [["".join(c[0] for c in row)] for row in grid], grid


# ------------------------------------------------------- a video layer
#
# PROTOCOL.md's "A video layer", driven at the fifos. What the wall shows
# is read where the receiver can say it (`video_up`), and otherwise the
# clause holds it to what it says: a frame taken leaves the stream framed,
# so the command after its payload is answered.



def qoi_frame(w=4, h=3, rgba=(255, 128, 0, 200)):
    """A QOI image, w by h, every pixel one colour."""
    import numpy as np
    img = np.zeros((h, w, 4), np.uint8)
    img[...] = rgba
    return bitwall.video.qoi(img)


def frame_bytes(data, extra=""):
    """A frame line and its payload, as a sender writes them."""
    w = int.from_bytes(data[4:8], "big")
    h = int.from_bytes(data[8:12], "big")
    words = f"frame qoi {w}x{h} {extra} {len(data)}".split()
    return (protocol.APC + protocol.MARK + " " + " ".join(words) + protocol.ST).encode() + data


def video_up(r):
    """Whether the receiver shows a frame on its video layer, or None when
    it cannot be asked."""
    fake = getattr(r, "fake", None)
    if fake is None and hasattr(r, "video_up"):
        return r.video_up()
    return bool(fake.pics) if fake is not None else None


def answers(c, id_):
    """Whether the session still reads its `in` as commands: a `ping` with
    this id is answered."""
    c.command(f"ping id={id_}")
    return c.wait(lambda h: f"pong id={id_}" in h)


