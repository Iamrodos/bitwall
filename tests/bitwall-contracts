class Page:
    """A tab on the control page, as its websocket: what it has been told,
    what it knows from it of the walls and the records, and a way to ask."""

    def __init__(self, ws):
        self.ws, self.said, self.ref = ws, [], 0
        self.walls, self.running = {}, {}

    async def send(self, **msg):
        self.ref += 1
        await self.ws.send_str(json.dumps(dict(msg, ref=self.ref)))

    async def until(self, test, seconds):
        """Read what the page is told until `test` holds of the last
        message, or the time is up; the message, or None."""
        import aiohttp
        end = time.monotonic() + seconds
        while time.monotonic() < end:
            try:
                msg = await asyncio.wait_for(self.ws.receive(), max(0.05, end - time.monotonic()))
            except asyncio.TimeoutError:
                break
            if msg.type == aiohttp.WSMsgType.TEXT:
                m = json.loads(msg.data)
                self.said.append(m)
                if m["type"] == "state":
                    self.walls, self.running = dict(m["walls"]), m["running"]
                elif m["type"] == "wall":
                    self.walls[m["wall"]["key"]] = m["wall"]
                elif m["type"] == "running":
                    self.running = m["running"]
                if test(m):
                    return m
            elif msg.type != aiohttp.WSMsgType.BINARY:
                break
        return None


def on_the_page(port, drive):
    """`drive(page)` against a control page on `port`."""
    import aiohttp

    async def run():
        async with aiohttp.ClientSession() as http:
            async with http.ws_connect(f"http://127.0.0.1:{port}/ws") as ws:
                await drive(Page(ws))
    asyncio.run(run())


