def jpeg_size(data):
    """(w, h) of a JPEG that decodes whole, or None if it is not one."""
    from PIL import Image
    try:
        im = Image.open(io.BytesIO(data))
        if im.format != "JPEG":
            return None
        im.load()
        return im.size
    except Exception:
        return None


def pictures_said(c):
    """The formats a session's `report` says a picture of the glass may
    be, from its `pictures` line, `grid` left out."""
    c.command("report id=pf")
    assert c.wait(lambda h: any(x.startswith("pictures ") for x in h)), c.heard
    line = next(x for x in c.heard if x.startswith("pictures "))
    return [w for w in line.split()[1:] if w != "grid"]


def jpeg_offered(r, ctl):
    """Whether the wall says it makes JPEG pictures, held to what it
    should: the web receiver always, the painter where it was built with
    libjpeg, which is where its `images=` takes jpeg too."""
    offered = "jpeg" in pictures_said(ctl)
    if r.name == "web":
        assert offered, "the web receiver does not say pictures jpeg"
    if r.name == "pi":
        assert offered == ("jpeg" in images_said(ctl)), \
            "the painter's pictures and images= disagree about jpeg"
    return offered


@conformance(known_for=SHELL_NO_CONTROLLERS)
def a_picture_of_the_glass_is_a_jpeg_where_the_wall_says_it_makes_one(r):
    """`picture glass format=jpeg quality=<1-100>` is a JPEG of the glass
    at the size the QOI would be, said `jpeg` in its line, where the
    wall's `pictures` says jpeg; without `format` it is QOI as ever. A
    wall that does not say it refuses it as `not offered`, and a quality
    out of range, or without jpeg, or a format for a layer, is refused."""
    base = connected(r, "base")
    ctl = connected(r, "ctl", "controller")
    if (skip := no_glass(r, ctl)):
        return skip
    base.write("\x1b[1;1H\x1b[48;2;0;90;200mglass\x1b[0m")
    pw, ph = glass_pixels(ctl)
    if not jpeg_offered(r, ctl):
        ctl.command("picture glass format=jpeg id=n")
        assert ctl.wait(lambda h: "error picture format=jpeg: not offered id=n" in h), ctl.heard
        base.close()
        ctl.close()
        return
    ctl.frames = []
    ctl.command("picture glass size=64x36 format=jpeg quality=70 id=j")
    ctl.command("picture glass format=jpeg id=k")
    ctl.command("picture glass size=64x36 format=qoi id=q")
    ctl.command("picture glass size=64x36 id=r")
    assert ctl.wait_frames(lambda f: len(f) >= 4, 6), f"no pictures; heard {ctl.heard}"
    (w1, d1), (w2, d2), (w3, d3), (w4, d4) = ctl.frames[:4]
    fw, fh = fitted((pw, ph), (64, 36))
    assert w1 == ["picture", "glass", "jpeg", f"{fw}x{fh}", str(len(d1)), "id=j"], w1
    assert w2[:4] == ["picture", "glass", "jpeg", f"{pw}x{ph}"] and w2[-1] == "id=k", w2
    assert w3 == ["picture", "glass", "qoi", f"{fw}x{fh}", str(len(d3)), "id=q"], w3
    assert w4[:3] == ["picture", "glass", "qoi"] and qoi_size(d4) == (fw, fh), w4
    assert d3 == d4, "format=qoi is not the picture without a format"
    for ask, said in (("picture glass format=jpeg quality=0", "error picture quality=0: bad quality"),
                      ("picture glass format=jpeg quality=101",
                       "error picture quality=101: bad quality"),
                      ("picture glass format=jpeg quality=hi",
                       "error picture quality=hi: bad quality"),
                      ("picture glass quality=50", "error picture quality=50: only for jpeg"),
                      ("picture glass format=webp", "error picture format=webp: not offered"),
                      ("picture base format=jpeg",
                       "error picture base format=jpeg: only for the glass")):
        ctl.command(ask)
        assert ctl.wait(lambda h: said in h), f"{ask}: heard {ctl.heard}"
    base.close()
    ctl.close()
    # Decoded once the sessions are done with, since Pillow's first
    # import can outlast a ping on a busy machine.
    assert jpeg_size(d1) == (fw, fh), jpeg_size(d1)
    assert jpeg_size(d2) == (pw, ph), jpeg_size(d2)


