           (b"\x1b_bitwall frame qoi 9999x2 3\x1b\\abc", "error frame 9999x2: bad size"),
           (b"\x1b_bitwall frame qoi 2x2 hold=x 3\x1b\\abc", "error frame hold=x: bad value"),
           (b"\x1b_bitwall frame qoi 4x3 4 id=q\x1b\\junk",
            "error frame qoi: does not decode id=q")]
    for i, (data, said) in enumerate(bad):
        v.write(data)
        assert answers(v, f"k{i}"), f"after {said!r} the stream was lost: {v.heard}"
        assert said in v.heard, f"{said}: heard {v.heard}"
    # Last, since the wall then skips as many bytes as it was told.
    v.command("frame qoi 2x2 99999999")
    assert v.wait(lambda h: "error frame 99999999: too big" in h), v.heard
    v.close()


def image_frame(codec, w=4, h=3, rgb=(255, 0, 0), mode="RGB"):
    """A PNG or a JPEG, w by h, every pixel one colour."""
    from PIL import Image
    out = io.BytesIO()
    Image.new(mode, (w, h), rgb if mode != "CMYK" else (0, 255, 255, 0)).save(
        out, "PNG" if codec == "png" else "JPEG", quality=95)
    return out.getvalue()


def any_frame_bytes(codec, data, extra="", size=None):
    """A frame line in any codec and its payload, as a sender writes them."""
    w, h = size or protocol.image_size(codec, data)
    words = f"frame {codec} {w}x{h} {extra} {len(data)}".split()
    return (protocol.APC + protocol.MARK + " " + " ".join(words) + protocol.ST).encode() + data


def images_said(c):
    """The codecs a session's `caps` says a frame may be, as a list."""
    c.command("report id=im")
    assert c.wait(lambda h: any(x.startswith("caps ") for x in h)), c.heard
    caps = next(x for x in c.heard if x.startswith("caps ")).split()
    return next((w[7:].split(",") for w in caps if w.startswith("images=")), ["qoi"])


@conformance(known_for=SHELL_NO_VIDEO)
def a_png_and_a_jpeg_frame_are_shown_and_given_back_as_sent(r):
    """Where `caps` says `images=` with png and jpeg, a frame in either is
    taken, shown, and given back by `picture` as it was sent, its codec,
    its own size, where it went and the box it was drawn to."""
    v = connected(r, "v", z=1, type="video")
    images = images_said(v)
    assert "qoi" in images, images
    ctl = connected(r, "ctl", "controller")
    for codec in ("png", "jpeg"):
        if codec not in images:
            continue
        frame = image_frame(codec, 6, 5)
        v.write(any_frame_bytes(codec, frame, "at=12,34 size=60x50 hold=5000"))
        assert answers(v, codec), v.heard
        assert not [x for x in v.heard if x.startswith("error")], v.heard
        assert layer_up(r, "v") in (True, None), f"the {codec} frame is not up"
        ctl.frames.clear()
        ctl.command(f"picture v id={codec}")
        assert ctl.wait_frames(lambda f: f), f"no picture; heard {ctl.heard}"
        words, data = ctl.frames[0]
        assert words == ["picture", "v", codec, "6x5", "at=12,34", "size=60x50",
                         str(len(frame)), f"id={codec}"], words
        assert data == frame, f"the {codec} frame was not given back as it was sent"
    v.close()
    ctl.close()


