@contextlib.contextmanager
def host_run(path):
    """BITWALL_RUN set for a while, so a wall on a host that does not
    exist has a directory without the host being asked for one."""
    before = os.environ.get("BITWALL_RUN")
    os.environ["BITWALL_RUN"] = path
    try:
        yield
    finally:
        if before is None:
            del os.environ["BITWALL_RUN"]
        else:
            os.environ["BITWALL_RUN"] = before


