def keyed_clip():
    """Three seconds of H.264 at 10 frames a second with a key every
    three frames, its middle damaged: a run of slice bytes overwritten,
    the parameter sets and every start code left as they were. None
    where this machine's ffmpeg cannot make it."""
    ff = shutil.which("ffmpeg")
    if not ff:
        return None
    path = os.path.join(run_dir(), "keyed.h264")
    for enc in ("libx264", "h264_videotoolbox"):
        made = subprocess.run(
            [ff, "-hide_banner", "-loglevel", "error", "-y", "-f", "lavfi",
             "-i", "testsrc2=size=128x72:rate=10", "-t", "3", "-pix_fmt", "yuv420p",
             "-c:v", enc, "-g", "3", "-bf", "0", "-f", "h264", path], capture_output=True)
        if made.returncode == 0 and os.path.getsize(path) > 0:
            break
    else:
        return None
    with open(path, "rb") as fh:
        film = bytearray(fh.read())
    at = len(film) * 2 // 5
    nal = film.find(b"\0\0\1", at) + 3      # a slice in the middle
    end = film.find(b"\0\0\1", nal)
    for k in range(nal + 2, min(end - 2, nal + 400)):
        film[k] = (film[k] * 7 + 91) & 0xFF
        if film[k - 1] == 0 and film[k] in (0, 1, 3):
            film[k] = 0x55                  # no start code made, none taken
    return bytes(film)


@conformance(known_for=dict(NO_DATA, fake="decodes nothing: a film's bytes are up as they "
                                         "arrive, so it has no frames to count at their time"))
def a_film_damaged_on_the_way_plays_on_from_its_next_key(r):
    """A film whose frames are damaged part way through is not a stream
    that does not decode: nothing is said, and it plays on from its next
    key, frames counted in `fps` after the damage as before it."""
    if r.name == "web":
        wait_for(lambda: "h264" in codecs_of(r)[1], 10)
    caps, codecs = codecs_of(r)
    assert "data" in caps, caps
    film = keyed_clip() if "h264" in codecs else None
    if film is None:
        return
    v = connected(r, "dmg", z="above", type="video", data="1", codec="h264", fps="10")
    c = Caller(r, f"dm-{random.randrange(1 << 20):05x}", "controller")
    try:
        c.command("measures 200")
        assert c.wait(lambda h: any(x.startswith("measure ") for x in h), 3), c.heard
        fd = data_in(v)
        t0 = time.monotonic()
        os.write(fd, film)
        got, seen = [], 0
        while time.monotonic() - t0 < 5:
            c.idle(0.1)
            for line in c.heard[seen:]:
                if line.startswith("measure ") and " session=dmg " in line:
                    kv = dict(w.split("=", 1) for w in line.split()[1:] if "=" in w)
                    got.append((time.monotonic() - t0, float(kv.get("fps", "0").replace("-", "0"))))
            seen = len(c.heard)
        os.close(fd)
        late = [fps for t, fps in got if 2.4 <= t <= 3.6]
        assert any(f > 0 for f in late), f"nothing shown after the damage: {got}"
        assert not any(x.startswith("error data") for x in v.heard), v.heard
    finally:
        c.close()
        v.close()


