@check
def an_mjpeg_stream_is_cut_at_each_pictures_end():
    """MJPEG on `data` is cut into its JPEGs however the bytes arrive, a
    thumbnail's end-of-image in a header passed over; bytes that are no
    JPEG are refused."""
    from bitwall.receivers import stream as streams
    jpegs = [image_frame("jpeg", 16 + k, 9, (60 * k, 80, 200)) for k in range(4)]
    thumb = jpegs[3]
    jpegs[3] = thumb[:2] + b"\xff\xe1" + (2 + len(jpegs[0])).to_bytes(2, "big") \
        + jpegs[0] + thumb[2:]
    clip = b"".join(jpegs)
    for step in (1, 7, 300, len(clip)):
        c, got = streams.cutter("mjpeg"), []
        for p in range(0, len(clip), step):
            got += c.feed(clip[p:p + step])
        assert got == jpegs, f"in pieces of {step}: {[len(x) for x in got]}"
    for bad in (b"qoif" + bytes(20), jpegs[0][:2] + b"\x00" * 8):
        try:
            streams.cutter("mjpeg").feed(bad)
        except ValueError:
            continue
