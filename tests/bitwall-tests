def a_catalogue_of_scripts(top, entries, settings=None):
    """A catalogue at top/senders of `entries`, name to the shell an
    `available` script runs (None for an entry without one), each with a
    start script; and the host's settings beside it, as written."""
    cat = os.path.join(top, "senders")
    os.makedirs(cat, exist_ok=True)
    for name, body in entries.items():
        os.makedirs(os.path.dirname(os.path.join(cat, name)), exist_ok=True)
        spec = {"label": name, "description": "x"}
        for kind, text in (("start", ""), ("available", body)):
            if text is None:
                continue
            path = os.path.join(top, f"{name}.{kind}")
            os.makedirs(os.path.dirname(path), exist_ok=True)
            with open(path, "w") as fh:
                fh.write("#!/bin/sh\n" + text + "\n")
            os.chmod(path, 0o755)
            spec[kind] = os.path.relpath(path, os.path.dirname(os.path.join(cat, name)))
        with open(os.path.join(cat, name + ".json"), "w") as fh:
            json.dump(spec, fh)
    if settings is not None:
        with open(os.path.join(top, "catalogue.json"), "w") as fh:
            fh.write(settings)
    return cat


