import catalogue                                               # noqa: E402


def a_catalogue(top):
    """A made-up catalogue, as a host might have it: a plain file, a tree
    linked in from another repository, a single file linked in, and each
    kind of mistake."""
    def put(path, spec, raw=None):
        os.makedirs(os.path.dirname(path), exist_ok=True)
        with open(path, "w") as fh:
            fh.write(raw if raw is not None else json.dumps(spec))

    def run(path):
        os.makedirs(os.path.dirname(path), exist_ok=True)
        with open(path, "w") as fh:
            fh.write("#!/bin/sh\n")
        os.chmod(path, 0o755)

    font = {"type": "font", "label": "Font", "description": "Cells",
            "default": 14}
    cat = os.path.join(top, "senders")
    repo = os.path.join(top, "repo")
    run(os.path.join(top, "clock", "main.py"))
    put(os.path.join(cat, "clock.json"),
        {"label": "Clock", "description": "The time",
         "start": "../clock/main.py", "options": {"font": font}})
    run(os.path.join(repo, "video", "main.py"))
    put(os.path.join(repo, "catalogue", "video.json"),
        {"label": "Films", "description": "A film",
         "start": "../video/main.py",
         "options": {"mode": {"type": "choice", "label": "Mode",
                              "description": "Pixels", "default": "fine",
                              "choices": ["half", "fine"]},
                     "shuffle": {"type": "bool", "label": "Shuffle",
                                 "description": "Any order", "default": False}}})
    os.symlink(os.path.join(repo, "catalogue"), os.path.join(cat, "demos"))
    os.symlink(os.path.join(repo, "catalogue", "video.json"),
               os.path.join(cat, "film.json"))
    os.symlink(os.path.join(repo, "catalogue"), os.path.join(cat, "again"))
    os.symlink(cat, os.path.join(repo, "catalogue", "back"))
    os.symlink(os.path.join(top, "gone.json"), os.path.join(cat, "dangling.json"))
    put(os.path.join(cat, "broken.json"), None, raw="{not json")
    put(os.path.join(cat, "nostart.json"),
        {"label": "No start", "description": "x", "start": "./nope"})
    with open(os.path.join(top, "plain"), "w") as fh:
        fh.write("")
    put(os.path.join(cat, "noexec.json"),
        {"label": "No exec", "description": "x", "start": "../plain"})
    put(os.path.join(cat, "badopt.json"),
        {"label": "Bad", "description": "x", "start": "../clock/main.py",
         "options": {"font": dict(font, default=999)}})
    put(os.path.join(cat, "badname.json"),
        {"label": "Bad", "description": "x", "start": "../clock/main.py",
         "options": {"--rm -rf": font}})
    return cat


def walked(fn):
    with tempfile.TemporaryDirectory() as top:
        return fn(catalogue.walk(a_catalogue(top)), top)


