# ---------------------------------------------------------------- letters

def _ink(out):
    """A drawing as rows of booleans: where a cell has anything on it."""
    return [[c is not None for c in row] for row in out]


class _Wall:
    """Only what `letters.usable` asks of a wall."""

    def __init__(self, glyphs):
        self.glyphs = glyphs

    def can(self, *text):
        return all(protocol.covers(self.glyphs, t) for t in text)


