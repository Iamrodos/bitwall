@check
def an_invented_kind_is_not_a_press():
    for bad in ({"kind": "exec", "cmd": "whoami"}, {"kind": None},
                {}, "not a dict", None, 42, []):
        assert bitwall.clean_input(bad) is None


@check
def capabilities_are_only_names_we_know():
    got = bitwall.clean_caps({"touch": True, "keyboard": False, "buttons": 4,
                              "surprise": {"deep": [1, 2]},
                              "can": {"touch": True, "nonsense": True}})
    assert got == {"touch": True, "keyboard": False, "buttons": 4,
                   "can": {"touch": True}}, got

    assert bitwall.clean_caps({"touch": "yes", "buttons": 10 ** 9}) == {}
    assert bitwall.clean_caps(["not", "a", "dict"]) == {}
    assert bitwall.clean_caps(None) == {}


@check
def an_area_a_receiver_claims_is_bounded():
    """The area a receiver announces decides what the sender allocates."""
    run = tempfile.mkdtemp(prefix="bitwall-test-")
    try:
        w = bitwall.Wall("localhost", run=run)

        def size(text):
            said = protocol.parse(f"area {text}") if text else None
            if said is None:
                w._said.pop("area", None)
            else:
                w._said["area"] = said
            return w._read_report()

        assert size("120x34 14") == (120, 34, "14")
        assert size("99999x99999 14") is None, "an absurd area was believed"
        assert size(f"{bitwall.MAX_COLS + 1}x10 14") is None
        assert size("1900x900 14") is None, "over MAX_CELLS believed"
        assert size("0x0 14") is None
        assert size("-5x-5 14") is None
        assert size("abcxdef 14") is None
        assert size("") is None
        odd = size("120x34 " + "9" * 40)
        assert odd[2] == "?", "an absurd font was passed on"
    finally:
        shutil.rmtree(run, ignore_errors=True)


@check
def a_font_size_is_a_number_before_it_is_a_command():
    run = tempfile.mkdtemp(prefix="bitwall-test-")
    try:
        w = bitwall.Wall("localhost", run=run)
        for bad in ("14; touch /tmp/bitwall-pwned", "14", 0, -1,
                    bitwall.MAX_FONT + 1, 3.5, True, None):
            try:
                w.set_font_size(bad, wait=False)
            except ValueError:
                continue
            raise AssertionError(f"{bad!r} was accepted as a font size")
        assert not os.path.exists("/tmp/bitwall-pwned")
    finally:
        shutil.rmtree(run, ignore_errors=True)


@check
def a_watcher_count_is_a_small_number_or_nothing():
    run = tempfile.mkdtemp(prefix="bitwall-test-")
    try:
        w = bitwall.Wall("localhost", run=run)

        def watching(text):
            said = protocol.parse(f"watching {text}")
            if said is None:
                w._said.pop("watching", None)
            else:
                w._said["watching"] = said
            return w.watching()

        assert watching("2") == 2
        assert watching("0") == 0
        assert watching("9" * 400) is None
        assert watching("-1") is None
        assert watching("two") is None
    finally:
