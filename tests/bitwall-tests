# ---------------------------------------------------------- legacy blocks

#: The solid blocks of Symbols for Legacy Computing that both receivers
#: draw as geometry, beside the two eighths of Block Elements they lacked.
LEGACY = ([0x2594, 0x2595] + list(range(0x1FB00, 0x1FB3C))
          + list(range(0x1FB70, 0x1FB8C)) + list(range(0x1FBE4, 0x1FBE8))
          + list(range(0x1CD00, 0x1CDE6)) + list(range(0x1CEA0, 0x1CEB0)))

_FRACTION = {"ONE EIGHTH": 1 / 8, "ONE QUARTER": 1 / 4, "THREE EIGHTHS": 3 / 8,
             "HALF": 1 / 2, "FIVE EIGHTHS": 5 / 8, "THREE QUARTERS": 3 / 4,
             "SEVEN EIGHTHS": 7 / 8}
_F = "|".join(sorted(_FRACTION, key=len, reverse=True))


def _side(side, part):
    """The band `part` deep along one side of a cell, as a test of (u, v)."""
    return {"UPPER": lambda u, v: v < part, "LOWER": lambda u, v: v > 1 - part,
            "LEFT": lambda u, v: u < part, "RIGHT": lambda u, v: u > 1 - part}[side]


def _named(cp):
    """What a block's Unicode name says it covers, as a test of (u, v).

    Read from the name alone, so it is a second reading of the characters
    beside the receivers' tables, not a copy of them.
    """
    import unicodedata
    name = unicodedata.name(chr(cp))
    m = re.fullmatch(r"BLOCK (SEXTANT|OCTANT)-(\d+)", name)
    if m:
        down = 3 if m[1] == "SEXTANT" else 4
        parts = {int(d) - 1 for d in m[2]}
        return lambda u, v: int(v * down) * 2 + int(u * 2) in parts
    m = re.fullmatch(r"(VERTICAL|HORIZONTAL) ONE EIGHTH BLOCK-(\d+)", name)
    if m:
        lines = {int(d) - 1 for d in m[2]}
        if m[1] == "VERTICAL":
            return lambda u, v: int(u * 8) in lines
        return lambda u, v: int(v * 8) in lines
    m = re.fullmatch(rf"(UPPER|LOWER|LEFT|RIGHT) ({_F}) BLOCK", name)
    if m:
        return _side(m[1], _FRACTION[m[2]])
    m = re.fullmatch(r"(\w+) AND (\w+) ONE EIGHTH BLOCK", name)
    if m:
        a, b = _side(m[1], 1 / 8), _side(m[2], 1 / 8)
        return lambda u, v: a(u, v) or b(u, v)
    m = re.fullmatch(rf"(LEFT|RIGHT|UPPER|LOWER) ({_F}) "
                     rf"(UPPER|LOWER|LEFT|RIGHT) ({_F}) BLOCK", name)
    if m:
        a = _side(m[1], _FRACTION[m[2]])
        b = _side(m[3], _FRACTION[m[4]])
        return lambda u, v: a(u, v) and b(u, v)
    m = re.fullmatch(r"(UPPER|LOWER|MIDDLE) (CENTRE|LEFT|RIGHT) ONE QUARTER BLOCK",
                     name)
    if m:
        y0 = {"UPPER": 0, "LOWER": .5, "MIDDLE": .25}[m[1]]
        x0 = {"LEFT": 0, "RIGHT": .5, "CENTRE": .25}[m[2]]
        return lambda u, v: x0 <= u < x0 + .5 and y0 <= v < y0 + .5
    raise AssertionError(f"U+{cp:04X} {name}: a name this reader does not know")


def _samples(inside):
    """A shape at the centres of an 8 x 24 grid over its cell, row by row:
    fine enough to put every edge in eighths, quarters and thirds between
    two samples."""
    return "".join("1" if inside((i + .5) / 8, (j + .5) / 24) else "0"
                   for j in range(24) for i in range(8))


def _legacy_reference():
    return {cp: _samples(_named(cp)) for cp in LEGACY}


