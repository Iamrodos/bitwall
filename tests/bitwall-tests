@check
def a_local_run_moves_this_machines_walls_alone():
    """BITWALL_LOCAL_RUN is where this machine's walls are; every other
    host's are still asked of that host. BITWALL_RUN moves them all."""
    from bitwall.session import Link
    saved = {k: os.environ.pop(k, None) for k in ("BITWALL_RUN", "BITWALL_LOCAL_RUN")}
    try:
        os.environ["BITWALL_LOCAL_RUN"] = "//./pipe/bitwall-someone"
        assert Link("localhost:0")._run == "//./pipe/bitwall-someone/bitwall/0"
        assert Link("pi.local:1")._run is None, "a Pi's walls were moved too"
        os.environ["BITWALL_RUN"] = "/tmp/elsewhere"
        assert Link("pi.local:1")._run == "/tmp/elsewhere/bitwall/1"
    finally:
        for k, v in saved.items():
            os.environ.pop(k, None)
            if v is not None:
                os.environ[k] = v


@check
def the_relays_clock_answers_once_and_then_once_a_line():
    """`relay clock` says the time at once, and again for each line on
    stdin until it ends, so the mirror times each answer on a relay
    already running; asked with nothing on stdin it answers once."""
    import importlib.util
    once = subprocess.run(bitwall.relay.command("clock", python=sys.executable),
                          stdin=subprocess.DEVNULL, capture_output=True, text=True, timeout=30)
    assert once.returncode == 0 and len(once.stdout.split()) == 1, once.stdout + once.stderr
    assert abs(float(once.stdout) - time.time()) < 5, once.stdout
    p = subprocess.Popen(bitwall.relay.command("clock", python=sys.executable),
                         stdin=subprocess.PIPE, stdout=subprocess.PIPE)
    said = [float(p.stdout.readline())]
    for _ in range(2):
        p.stdin.write(b"\n")
        p.stdin.flush()
        said.append(float(p.stdout.readline()))
    p.stdin.close()
    assert p.wait(10) == 0 and said == sorted(said), said
    spec = importlib.util.spec_from_file_location(
        "mirror_main", os.path.join(ROOT, "senders", "mirror", "main.py"))
    m = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(m)
    from bitwall.session import Link
    off = m._relay_offset(Link("localhost"), 5)
    assert off is not None and abs(off) < 0.05, off


