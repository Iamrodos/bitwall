#!/usr/bin/env -S uv run --quiet --script
# /// script
# requires-python = ">=3.14"
# ///
"""What bitwall must keep being true.

    tests/bitwall-tests [word ...] [--skip word ...]

A word runs only the checks whose names hold it, and --skip leaves out
those that do: `--skip contracts --skip gpu --skip windows` is what runs
on a machine with no walls, as the GitHub workflow does.

Not a test of how a wall looks -- nothing here can tell you whether snake
is right or whether a film judders, and looking at the wall is still how
that is decided. These cover the things that break silently instead: a
contract two implementations depend on, and a boundary that stops a screen
from telling a sender what to do.

Nine groups:

    the wire       what `serialise` emits, including the frame delimiter
                   the receivers paint on
    the boundary   what a sender believes from a receiver, and what it
                   refuses
    both ends      the python that writes the stream and the javascript
                   that reads it, agreeing on a real frame
    the painter    the Pi's C painter, built against fakes and run under
                   the sanitizers; its own tests are in tests/paint
    the catalogue  what a sender host says it can run, walked over a
                   made-up catalogue of links, loops and bad files
    the letters    bitwall.letters: sizes, spacing, turns, fit, smoothing,
                   ghosts, cut edges, and the faint cell they travel in
    the terminal   a terminal program read into cells, by bitwall.terminal
                   and through tmux
    the contracts  every receiver that runs here, and a real Wall against
                   a fake one; its own checks are in tests/bitwall-contracts
    the GPU painter
                   the painter built for this machine and run on its own
                   GPU with no screen: the contracts again, and its pixels
                   (tests/painter-pixels), against v1's on a Pi among them

Both ends needs node, the painter needs a C compiler, the terminal needs
tmux and bitwall/vt/build run, the contracts need uv, and the GPU painter
a machine the Makefile builds one for, a Mac. Without one, that group is
skipped and said to be.
"""
import json
import os
import random
import re
import shutil
import subprocess
import sys
import tempfile
import time

HERE = os.path.dirname(os.path.abspath(__file__))
ROOT = os.path.dirname(HERE)
sys.path.insert(0, ROOT)
sys.path.insert(0, HERE)

import bitwall                                                 # noqa: E402
from bitwall import protocol                                   # noqa: E402
from bitwall import BLANK, cell, compose, serialise            # noqa: E402

RESET = "\x1b[0m"
CUP = re.compile(r"\x1b\[(\d+);(\d+)H")

_checks = []


def check(fn):
    _checks.append(fn)
    return fn


def grid_of(cols, rows, ch=" ", fg="default", bg="default"):
    return [[cell(ch, fg, bg) for _ in range(cols)] for _ in range(rows)]


# ------------------------------------------------------------------- wire

@check
def full_frame_is_wrapped_in_bare_resets():
    """A bare reset opens a full repaint and closes any frame that drew.

    Both receivers paint on this and nothing else marks a frame, so a
    change that drops either reset puts the band back on the wall.
    """
    g = grid_of(10, 3, "x", "ff8800")
    out = serialise(g, None, True, 10, 3)
    assert out.startswith(RESET), "a full frame must open with a bare reset"
    assert out.endswith(RESET), "a frame must close with a bare reset"


@check
def a_bare_reset_means_a_frame_boundary_and_nothing_else():
    """Exactly two in a full frame, exactly one in a delta.

    Every other SGR carries parameters, so a receiver can count these to
    know where a frame ends -- which is only true while this holds.
    """
    g = grid_of(20, 4, "a", "00ff00", "000040")
    full = serialise(g, None, True, 20, 4)
    assert full.count(RESET) == 2, f"full frame has {full.count(RESET)}"

    after = [row[:] for row in g]
    after[1][5] = cell("Z", "ff0000")
    delta = serialise(after, g, False, 20, 4)
    assert delta.count(RESET) == 1, f"delta has {delta.count(RESET)}"


@check
def an_unchanged_grid_emits_nothing():
    g = grid_of(12, 3, "q", "ffffff")
    assert serialise(g, g, False, 12, 3) == ""


@check
def a_delta_carries_only_what_changed():
    g = grid_of(40, 6, ".", "888888")
    after = [row[:] for row in g]
    after[3][7] = cell("!", "ff0000")
    delta = serialise(after, g, False, 40, 6)
    assert "!" in delta
    assert delta.count(".") <= 8, "a one-cell change redrew the grid"
    rows = {int(m.group(1)) for m in CUP.finditer(delta)}
    assert rows == {4}, f"a change in one row addressed rows {rows}"


@check
def every_run_is_positioned_before_it_is_drawn():
    """Nothing relies on where the cursor happened to be.

    A receiver keeps a cursor and no other state, so a run that assumed
    wrapping or a previous position would land in the wrong place.
    """
    g = grid_of(8, 2, "Z")
    out = serialise(g, None, True, 8, 2)
    body = out[len(RESET):]
    first = CUP.search(body)
    assert first is not None, "a frame drew nothing anywhere"
    assert first.start() == 0, "text is drawn before the cursor is placed"


@check
def the_wire_carries_only_cursor_moves_and_attributes():
    """No scrolling, no margins, no mode changes, no controls.

    A receiver that only knows CUP and SGR is a correct receiver, and
    stays one only while this is the whole vocabulary.
    """
    g = grid_of(16, 3, "w", 33, "004400")
    g[1][2] = cell("█", "ff00ff")
    out = serialise(g, None, True, 16, 3)
    finals = re.findall(r"\x1b\[[\d;]*([A-Za-z])", out)
    assert set(finals) <= {"H", "m"}, f"unexpected sequences: {set(finals)}"
    stripped = re.sub(r"\x1b\[[\d;]*[A-Za-z]", "", out)
    bad = [c for c in stripped if ord(c) < 32]
    assert not bad, f"control characters in the payload: {bad!r}"



@check
def a_look_worked_out_once_is_the_look_worked_out_every_time():
    """Remembering a cell's SGR changes the speed and never the bytes.

    Every depth, every attribute, and colours of every kind a cell may
    carry, against the same sequence worked out afresh.
    """
    from bitwall import stream
    rng = random.Random(7)
    colours = ["default", "red", 33, 196, 0, "004400", "ff00ff", "a4c2ff", "zzzzzz"]
    def fresh(fg, bg, bold, italics, underscore, strike, reverse, depth):
        p = ["0"] + [n for n, on in zip("13497", (bold, italics, underscore,
                                                  strike, reverse)) if on]
        p += stream._colour_params(fg, 30, depth)
        p += stream._colour_params(bg, 40, depth)
        return "\033[" + ";".join(p) + "m"
    for _ in range(4000):
        c = (rng.choice(colours) if rng.random() < 0.5
             else "%06x" % rng.randrange(1 << 24))
        c2 = (rng.choice(colours) if rng.random() < 0.5
              else "%06x" % rng.randrange(1 << 24))
        flags = [rng.random() < 0.3 for _ in range(5)]
        look = cell("x", c, c2, *flags)
        for depth in ("mono", "grey", "16", "256", "true"):
            got = stream._sgr(look, depth)
            want = fresh(*look[1:8], depth)
            assert got == want, (look, depth, got, want)
            assert stream._sgr(look, depth) == got, "a second asking differed"


# ---------------------------------------------------------------- compose

@check
def only_a_source_that_offers_arrays_needs_numpy():
    """bitwall, and every source that hands over cells, runs where numpy
    is not installed; the arrays path imports it when a source uses it."""
    run = subprocess.run(
        [sys.executable, "-c",
         "import sys; sys.path.insert(0, %r); import bitwall; "
         "bitwall.serialise([[bitwall.BLANK]], None, True, 1, 1); "
         "print('numpy' in sys.modules)" % ROOT],
        capture_output=True, text=True)
    assert run.returncode == 0, run.stderr
    assert run.stdout.strip() == "False", "importing bitwall imported numpy"


@check
def compose_clips_what_does_not_fit_and_pads_what_does_not_fill():
    big = grid_of(10, 4, "B")
    out = compose(big, 6, 2)
    assert len(out) == 2 and len(out[0]) == 6
    assert all(c[0] == "B" for c in out[0])

    small = grid_of(2, 1, "S")
    out = compose(small, 5, 3)
    assert out[0][0][0] == "S" and out[0][2] == BLANK
    assert out[2][0] == BLANK, "rows beyond the source must be blank"


@check
def a_source_that_says_nothing_changed_costs_nothing():
    """Returning None is not an empty grid; it means do not send."""
    run = tempfile.mkdtemp(prefix="bitwall-test-")
    try:
        w = bitwall.Wall("localhost", run=run)
        w.cols, w.rows = 20, 4
        w._prev = grid_of(20, 4, "x")
        # A frame is only built when something says it should be.
        assert serialise(w._prev, w._prev, False, 20, 4) == ""
    finally:
        shutil.rmtree(run, ignore_errors=True)


@check
def a_repaint_is_asked_for_rather_than_waited_for():
    """A receiver says `repaint`; the sender forces a full frame.

    The alternative -- a full repaint on a timer -- costs every wall a
    frame it has nothing to say in, forever. On a dashboard that was 83%
    of everything sent.
    """
    run = tempfile.mkdtemp(prefix="bitwall-test-")
    try:
        w = bitwall.Wall("localhost", run=run)
        w._force = False
        w._prev = object()
        w._told(protocol.parse("repaint"))
        assert w._force and w._prev is None, "a repaint asked for was not forced"
        # The backstop is long enough that it is not the mechanism.
        assert w.resync >= 10, "resync is still doing the work"
    finally:
        shutil.rmtree(run, ignore_errors=True)


# --------------------------------------------------------------- protocol

@check
def a_command_travels_in_the_frame_stream_without_being_painted():
    """An APC string is what a terminal ignores, which is the point.

    Commands share the stream with frames so that a receiver is still
    anything that can read a pipe. If a terminal drew them the whole
    arrangement would fall over.
    """
    stream = ("\x1b[1;1Hbefore"
              + protocol.command("font", 14)
              + "after\x1b[0m")
    paint, said = protocol.Commands().feed(stream)
    assert "\x1b_" not in paint, "a command was left in the paintable text"
    assert paint == "\x1b[1;1Hbeforeafter\x1b[0m"
    assert said == [protocol.Message("font", ("14",))]


@check
def a_command_cut_in_half_by_the_pipe_is_held_until_it_arrives():
    whole = "A" + protocol.command("blank", 1) + "B"
    for cut in range(1, len(whole)):
        r = protocol.Commands()
        paint1, said1 = r.feed(whole[:cut])
        paint2, said2 = r.feed(whole[cut:])
        assert paint1 + paint2 == "AB", f"cut at {cut}: {paint1 + paint2!r}"
        assert said1 + said2 == [protocol.Message("blank", ("1",))], \
            f"cut at {cut} lost the command"


@check
def a_glyph_cut_in_half_by_the_pipe_reaches_the_tab_whole():
    """What a receiver forwards must be the bytes that were sent.

    A wall of block and braille glyphs is a wall of multi-byte characters,
    and a pipe cuts wherever it fills. Decoding each read on its own turns
    the half that came first into U+FFFD, and the cells carrying it stay
    wrong until the sender's next full repaint -- which is what a viewer
    sees as a band of stale picture.
    """
    import codecs
    grid = grid_of(12, 3, ch="\u2580", fg="ff0000")
    raw = serialise(grid, None, True, 12, 3).encode("utf-8")
    for cut in range(1, len(raw)):
        dec = codecs.getincrementaldecoder("utf-8")("replace")
        held = protocol.Commands()
        out = "".join(held.feed(dec.decode(raw[a:b]))[0]
                      for a, b in ((0, cut), (cut, len(raw))))
        assert out.encode("utf-8") == raw, f"cut at {cut} corrupted the frame"


@check
def an_apc_that_never_ends_is_painted_rather_than_held_forever():
    """A command being assembled is bounded; anything longer is not one.

    Holding it costs a buffer that grows for as long as the stream runs
    and a rescan of all of it every time more arrives -- and a wall that
    quietly stopped painting says nothing about which end is at fault.
    """
    parser = protocol.Commands()
    painted = 0
    for _ in range(100):
        text, said = parser.feed("\x1b_never" + "x" * 500)
        painted += len(text)
        assert said == []
        assert len(parser.rest) <= protocol.MAX_MESSAGE, "held without bound"
    assert painted > 0, "an escape that never ends must reach the screen"


@check
def an_apc_that_is_not_ours_is_dropped_rather_than_painted():
    paint, said = protocol.Commands().feed("a\x1b_somebody else\x1b\\b")
    assert paint == "ab"
    assert said == []


@check
def the_packages_major_version_is_the_protocols():
    """A sender pinned to bitwall 1.x speaks the protocol a wall calls v1,
    so the two numbers move together or a pin means nothing. The Rust
    crates carry the same version and check it in their own tests."""
    major = int(bitwall.__version__.split(".")[0])
    assert major == protocol.VERSION, (bitwall.__version__, protocol.VERSION)
    assert protocol.TAG == f"v{major}", protocol.TAG
    for crate in ("bitwall/rust", "bitwall/receivers/core-rs", "bitwall/receivers/term",
                  "bitwall/receivers/eink", "senders/games/cells/rust"):
        with open(os.path.join(ROOT, crate, "Cargo.toml"), encoding="utf-8") as fh:
            said = re.search(r'^version = "([^"]+)"', fh.read(), re.M).group(1)
        assert said == bitwall.__version__, (crate, said, bitwall.__version__)


@check
def hello_says_how_to_read_everything_after_it():
    first = protocol.parse(protocol.hello())
    assert first.name == "hello"
    assert first.args == (protocol.TAG, protocol.GRAMMAR)
    assert protocol.TAG == "v1", "the version spelling is frozen"
    assert protocol.version_of(first) == protocol.VERSION

    # Tolerant of a receiver written before the prefix existed.
    assert protocol.version_of(protocol.parse("hello 1 line")) == 1
    assert protocol.version_of(protocol.parse("hello line")) is None
    assert protocol.version_of(protocol.parse("area 10x10 14")) is None


@check
def a_message_survives_a_round_trip():
    for name, args, opts in (("area", ("174x42", "14"), {}),
                             ("input", ("key",), {"key": "Return",
                                                  "mods": "ctrl"}),
                             ("caps", ("area", "touch"), {"version": "1"}),
                             ("repaint", (), {})):
        line = protocol.render(name, *args, **opts)
        back = protocol.parse(line)
        assert back == protocol.Message(name, args, opts), \
            f"{line!r} came back as {back!r}"


@check
def a_malformed_line_is_dropped_rather_than_raising():
    """This reads a pipe anybody can write to."""
    for bad in ("", "   ", "\x1b[2J", "a" * 5000, "name " + "x " * 200,
                "name key=", "name =value", "name a\x00b"):
        assert protocol.parse(bad) is None, f"{bad[:24]!r} was accepted"


@check
def a_value_with_a_space_travels_as_one_word():
    """An argument or a value holding what a word cannot -- whitespace, a
    control, `=`, `%` -- is percent-encoded and comes back as it went; a
    name or a key that is not a word, or an empty value, is refused."""
    for value in ("Back room", "a=b", "50%", "tab\there", "line\nbreak",
                  "Café ⣿", "%20 literal", "plain"):
        line = protocol.render("label", value, title=value)
        assert len(line.split()) == 3, line
        back = protocol.parse(line)
        assert back.args == (value,) and back.get("title") == value, (value, back)
    assert protocol.render("label", "plain") == "label plain"
    assert protocol.render("label", "Back room") == "label Back%20room"
    # A % that is no escape, as a sender wrote before values were encoded.
    assert protocol.parse("stats at=50% show=%zz").opts == {"at": "50%", "show": "%zz"}
    for bad in (lambda: protocol.render("two words"),
                lambda: protocol.render("name", **{"": "v"}),
                lambda: protocol.render("name", "")):
        try:
            bad()
        except ValueError:
            continue
        raise AssertionError("refused nothing")


@check
def lines_arrive_whole_however_the_pipe_cuts_them():
    said = [protocol.announce("hello", 1, "line"),
            protocol.announce("area", "174x42", "14"),
            protocol.announce("watching", 1)]
    whole = "".join(said)
    for size in (1, 3, 7, 40, 500):
        r = protocol.Lines()
        got = []
        for i in range(0, len(whole), size):
            got += r.feed(whole[i:i + size])
        assert [m.name for m in got] == ["hello", "area", "watching"], \
            f"chunks of {size} gave {[m.name for m in got]}"


@check
def an_option_is_read_as_a_number_only_when_it_is_one():
    m = protocol.parse("area cols=174 rows=42 font=huge")
    assert m.int("cols", 1, 1000) == 174
    assert m.int("rows", 1, 1000) == 42
    assert m.int("font", 1, 400) is None, "a word was read as a number"
    assert m.int("cols", 1, 100) is None, "out of range was accepted"
    assert m.int("missing", 1, 10, default=7) == 7


@check
def an_announced_area_is_bounded_like_a_published_one():
    """The pipe is not more trusted than the file was."""
    good = protocol.parse("area 174x42 14")
    assert bitwall.Wall._area_from(good) == (174, 42)
    for bad in ("area 99999x99999 14", "area 0x0 14", "area -5x-5 14",
                "area abcxdef 14", "area 1900x900 14", "area"):
        assert bitwall.Wall._area_from(protocol.parse(bad)) is None, bad


@check
def an_announced_press_becomes_the_same_dict_a_file_gave():
    """A sender cannot tell which way the press reached it."""
    said = protocol.parse("input key key=Return mods=ctrl")
    assert bitwall.clean_input(bitwall._as_press(said)) == {
        "kind": "key", "key": "Return", "mods": ["ctrl"]}

    said = protocol.parse("input tap cell=3,4 area=174,42")
    assert bitwall.clean_input(bitwall._as_press(said)) == {
        "kind": "tap", "cell": [3, 4], "area": [174, 42]}

    for bad in ("input key key=rm -rf", "input tap cell=9,9 area=2,2",
                "input exec cmd=whoami", "input"):
        said = protocol.parse(bad)
        got = bitwall.clean_input(bitwall._as_press(said)) if said else None
        assert got is None, f"{bad!r} was accepted as {got}"


