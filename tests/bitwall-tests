@check
def cut_edges_draw_slopes_with_diagonal_halves():
    """edges="cut" edges slopes with ◢◣◤◥ on SEGMENT and BLOCK; square,
    the default, never does, and HALF, whose edges fall on half cells,
    stays square; SEGMENT_CUT is SEGMENT cut."""
    from bitwall import letters as L
    tri = set("◢◣◤◥")

    def halves(out):
        return sum(1 for row in out for c in row if c and c[0] in tri)

    for font, opts in ((L.SEGMENT, {"height": 12}), (L.BLOCK, {}),
                       (L.HALF, {"scale": 2})):
        text = "MXZ" if font == L.SEGMENT else "O2S"
        square = L.rows(text, font, "ffffff", **opts)
        assert square == L.rows(text, font, "ffffff", edges="square", **opts)
        assert halves(square) == 0, font
        cut_ = L.rows(text, font, "ffffff", edges="cut", **opts)
        if font == L.HALF:
            assert cut_ == square, font
        else:
            assert halves(cut_), font
    cut = L.rows("MXZ 42", L.SEGMENT, "ffffff", height=12, edges="cut")
