@check
def a_press_of_a_kind_nobody_asked_for_is_not_carried():
    """A sender acts on the input it asked for, not on what arrives.

    A receiver reports what it likes, and the reporting is honest --
    somebody did press a key. Whether this sender is in the business of
    keys is its own question, and the answer cannot come from the same
    place the press did.
    """
    run = tempfile.mkdtemp(prefix="bitwall-test-")
    try:
        w = bitwall.Wall("localhost", run=run)
        w._told(protocol.parse("hello v1 line"))

        def press(line):
            w._told(protocol.parse(line))
            return w.input()

        assert press("input key key=a") is None, "asked for nothing"
        assert press("input tap cell=1,1 area=9,9") is None, "asked for nothing"

        w.want(keyboard=True)
        assert press("input key key=a") == {"kind": "key", "key": "a"}
        assert press("input tap cell=1,1 area=9,9") is None, "keys only"

        w.want(touch=True)
        assert press("input tap cell=1,1 area=9,9") is not None

        w.want(keyboard=False)
        assert press("input key key=a") is None, "turned off"
    finally:
        shutil.rmtree(run, ignore_errors=True)


@check
def a_screen_that_cannot_show_a_colour_is_not_sent_one():
    """Reducing on the way out is the point of announcing it.

    A receiver has to quantise anyway to paint at all, so an announcement
    that only informed the receiver would buy nothing. It buys something
    here: the cells that survive repeat, so they run together and the
    frame both shrinks and diffs smaller against the last.
    """
    grid = [[cell("#", "%02x%02x%02x" % (x * 2 % 256, y * 7 % 256, x % 256),
                  "default") for x in range(60)] for y in range(20)]
    sizes = {d: len(serialise(grid, None, True, 60, 20, d))
             for d in ("true", "256", "grey", "mono")}
    assert sizes["mono"] < sizes["true"] * 0.7, sizes
    assert sizes["256"] < sizes["true"], sizes
    # Two colours means two colours, whatever was composed.
    out = serialise(grid, None, True, 60, 20, "mono")
    assert "38;2;" not in out, "truecolour reached a one-ink screen"
    # A depth nobody defined is not a licence to mangle the picture.
    assert serialise(grid, None, True, 60, 20, "nonsense") == \
        serialise(grid, None, True, 60, 20, "true")


@check
def a_screen_may_slow_a_sender_but_never_hurry_one():
    """The rate is a ceiling the sender is held to, not a target.

    A sender drawing four frames a second has its own reason, and a screen
    willing to take sixty is not one of them. The other way round matters
    more: frames a panel cannot show are spent on the wire before anyone
    can decline them.
    """
    run = tempfile.mkdtemp(prefix="bitwall-test-")
    try:
        w = bitwall.Wall("localhost", run=run, min_frame=0.05)
        w._told(protocol.parse("hello v1 line"))
        assert w.depth == "true" and w.screen() == {}, "silence says nothing"

        w._told(protocol.parse("screen colour=mono rate=1"))
        assert w.depth == "mono"
        assert w.screen() == {"colour": "mono", "rate": 1}
        assert w.min_frame == 1.0, w.min_frame

        w._told(protocol.parse("screen colour=true rate=240"))
        assert w.min_frame == 0.05, "a fast screen must not hurry a sender"

        for bad in ("screen colour=lots", "screen rate=0",
                    "screen rate=99999", "screen"):
            w._told(protocol.parse(bad))
            assert w.depth in bitwall.DEPTHS
            assert w.min_frame >= 0.05
    finally:
        shutil.rmtree(run, ignore_errors=True)


@check
def a_screen_says_which_code_points_it_has_and_is_believed():
    """Coverage as CSS spells it, and silence meaning no constraint.

    The spelling is `unicode-range`, which exists for this exact question,
    and ranges rather than categories because a font either has a code
    point or it does not -- a name for the group it belongs to is a guess
    laid over the evidence.

    Saying nothing is the case that matters most: every sender written
    before this said nothing and must keep working, and a browser falling
    back through every font on the machine genuinely has no constraint to
    declare. So an absent claim is not a claim of ASCII.
    """
    spans = protocol.ranges("U+2500-257F,U+2580-259F,U+2800-28FF")
    assert spans == ((0x2500, 0x257F), (0x2580, 0x259F), (0x2800, 0x28FF))
    assert protocol.covers(spans, "\u2588\u2500\u2801")
    assert not protocol.covers(spans, "\uff66")
    assert not protocol.covers(spans, "A")
    # A word is covered only if every letter of it is.
    assert not protocol.covers(spans, "\u2588A")

    # Silence is not a refusal.
    assert protocol.covers(protocol.ranges(""), "\uff66")
    assert protocol.covers(protocol.ranges(None), "anything")

    # Nothing a receiver writes may make this raise or grow without bound.
    for bad in ("U+ZZZZ", "U+10-1", "nonsense", "U+", "-", "U+110000",
                ",,,,", "U+41-" , "u+0041"):
        got = protocol.ranges(bad)
        assert isinstance(got, tuple), bad
    assert len(protocol.ranges(",".join(["U+41"] * 500))) \
        <= protocol.MAX_RANGES

    run = tempfile.mkdtemp(prefix="bitwall-test-")
    try:
        w = bitwall.Wall("localhost", run=run)
        w._told(protocol.parse("hello v1 line"))
        assert w.can("\uff66"), "told nothing, so free as before"

        w._told(protocol.parse(
            "screen colour=true rate=30 glyphs=U+0020-007E,U+2500-259F"))
        assert w.can("\u2588") and w.can("A")
        assert not w.can("\u2801"), "braille was not claimed"
        assert not w.can("\u2588", "\u2801"), "all of them, or none"
        assert w.screen()["glyphs"] == ((0x20, 0x7E), (0x2500, 0x259F))

        # And it is the only part of `screen` a sender must act on itself,
        # so a receiver that claims nothing leaves the rate and the colour
        # doing their own work regardless.
        assert w.screen()["rate"] == 30 and w.depth == "true"
    finally:
        shutil.rmtree(run, ignore_errors=True)


