def _js_roundtrip(cols, rows, frames):
    """Feed real frames to the real parser, and get its grid back."""
    node = shutil.which("node")
    if not node:
        return None
    work = tempfile.mkdtemp(prefix="bitwall-js-")
    try:
        data = os.path.join(work, "frames.json")
        with open(data, "w") as fh:
            json.dump({"cols": cols, "rows": rows, "frames": frames}, fh)
        script = os.path.join(work, "run.js")
        with open(script, "w") as fh:
            fh.write(_JS % (json.dumps(os.path.join(
                ROOT, "bitwall", "receivers", "web", "bitwall-screen.js")),
                json.dumps(data)))
        out = subprocess.run([node, script], capture_output=True, text=True)
        if out.returncode != 0:
            raise AssertionError(f"node failed: {out.stderr[:400]}")
        return json.loads(out.stdout)
    finally:
        shutil.rmtree(work, ignore_errors=True)


_JS = """
const fs = require('fs');
global.window = global;
global.document = { createElement: () => ({ getContext: () => ({
  measureText: () => ({ width: 10 }) }), style: {} }),
  addEventListener: () => {} };
global.HTMLElement = class {};
global.customElements = { define: () => {} };
global.ResizeObserver = class { observe() {} disconnect() {} };
global.performance = { now: () => Date.now() };
global.requestAnimationFrame = () => 0;
global.location = {};
eval(fs.readFileSync(%s, 'utf8'));
const B = window.Bitwall;
const d = JSON.parse(fs.readFileSync(%s, 'utf8'));
const g = new B.Grid(d.cols, d.rows);
const p = new B.Parser(g);
p.cover();
const enc = new TextEncoder();
for (const f of d.frames) {
  const bytes = enc.encode(f.text);
  const n = f.chunks || 1;
  const size = Math.ceil(bytes.length / n);
  for (let i = 0; i < bytes.length; i += size)
    p.feed(bytes.slice(i, i + size));
}
const cells = [];
for (let y = 0; y < d.rows; y++) {
  const row = [];
  for (let x = 0; x < d.cols; x++) {
    const k = y * d.cols + x;
    row.push([String.fromCodePoint(g.ch[k]), g.fg[k], g.bg[k], g.at[k]]);
  }
  cells.push(row);
}
console.log(JSON.stringify({ cells: cells, covered: p.covered,
                             frames: p.frames }));
"""


def _as_js_colour(value):
    return -1 if value == "default" else int(value, 16)


@check
def the_javascript_parser_rebuilds_what_serialise_wrote():
    """The two implementations of the wire format, on a real frame.

    This is the one that breaks everything at once if it ever fails, and
    it fails silently: nothing errors, the wall just looks wrong.
    """
    cols, rows = 40, 8
    rnd = random.Random(7)
    glyphs = "abcXY0123 ." + "█▀▄┌─┴⠁"
    want = [[cell(rnd.choice(glyphs),
                  "default" if rnd.random() < .2 else
                  f"{rnd.randrange(1 << 24):06x}",
                  "default" if rnd.random() < .6 else
                  f"{rnd.randrange(1 << 24):06x}")
             for _ in range(cols)] for _ in range(rows)]
