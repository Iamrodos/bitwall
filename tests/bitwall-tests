@check
def a_key_is_one_printable_character_or_a_name_we_know():
    ok = ("a", "Z", "7", "-", "é", "Return", "Escape", "space", "F12")
    for k in ok:
        got = bitwall.clean_input({"kind": "key", "key": k})
        assert got == {"kind": "key", "key": k}, f"{k!r} was refused"

    refused = ("rm -rf ~", "a\x1b[2J", "\x03", "\n", "A" * 500, "",
               "Retrun", "ctrl-c", None, 42, ["a"])
    for k in refused:
        got = bitwall.clean_input({"kind": "key", "key": k})
        assert got is None, f"{k!r} was accepted as {got}"


