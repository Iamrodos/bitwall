@check
def a_turned_word_swaps_its_sides_and_reads_the_right_way():
    """Up reads from the bottom, down from the top, each a quarter turn."""
    from bitwall import letters as L
    upright = L.rows("LT", L.BLOCK, cell=1.0)
    for turn in ("up", "down"):
        c, r = L.size("LT", L.BLOCK, cell=1.0, turn=turn)
        assert (c, r) == (len(upright), len(upright[0])), (turn, c, r)
    up = _ink(L.rows("LT", L.BLOCK, cell=1.0, turn="up"))
    down = _ink(L.rows("LT", L.BLOCK, cell=1.0, turn="down"))
    ink = _ink(upright)
    wide, high = len(ink[0]), len(ink)
    for y in range(wide):
        for x in range(high):
            assert up[y][x] == ink[x][wide - 1 - y], ("up", x, y)
            assert down[y][x] == ink[high - 1 - x][y], ("down", x, y)
    # The L comes first: at the bottom going up, at the top going down.
    assert up[-1] == [True] * 5 and down[0] == [True] * 5
    got = L.size("TALL", L.SEGMENT, turn="up", height=20)
    assert got[1] <= 20, got


