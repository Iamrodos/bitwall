class _Screen:
    """A wall as far as letters asks of it: what it can draw, its depth,
    its screen and the font size its area is at."""

    def __init__(self, cell=None, font=None, depth="true", glyphs=()):
        self.cell, self.font_size, self.depth = cell, font, depth
        self.glyphs = glyphs

    def can(self, *text):
        return all(protocol.covers(self.glyphs, t) for t in text)

    def screen(self):
        return {"cell": self.cell} if self.cell else {}


