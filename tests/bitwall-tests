@check
def a_number_a_receiver_sends_is_one_python_will_take():
    """Deciding a word is a number and turning it into one must agree.

    `str.isdigit` is true of superscripts and of digits from other
    scripts, which `int` refuses. A guard written with one and a
    conversion written with the other lets a ValueError out of `input()`,
    `capabilities()` or `watching()` into the loop that called them --
    which is the sender's own, so one word from a receiver stops the wall.
    """
    for text in ("\u00b2", "--5", "9" * 200, "\uff11", " 5", "5 ", "+5", ""):
        assert protocol.number(text) is None, f"{text!r} is not a number"
    assert protocol.number("5") == 5
    assert protocol.number("-5") == -5

    run = tempfile.mkdtemp(prefix="bitwall-test-")
    try:
        w = bitwall.Wall("localhost", run=run)
        w._told(protocol.parse("hello v1 line"))
        for line in ("watching \u00b2", "watching " + "9" * 200):
            w._told(protocol.parse(line))
