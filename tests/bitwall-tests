    fake, w, _ = _fake_and_wall("Hi")
    try:
        assert _until(lambda: w.talking and fake.painted), "the sender never painted"
        found = w.sessions()
        base = [s for s in found if s.z == 0]
        assert [s.name for s in base] == [w.session.name] and base[0].type == "cells", found
        assert _until(lambda: fake.grid.ch[0][:2] == ["H", "i"]), fake.grid.ch[0][:4]
        p = w.picture(base[0].name)
        assert p.format == "grid" and (p.width, p.height) == (20, 5), p
        assert p.cell(0, 0) == ("H", 0xff0000, 0x0000ff), p.cell(0, 0)
        assert p.row(0).startswith("Hi"), p.row(0)
        g = w.picture("glass", size=(40, 40))
        assert g.format == "qoi" and g.data[:4] == b"qoif" and g.width == 40 \
            and g.height < 40, (g, g.width, g.height)
        try:
            w.picture("nobody")
        except bitwall.CaptureError as e:
            assert "no such session" in str(e), e
        else:
            raise AssertionError("a picture of nobody came back")
    finally:
        w.detach()
        fake.remove()


@check
def a_mirror_keeps_a_current_copy_and_says_when_it_changed():
    fake, w, shown = _fake_and_wall("one")
    try:
        assert _until(lambda: w.talking and fake.painted), "the sender never painted"
        base = next(s.name for s in w.sessions() if s.z == 0)
        m = w.mirror(base, every=50)
        assert _until(lambda: m.version and m.row(0).startswith("one")), (m.version, m.grid)
        seen, when = m.version, m.changed
        shown["text"] = "two"
        assert _until(lambda: m.version > seen and m.row(0).startswith("two")), \
            (m.version, m.row(0))
        assert m.changed > when and m.cell(0, 0) == ("t", 0xff0000, 0x0000ff), m.cell(0, 0)
        m.off()
        import time
        time.sleep(0.3)
        seen = m.version
        shown["text"] = "three"
        time.sleep(0.5)
        assert m.version == seen and m.row(0).startswith("two"), "a stopped mirror went on"
    finally:
        w.detach()
        fake.remove()


@check
def a_mirror_of_a_video_layer_holds_its_frame_and_goes_when_it_does():
    fake, w, _ = _fake_and_wall()
    layer = None
    try:
        assert _until(lambda: w.talking), "the sender never opened"
        layer = w.layer()
        assert _until(lambda: layer.open_now), "the layer never opened"
        m = w.mirror(layer._session.name)
        import time
        time.sleep(0.2)
        q = bytes.fromhex("716f6966000000020000000204 00".replace(" ", "")) \
            + bytes([0xFE, 1, 2, 3, 0xC2]) + b"\0" * 7 + b"\1"
        assert layer.frame(q, at=(7, 9), hold=5000), "the frame was dropped"
        assert _until(lambda: m.shown and m.data == q), (m.shown, m.data)
        assert (m.format, m.width, m.height, m.at, m.hold) == ("qoi", 2, 2, (7, 9), 5000), \
            (m.format, m.width, m.height, m.at, m.hold)
        p = layer.picture(layer._session.name)
        assert p.data == q and p.at == (7, 9), p
        layer.clear()
        assert _until(lambda: not m.shown), "the mirror did not go when the layer did"
    finally:
        if layer is not None:
            layer.close()
        w.detach()
        fake.remove()


# ---------------------------------------------------------------- windows
#
# A wall on Windows is named pipes, reached through the relay (WINDOWS.md).
# The relay runs on any host, so here it carries a session to the fake
# wall's fifos as it would to a Windows wall's pipes; the receiver core on
# this machine's own pipes is tests/windows-pipes, run here and, when it
# answers, on the Windows host `BITWALL_WINDOWS_HOST` (default `pc`).

def _relayed(fake, name=None):
    from bitwall.session import Controller
    c = Controller("localhost", run=fake.dir, name=name)
    c.link._pipes = True          # what a `//./pipe/` run directory says
    return c


@check
def the_relay_carries_a_session_as_cat_and_the_opener_do():
    import tempfile
    sys.path.insert(0, HERE)
    import fakewall
    fake = fakewall.FakeWall(tempfile.mkdtemp(prefix="bwt-"), "0", 20, 5, 14,
                             timings=fakewall.Timings(0.1))
    try:
        c = _relayed(fake)
        assert c.session.open_argv()[:3] == [sys.executable, "-c", bitwall.relay.BOOT], \
            "a local wall's relay runs on this Python, with no shell"
        c.open()
        assert any(m.name == "area" for m in c.report), [m.raw for m in c.report]
        said = [m.raw for m in c.ask("sessions")]
        assert any(c.name in x for x in said), said
        dup = _relayed(fake, name=c.name)
        dup.TRIES = 1
        try:
            dup.open()
            raise AssertionError("a name already a session's was opened again")
        except bitwall.session.Refused:
            pass
        c.close()
        assert (c.state, c.closed) == ("closed", "asked"), (c.state, c.closed)
    finally:
        fake.remove()


