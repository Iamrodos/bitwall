def _one_run(cells):
    """Whether a set of (x, y) is one piece, each touching the next on a
    side or a corner."""
    if not cells:
        return False
    todo, seen = [next(iter(cells))], set()
    while todo:
        x, y = todo.pop()
        if (x, y) in seen:
            continue
        seen.add((x, y))
        todo += [(x + dx, y + dy) for dx in (-1, 0, 1) for dy in (-1, 0, 1)
                 if (x + dx, y + dy) in cells]
    return seen == cells


@check
def a_segment_diagonal_is_one_stroke_even_small():
    """Each diagonal alone, at SEGMENT's smallest sizes, upright and turned,
    square, cut and smooth: one run of lit cells from its corner towards
    the centre, stopping a gap short of it, never broken into dashes by a
    gap or a steep slope."""
    from bitwall import letters as L
    one = "\x01"
    try:
        for name in "klmn":
            L.SEGMENTS[one] = name
            for n in range(L.SEGMENT_MIN, 13):
                for opts in ({}, {"edges": "cut"}, {"smooth": True},
                             {"turn": "up"}, {"turn": "down", "smooth": True}):
                    out = L.rows(one, L.SEGMENT, "ffffff", height=n, **opts) \
                        if "turn" not in opts else \
                        L.rows(one, L.SEGMENT, "ffffff", scale=1, **opts)
                    lit = {(x, y) for y, row in enumerate(out)
                           for x, c in enumerate(row) if c is not None}
                    assert _one_run(lit), (name, n, opts, sorted(lit))
                    if "turn" not in opts:
                        rows_ = {y for _x, y in lit}
                        # from a corner's rows most of the way in
                        assert len(rows_) >= max(1, (n - 2) // 3), (
                            name, n, opts, rows_)
                L.SEGMENTS.pop(one, None)
                L.SEGMENTS[one] = name
    finally:
        L.SEGMENTS.pop(one, None)
    # Two that carry on from each other, as N's and Z's do, are one line
    # through the middle.
    try:
        for pair in ("kn", "lm"):
            L.SEGMENTS[one] = pair
            for n in range(L.SEGMENT_MIN, 13):
                for opts in ({}, {"edges": "cut"}):
                    out = L.rows(one, L.SEGMENT, "ffffff", height=n, **opts)
                    lit = {(x, y) for y, row in enumerate(out)
                           for x, c in enumerate(row) if c is not None}
                    assert _one_run(lit), (pair, n, opts, sorted(lit))
    finally:
        L.SEGMENTS.pop(one, None)


