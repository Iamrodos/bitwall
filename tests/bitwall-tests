@check
def cut_never_fills_a_counter():
    """A slope is bridged only in empty space open to the outside: the
    inside of a D, an O or an 8 is exactly as square draws it."""
    from bitwall import letters as L
    for ch in "DOBPR0896AQ":
        bits = L._bits(L.BLOCK, ch, "mono")
        high, wide = len(bits), len(bits[0])
        out, todo = set(), [(x, y) for x in range(-1, wide + 1)
                            for y in (-1, high)] + \
            [(x, y) for y in range(high) for x in (-1, wide)]
        while todo:
            x, y = todo.pop()
            if (x, y) in out or not (-1 <= x <= wide and -1 <= y <= high):
                continue
            if 0 <= x < wide and 0 <= y < high and bits[y][x]:
                continue
            out.add((x, y))
            todo += [(x + 1, y), (x - 1, y), (x, y + 1), (x, y - 1)]
        holes = [(x, y) for y in range(high) for x in range(wide)
                 if not bits[y][x] and (x, y) not in out]
        for font, scale, per in ((L.BLOCK, 1, 1), (L.BLOCK, 2, 1),
                                 (L.HALF, 2, 2), (L.HALF, 4, 2)):
            square = L.rows(ch, font, "ffffff", scale=scale, spacing="mono")
            cut = L.rows(ch, font, "ffffff", scale=scale, spacing="mono",
                         edges="cut")
            across = scale * L._widen(font, 2.0)
            for hx, hy in holes:
                for r in range(hy * scale // per,
                               -(-(hy + 1) * scale // per)):
                    for c in range(hx * across, (hx + 1) * across):
                        assert cut[r][c] == square[r][c], (ch, font, scale,
                                                            r, c, cut[r][c])
    # D's outside corners are the slopes, not its counter's.
    d = L.rows("D", L.BLOCK, "ffffff", edges="cut")
    assert d[0][4][0] == "◣" and d[4][4][0] == "◤", (d[0], d[4])


@check
def a_ghost_is_chosen_for_the_depth_it_goes_out_at():
    """At 256 colours a ghost is a palette colour no lighter than asked and
    well under the ink, and the stream sends it as that colour; with 16
    colours or one there is none."""
    from bitwall import letters as L
    from bitwall import stream as S

    def luma(h):
        r, g, b = (int(h[i:i + 2], 16) for i in (0, 2, 4))
        return 0.2126 * r + 0.7152 * g + 0.0722 * b

    for ghost in ("1a2130", "3a2a08", "12304a", "402020", "0a0a0a"):
        for ink in ("ffd75f", "7fe8ff", "808080"):
            got = L.ghost_for(ghost, ink, "256")
            if got is None:
                continue
            assert luma(got) <= luma(ghost) + 0.5, (ghost, got)
            assert luma(got) <= luma(ink) * L.GHOST_UNDER_INK, (ink, got)
            sent = S.palette_256(S._reduce(got, "256"))
            assert "%02x%02x%02x" % sent == got, (got, sent)
        assert L.ghost_for(ghost, "ffd75f", "16") is None
        assert L.ghost_for(ghost, "ffd75f", "mono") is None
        assert L.ghost_for(ghost, "ffd75f", "true") == ghost
    # drawn: no ghost at 16 colours, for segments or dots
    seg = L.rows("1", L.SEGMENT, "ffd75f", height=10, ghost="1a2130",
                 depth="16")
    assert seg == L.rows("1", L.SEGMENT, "ffd75f", height=10, depth="16")
    dots = L.rows("Hi", L.DOTS, "ffd75f", ghost="12304a", depth="16")
    assert not any(c and len(c) > 3 for row in dots for c in row)
    # the stream matches a dark colour to what the palette really has
    assert S.palette_256(S._reduce("1a2130", "256"))[0] < 60


