#: The contracts, started as the run starts: they take longest, and are
#: mostly waiting, so the other groups run while they do. What they say
#: goes to files rather than pipes, which nobody reads until the other
#: groups are done and which would stop them when full.
_contracts = None


def _start_contracts():
    out, err = tempfile.TemporaryFile("w+"), tempfile.TemporaryFile("w+")
    proc = subprocess.Popen([os.path.join(HERE, "bitwall-contracts")],
                            stdout=out, stderr=err, text=True)
    proc.said = (out, err)
    return proc


def chosen(argv):
    """The checks to run: those whose names hold any word given, else all,
    less those holding a word after --skip."""
    want, skip = [], []
    words = iter(argv)
    for word in words:
        if word == "--skip":
            skip.append(next(words, ""))
        else:
            want.append(word)
    name = lambda fn: fn.__name__.replace("_", " ")             # noqa: E731
    return [fn for fn in _checks
            if (not want or any(w in name(fn) for w in want))
            and not any(w and w in name(fn) for w in skip)]


def main():
    global _contracts
    checks = chosen(sys.argv[1:])
    if shutil.which("uv") and the_receivers_and_the_wall_keep_their_contracts in checks:
        _contracts = _start_contracts()
    width = max(len(c.__name__) for c in _checks) + 2
    failed = skipped = 0
    for fn in checks:
        name = fn.__name__.replace("_", " ")
        try:
            note = fn()
        except AssertionError as exc:
            failed += 1
            print(f"  FAIL  {name}\n        {exc}")
        except Exception as exc:                       # noqa: BLE001
            failed += 1
            print(f"  ERROR {name}\n        {type(exc).__name__}: {exc}")
        else:
            if note:
                skipped += 1
                print(f"  skip  {name:<{width}} {note}")
            else:
                print(f"  ok    {name}")
    total = len(checks)
    print(f"\n{total - failed - skipped} passed, {failed} failed, "
          f"{skipped} skipped")
    return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main())
