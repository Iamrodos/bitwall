@check
def dots_grow_as_strokes_on_the_dot_grid_not_as_blocks():
    """Bigger, a diagonal is a line of dots rather than steps of squares,
    and a corner is rounded off rather than square."""
    from bitwall import letters as L
    o = L._options({"spacing": "mono"})
    # '/' is one pixel wide stepping diagonally; at scale 4 a block
    # would be 4x4 dots at each step, a stroke a thin slanted line.
    big = L._pixels(L.DOTS, 8, ["/"], o)[0]
    widths = [sum(1 for v in row if v) for row in big if any(row)]
    assert max(widths) <= 6, widths
    blocky = [[v for v in row for _ in range(4)]
              for row in L._bits(L.DOTS, "/", "mono") for _ in range(4)]
    assert big != blocky
    # Each row's ink moves along a little at a time, not four at once.
    starts = [row.index(1.0) for row in big if any(row)]
    steps = {abs(a - b) for a, b in zip(starts, starts[1:])}
    assert steps <= {0, 1, 2}, steps
    # The outer corner of an L-shape (the top left of 'E') is cut off.
    e = L._pixels(L.DOTS, 8, ["E"], o)[0]
    assert not e[0][0] and e[0][3] and e[3][0], "a rounded corner"
    assert L.size("Ag", L.DOTS, height=7)[1] == 7, "height fills exactly"


