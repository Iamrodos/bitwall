def _copier(path):
    return subprocess.Popen(
        [sys.executable, "-c", "import sys, shutil; "
         "shutil.copyfileobj(sys.stdin.buffer, open(sys.argv[1], 'wb'))", path],
        stdin=subprocess.PIPE)


@check
def a_pipe_carries_everything_whole_and_closes_once_drained():
    """What a Pipe is handed reaches the far end in order and entire, and
    its close lets the far end finish rather than cutting it off."""
    from bitwall import portable
    with tempfile.TemporaryDirectory() as tmp:
        path = os.path.join(tmp, "got")
        proc = _copier(path)
        pipe = portable.Pipe(proc)
        parts = [os.urandom(n) for n in (1, 70000, 3, 1 << 20)]
        for part in parts:
            assert pipe.write(part, timeout=10) == len(part), "a write came up short"
        assert pipe.idle, "a pipe with nothing in hand says it is busy"
        pipe.close()
        assert proc.wait(timeout=10) == 0
        with open(path, "rb") as fh:
            assert fh.read() == b"".join(parts), "the far end got something else"
        assert pipe.write(b"late") is None, "a closed pipe took a write"


@check
def a_pipe_nobody_reads_holds_a_write_only_as_long_as_asked():
    """A wall that has stopped reading costs a writer its timeout, or less
    when told to stop, and a far end that goes is noticed."""
    import threading
    from bitwall import portable
    proc = subprocess.Popen([sys.executable, "-c", "import time; time.sleep(30)"],
                            stdin=subprocess.PIPE)
    try:
        pipe = portable.Pipe(proc)
        big = b"x" * (4 << 20)
        t = time.monotonic()
        got = pipe.write(big, timeout=0.3)
        took = time.monotonic() - t
        assert got is not None and got < len(big), f"a stuck pipe took {got} bytes"
        assert took < 1.0, f"a 0.3s timeout held the writer {took:.2f}s"
        assert not pipe.idle, "a pipe still holding a piece says it is idle"
        stop = threading.Event()
        threading.Timer(0.2, stop.set).start()
        t = time.monotonic()
        assert pipe.write(b"y", stop) is None, "a stopped write said it went"
        assert time.monotonic() - t < 1.0, "stop was not heard"
        proc.kill()
        proc.wait()
        assert _until(lambda: pipe.closed), "a far end that went was not noticed"
        assert pipe.write(b"z", timeout=1) is None, "a broken pipe took a write"
    finally:
        proc.kill()


