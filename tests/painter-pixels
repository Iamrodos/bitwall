def footprint(pid):
    """What process `pid` holds, in bytes, as macOS's footprint says:
    the whole (`phys_footprint`, which on a Mac's shared memory counts
    what the GPU holds for it too), the part in the GPU's own categories
    (IOAccelerator, and owned memory not mapped); and its RSS, as ps says.
    On Windows: its private bytes, nothing of the GPU's part, and its
    working set."""
    import subprocess
    if gpupainter.WINDOWS:
        return _footprint_windows(pid)
    out = subprocess.run(["footprint", "-p", str(pid), "-f", "bytes"],
                         capture_output=True, text=True).stdout
    whole = gpu = 0
    for line in out.splitlines():
        words = line.split()
        if line.strip().startswith("phys_footprint:"):
            whole = int(words[1])
        elif len(words) >= 8 and words[1] == "B" and (
                "IOAccelerator" in line or "Owned physical footprint" in line):
            gpu += int(words[0])
    rss = subprocess.run(["ps", "-o", "rss=", "-p", str(pid)], capture_output=True, text=True)
    return whole, gpu, int(rss.stdout.strip() or 0) * 1024


def _footprint_windows(pid):
    import ctypes
    import ctypes.wintypes as wt

    class Counters(ctypes.Structure):
        _fields_ = [("cb", wt.DWORD), ("faults", wt.DWORD)] + [
            (n, ctypes.c_size_t) for n in ("peak_ws", "ws", "peak_pp", "pp", "peak_npp",
                                           "npp", "pagefile", "peak_pagefile", "private")]
    k32 = ctypes.windll.kernel32
    h = k32.OpenProcess(0x1000 | 0x0010, False, pid)
    c = Counters()
    c.cb = ctypes.sizeof(c)
    ctypes.windll.psapi.GetProcessMemoryInfo(h, ctypes.byref(c), c.cb)
    k32.CloseHandle(h)
    return c.private, 0, c.ws


class _Reader:
    """A glass stream read on a thread of its own as long as it runs:
    how many frames came, each the size it was asked, numbers rising."""

    def __init__(self, path, size):
        import threading
        self.path, self.size, self.frames, self.bad = path, size, 0, []
        self.stop = False
        self.thread = threading.Thread(target=self.run, daemon=True)
        self.thread.start()

    def run(self):
        import select
        fd = gpupainter.Reader(self.path)
        buf, last = bytearray(), -1
        try:
            while not self.stop:
                try:
                    data = fd.read(1 << 22)
                except BlockingIOError:
                    data = None
                if not data:
                    # Waiting on the fifo, as the mirror sender does, not a
                    # sleep: a fifo hands a stream over a few KB at a time,
                    # and a fixed pause between pieces caps what is read
                    # below what the painter streams, which then lets frames
                    # go for want of room.
                    if gpupainter.WINDOWS:
                        time.sleep(0.003)
                    else:
                        select.select([fd.fd], [], [], 0.2)
                    continue
                buf += data
                while len(buf) >= 32:
                    _, w, h, num, _, length = struct.unpack("<4sIIQQI", bytes(buf[:32]))
                    if len(buf) < 32 + length:
                        break
                    del buf[:32 + length]
                    self.frames += 1
                    if (w, h) != self.size or num <= last:
                        self.bad.append((w, h, num, last))
                    last = num
        finally:
            fd.close()


def _measured(p, ctl):
    """The painter's footprint with its glass at 1280x720, so what is
    measured at two times is measured at the same size: a glass's own
    pictures are as big as it is."""
    ctl.command("glass 1280x720 id=m")
    assert ctl.wait(lambda h: any(x.endswith(" id=m") for x in h), 5), ctl.heard[-3:]
    _settled(ctl)
    time.sleep(1)
    return footprint(p.proc.pid)


def _sizes(n):
    """`n` sizes of glass across the range a wall has, wide and tall, in
    an order that goes up and down by turns; the same every run. The
    largest and the smallest come first, so that what a GPU keeps for the
    biggest it has drawn is kept before memory is first measured."""
    import random
    r = random.Random(5)
    return ([(1920, 1080), (320, 180)]
            + [(r.randrange(320, 1921), r.randrange(180, 1081)) for _ in range(n - 2)])[:n]


def _settled(ctl):
    """The glass once a picture of it comes back the same twice in a row,
    compared as it comes and decoded once, since a whole glass is a second
    to decode."""
    last = None
    for _ in range(60):
        time.sleep(0.03)
        ctl.pictures = []
        ctl.command("picture glass")
        # Read as fast as it comes: a whole glass is megabytes, through a
        # pipe that holds 64 KB.
        if not gpupainter.wait_for(lambda: (ctl.pump(), ctl.pictures)[1], 5, step=0.0005):
            raise AssertionError(f"no picture of the glass; heard {ctl.heard[-4:]}")
        got = ctl.pictures[0][1]
        if got == last:
            return rgb(got)
        last = got
    raise AssertionError("the glass never settled")


def _ground(x, y):
    return (40 + (x * 7) % 200, 30 + (y * 13) % 200, (x * 3 + y * 5) % 256)


@check
def the_glass_resized_again_and_again_is_drawn_right_and_holds_its_memory():
    """The glass asked for a new size by `glass WxH` again and again (200
    times, or BITWALL_RESIZES), every tenth a drag of four sizes asked in
    a row, with a cells base, a video layer and two streams running. After
    each: the answer is the area at the size the glass now is, and nothing
    between was said; `picture glass` is that size, every cell the colour
    the base drew there, the margins black and the layer's frame where it
    was put; the streams keep their own sizes, frames numbered in order, at
    their rates. The painter's memory, and the GPU's part of it, measured
    at one size after the first ten and at the end: what grows is a leak.
    A Mac's GL keeps memory for the biggest glass it has drawn, so the
    biggest is among the first ten; beyond that a few MB come and go."""
    n = int(os.environ.get("BITWALL_RESIZES", "200"))
    frame = qoi(48, 32, (255, 0, 255, 255))
    with gpupainter.Painter((1280, 720)) as p:
        base, ctl = connected_base(p), p.session("ctl", "controller")
        v = p.session("v", "layer", z="above", type="video")
        streams = {"a": (640, 360, 25), "b": (320, 240, 15)}
        for name, (w, h, fps) in streams.items():
            ctl.command(f"mirror glass stream=i420 size={w}x{h} fps={fps} name={name}")
        paths = {k: os.path.join(ctl.dir, f"glass-{k}") for k in streams}
        assert gpupainter.wait_for(lambda: all(map(gpupainter.there, paths.values())), 3), ctl.heard
        readers = {k: _Reader(paths[k], streams[k][:2]) for k in streams}
        sizes, before, t0, frames0, said = _sizes(n), None, None, None, 0
        try:
            for i, (gw, gh) in enumerate(sizes):
                if i == 10:
                    before = _measured(p, ctl)
                    t0, frames0 = time.monotonic(), {k: r.frames for k, r in readers.items()}
                base.heard, v.heard, ctl.heard = [], [], []
                if i % 10 == 9:
                    for k in range(3):     # a drag: sizes on the way, then the one it stops at
                        ctl.command(f"glass {gw - 40 * (3 - k)}x{gh - 20 * (3 - k)}")
                        time.sleep(0.03)
                ctl.command(f"glass {gw}x{gh} id=g{i}")
                assert ctl.wait(lambda h: any(x.endswith(f" id=g{i}") for x in h), 5), \
                    f"resize {i} to {gw}x{gh}: no answer; heard {ctl.heard[-3:]}"
                answer = next(x for x in ctl.heard if x.endswith(f" id=g{i}"))
                assert answer.startswith("area "), answer
                areas = [x for x in ctl.heard if x.startswith("area ")]
                assert areas == [answer], f"resize {i}: said {areas}"
                assert base.wait(lambda h: "repaint" in h, 3), base.heard
                assert v.wait(lambda h: "repaint" in h, 3), v.heard
                assert not any(x.startswith("area ") for x in v.heard), v.heard
                screen = next(x for x in reversed(base.heard) if x.startswith("screen "))
                opts = dict(w.split("=", 1) for w in screen.split()[1:] if "=" in w)
                assert opts["pixels"] == f"{gw}x{gh}", (gw, gh, screen)
                cw, chh = map(int, opts["cell"].split("x"))
                cols, rows = area_of(base)
                grid = [[cell(" ", "default", "%02x%02x%02x" % _ground(x, y))
                         for x in range(cols)] for y in range(rows)]
                v.write(frame_bytes(frame, "hold=still").replace(b"at=0,0", b"at=8,8"))
                base.write(serialise(grid, None, True, cols, rows))
                got = _settled(ctl)
                said += 1
                assert got.shape[:2] == (gh, gw), f"resize {i}: picture {got.shape} for {gw}x{gh}"
                ox, oy = (gw - cols * cw) // 2, (gh - rows * chh) // 2
                ys = oy + chh // 2 + chh * np.arange(rows)
                xs = ox + cw // 2 + cw * np.arange(cols)
                want = np.array([[_ground(x, y) for x in range(cols)] for y in range(rows)])
                seen = got[ys][:, xs].astype(int)
                under = (xs[None, :] < 8 + 48) & (ys[:, None] < 8 + 32)
                wrong = np.argwhere((seen != want).any(axis=2) & ~under)
                assert not len(wrong), f"resize {i} to {gw}x{gh}: {len(wrong)} cells wrong, " \
                                       f"first {wrong[0]} {seen[tuple(wrong[0])]} for {want[tuple(wrong[0])]}"
                assert (got[8:40, 8:56] == (255, 0, 255)).all(), f"resize {i}: the frame is not up"
                margins = np.ones((gh, gw), bool)
                margins[oy:oy + rows * chh, ox:ox + cols * cw] = False
                margins[8:40, 8:56] = False
                assert not got[margins].any(), f"resize {i}: the margins are not black"
            took = time.monotonic() - t0
            frames1 = {k: r.frames for k, r in readers.items()}
            after = _measured(p, ctl)
        finally:
            for r in readers.values():
                r.stop = True
            for r in readers.values():
                r.thread.join(2)
        rates = {}
        for k, r in readers.items():
            assert not r.bad, f"stream {k}: {r.bad[:3]}"
            rates[k] = (frames1[k] - frames0[k]) / took
            assert rates[k] >= 0.8 * streams[k][2], \
                f"stream {k}: {rates[k]:.1f} fps of {streams[k][2]}"
        grew = (after[0] - before[0]) / 2**20, (after[1] - before[1]) / 2**20
        assert grew[0] < 6 and grew[1] < 4, \
            f"after {n - 10} resizes the painter grew {grew[0]:.1f} MB, the GPU's part {grew[1]:.1f} MB"
        return (f"{said} resizes ({n // 10} drags) 320-1920 x 180-1080, every picture right; "
                f"streams {rates['a']:.1f}/25 and {rates['b']:.1f}/15 fps; footprint "
                f"{before[0] / 2**20:.1f} -> {after[0] / 2**20:.1f} MB, GPU "
                f"{before[1] / 2**20:.1f} -> {after[1] / 2**20:.1f} MB, RSS "
                f"{before[2] / 2**20:.1f} -> {after[2] / 2**20:.1f} MB")


def capture(target, env):
    """The scene on a v1 wall at font 14, and its glass kept in tests/pixels
    as the reference, with the glass, cell and area it was taken at. The
    base is attached for this and detached after.

    The scene is written to the base's `in` by a `cat` of its own rather
    than by the Wall, which composes nothing while nobody is in the room:
    a wall that follows a presence is as likely as not dark."""
    import subprocess
    w = bitwall.attach(target)
    try:
        w.set_font_size(14)
        cols, rows = w.area()
        if cols < COLS_NEEDED or rows < ROWS_NEEDED:
            raise SystemExit(f"{target} is {cols}x{rows} at 14; the scene needs "
                             f"{COLS_NEEDED}x{ROWS_NEEDED}")
        into = w._link.session_dir(w._session.name) + "/in"
        subprocess.run(w._link.argv(f"cat > {into}"), check=True, timeout=30,
                       input=serialise(scene(cols, rows), None, True, cols, rows).encode())
        last = None
        for _ in range(60):
            time.sleep(0.5)
            pic = w.picture("glass")
            if last is not None and pic.data == last and rgb(last).any():
                break
            last = pic.data
        else:
            raise SystemExit(f"{target}: the glass never settled on the scene")
        cw, chh = w.screen()["cell"]
    finally:
        w.detach()
    report = subprocess.run([os.path.join(ROOT, "controllers", "bitwall-ctl"), target, "report"],
                            capture_output=True, text=True, timeout=30).stdout
    version = next((w.split("=", 1)[1] for line in report.splitlines()
                    if line.startswith("receiver ") for w in line.split()
                    if w.startswith("version=")), None)
    os.makedirs(PIXELS, exist_ok=True)
    im = Image.open(io.BytesIO(last)).convert("RGB")
    im.save(V1, optimize=True)
    meta = {"target": target, "version": version, "env": env, "glass": list(im.size), "font": 14, "cell": [cw, chh],
            "area": [cols, rows], "taken": time.strftime("%Y-%m-%d")}
    with open(V1_SAID, "w") as fh:
        json.dump(meta, fh, indent=1)
    print(f"{V1}: {im.size[0]}x{im.size[1]}, {os.path.getsize(V1)} bytes; {meta}")


# -------------------------------------------------------------------- run

def main(argv):
    if argv[:1] == ["--capture"] and len(argv) >= 2:
        capture(argv[1], dict(x.split("=", 1) for x in argv[2:]))
        return 0
    words = argv
    chosen = [c for c in _checks if not words
              or any(w in c.__name__.replace("_", " ") for w in words)]
    why = gpupainter.why_not()
    width = max(len(c.__name__) for c in chosen) + 2
    failed = skipped = 0
    for fn in chosen:
        name = fn.__name__.replace("_", " ")
        try:
            if why:
                raise _Skip(why)
            note = fn()
        except _Skip as e:
            skipped += 1
            print(f"  skip  {name:<{width}} skipped: {e}")
            continue
        except AssertionError as exc:
            failed += 1
            print(f"  FAIL  {name}\n        {exc}")
            continue
        except Exception as exc:                       # noqa: BLE001
            failed += 1
            print(f"  ERROR {name}\n        {type(exc).__name__}: {exc}")
            continue
        if note and note.startswith("skipped"):
            skipped += 1
            print(f"  skip  {name:<{width}} {note}")
        else:
            print(f"  ok    {name:<{width}} {note or ''}".rstrip())
        sys.stdout.flush()
    print(f"\n{len(chosen) - failed - skipped} passed, {failed} failed, {skipped} skipped")
    return 1 if failed else 0


class _Skip(Exception):
    pass


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
