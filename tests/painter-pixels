@check
def one_scene_composed_twice_is_the_same_pixels():
    """The scene drawn, then drawn again whole, then a picture with
    nothing changed: three pictures, every pixel the same. A frame that
    composes differently the second time -- state left from the first, a
    buffer reused before it was finished with -- shows here."""
    with gpupainter.Painter((1280, 720)) as p:
        base, ctl = connected_base(p), p.session("ctl", "controller")
        once = show_scene(p, base, ctl)
        twice = show_scene(p, base, ctl)
        again = rgb(ctl.picture()[1])
        assert once.any(), "the glass is black"
        for name, got in (("drawn twice", twice), ("asked again", again)):
            diff = np.argwhere((got != once).any(axis=2))
            assert not len(diff), f"{name}: {len(diff)} pixels differ, first at {diff[0]}"
        return f"1280x720, {np.count_nonzero(once.any(axis=2))} lit pixels identical three times"


def i420_frames(ctl, path, n, timeout=5.0):
    """The next `n` whole frames on a glass stream: (header, y, u, v)."""
    fd = gpupainter.Reader(path)
    buf, out = b"", []
    until = time.monotonic() + timeout
    try:
        while len(out) < n and time.monotonic() < until:
            ctl.pump()
            try:
                buf += fd.read(1 << 22)
            except BlockingIOError:
                time.sleep(0.005)
            while len(buf) >= 32:
                magic, w, h, num, us, length = struct.unpack("<4sIIQQI", buf[:32])
                assert magic == b"BWG1", buf[:32]
                if len(buf) < 32 + length:
                    break
                body = np.frombuffer(buf[32:32 + length], np.uint8)
                y = body[:w * h].reshape(h, w)
                u = body[w * h:w * h * 5 // 4].reshape(h // 2, w // 2)
                v = body[w * h * 5 // 4:].reshape(h // 2, w // 2)
                out.append(((w, h, num, us), y, u, v))
                buf = buf[32 + length:]
    finally:
        fd.close()
    assert len(out) >= n, f"{len(out)} frames of {n}"
    return out


def bt709(px):
    """Y, U, V of RGB pixels as the painter's stream makes them: BT.709 at
    studio range, U and V of each 2x2 block's mean."""
    f = px.astype(np.float64) / 255
    y = 16 + 219 * (f @ np.array([0.2126, 0.7152, 0.0722]))
    h, w = f.shape[:2]
    blocks = f.reshape(h // 2, 2, w // 2, 2, 3).mean(axis=(1, 3))
    u = 128 + 224 * (blocks @ np.array([-0.1146, -0.3854, 0.5]))
    v = 128 + 224 * (blocks @ np.array([0.5, -0.4542, -0.0458]))
    return y, u, v


@check
def the_stream_is_the_glass_in_its_colours():
    """`mirror glass stream=i420` at the glass's own size, against `picture
    glass` turned to I420 here: Y within 1 of every pixel's, U and V within
    1 of each 2x2 block's mean, which is the rounding of one 8-bit value
    and nothing else."""
    with gpupainter.Painter((1280, 720)) as p:
        base, ctl = connected_base(p), p.session("ctl", "controller")
        glass = show_scene(p, base, ctl)
        ctl.command("mirror glass stream=i420 size=1280x720 fps=10")
        path = os.path.join(ctl.dir, "glass")
        assert gpupainter.wait_for(lambda: gpupainter.there(path), 3), f"no stream: {ctl.heard}"
        # A frame is read back a frame later: the third is long past the scene.
        (w, h, _, _), y, u, v = i420_frames(ctl, path, 3)[-1]
        ctl.command("mirror glass off")
        assert (w, h) == (1280, 720), (w, h)
        wy, wu, wv = bt709(glass)
        worst = {}
        for name, got, want in (("Y", y, wy), ("U", u, wu), ("V", v, wv)):
            d = np.abs(got.astype(np.float64) - want)
            worst[name] = d.max()
            assert d.max() <= 1.0, (f"{name} is {d.max():.1f} out at "
                                    f"{np.unravel_index(d.argmax(), d.shape)}; "
                                    f"{np.count_nonzero(d > 1)} values more than 1")
        return "max error " + ", ".join(f"{k} {x:.2f}" for k, x in worst.items())


def streams_of(ctl, asks, n=3, timeout=8.0):
    """Several glass streams asked of `ctl` at once, by name, and the
    last of the next `n` whole frames of each: {name: (header, y, u, v)}.
    Each fifo is read by its own thread, as a mirror's are."""
    import threading
    for name, (w, h, fps, extra) in asks.items():
        ctl.command(f"mirror glass stream=i420 size={w}x{h} fps={fps} name={name} {extra}".strip())
    got, errors = {}, []

    def one(name):
        path = os.path.join(ctl.dir, f"glass-{name}")
        if not gpupainter.wait_for(lambda: gpupainter.there(path), 3):
            errors.append(f"no stream {name}")
            return
        try:
            got[name] = i420_frames(_Quiet(), path, n, timeout)[-1]
        except AssertionError as e:
            errors.append(f"{name}: {e}")
    threads = [threading.Thread(target=one, args=(k,)) for k in asks]
    for th in threads:
        th.start()
    while any(th.is_alive() for th in threads):
        ctl.pump()
        time.sleep(0.01)
    for name in asks:
        ctl.command(f"mirror glass off name={name}")
    assert not errors, f"{errors}; heard {ctl.heard[-4:]}"
    return got


class _Quiet:
    """A session for i420_frames to pump that is pumped elsewhere."""

    def pump(self):
        pass


def planes_against(glass, y, u, v, box=None):
    """The worst difference of a frame's planes from `glass`, a picture of
    the glass at the size the frame shows it, turned to I420 here: Y over
    the box the glass fills and U and V where its blocks fall whole on the
    picture's; and of the frame round the box, from black."""
    bx, by, bw, bh = box or (0, 0, y.shape[1], y.shape[0])
    wy = 16 + 219 * (glass.astype(np.float64) / 255 @ np.array([0.2126, 0.7152, 0.0722]))
    worst = {"Y": np.abs(y[by:by + bh, bx:bx + bw].astype(np.float64) - wy).max()}
    if not (bx % 2 or by % 2 or bw % 2 or bh % 2):
        _, wu, wv = bt709(glass)
        cy, cx = by // 2, bx // 2
        worst["U"] = np.abs(u[cy:cy + bh // 2, cx:cx + bw // 2].astype(np.float64) - wu).max()
        worst["V"] = np.abs(v[cy:cy + bh // 2, cx:cx + bw // 2].astype(np.float64) - wv).max()
    mask = np.ones(y.shape, bool)
    mask[by:by + bh, bx:bx + bw] = False
    if mask.any():
        worst["pad"] = np.abs(y[mask].astype(np.float64) - 16).max()
    return worst


def area_weights(n, m):
    """The (m, n) matrix shrinking n samples to m by area: each of the m
    the mean of the n it covers, a part sample counted by its part."""
    k = n / m
    w = np.zeros((m, n))
    for i in range(m):
        a, b = i * k, (i + 1) * k
        for j in range(int(a), min(n, int(np.ceil(b)))):
            w[i, j] = (min(b, j + 1) - max(a, j)) / k
    return w


def area_shrink(px, w, h):
    """`px`, an (H, W, 3) picture, shrunk to w by h by area: what a pixel
    of a smaller glass would be if it took exactly the light that falls
    on it."""
    f = px.astype(np.float64)
    wy, wx = area_weights(f.shape[0], h), area_weights(f.shape[1], w)
    return np.stack([wy @ f[:, :, ch] @ wx.T for ch in range(3)], axis=2)


#: How far a stream's Y may be from the glass shrunk by area, in levels:
#: (mean, 99th percentile, most), on this scene of text, box lines and
#: blocks, which is as hard as a glass gets. At the glass's own size, a
#: half and a quarter the stream's looks fall where they take exactly the
#: area, and only rounding is left (measured 0.05, 0.5, 0.5). Between, a
#: look takes the light near a pixel's middle a little more than at its
#: edges, which shows on hairlines: measured at 854x480 and 400x225 of
#: 1280x720 at most 0.39, 10.8 and 59, where `picture glass`, a box of
#: sixteen looks, is 0.38, 9.8 and 28 at 854x480. The limits are those,
#: rounded up.
STREAM_AREA_TOLERANCE = {1.0: (0.1, 0.6, 0.6), 2.0: (0.1, 0.6, 0.6), 4.0: (0.1, 0.6, 0.6),
                         None: (0.45, 12.0, 64.0)}


@check
def each_stream_is_the_glass_at_its_own_size():
    """Five streams at once from one glass, each at a size and rate of its
    own, against the glass shrunk by area to the size each shows it: Y
    within STREAM_AREA_TOLERANCE of it, exactly where the size is the
    glass's, a half or a quarter; U and V within 1 at the glass's size and
    a half; and a stream
    of another shape the glass in the middle with black round it. What
    `picture glass` at that size is from the same is said beside it."""
    with gpupainter.Painter((1280, 720)) as p:
        base, ctl = connected_base(p), p.session("ctl", "controller")
        full = show_scene(p, base, ctl)
        asks = {"full": (1280, 720, 10, ""), "half": (640, 360, 5, ""),
                "small": (320, 180, 15, ""), "third": (854, 480, 10, ""),
                "square": (400, 400, 10, "")}
        got = streams_of(ctl, asks)
        notes = []

        def box(w, h):
            k = min(w / 1280, h / 720)
            bw, bh = round(1280 * k), round(720 * k)
            return bw, bh, (w - bw) // 2, (h - bh) // 2
        # Every picture asked before the sums, which take seconds on a
        # slow machine and would leave the wall's ping unanswered.
        pictures = {name: ctl.picture("glass size={}x{}".format(*box(w, h)[:2]))
                    for name, (w, h, _, _) in asks.items()}
        for name, (w, h, fps, _) in asks.items():
            (fw, fh, _, _), y, u, v = got[name]
            assert (fw, fh) == (w, h), (name, fw, fh)
            bw, bh, bx, by = box(w, h)
            truth = area_shrink(full, bw, bh)
            wy = 16 + 219 * (truth / 255 @ np.array([0.2126, 0.7152, 0.0722]))
            d = np.abs(y[by:by + bh, bx:bx + bw].astype(np.float64) - wy)
            said = (d.mean(), np.percentile(d, 99), d.max())
            ratio = 1280 / bw
            exact = next((r for r in (1.0, 2.0, 4.0) if abs(ratio - r) < 1e-9), None)
            most = STREAM_AREA_TOLERANCE[exact]
            words, data = pictures[name]
            pic = rgb(data).astype(np.float64)
            py = 16 + 219 * (pic / 255 @ np.array([0.2126, 0.7152, 0.0722]))
            pd = np.abs(py - wy)
            assert all(a <= b for a, b in zip(said, most)), \
                (f"{name} {w}x{h}: Y from the area mean {said[0]:.2f}, p99 {said[1]:.1f}, "
                 f"most {said[2]:.1f}; allowed {most}; picture glass {pd.mean():.2f}, "
                 f"{np.percentile(pd, 99):.1f}, {pd.max():.1f}")
            mask = np.ones(y.shape, bool)
            mask[by:by + bh, bx:bx + bw] = False
            assert not mask.any() or np.abs(y[mask].astype(np.float64) - 16).max() <= 0.5, \
                f"{name}: not black round the glass"
            if exact in (1.0, 2.0) and not (bx % 2 or by % 2 or bw % 2 or bh % 2):
                _, tu, tv = bt709(truth.round().clip(0, 255))
                cu = np.abs(u[by // 2:(by + bh) // 2, bx // 2:(bx + bw) // 2] - tu).max()
                cv = np.abs(v[by // 2:(by + bh) // 2, bx // 2:(bx + bw) // 2] - tv).max()
                assert max(cu, cv) <= 1.0, f"{name}: U {cu:.1f} V {cv:.1f}"
            notes.append(f"{w}x{h} Y {said[0]:.2f}/{said[1]:.1f}/{said[2]:.0f} "
                         f"(picture {pd.mean():.2f}/{np.percentile(pd, 99):.1f}/{pd.max():.0f})")
        return "mean/p99/most from the area mean: " + ", ".join(notes)


@check
def a_stream_carries_the_overlay_only_where_asked():
    """With the overlay up, a stream asked with `overlay=1` shows it over
    the glass and one asked without does not, from the one composition:
    the second is `picture glass`, which never shows it, and the first
    differs from it only in the overlay's box."""
    with gpupainter.Painter((1280, 720)) as p:
        base, ctl = connected_base(p), p.session("ctl", "controller")
        ctl.command("stats 1 at=nw show=fps,in")
        glass = show_scene(p, base, ctl)
        time.sleep(1.2)                 # the overlay's first numbers
        got = streams_of(ctl, {"plain": (1280, 720, 10, ""),
                               "lit": (1280, 720, 10, "overlay=1")})
        _, y, u, v = got["plain"]
        worst = planes_against(glass, y, u, v)
        assert max(worst.values()) <= 1.0, f"without the overlay: {worst}"
        _, ly, _, _ = got["lit"]
        wy, _, _ = bt709(glass)
        rows, cols = np.nonzero(np.abs(ly.astype(np.float64) - wy) > 1.0)
        assert len(rows), "the overlay is not in the stream that asked for it"
        top, left, bottom, right = rows.min(), cols.min(), rows.max(), cols.max()
        assert top < 100 and left < 100 and bottom < 400 and right < 700, \
            f"the overlay's stream differs outside the top left: {left},{top} to {right},{bottom}"
        return f"overlay over {right - left + 1}x{bottom - top + 1} at {left},{top}; " \
               f"without it max error {max(worst.values()):.1f}"


def qoi(w, h, rgba):
    """A QOI image of `w` by `h`, every pixel `rgba`."""
    return bitwall.video.qoi(np.tile(np.array(rgba, np.uint8), (h, w, 1)))


def encoded(fmt, w, h, rgba, **kw):
    im = Image.new("RGBA" if fmt == "PNG" else "RGB", (w, h),
                   tuple(rgba) if fmt == "PNG" else tuple(rgba[:3]))
    out = io.BytesIO()
    im.save(out, fmt, **kw)
    return out.getvalue()


def frame_bytes(data, extra=""):
    codec = bitwall.protocol.image_of(data)
    w, h = bitwall.protocol.image_size(codec, data)
    return (gpupainter.APC + f"bitwall frame {codec} {w}x{h} at=0,0 {extra} {len(data)}"
            + gpupainter.ST).encode() + data


@check
def a_frame_sits_on_the_glass_where_align_says():
    """A frame far wider than the glass's shape, on a data stream, put
    against the top, the bottom and the middle with `align`: the rows it
    lights on the glass are exactly those, and nothing else is lit."""
    gw, gh = 640, 360
    with gpupainter.Painter((gw, gh)) as p:
        base, ctl = connected_base(p), p.session("ctl", "controller")
        show_scene(p, base, ctl, frame=[[cell(" ")] * area_of(base)[0]
                                        for _ in range(area_of(base)[1])])
        v = p.session("v", "layer", z="above", type="video", data=1, codec="qoi")
        fd = gpupainter.writer(os.path.join(v.dir, "data"))
        fw, fh = 64, 4
        dh = round(fh * gw / fw)
        want = {"top": 0, "centre": (gh - dh) // 2, "bottom": gh - dh}
        try:
            for where in ("top", "bottom", "centre"):
                v.command(f"align {where}")
                time.sleep(0.05)
                os.write(fd, qoi(fw, fh, (200, 40, 40, 255)))

                def lit():
                    g = rgb(ctl.picture()[1])
                    rows = np.flatnonzero((g == (200, 40, 40)).all(axis=2).all(axis=1))
                    others = np.count_nonzero(g.any(axis=2)) - len(rows) * gw
                    return (int(rows[0]), int(rows[-1]) + 1, others) if len(rows) else None
                got = gpupainter.wait_for(lambda: lit() == (want[where], want[where] + dh, 0), 3)
                assert got, f"align {where}: lit {lit()}, want rows {want[where]}-" \
                            f"{want[where] + dh} and nothing else"
        finally:
            os.close(fd)
        return f"{fw}x{fh} on {gw}x{gh}: rows {dh} high at {sorted(want.values())}"


@check
def frames_with_alpha_blend_over_the_cells():
    """A ground of one colour in cells, and over it a frame the glass's
    size in another, as QOI and PNG at several alphas and as JPEG, which
    has none: each pixel is the frame's colour over the ground's, mixed
    by its alpha, within 1; the JPEG within 2 of the colour it decodes to
    here, since two JPEG decoders may round a flat colour differently."""
    gw, gh = 320, 180
    ground = (32, 64, 96)
    with gpupainter.Painter((gw, gh)) as p:
        base, ctl = connected_base(p), p.session("ctl", "controller")
        cols, rows = area_of(base)
        g = [[cell(" ", "default", "%02x%02x%02x" % ground) for _ in range(cols)]
             for _ in range(rows)]
        under = show_scene(p, base, ctl, frame=g)
        cw, chh = cols * (gw // cols), rows * (gh // rows)
        assert (under[:chh, :cw] == ground).all(), "the ground is not the colour asked"
        v = p.session("v", "layer", z="above", type="video")
        worst = {}
        cases = []
        for a in (255, 192, 128, 64, 1, 0):
            cases.append((f"qoi a={a}", qoi(gw, gh, (200, 100, 50, a)), (200, 100, 50, a), 1))
        for a in (255, 128, 0):
            cases.append((f"png a={a}", encoded("PNG", gw, gh, (10, 220, 130, a)),
                          (10, 220, 130, a), 1))
        jpeg = encoded("JPEG", gw, gh, (240, 200, 20), quality=95)
        cases.append(("jpeg", jpeg, tuple(int(c) for c in rgb(jpeg)[gh // 2, gw // 2]) + (255,), 2))
        for name, data, (r, gr, b, a), tol in cases:
            v.write(frame_bytes(data, "hold=still"))
            want = np.array((r, gr, b)) * a / 255 + np.array(ground) * (1 - a / 255)

            def err():
                got = rgb(ctl.picture()[1])[:chh, :cw].astype(np.float64)
                return np.abs(got - want).max()
            ok = gpupainter.wait_for(lambda: err() <= tol, 3)
            worst[name] = err()
            assert ok, f"{name}: {worst[name]:.1f} from {want.round(1)} (tolerance {tol})"
        v.command("clear")
        return "max error " + ", ".join(f"{k} {x:.1f}" for k, x in worst.items())


#: How far each class may be from v1's pixels: (largest channel
#: difference, share of the class's pixels that may differ at all). What
#: the painter draws as geometry is its own arithmetic and matches to the
#: pixel. Text is FreeType's: 2.14 on the Mac and 2.13 on the Pis put one
#: level of a glyph's edge one apart in about a quarter of a per cent of
#: the text's pixels, and a glyph drawn at all wrong is far more than
#: either bound.
TOLERANCE = {
    "blocks": (0, 0.0),
    "box": (0, 0.0),
    "shapes": (0, 0.0),
    "braille": (0, 0.0),
    "fill": (0, 0.0),
    "text": (1, 0.01),
}


@check
def cells_and_drawn_characters_match_v1():
    """The scene on a glass the size of the Pi's that made the reference,
    at its font, against v1's `picture glass` of it: every character the
    painter draws as geometry exactly, class by class; the text, which
    each machine's FreeType rasterises, to within TOLERANCE."""
    if not os.path.exists(V1):
        return f"skipped: no reference; take one with --capture HOST:WALL"
    with open(V1_SAID) as fh:
        said = json.load(fh)
    want = rgb(open(V1, "rb").read())
    with gpupainter.Painter(tuple(said["glass"]), font=said["font"], env=said["env"]) as p:
        base, ctl = connected_base(p), p.session("ctl", "controller")
        glass, cellsz = glass_of(ctl)
        assert list(cellsz) == said["cell"], f"a cell is {cellsz} here, {said['cell']} on v1"
        assert list(area_of(base)) == said["area"], f"{area_of(base)} here, {said['area']} on v1"
        got = show_scene(p, base, ctl)
    assert got.shape == want.shape, (got.shape, want.shape)
    ch = said["cell"][1]
    out, bad = [], []
    for name, (a, b) in class_rows().items():
        g = got[a * ch:(b + 1) * ch].astype(int)
        w = want[a * ch:(b + 1) * ch].astype(int)
        d = np.abs(g - w).max(axis=2)
        most, share = TOLERANCE[name]
        off = np.count_nonzero(d) / d.size
        out.append(f"{name} {d.max()}/{off:.2%}")
        if d.max() > most or off > share:
            ys, xs = np.nonzero(d)
            bad.append(f"{name}: {np.count_nonzero(d)} pixels differ, up to {d.max()}, "
                       f"first at cell {xs[0] // said['cell'][0]},{a + ys[0] // ch}")
    rest = np.abs(got.astype(int) - want.astype(int)).max(axis=2)
    rest[:(FILL_ROW + 1) * ch] = 0
    if rest.any():
        bad.append(f"outside the scene: {np.count_nonzero(rest)} pixels differ")
    assert not bad, "; ".join(bad)
    return "largest difference/share differing: " + ", ".join(out)


