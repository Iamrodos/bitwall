# ------------------------------------------------------------- the scene
#
# One scene for the painter here and for v1 on a Pi: every class of
# character the painter draws as geometry, in colours that change from
# cell to cell, and a line of text from the font. Each class has rows of
# its own, so each is compared with a tolerance of its own.

def _fg(x, y):
    return f"{(37 * x + 11 * y) % 256:02x}{(91 * x + 40 + 5 * y) % 256:02x}{(53 * x + 200) % 256:02x}"


def _bg(x, y):
    return f"{(13 * x + 3 * y) % 64:02x}{(7 * x) % 48:02x}{(29 * x + 9 * y) % 64:02x}"


def _span(a, b, skip=()):
    return "".join(chr(c) for c in range(a, b + 1) if c not in skip)


#: Box lines drawn by the font, not as geometry: dashed and diagonal.
FONT_BOX = set(range(0x2504, 0x250C)) | set(range(0x254C, 0x2550)) | {0x2571, 0x2572, 0x2573}

#: The scene's rows: (class, row, text). A row's text starts at column 1.
SCENE = [
    ("text", 0, "bitwall painter pixels: The quick brown fox 0123456789 {}[]()<>=+-*/@#$%&"),
    ("text", 1, "".join(chr(c) for c in sorted(FONT_BOX)) + " ÀÉÎõü ßøæ ←↑→↓ ⇐⇒ ■□▲▼●◆"),
    ("blocks", 3, "█▀▄▌▐▁▂▃▄▅▆▇▉▊▋▍▎▏▔▕ ▖▗▘▝▙▚▛▜▞▟"),
    ("blocks", 4, _span(0x1FB00, 0x1FB3B)),
    ("blocks", 5, _span(0x1CD00, 0x1CD72)),
    ("blocks", 6, _span(0x1CD73, 0x1CDE5)),
    ("blocks", 7, _span(0x1FB70, 0x1FB8B) + _span(0x1FBE4, 0x1FBE7) + _span(0x1CEA0, 0x1CEAF)),
    ("box", 9, "┌─┬─┐ ╔═╦═╗ ┏━┳━┓ ╭──╮ ┍┑┎┒ ╓╖╒╕ ┼╋╬╪╫"),
    ("box", 10, "├─┼─┤ ╠═╬═╣ ┣━╋━┫ │  │ ┕┙┖┚ ╙╜╘╛ ╴╵╶╷╸╹╺╻╼╽╾╿"),
    ("box", 11, "└─┴─┘ ╚═╩═╝ ┗━┻━┛ ╰──╯"),
    ("box", 12, _span(0x2500, 0x257F, FONT_BOX)),
    ("shapes", 14, "◢◣◤◥ ◢██◣ ░▒▓ ░░▒▒▓▓ ▪▪▪▪ ▪ ▪"),
    ("shapes", 15, "◥██◤ ░▒▓█"),
    ("braille", 17, _span(0x2800, 0x287F)),
    ("braille", 18, _span(0x2880, 0x28FF)),
]
#: A row of grounds alone: the xterm colours and the default.
FILL_ROW = 20
ROWS_NEEDED = 22
COLS_NEEDED = 130
CLASSES = ("text", "blocks", "box", "shapes", "braille", "fill")


def scene(cols, rows):
    """The scene on a grid of `cols` by `rows`."""
    g = [[cell(" ") for _ in range(cols)] for _ in range(rows)]
    for _, y, text in SCENE:
        for i, ch in enumerate(text[:cols - 1]):
            x = i + 1
            if ch == " ":
                continue
            g[y][x] = cell(ch, _fg(x, y), _bg(x, y), bold=(y == 0 and 30 <= x < 40))
    for x in range(1, cols - 1):
        g[FILL_ROW][x] = cell(" ", "default", (x - 1) % 256 if x < cols - 2 else "default")
    return g


def class_rows():
    """Each class's rows, as (first, last) cell rows."""
    out = {}
    for name, y, _ in SCENE:
        a, b = out.get(name, (y, y))
        out[name] = (min(a, y), max(b, y))
    out["fill"] = (FILL_ROW, FILL_ROW)
    return out


# ------------------------------------------------------------- pictures

def rgb(data):
    """A picture's bytes, QOI or PNG, as an (h, w, 3) array."""
    return np.asarray(Image.open(io.BytesIO(data)).convert("RGB"))


def glass_of(ctl):
    """(w, h) of the glass, and (cw, ch) of a cell, from `screen`."""
    ctl.command("report")
    ctl.wait(lambda h: any(x.startswith("screen ") for x in h))
    line = next(x for x in reversed(ctl.heard) if x.startswith("screen "))
    opts = dict(w.split("=", 1) for w in line.split()[1:] if "=" in w)
    pw, ph = map(int, opts["pixels"].split("x"))
    cw, chh = map(int, opts["cell"].split("x"))
    return (pw, ph), (cw, chh)


def area_of(s):
    line = next(x for x in reversed(s.heard) if x.startswith("area "))
    cols, rows = map(int, line.split()[1].split("x"))
    return cols, rows


def show_scene(p, base, ctl, frame=None):
    """The scene sent to the base whole, and the glass once it has been
    drawn: a picture that comes back the same twice in a row."""
    cols, rows = area_of(base)
    base.write(serialise(frame or scene(cols, rows), None, True, cols, rows))
    last = None
    for _ in range(40):
        time.sleep(0.05)
        got = rgb(ctl.picture()[1])
        if last is not None and np.array_equal(got, last):
            return got
        last = got
    raise AssertionError("the glass never settled")


def connected_base(p, name="base"):
    base = p.session(name, "layer", z=0, type="cells", take=1)
    base.command("report")
    if not base.wait(lambda h: any(x.startswith("area ") for x in h)):
        raise AssertionError(f"no area: {base.heard}")
    return base


